                {
                  "id": "d308aa31-1534-9882-731d-303e3599588d",
                  "title": "Capture Friction & Progressive Qualification",
                  "blocks": [
                    {
                      "text": "Balancing Conversion Rate With Lead Signal",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "On top-of-funnel checklists, ask strictly First Name + Work/Personal Email (plus optional single-click role dropdown). Save deeper budget or timeline questions for high-intent \"Request Consultation\" pages or automated Email #2 quick reply triggers.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Progressive Profiling",
                      "text": "Gathering lightweight initial contact info first, then collecting deeper context naturally across follow-up interactions or booking steps.",
                      "type": "definition"
                    },
                    {
                      "body": "Checklist download: Email + First Name. Strategy Call Booking: Email + Name + Website URL + Primary Bottleneck dropdown.",
                      "type": "example",
                      "title": "Right-Sized Form Fields"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Cut unnecessary phone-number prompts on free resource pages unless callers requested calls.",
                        "State plainly beneath the CTA what happens next (\"Instant PDF link, unsubscribe anytime\").",
                        "Test every opt-in confirmation flow from mobile phones directly."
                      ],
                      "title": "Applying Capture Friction & Progressive Qualification"
                    },
                    {
                      "text": "Removing a mandatory phone number from a beginner guide download form lifted opt-in completions from 14% to 33%—while adding an optional \"Want a custom review?\" link inside Email #1 booked warmer calls anyway.",
                      "type": "case_study",
                      "title": "Doubling Opt-Ins by Dropping Phone",
                      "takeaway": "Match form ask strictly to promise value."
                    },
                    {
                      "text": "One honest line explaining email cadence and privacy reassurance measurably calms hesitation.",
                      "type": "callout",
                      "title": "Respect Trust Beneath the Button",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "When should you keep opt-in form fields minimal (Email + Name) instead of requiring phone, budget, and address?",
                      "options": [
                        "When delivering high-intent legal contracts",
                        "On top-of-funnel educational resources where high friction drops opt-ins before trust is built",
                        "Never"
