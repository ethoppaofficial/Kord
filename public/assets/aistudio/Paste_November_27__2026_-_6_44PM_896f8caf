                  "blocks": [
                    {
                      "text": "Anchored Time Checkpoints",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Never rehearse by memorizing rigid paragraphs; rehearse opening minute, key transitions, and closing minute aloud with a visible midpoint clock check (\"By minute 10, must reach Option Comparison\"). Always preserve your final 20% buffer for genuine Q&A and crisp closing next steps—cutting middle fluff calmly rather than speed-talking the finish.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Midpoint Time Anchor",
                      "text": "Setting one clear halfway slide checkpoint (\"Slide 5 at half time\") plus cutting planned optional middle slides cleanly if Q&A runs rich early.",
                      "type": "definition"
                    },
                    {
                      "body": "Tag Slides 7 and 8 internally as \"Deep Detail—Skip Cleanly if Q&A Runs Rich\" so closing CTA never gets clipped at minute zero.",
                      "type": "example",
                      "title": "Modular Cut-Safe Structure"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Speak key transitions out loud twice standing or seated like real calls.",
                        "Set 1 midpoint clock target clearly.",
                        "Design 1–2 modular optional detail slides you can skip seamlessly without anyone noticing."
                      ],
                      "title": "Applying Smart Rehearsal & Time Protection"
                    },
                    {
                      "text": "Ending two minutes early with confident next steps consistently wins stronger praise than frantic breathless rushing at minute 31.",
                      "type": "case_study",
                      "title": "Always Finishing Cleanly Early",
                      "takeaway": "Punctual poised finishers command respect immediately."
                    },
