            {
              "id": "28fedb46-1926-6e1b-faf4-d14cce6c628f",
              "title": "Module 6: Workplace Professionalism Capstone Integration",
              "lessons": [
                {
                  "id": "26fccbf6-0239-8cd8-decf-163d880c433d",
                  "title": "Navigating Delicate Workplace Dynamics",
                  "blocks": [
                    {
                      "text": "Principled Diplomacy & Clarity",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Diplomacy is not fake friendliness or avoiding truth—it is speaking truth in ways others can hear and act upon without unnecessary bruised egos. Keep records factual, advocate openly for users and sound standards, and refuse office gossip by redirecting rumors back to direct owners.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Gossip Redirect Habit",
                      "text": "Calmly suggesting two peers speak directly (\"Have you raised that timeline worry with Sam yet? Want me to help frame it?\") instead of feeding side-channel venting.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Sounds frustrating waiting on those specs—let's tag Sam in the project thread cleanly with today's launch impact so we get clarity fast.\"",
                      "type": "example",
                      "title": "Turning Side-Channel Tension Constructive"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Never vent about teammates in public or semi-public work channels.",
                        "Direct complaints constructively back toward decision-makers.",
                        "Keep personal integrity steady regardless of temporary pressure."
                      ],
                      "title": "Applying Navigating Delicate Workplace Dynamics"
                    },
                    {
                      "text": "During an intense quarterly close, refusing blame games and encouraging transparent blocker triage kept cross-functional morale remarkably high.",
                      "type": "case_study",
                      "title": "Maintaining Team Cohesion Under Crunch",
                      "takeaway": "Steady diplomacy anchors teams when deadlines tighten."
                    },
                    {
                      "text": "Write every workplace chat or email as though leadership and affected teammates might one day read it fairly.",
