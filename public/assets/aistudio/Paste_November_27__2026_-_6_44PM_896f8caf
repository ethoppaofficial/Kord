                  "blocks": [
                    {
                      "text": "Reading Role Specs Like Diagnostic Checklists",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Compare real role requirements against your current evidence: match 60–75%+ of core competencies cleanly, identify 1–2 highest-leverage missing skills (e.g., reaching Practising or Demonstrated on a linked roadmap), and prioritize tailored applications to realistic, growing teams rather than spraying 50 generic PDFs.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Skill-Gap Triage",
                      "text": "Evaluating which single missing or early-stage competency yields the highest readiness lift for a target role before applying.",
                      "type": "definition"
                    },
                    {
                      "body": "Seeing you already match HTML/CSS and Marketing Basics, completing one practical analytics capstone lifts readiness from \"Developing\" to \"Strong match\".",
                      "type": "example",
                      "title": "Strategic Match Lift"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Track target roles in a clean 10-row pipeline sheet.",
                        "Customize resume summary and project ordering for each target track.",
                        "Bridge top 1–2 recurring skill gaps via practical portfolio artifacts."
                      ],
                      "title": "Applying Skill-Gap Mapping & Smart Application Targeting"
                    },
                    {
                      "text": "Applying thoughtfully to 8 well-matched studios with tailored 1-paragraph notes yielded 3 interviews versus zero from 80 blind portals.",
                      "type": "case_study",
                      "title": "Targeted 8 vs Generic 80",
                      "takeaway": "Precision beats volume cleanly."
                    },
                    {
                      "text": "Job specs list wishlists—if you hold solid proof on ~70% of core duties and learn fast, apply cleanly!",
                      "type": "callout",
                      "title": "Don’t Wait for 100% Match",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "How should you react when you meet ~70% of a target role’s core skills while lacking 1–2 nice-to-haves?",
                      "options": [
                        "Wait 2 years until 100%",
