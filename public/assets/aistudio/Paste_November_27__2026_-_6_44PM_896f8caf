                    },
                    {
                      "id": "f501f4ea-f000-41f0-8816-3ef5cf6a240a",
                      "url": "https://www.gov.uk/guidance/content-design",
                      "title": "Content Design & Writing Standards",
                      "position": 2,
                      "resource_type": "guide"
                    }
                  ],
                  "takeaways": [
                    "Protect uninterrupted drafting sprints",
                    "Flag missing facts cleanly with bracket markers",
                    "Write introductions last if the opening stalls"
                  ],
                  "objectives": [
                    "Explain zero-friction drafting momentum",
                    "Apply separating drafting from editing in original drafts"
                  ],
                  "est_minutes": 28,
                  "is_required": true,
                  "introduction": "Editing every word while typing breaks flow and traps writers on the first paragraph.",
                  "further_reading": [
