                  "blocks": [
                    {
                      "text": "Protecting Deep Work for High-Leverage Outcomes",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Evaluate tasks along Importance (moves long-term goals/deliverables forward) vs Urgency (loud deadline or ping). Lock your highest-energy morning/peak hours strictly for Important creative/analytical work before diving into reactive inbox cleanup.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Eisenhower Priority Triage",
                      "text": "Sorting work intentionally across Do Now (Urgent+Important), Schedule Deep Focus (Important, Not Yet Urgent), Batch/Delegate (Urgent Noise), and Drop.",
                      "type": "definition"
                    },
                    {
                      "body": "Spending the first 90 minutes writing the core report before opening Slack kept a team lead’s week calm regardless of afternoon requests.",
                      "type": "example",
                      "title": "Morning Anchor Habit"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Name top 1–2 \"Must-Win\" outcomes before starting each morning.",
                        "Silence non-urgent notifications during 60–90 minute deep blocks.",
                        "Say polite clear \"Not this week—here’s next week’s slot\" to low-value requests."
                      ],
                      "title": "Applying Impact Triage: Important vs Urgent Noise"
                    },
                    {
                      "text": "Clearing 45 minor messages felt busy until Friday revealed zero progress on the quarterly brief—protecting mornings fixed it instantly.",
                      "type": "case_study",
                      "title": "Zero-Inbox Illusion",
                      "takeaway": "Inbox zero is not work impact."
                    },
                    {
                      "text": "Checking messages every 4 minutes slashes deep analytical comprehension severely; check on clean 60–90 minute cadences instead.",
                      "type": "callout",
                      "title": "Beware Reactive Switching",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why protect peak daily energy hours for Important non-urgent work before checking inboxes?",
