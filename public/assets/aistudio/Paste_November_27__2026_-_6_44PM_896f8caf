                  "blocks": [
                    {
                      "text": "Independent Thinking Before Open Debate",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Before discussing options aloud in a team meeting, spend five quiet minutes letting every member write their independent recommendation, risk, and rationale silently on a shared doc. Seeing all views uninfluenced eliminates anchoring behind the first manager voice—surfacing dramatically richer solutions.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Silent Pre-Write",
                      "text": "Dedicated 5-minute solo writing phase before verbal group discussion so titles and early loud voices do not bias independent thinking.",
                      "type": "definition"
                    },
                    {
                      "body": "Five team members independently scored 3 vendor demos silently before revealing scores—catching major support gaps missed during hype discussion.",
                      "type": "example",
                      "title": "Fair Vendor Evaluation"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "State clear decision criteria upfront.",
                        "Collect silent written views before vocal debate starts.",
                        "Debate top 2 options crisply against stated criteria."
                      ],
                      "title": "Applying Defeating Groupthink With Silent Pre-Writes"
                    },
                    {
                      "text": "Switching sprint planning to silent pre-writes surfaced two critical architectural bugs from a shy junior developer never raised aloud previously.",
                      "type": "case_study",
                      "title": "Quieter Genius Unlocked",
                      "takeaway": "Structured inclusion unleashes full collective IQ cleanly."
                    },
                    {
                      "text": "Team leads should share opinions LAST during ideation so teammates think freely first.",
                      "type": "callout",
                      "title": "Hide Manager Picks Until Step 3",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why start high-stakes team evaluations with a 5-minute silent written brainstorm?",
                      "options": [
