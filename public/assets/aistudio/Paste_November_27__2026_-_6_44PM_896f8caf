              "lessons": [
                {
                  "id": "57128a61-1d78-ead5-30f9-ed628fac9d88",
                  "title": "Constructive Pushback & Saying No",
                  "blocks": [
                    {
                      "text": "Yes-If Trade-Off Framing",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Professional boundary setting means declining a specific constraint—not refusing to help. Using \"Yes, if...\" framing shows commitment to the team goal while surfacing real capacity, scope, or quality trade-offs. Giving stakeholders two realistic paths puts them in control of priorities rather than surprising them late.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Trade-Off Framing",
                      "text": "Responding to unrealistic asks by presenting achievable combinations of scope, timeline, and quality rather than bare refusal.",
                      "type": "definition"
                    },
                    {
                      "body": "\"We can ship by Friday if we defer CSV export to Monday, or keep all features and ship Tuesday. Which serves the launch best?\"",
                      "type": "example",
                      "title": "Protecting Quality Under Tight Timelines"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Acknowledge the urgency behind the requester's goal.",
                        "State current capacity or risk objectively without apologetic drama.",
                        "Present two actionable trade-off paths and ask them to choose."
                      ],
                      "title": "Applying Constructive Pushback & Saying No"
                    },
                    {
                      "text": "An account specialist accepted three overlapping rush requests, missing two deadlines silently.",
                      "type": "case_study",
                      "title": "Silent Overload Burnout",
                      "takeaway": "Immediate trade-off framing preserved client trust and reallocated one task cleanly."
                    },
                    {
                      "text": "Bad news ages poorly; surfacing a 2-day slip four days early earns gratitude, while surfacing it on due day erodes trust.",
                      "type": "callout",
                      "title": "Raise Risks Early",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What makes \"Yes, if...\" pushback constructive?",
                      "options": [
                        "It hides capacity limits until failure occurs",
                        "It shares goal ownership while letting stakeholders pick realistic scope/date trade-offs",
                        "It blames leadership for poor planning"
                      ],
                      "explanation": "Offering honest options keeps collaboration active and transparent.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Clear boundaries protect reliability, quality, and long-term trust.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "ba4cc657-8f39-46f7-a76f-b03d20a33f45",
