            {
              "id": "912d563f-9943-1710-55b9-5bcd15d76884",
              "title": "Module 4: Cross-Cultural & Empathetic Communication",
              "lessons": [
                {
                  "id": "9452b9fd-1095-5f09-3667-1f38bc712db9",
                  "title": "Navigating Communication Styles",
                  "blocks": [
                    {
                      "text": "Direct vs. Indirect & High- vs. Low-Context Cues",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Low-context communicators rely heavily on explicit literal words, while high-context communicators embed meaning in tone, relationship warmth, and shared background. Misreading style differences as rudeness or evasiveness damages global and cross-functional teamwork. Adapting with curiosity—clarifying agreements gently in writing—keeps diverse teams cohesive.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Context Dependency",
                      "text": "The extent to which a speaker expects listeners to infer meaning from shared background and subtle cues versus explicit statements.",
                      "type": "definition"
                    },
                    {
                      "body": "Pair warm opening rapport with explicit bulleted milestones so both relationship-oriented and task-focused teammates feel respected.",
                      "type": "example",
                      "title": "Bridging Style Differences"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Observe without labeling style differences as character flaws.",
                        "Confirm silent hesitations politely with open questions.",
                        "Document explicit agreements cleanly after discussions."
                      ],
                      "title": "Applying Navigating Communication Styles"
                    },
                    {
                      "text": "An overseas partner said \"We will see what we can try\" to decline gracefully, which the requestor logged as a firm commitment.",
                      "type": "case_study",
                      "title": "Polite \"Yes\" Misinterpretation",
                      "takeaway": "Asking \"What specific constraints could prevent Friday delivery?\" uncovers honest feasibility safely."
                    },
                    {
                      "text": "Instead of \"Can you make it?\", ask \"Walk me through what needs to happen for Friday to be realistic.\"",
                      "type": "callout",
                      "title": "Ask Process Questions",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why can \"Are you sure you can do this?\" fail in high-context settings?",
                      "options": [
                        "It triggers face-saving pressure instead of honest feasibility discussion",
                        "It uses too many technical terms",
                        "It is too slow to type"
                      ],
                      "explanation": "Open feasibility questions let partners surface constraints without losing face.",
                      "correctIndex": 0
                    }
                  ],
                  "videos": [],
                  "summary": "Awareness of style differences builds psychological safety across teams.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "0d11f1a8-703c-46ea-a1dd-58965d078e4f",
                      "url": "https://www.plainlanguage.gov/guidelines/",
                      "title": "Plain Language Guidelines & Clarity Principles",
                      "position": 1,
                      "resource_type": "guide"
                    },
                    {
                      "id": "8b3a128c-2737-4dae-b668-029a2af19b52",
                      "url": "https://www.mindtools.com/",
                      "title": "Communicating Clearly in Workplaces",
                      "position": 2,
                      "resource_type": "article"
                    }
                  ],
                  "takeaways": [
                    "Separate style habits from personal intent",
                    "Balance warmth with explicit clarity on deliverables",
                    "Use open feasibility questions to check hidden risks"
