                {
                  "id": "1673e385-6513-90c1-3e93-e85e6e5eb612",
                  "title": "The Weekly Operating Pulse & Dependency Tracking",
                  "blocks": [
                    {
                      "text": "25-Minute Weekly Alignment Cadence",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Healthy execution beats on a crisp weekly drum: a structured 25-minute review examining strictly (1) 5–7 **Weekly Leading Scorecard numbers** (`cash in/out, leads added, utilization %, urgent bugs`), (2) Red/Yellow/Green milestone status on active 90-day priorities, and (3) Cross-functional **Blockers needing live resolution**—deferring lengthy raw storytelling outside the room!",
                      "type": "paragraph"
                    },
                    {
                      "term": "Leading vs. Lagging Scorecard",
                      "text": "Tracking fast weekly inputs you steer immediately (`discovery calls booked, setup SLA hours`) rather than waiting passively for slow quarter-end outcomes (`quarterly churn`).",
                      "type": "definition"
                    },
                    {
                      "body": "Monday 9 AM (25 min): Scan 6 green/red scorecard rows (4 min) -> Spot two Yellow milestones -> Spend 15 min clearing the Marketing-to-Sales handoff blocker cleanly -> Done!",
                      "type": "example",
                      "title": "Clean Weekly Rhythm"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Publish scoreboard numbers visibly BEFORE Monday sync starts—zero live spreadsheet typing!",
                        "Use Red/Yellow/Green status honestly: \"Yellow\" early invites cheerful peer rescue before exploding into \"Red\" failures.",
                        "Assign crisp single-owner Friday deliverables to clear every raised blocker within days."
                      ],
                      "title": "Applying The Weekly Operating Pulse & Dependency Tracking"
                    },
                    {
                      "text": "Teams drifted weekly through rambling 90-minute status monologues without uncovering slipping billing metrics until month-end close.",
                      "type": "case_study",
                      "title": "2-Hour Monday Storytelling Drag",
                      "takeaway": "Switching to pre-read scorecards + blocker-only focus cut meeting bloat 70% while quadrupling speed!"
                    },
                    {
                      "text": "Celebrate managers who flag `\"Yellow — slipping 4 days unless QA unblocks\"` early instead of hiding issues under fake Green until disaster!",
                      "type": "callout",
                      "title": "Make \"Yellow\" Safe & Normal",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why make \"Yellow\" early-warning flags celebrated rather than punished in weekly operating reviews?",
                      "options": [
