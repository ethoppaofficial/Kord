            {
              "id": "a478d12f-793e-cdad-6e0b-a624bd126a23",
              "title": "Module 4: Risk Registers, Scenarios & Contingency Planning",
              "lessons": [
                {
                  "id": "ff5d784a-9d97-bb59-2d50-8b9f9fc374a9",
                  "title": "Practical Risk Registers Beyond Boilerplate",
                  "blocks": [
                    {
                      "text": "Probability, Blast Radius & Concrete Mitigations",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Effective operational risk registers surface 4–6 specific vulnerabilities unique to your actual business model (`Top 1 client represents 45% of total revenue!`, `Single key shipping supplier lacks backup`, `Founder holds sole password access`). Score **Likelihood x Severity**, assign concrete preventive buffers (`cap single-client share <25%`), and attach unmistakable trigger rules.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Concentration Risk",
                      "text": "Excessive business vulnerability tied to over-reliance on a single customer (>25–30% revenue), single ad platform, single vendor, or single irreplaceable key employee.",
                      "type": "definition"
                    },
                    {
                      "body": "Risk: Primary wholesale account accounts for 42% of Q2 cash (Medium Likelihood / Severe Impact). Prevention: Dedicate 40% sales energy diversifying 4 mid-tier accounts cleanly; hold 3-month emergency cash line untouched.",
                      "type": "example",
                      "title": "Specific High-Impact Risk Row"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Ask candidly: \"What single realistic event breaks payroll or customer delivery inside 30 days?\"",
                        "Target concentration risks across Clients, Marketing Channels, Suppliers, and Key Staff Knowledge.",
                        "Write explicit cross-training SOPs eliminating \"Bus Factor = 1\" single-person secrets cleanly!"
                      ],
                      "title": "Applying Practical Risk Registers Beyond Boilerplate"
                    },
                    {
                      "text": "An e-commerce brand built 95% of daily revenue exclusively on one social channel—an accidental ad-account suspension froze revenue cleanly to $0 overnight for 18 days.",
                      "type": "case_study",
                      "title": "Single-Channel Algorithm Wipeout",
                      "takeaway": "Holding email capture lists + diverse organic referral feeds insulates business continuity deeply."
                    },
                    {
                      "text": "Store critical domain, tax, billing, and cloud root recovery credentials cleanly inside secure shared team password vaults—never solely in one person’s head!",
                      "type": "callout",
                      "title": "Fix \"Bus Factor = 1\" Quietly Now",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Which vulnerability exposes a growing business to the sharpest abrupt revenue cliff risk?",
                      "options": [
                        "Changing brand fonts",
                        "Heavy concentration reliance on one single large client (>35% revenue) or one unbacked acquisition channel",
                        "Keeping weekly scorecards"
                      ],
                      "explanation": "Single-point customer or platform dependence leaves entire firms vulnerable overnight to external policy shifts.",
                      "correctIndex": 1
                    }
