                  "title": "Mean vs Median, Denominators & Sampling Bias",
                  "blocks": [
                    {
                      "text": "Choosing Honest Summary Statistics",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Use median and percentiles (p50/p90) alongside mean whenever data is skewed (e.g., study minutes, salaries, page latency). Always ask \"What is the denominator?\" and inspect who is missing from the sample (survivorship bias).",
                      "type": "paragraph"
                    },
                    {
                      "term": "Survivorship Bias",
                      "text": "Drawing conclusions solely from visible survivors (e.g., completed learners) while ignoring users who churned before finishing.",
                      "type": "definition"
                    },
                    {
                      "body": "Nine learners studied 15 minutes and one bot studied 6,000 minutes—mean says 613m while median accurately reflects 15m.",
                      "type": "example",
                      "title": "Misleading Average Completion"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Check median vs mean side-by-side on skewed metrics.",
                        "State explicit denominators (completed out of enrolled vs out of total site visitors).",
                        "Call out missing or truncated timeframes honestly."
                      ],
                      "title": "Applying Mean vs Median, Denominators & Sampling Bias"
                    },
                    {
                      "text": "Measuring challenge approval out of *started* learners rather than *approved only* exposed a steep drop at Module 3.",
                      "type": "case_study",
                      "title": "Flipped Funnel Diagnosis",
                      "takeaway": "Honest denominators point directly to real bottlenecks."
                    },
                    {
                      "text": "Start bar-chart baselines at zero and label sample sizes (`n = 42`) clearly on small cohorts.",
                      "type": "callout",
                      "title": "Never Crop Y-Axes Deceptively",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why report median alongside mean when analyzing skewed response times or incomes?",
                      "options": [
                        "Median is easier to color",
                        "Extreme outliers pull the mean far away from what typical users actually experience",
                        "Medians ignore zero values"
                      ],
                      "explanation": "Median accurately represents central experience under heavy skew.",
                      "correctIndex": 1
