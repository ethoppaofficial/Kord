                  "videos": [],
                  "summary": "Early metadata capture and rigorous cross-checking make academic attribution effortless.",
                  "position": 2,
                  "resources": [
                    {
                      "id": "03c5e2ae-16a1-4f63-82fd-a1efbdbd12d6",
