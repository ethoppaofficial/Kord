              "lessons": [
                {
                  "id": "28882e89-3017-b33b-b03c-0c73ad0396a8",
                  "title": "Closing the Say-Do Gap",
                  "blocks": [
                    {
                      "text": "Environment Design & Friction Removal",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Agreement in a meeting does not change Tuesday morning habits. Follow up every persuasive win by placing templates directly inside tools people already open, archiving confusing legacy versions, naming early visible wins publicly, and running a 10-minute week-two friction check (\"What step felt clunky?\").",
                      "type": "paragraph"
                    },
                    {
                      "term": "Say-Do Gap",
                      "text": "The common drop-off between verbal endorsement of a good idea and actual repeated behavioral execution weeks later.",
                      "type": "definition"
                    },
                    {
                      "body": "Instead of burying a PDF in Drive, embed the 4-item QA checklist directly inside the GitHub Pull Request template automatically.",
                      "type": "example",
                      "title": "Making New Checklists Effortless"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Put new workflows directly inside existing tools.",
                        "Trim setup steps down to <2 minutes.",
                        "Check real adoption after 14 days and fix friction calmly."
                      ],
                      "title": "Applying Closing the Say-Do Gap"
                    },
                    {
                      "text": "Embedding one structured intake form inside Jira raised complete project briefs from 35% to 92% with zero extra nagging.",
                      "type": "case_study",
                      "title": "Default Template Victory",
                      "takeaway": "Better defaults outperform endless reminder emails."
                    },
                    {
                      "text": "If teams keep forgetting step 3, check if step 3 is buried in a weird tab rather than lecturing everyone.",
                      "type": "callout",
                      "title": "Fix the System, Not Just People",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why do well-persuaded process changes often fade quietly after week two?",
                      "options": [
                        "Teams lack intelligence",
                        "High friction in old workflows pushes busy staff back to familiar defaults",
                        "Slides were too pretty"
                      ],
                      "explanation": "Embedding clean defaults removes reliance on constant willpower.",
                      "correctIndex": 1
                    }
