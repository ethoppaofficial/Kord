              "lessons": [
                {
                  "id": "6e96f39b-d244-622a-491d-8b224f7c7b7c",
                  "title": "Disciplined Five Whys Inquiry",
                  "blocks": [
                    {
                      "text": "Digging Past Human Blame",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "When an erroneous invoice goes out, stopping at \"Why #1: Rep typed wrong tax rate\" yields useless advice (\"Try harder\"). Continuing—Why #2: rate wasn't auto-filled from country table -> Why #3: CRM lacked validation against finance codes -> Why #4: handoff checklist never synced changes—uncovers a 1-hour structural fix permanently stopping errors.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Systemic Root Cause",
                      "text": "The underlying missing process guardrail, tool default, or ambiguous standard that, once fixed, prevents the entire class of failure permanently.",
                      "type": "definition"
                    },
                    {
                      "body": "Wrong link shipped -> Why? Tested on staging only -> Why? Final copy pasted after QA froze -> Why? No locked cut-off freeze rule existed.",
                      "type": "example",
                      "title": "Tracing a Broken Launch Email"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Verify every \"Because...\" answer is factually observable.",
                        "Never stop on \"someone forgot\"—ask \"Why didn't the system catch it?\"",
                        "Watch for parallel branches when two causes combine."
                      ],
                      "title": "Applying Disciplined Five Whys Inquiry"
                    },
                    {
                      "text": "Replacing vague \"be careful!\" reminders with a pre-deploy URL link checker cut live broken promos to zero permanently.",
                      "type": "case_study",
                      "title": "Permanent Outage Reduction",
                      "takeaway": "Strong safeguards rescue tired humans cleanly."
                    },
                    {
                      "text": "Read your 5-Whys chain backwards using \"Therefore\" to verify each link makes tight logical sense.",
                      "type": "callout",
                      "title": "Test Reversibility With \"Therefore\"",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why is stopping a 5-Whys investigation at \"Because an employee made a typo\" flawed?",
