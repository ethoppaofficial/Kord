                  "blocks": [
                    {
                      "text": "Rapid Truth Hygiene Routine",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Before forwarding shocking industry claims, signing off dramatic charts, or adopting viral workflows, run five fast checks: What is the source incentive? Are sample size and baseline shown? Is correlation masquerading as cause? What strongest alternative explains the numbers? What unstated assumption must hold true? Five focused minutes prevent lifelong bad bets.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Calibrated Judgment",
                      "text": "Pairing healthy analytical skepticism with open curiosity—neither gullibly swallowing hype nor cynically dismissing every new idea blindly.",
                      "type": "definition"
                    },
                    {
                      "body": "See \"90% drop in churn using X!\" -> Check denominator, timeframe, confounding price cut, and non-survivor accounts inside 2 minutes.",
                      "type": "example",
                      "title": "Rapid Chart Vet"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Notice strong emotional hooks designed to rush critical judgment.",
                        "Check source incentives and original evidence cleanly.",
                        "Maintain calibrated confidence levels (\"high/moderate/low evidence\") honestly."
                      ],
                      "title": "Applying A Five-Minute Skepticism Checklist"
                    },
                    {
                      "text": "Teams cultivating five-minute evidence hygiene calmly skipped three costly short-lived tech trends while adopting enduring tools thoughtfully.",
                      "type": "case_study",
                      "title": "Balanced Hype Immunity",
                      "takeaway": "Calm discernment saves massive focus and money."
                    },
                    {
                      "text": "Real noisy human operations rarely drop cleanly by neat round figures—verify underlying splits carefully.",
