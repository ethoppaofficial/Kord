                      "title": "Plain Language Audience Writing Principles",
                      "position": 2,
                      "resource_type": "documentation"
                    }
                  ],
                  "takeaways": [
                    "Audit real reviews and support transcripts systematically",
                    "Separate Pain, Outcome, and Hesitation quotes",
                    "Keep natural customer phrasing intact"
                  ],
                  "objectives": [
                    "Analyze message mining & exact phrasing",
                    "Apply mining real voice-of-customer (voc) phrases in original writing"
                  ],
                  "est_minutes": 28,
                  "is_required": true,
                  "introduction": "Your sharpest headlines already live inside customer support tickets, product reviews, and sales call recordings.",
                  "further_reading": [
                    {
                      "url": "https://www.nngroup.com/",
