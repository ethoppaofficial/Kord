                {
                  "id": "6b59bfd8-fd21-bcb0-0758-c6f8e127cd73",
                  "title": "The 4-Stage Resolution Flow",
                  "blocks": [
                    {
                      "text": "Opening -> Context -> Options -> Agreement",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Move cleanly across four phases: (1) Align shared goal & rules (4 min), (2) Uninterrupted perspective sharing + neutral mediator recap (10 min), (3) Joint brainstorming addressing future workflow criteria (10 min), (4) Concrete written check-in agreements (6 min). Keep 75% of energy focused on future safeguards rather than relitigating past blame.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Future-Focused Pivot",
                      "text": "Gently acknowledging past frustration once heard, then asking \"How should we handle this exact handoff differently next Tuesday?\"",
                      "type": "definition"
                    },
                    {
                      "body": "\"Both sides see how painful Tuesday's surprise was. Starting next sprint, what 24-hour notice works cleanly for both of you?\"",
                      "type": "example",
                      "title": "Clean Pivot Line"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Limit past narration strictly to surfacing lessons.",
                        "Generate at least 3 forward options before judging.",
                        "Write explicit behavioral triggers and owners."
                      ],
                      "title": "Applying The 4-Stage Resolution Flow"
                    },
                    {
                      "text": "Spending 20 minutes on next-month release checklists instead of arguing who broke July's launch cleared deadlocked hostility completely.",
                      "type": "case_study",
                      "title": "Forward Pivot Breakthrough",
                      "takeaway": "Future criteria unify teams fast."
                    },
                    {
                      "text": "Whenever someone restarts old complaints, ask gently: \"What rule would prevent that next time?\"",
                      "type": "callout",
                      "title": "Ask \"Next Time\" Questions",
                      "variant": "tip"
                    },
