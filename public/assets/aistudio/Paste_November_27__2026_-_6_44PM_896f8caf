                },
                {
                  "id": "cc509ad6-e68d-a8f4-5ab3-ffa81b395659",
                  "title": "Winning Proposals That Mirror Buyer Words",
                  "blocks": [
                    {
                      "text": "Value-Anchored Executive Proposals",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Never use generic boilerplate proposals when closing consultative deals! Mirror exact words captured during discovery inside **Section 1 (\"Your Goals & Current Stakes\")**, lay out crisp clear **Section 2 (\"Proposed Solution & Clear Out-of-Scope Boundaries\")**, offer **2–3 Value-Scaled Options** cleanly (`Core Fix vs. Accelerated Launch` replacing bare Take-It-or-Leave-It prices!), and walk through the proposal **LIVE together over a brief 15-minute review call** rather than emailing blind into void!",
                      "type": "paragraph"
                    },
                    {
                      "term": "Walk-Through Proposal Rule",
                      "text": "Reviewing commercial proposals live face-to-face (`or via short recorded loom walkthrough alongside PDF`) so nuances, option comparisons, and sticker reactions surface calmly in real time instead of disappearing into silent inbox ghosting.",
                      "type": "definition"
                    },
                    {
                      "body": "Instead of single `$5,000 take-or-leave`, offer Option A (`Core Audit + Setup: $3,800`), Option B (`Full Rollout + Team Training: $5,400` - Most Popular), Option C (`VIP Retainer: $8,200`)—shifting the buyer question cleanly from `\"Yes or No?\"` to `\"Which fit suits us best?\"`!",
                      "type": "example",
                      "title": "Three-Tier Option Contrast"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Always mirror the buyer’s exact problem metrics in the opening paragraph ahead of pricing figures.",
                        "Frame investment side-by-side against quantified savings/upside (`\"$5,400 one-time vs ~$2,200/mo wasted rework recovered cleanly inside 10 weeks\"`).",
                        "Book the exact 15-minute live Proposal Review slot right BEFORE ending the prior demo call!"
                      ],
                      "title": "Applying Winning Proposals That Mirror Buyer Words"
                    },
                    {
                      "text": "Firing raw pricing PDFs via email immediately when asked `\"Can you send a quick quote?\"` produced an 80% ghost rate cleanly because buyers skipped straight to bottom-line totals without shared value context!",
                      "type": "case_study",
                      "title": "Silent Ghosted PDF Quote",
                      "takeaway": "Walking cleanly through 1-page value-anchored summaries live boosted close rates substantially smoothly!"
                    },
                    {
                      "text": "Show clearly what staying broken costs annually right before introducing investment figures smoothly!",
                      "type": "callout",
                      "title": "Always Anchor ROI Before Total Price",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why offer 2–3 cleanly scaled Option Packages (`Core` vs `Full Rollout`) inside consultative proposals instead of one fixed number?",
                      "options": [
                        "Makes design fancier",
                        "Moves buyers cleanly off stressful binary Yes/No framing toward evaluating which tailored scope fits their priority and budget best",
                        "Confuses finance teams"
                      ],
                      "explanation": "Structured option tiers protect margins while empowering buyers with genuine choice and control.",
                      "correctIndex": 1
