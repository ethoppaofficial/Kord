                {
                  "id": "83a6011d-dd06-651d-7763-63528b3072c1",
                  "title": "Calibrated \"How / What\" Questions Instead of Blunt \"No\"",
                  "blocks": [
                    {
                      "text": "Inviting Counterparties Into Solving Your Constraint",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Replace rigid blunt refusals gently with calm open **Calibrated Questions (`starting cleanly with How or What—never accusatory Why!`)**: **\"How am I supposed to fit 6 extra custom pages inside the exact same Friday deadline without sacrificing mobile accuracy?\"** Instead of fighting YOU, the buyer’s brain immediately pivots toward helping solve the realistic puzzle collaboratively (`\"Oh right—maybe skip page 5 until November!\"`).",
                      "type": "paragraph"
                    },
                    {
                      "term": "Calibrated \"How / What\" Question",
                      "text": "A calm, open-ended question asking the counterparty constructively how to solve a real constraint (\"How can we make that schedule realistic together?\"), politely defending boundaries without flat confrontation.",
                      "type": "definition"
                    },
                    {
                      "body": "Client: \"Cut your fee 30% today!\" Calm Reply: \"We genuinely want to help launch cleanly—help me understand, what specific piece of our $10k deliverables could we trim safely to hit your $7k cap?\"",
                      "type": "example",
                      "title": "Graceful Price Pushback Reply"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Ban harsh accusatory `\"Why did you ask that?\"` phrasing cleanly (`\"Why\"` puts humans instantly on defensive trial!).",
                        "Pair warm positive intent (`\"I want to hit your Q4 goal cleanly...\"`) right ahead of your `\"How\"` reality constraint.",
                        "Listen silently while THEY invent realistic scope trims or timeline relief cleanly!"
                      ],
                      "title": "Applying Calibrated \"How / What\" Questions Instead of Blunt \"No\""
                    },
                    {
                      "text": "Demanding clients angrily insisted on rushing 10 custom videos cleanly inside 3 days until asked gently: `\"How should we sequence the top 3 urgent ones cleanly for Friday while keeping quality strong?\"` Instant calm relief!",
                      "type": "case_study",
                      "title": "The Magic Scope Defuser"
                    },
                    {
                      "text": "Never deploy fake snarky `\"How\"` traps—ask genuinely searching collaboratively for creative solutions!",
                      "type": "callout",
                      "title": "Keep Questions Strictly Honest",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why replace blunt defensive refusals (`\"No, impossible!\"`) with calm Calibrated Questions like `\"How am I supposed to absorb that scope inside Friday’s deadline?\"`",
