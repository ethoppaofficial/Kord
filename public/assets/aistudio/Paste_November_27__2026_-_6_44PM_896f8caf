                  "id": "b54fd131-e2e5-cb54-2a92-34a75ab05bc3",
                  "title": "Visual Scannability & Modern Layout",
                  "blocks": [
                    {
                      "text": "Designing Text for Digital Scanners",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "On laptops and phones, readers scan subheadings, bold lead-ins, and numbered lists before deciding which sections to read closely. Informative subheadings act as a mini outline of your piece, while 3–4 line paragraphs create restful whitespace.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Informative Subheading",
                      "text": "A section header that states a clear idea or takeaway rather than a vague one-word category label.",
                      "type": "definition"
                    },
                    {
                      "body": "Instead of \"Overview\", use \"Why Short Paragraphs Double Mobile Read-Through\".",
                      "type": "example",
                      "title": "Meaningful Subheadings"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Keep paragraphs between 2 and 4 sentences for digital clarity.",
                        "Convert enumerations of 3+ items into clean parallel bullet points.",
                        "Ensure every bullet item shares the same grammatical start (all verbs or all nouns)."
                      ],
                      "title": "Applying Visual Scannability & Modern Layout"
                    },
                    {
                      "text": "A checklist mixed nouns (\"Weekly audit\") with verbs (\"Check all links cleanly\") across five bullets, looking sloppy.",
                      "type": "case_study",
                      "title": "Parallelism Breakdown",
                      "takeaway": "Standardizing every bullet to start with an action verb unified the list instantly."
                    },
                    {
                      "text": "Make sure items inside every bulleted list follow one consistent grammatical pattern.",
                      "type": "callout",
                      "title": "Check Parallel Lists",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What improves scannability most cleanly on long web articles?",
                      "options": [
                        "Tiny margins and dense 12-line paragraphs",
                        "Meaningful subheadings, short paragraphs, and parallel bullet lists",
