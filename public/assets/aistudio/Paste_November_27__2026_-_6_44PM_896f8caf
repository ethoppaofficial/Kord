                  "title": "Bottom Line Up Front (BLUF)",
                  "blocks": [
                    {
                      "text": "Pyramid Principle & Decision Headlines",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Academic writing builds slowly toward a conclusion on page five; business communication starts at the conclusion. Under BLUF, your opening paragraph states the decision needed, headline result, and commercial or timeline impact. Only after anchoring why it matters do you lay out supporting evidence grouped into two or three logical pillars.",
                      "type": "paragraph"
                    },
                    {
                      "term": "BLUF (Bottom Line Up Front)",
                      "text": "Structuring business messages so the central recommendation, impact, and required action appear in the very first lines.",
                      "type": "definition"
                    },
                    {
                      "body": "Instead of starting with three months of software history, start: \"Request: approve £4,200/year analytics upgrade to cut weekly reporting by 12 analyst hours (4-month payback).\"",
                      "type": "example",
                      "title": "Before vs. After Budget Request"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Write the final recommendation first on a scratch line.",
                        "Move that conclusion directly to paragraph one.",
                        "Group supporting evidence into 2–3 clear bulleted pillars.",
                        "Place detailed raw logs in an optional appendix."
                      ],
                      "title": "Applying Bottom Line Up Front (BLUF)"
                    },
                    {
                      "text": "An operations lead sent a five-page audit memo with the £18k savings figure hidden on page four; executives deferred it twice.",
                      "type": "case_study",
                      "title": "The Unread Five-Page Proposal",
                      "takeaway": "Adding a 6-line Executive Summary box won approval inside 24 hours."
                    },
                    {
                      "text": "Test whether a reader skimming only your subject line and opening three sentences knows what you want approved.",
                      "type": "callout",
                      "title": "Rule of 15 Seconds",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Where does raw background chronology belong in a BLUF business memo?",
                      "options": [
                        "Paragraph one before any recommendation",
                        "In a brief supporting section or appendix after the main recommendation",
                        "Spread randomly across footnotes"
                      ],
                      "explanation": "Leaders decide faster when the recommendation comes first and context supports it cleanly.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "BLUF respects reader attention and accelerates commercial decisions.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "0a2c44d4-c89f-4d28-8251-ba39864cd076",
                      "url": "https://www.plainlanguage.gov/guidelines/",
                      "title": "Plain Language Guidelines & Clarity Principles",
                      "position": 1,
                      "resource_type": "guide"
                    },
                    {
                      "id": "2e2afc5f-1678-49a8-b2ec-80a00cc84279",
                      "url": "https://www.mindtools.com/",
                      "title": "Communicating Clearly in Workplaces",
                      "position": 2,
                      "resource_type": "article"
                    }
                  ],
                  "takeaways": [
                    "Put the headline recommendation at the very top",
                    "Group evidence into 2–3 logical pillars",
                    "Keep detailed logs in an appendix"
                  ],
                  "objectives": [
                    "Explain pyramid principle & decision headlines",
                    "Apply bottom line up front (bluf) in everyday scenarios"
                  ],
                  "est_minutes": 28,
                  "is_required": true,
                  "introduction": "Decision-makers read chronologically-written emails from bottom to top—or stop halfway through.",
                  "further_reading": [
                    {
                      "url": "https://www.plainlanguage.gov/guidelines/",
