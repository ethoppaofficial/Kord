              "lessons": [
                {
                  "id": "6dbd3d98-be8e-9074-1307-f12f2721c9e7",
                  "title": "Causality: \"But\" and \"Therefore\"",
                  "blocks": [
                    {
                      "text": "Narrative Causality Engine",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "As South Park creators famously framed it, great storytelling connects beats with \"but\" (complication) and \"therefore\" (consequence), never plain \"and then\". Causality makes listeners lean forward because every choice forces the next hurdle rather than floating as random trivia.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Causal Beats",
                      "text": "Story sequencing where one event creates a complication (\"but\") triggering a decisive reaction (\"therefore\"), driving unified momentum.",
                      "type": "definition"
                    },
                    {
                      "body": "Flat: \"We built a tool and hired three reps and went to an expo.\" Causal: \"We built a tool, BUT clients ignored signup links; THEREFORE we interviewed 20 buyers and discovered trust hung on live demos.\"",
                      "type": "example",
                      "title": "Converting Flat Company History"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Write out 5 key events from your experience.",
                        "Draw arrows replacing every \"then\" with \"but\" or \"therefore\".",
                        "Cut any beat that fails to trigger tension or shift direction."
                      ],
                      "title": "Applying Causality: \"But\" and \"Therefore\""
                    },
                    {
                      "text": "A startup pitched its timeline chronologically from college roommates to office leases while investors checked phones.",
                      "type": "case_study",
                      "title": "Monotone Founder Pitch",
                      "takeaway": "Reframing around the failed pilot (\"BUT zero retention...\") snapped the whole room upright."
                    },
                    {
                      "text": "Circle every \"and then\" in draft stories—if three appear in a row, tension has flattened out.",
                      "type": "callout",
                      "title": "Audit Transitions With Markers",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What turns a sequence of real events into a genuine gripping story?",
                      "options": [
                        "Detailed weather timestamps",
                        "Causal friction (\"but\" and \"therefore\") linking stakes and choices",
                        "Long lists of credentials"
                      ],
                      "explanation": "Conflict and consequence generate forward anticipation where pure chronology falls flat.",
