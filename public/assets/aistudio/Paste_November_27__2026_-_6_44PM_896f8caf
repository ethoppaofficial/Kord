                      "resourceType": "Research"
                    }
                  ],
                  "publication_status": "published",
                  "completion_criteria": "Study the core frameworks in \"The Micro-Arc Inside Every Scene\", verify the inline knowledge check, and apply the practical checklist."
                },
                {
                  "id": "07a31016-8e74-e6ae-2cd6-328100350299",
                  "title": "Rhythm, Tension & Pacing Shifts",
                  "blocks": [
                    {
                      "text": "Alternating Scene & Sequel Beats",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Longer stories breathe cleanly by alternating high-intensity Scene confrontations with brief reflective Sequel beats where the character absorbs fallout, reacts emotionally, and chooses a fresh risky plan. Tight syntax speeds tempo; longer sensory observations deliberately slow time before big turns.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Sequel Beat",
                      "text": "A brief transitional beat following intense conflict where the character processes emotional impact and commits to their next risky move.",
                      "type": "definition"
                    },
                    {
                      "body": "Fast crisis: \"Glass snapped. She vaulted the low rail, shoes skidding across wet slate.\" Quiet aftermath: \"Rain settled slowly into porch boards while streetlights buzzed.\"",
                      "type": "example",
                      "title": "Pacing Syntax Control"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Follow intense confrontations with brief grounding breathers.",
                        "Compress tense action using active verbs and short sentences.",
                        "Eliminate redundant modifiers during rapid beats."
                      ],
                      "title": "Applying Rhythm, Tension & Pacing Shifts"
                    },
                    {
                      "text": "Six consecutive escape chapters with zero reflective pauses left beta readers numb and indifferent.",
                      "type": "case_study",
                      "title": "Fatiguing Action Sprint",
                      "takeaway": "Inserting short quiet dilemma pauses restored emotional attachment instantly."
                    },
                    {
                      "text": "When action moves fast, strip descriptive padding—pure nouns and crisp verbs accelerate reading speed naturally.",
                      "type": "callout",
                      "title": "Speed Uses Fewer Adjectives",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "How do writers intentionally accelerate scene pacing?",
                      "options": [
                        "Adding long architectural histories",
                        "Cutting modifiers in favor of tight sentences with direct active verbs",
                        "Inserting flashbacks mid-chase"
                      ],
                      "explanation": "Sparse syntax mirrors hurried physical urgency cleanly.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Deliberate pacing contrasts make both quiet moments and crises strike harder.",
                  "position": 2,
                  "resources": [
                    {
                      "id": "16cc71a5-f5b4-45f6-8a69-d60072e585f1",
                      "url": "https://www.nngroup.com/",
                      "title": "Nielsen Norman Group UX & Copy Clarity",
                      "position": 1,
                      "resource_type": "research"
                    },
                    {
                      "id": "ebc3b078-d305-4b4f-9df5-bb200837ef6f",
                      "url": "https://www.plainlanguage.gov/guidelines/",
                      "title": "Plain Language Audience Writing Principles",
                      "position": 2,
                      "resource_type": "documentation"
                    }
                  ],
                  "takeaways": [
                    "Pair action bursts with thoughtful decision pauses",
                    "Trim descriptive modifiers to quicken tempo",
                    "Match sentence length to emotional speed"
                  ],
                  "objectives": [
                    "Analyze alternating scene & sequel beats",
                    "Apply rhythm, tension & pacing shifts in original writing"
                  ],
                  "est_minutes": 28,
                  "is_required": true,
                  "introduction": "Constant breathless action numbs readers just as quickly as endless introspection slows them down.",
                  "further_reading": [
                    {
                      "url": "https://www.nngroup.com/",
                      "title": "Nielsen Norman Group UX & Copy Clarity",
                      "source": "nngroup.com",
                      "resourceType": "Research"
                    },
                    {
                      "url": "https://www.plainlanguage.gov/guidelines/",
                      "title": "Plain Language Audience Writing Principles",
                      "source": "plainlanguage.gov",
                      "resourceType": "Documentation"
                    }
                  ],
                  "publication_status": "published",
                  "completion_criteria": "Study the core frameworks in \"Rhythm, Tension & Pacing Shifts\", verify the inline knowledge check, and apply the practical checklist."
                }
              ],
              "summary": "Shape individual scenes as mini-stories containing goal, conflict, turn, and aftermath.",
              "position": 3,
              "est_hours": 3,
              "activities": [
                {
                  "id": "d4272174-04a5-e642-4248-6c26deffbb56",
                  "title": "Scene Beat Sheet & Draft",
                  "phase_id": "9b163f74-b560-3bb7-ad01-16a324dbc122",
                  "position": 1,
                  "lesson_id": "07a31016-8e74-e6ae-2cd6-328100350299",
                  "resources": [],
                  "description": "Plan and write a 350-word turning-point scene with explicit Goal, Escalation, and Shift.",
                  "est_minutes": 30,
                  "is_required": true,
                  "instructions": "End on an unexpected reversal or deepened complication.",
                  "expected_output": "Beat map + 350-word turning-point scene"
                }
              ],
              "difficulty": "Beginner",
              "objectives": [
