                {
                  "id": "7df0cc33-3642-c7eb-5ead-d77a18f05eba",
                  "title": "Compelling Titles, Slugs & Meta Descriptions",
                  "blocks": [
                    {
                      "text": "Organic CTR Without Clickbait",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Clean search snippets optimize three touchpoints: concise evergreen URL Slugs (`/blog/bluf-business-writing`, avoiding hard-coded dates like `/2024/` that go stale!), tight `<title>` tags under ~55–58 characters front-loading key value + distinct differentiator without ellipsis cutoff, and inviting Meta Descriptions under ~150 characters summarizing exact reader value like clean mini-ad copy.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Evergreen Slug",
                      "text": "Short descriptive lowercase hyphenated URL path omitting brittle calendar years or fluff words (`/guide-to-csv-cleanup`) so future content updates keep exact links intact cleanly.",
                      "type": "definition"
                    },
                    {
                      "body": "Weak Title (78 chars truncated): \"A Comprehensive Complete Ultimate Guide to Everything About...\" Crisp Title (52 chars): \"BLUF Business Writing: Write Decision Memos Fast\". Meta (142 chars): \"Learn the BLUF memo structure with worked before-and-after examples, scorecard templates, and executive email tips.\"",
                      "type": "example",
                      "title": "Search Snippet Makeover"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Keep `<title>` tags comfortably within ~50–58 characters so full hooks display on mobile/desktop results.",
                        "Front-load target concept toward the left side of `<title>`.",
                        "Keep URLs tidy (`3–5` clear words) and omit volatile year numbers from permanent slugs!"
                      ],
                      "title": "Applying Compelling Titles, Slugs & Meta Descriptions"
                    },
                    {
                      "text": "Publishing `/top-tools-2023` forced either broken redirects or weird outdated URL stamps when updated cleanly in 2026.",
