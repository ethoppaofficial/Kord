                {
                  "id": "f4007ad1-e2c5-7d89-004b-76b96e56450d",
                  "title": "Eye Prose Crashes Out Loud",
                  "blocks": [
                    {
                      "text": "Spoken Syntax & Conversational Contractions",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Listeners cannot rewind casually mid-clause like readers scanning backwards over a comma. Writing for ears favors short active sentences, everyday contractions (\"we'll\", \"doesn't\", \"here's\"), crisp one-idea-per-line rhythm, and repeating key subject nouns instead of distant pronouns.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Ear-Readiness Test",
                      "text": "Reading script drafts aloud at normal camera speed—highlighting every tongue-twister consonant cluster, stiff formal phrase (\"furthermore\"), or multi-comma breath trap.",
                      "type": "definition"
                    },
                    {
                      "body": "Page: \"Furthermore, utilizing unindexed queries frequently results in degraded performance.\" Mic: \"And here’s why queries crawl—without an index, the database reads every single row.\"",
                      "type": "example",
                      "title": "Page vs. Mic Rewrite"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Use natural contractions always unless legal scripts forbid them.",
                        "Replace stiff essay transitions (\"moreover\", \"consequently\") with natural bridges (\"that’s why\", \"meaning\").",
                        "Read every single line aloud before locking any script."
                      ],
                      "title": "Applying Eye Prose Crashes Out Loud"
                    },
                    {
                      "text": "An articulate founder sounded stiff and insincere reading formal whitepaper phrasing verbatim off a prompter.",
                      "type": "case_study",
                      "title": "Robotic Teleprompter Stumble",
                      "takeaway": "Swapping in conversational clauses and cutting clauses in half restored effortless warmth instantly."
                    },
                    {
                      "text": "Picture explaining the idea across a coffee table to one smart friend—never lecture an empty stadium.",
                      "type": "callout",
                      "title": "Type Like Talking to One Friend",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why do essay transitions like \"moreover\" and long nested clauses fail inside spoken scripts?",
                      "options": [
                        "Microphones drop quiet syllables",
                        "Listeners cannot visually re-read long complex syntax and formal words sound unnatural spoken aloud",
                        "Scripts restrict length strictly"
                      ],
                      "explanation": "Simple direct speech lets audio listeners grasp meaning effortlessly in real time.",
                      "correctIndex": 1
