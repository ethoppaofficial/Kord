            {
              "id": "8c1ab3a5-e384-4aab-dfdb-b623cdf75c22",
              "title": "Module 6: Business Case Polish & Presentation",
              "lessons": [
                {
                  "id": "4e92fecb-b6d2-e990-09af-ee2707b007b9",
                  "title": "Pre-Answering Skeptical Executive Objections",
                  "blocks": [
                    {
                      "text": "Red-Teaming Your Own Business Brief",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Before submitting any major business memo, switch hats and ask the hardest three questions a finance director, operations lead, or skeptical customer might raise. Addressing one key objection calmly inside your Risks & Mitigations block builds extraordinary authority.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Red-Teaming",
                      "text": "Stress-testing your own proposal deliberately from a critical reviewer’s perspective to surface blind spots before submission.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Risk: QA lacks capacity this month. Mitigation: Shift regression smoke tests to automated runner already licensed, holding manual QA below 3 hours/week.\"",
                      "type": "example",
                      "title": "Addressing Staffing Skepticism"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "List top 3 potential objections around cost, timeline, and team load.",
                        "Ensure your body text or short Risk block answers every one transparently.",
                        "Remove weak defensive adjectives in favor of factual verification."
                      ],
                      "title": "Applying Pre-Answering Skeptical Executive Objections"
                    },
                    {
