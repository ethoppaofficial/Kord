                {
                  "id": "eca19caa-d6db-c937-2eb0-dd4cc08d03ad",
                  "title": "Emotion Labeling & Tactical Empathy",
                  "blocks": [
                    {
                      "text": "Naming Unspoken Tension Gently",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Neuroscience confirms naming a strong emotion reduces amygdala distress almost immediately. When a teammate looks tense, saying calmly \"It sounds frustrating carrying three rush fixes without clear priority\" lowers defensive adrenaline so clear problem-solving can begin—without agreeing to unreasonable demands.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Emotion Labeling",
                      "text": "Tentatively identifying the speaker's apparent emotional state (\"It seems exhausting...\", \"Feels risky...\") to validate humanity and restore calm.",
                      "type": "definition"
                    },
                    {
                      "body": "\"It sounds frustrating explaining the onboarding bug twice after expecting Monday launch.\" -> Client exhales and shares helpful logs.",
                      "type": "example",
                      "title": "Defusing an Upset Client"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Listen for tone, pace, and loaded adjectives.",
                        "Name emotion gently using tentative framing (\"It sounds...\", \"Seems like...\").",
                        "Pause cleanly afterward—let them confirm or adjust freely."
                      ],
                      "title": "Applying Emotion Labeling & Tactical Empathy"
                    },
                    {
                      "text": "Instead of debating deadlines immediately, a lead noted \"It looks exhausting absorbing unplanned requests all sprint.\" The engineer opened up and fixed root intake.",
                      "type": "case_study",
                      "title": "De-Escalating Sprint Burnout",
                      "takeaway": "Validating pressure releases hidden candor safely."
                    },
                    {
                      "text": "Say \"It sounds overwhelming carrying...\" rather than making it about your feelings.",
                      "type": "callout",
                      "title": "Avoid \"I Know How You Feel\"",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why pause silently right after tentatively naming a speaker's frustration?",
                      "options": [
