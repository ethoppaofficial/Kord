                },
                {
                  "id": "a0620b5b-53c1-a616-9266-964ebb8f84e8",
                  "title": "Sentence Rhythm & Punctuation Control",
                  "blocks": [
                    {
                      "text": "Varying Sentence Length & Clause Joins",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Effective prose alternates crisp short sentences with well-structured medium sentences joined cleanly by commas, semicolons, or subordinating conjunctions. Understanding independent versus dependent clauses prevents run-on comma splices and sentence fragments that jar the reader.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Comma Splice",
                      "text": "Joining two complete independent sentences with only a comma instead of a period, semicolon, or coordinating conjunction.",
                      "type": "definition"
                    },
                    {
                      "body": "Incorrect: \"The draft looked finished, the citations failed.\" Correct: \"The draft looked finished, yet the citations failed.\"",
                      "type": "example",
                      "title": "Fixing a Comma Splice Three Ways"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Read drafts aloud and mark any sentence requiring two breaths.",
                        "Break dense multi-clause claims into two focused sentences.",
                        "Follow a complex explanation with one short anchor sentence."
                      ],
                      "title": "Applying Sentence Rhythm & Punctuation Control"
                    },
                    {
                      "text": "An onboarding FAQ strung 45-word conditional rules into single sentences with four commas.",
                      "type": "case_study",
                      "title": "Stiff FAQ Page",
                      "takeaway": "Splitting conditions into short rhythmic steps lifted task completion noticeably."
                    },
                    {
                      "text": "If you run out of breath reading your sentence aloud, split it cleanly or tighten the middle clause.",
                      "type": "callout",
                      "title": "The One-Breath Test",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Which punctuation choice properly joins two closely related independent clauses?",
                      "options": [
                        "A lone comma without a conjunction",
                        "A semicolon or comma paired with a coordinating conjunction",
                        "A colon placed mid-verb"
                      ],
                      "explanation": "Two full clauses require a semicolon, a period, or a comma plus a conjunction like \"and\" or \"but\".",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Deliberate sentence variety creates natural cadence and effortless comprehension.",
                  "position": 2,
