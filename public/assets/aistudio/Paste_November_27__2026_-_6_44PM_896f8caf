                  "blocks": [
                    {
                      "text": "Least-Privilege Access & Data Minimization",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Steward customer trust honorably: practice **Data Minimization** (never hoard sensitive SSNs, personal family rumors, or unnecessary payment details inside casual CRM comment boxes!), set **Least-Privilege Roles** (interns or limited contractors access strictly assigned scopes—never unbridled \"Export All 20,000 Customer Emails\" buttons!), honor **Marketing Opt-Outs instantaneously**, and fulfill data-deletion requests cleanly.",
                      "type": "paragraph"
                    },
                    {
                      "term": "CRM Note Hygiene",
                      "text": "Keeping subjective, embarrassing, or private personal gossip strictly out of shared CRM notes (`\"Remember under privacy laws, clients may legally request viewing stored notes!\"`), recording solely objective factual business context.",
                      "type": "definition"
                    },
                    {
                      "body": "Bad casual note: \"Client seemed super grumpy/scattered post-divorce.\" Good objective note: \"Prefers brief concise bullet summaries; prioritizing quick turnaround before November audit.\"",
                      "type": "example",
                      "title": "Clean Objective Notes Rule"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Never store passwords, bank credentials, or credit numbers inside plain CRM text notes—ever!",
                        "Restrict CSV bulk-export permissions strictly to vetted senior operations roles with audit logs.",
                        "Audit inactive departed employee CRM seats and revoke access immediately on departure day!"
                      ],
                      "title": "Applying CRM Data Privacy, Consent & Security Ethics"
                    },
                    {
                      "text": "An exiting account manager downloaded complete unprotected client email lists days before joining a rival because zero export-role permissions existed.",
                      "type": "case_study",
                      "title": "Departed Rep CSV Theft",
                      "takeaway": "Least-privilege export locks plus offboarding checklist safeguards protect core customer trust silently!"
                    },
