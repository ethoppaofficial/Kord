              "lessons": [
                {
                  "id": "34a889f3-5def-faa8-c7ee-4f5e7d363877",
                  "title": "Clean Invoicing & Polite Overdue Collections",
                  "blocks": [
                    {
                      "text": "Frictionless Invoices & Calm Follow-Up Cadence",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Include sequential invoice numbers, legal name/address, clear line items, total due, explicit due date (\"Net 14\"), and exact bank/payment link. When an invoice passes due: Day +1 friendly reminder assuming simple oversight; Day +7 direct follow-up asking for exact scheduled payout date; Day +14 formal pause on ongoing active work until cleared.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Net 14 Terms",
                      "text": "Standard invoice payment expectation specifying full settlement within 14 calendar days of invoice issue.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Hi Sam, attaching Invoice #1042 (£900) due yesterday in case accounting missed it—payment details are at the bottom. Thanks!\"",
                      "type": "example",
                      "title": "Day +1 Frictionless Nudge"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Send invoices immediately upon milestone completion—never wait until month-end.",
                        "Confirm client’s finance contact email during kickoff.",
                        "Avoid angry accusations early; stay warm, brief, and crystal clear."
                      ],
                      "title": "Applying Clean Invoicing & Polite Overdue Collections"
                    },
                    {
                      "text": "Adding a direct payment link and confirming the billing email at project kickoff reduced average payment wait from 29 days to 6 days.",
                      "type": "case_study",
                      "title": "Cut Payout Delays in Half",
                      "takeaway": "Remove administrative friction for clients’ finance teams."
                    },
                    {
                      "text": "Never keep shipping new unpaid milestones when earlier approved invoices remain weeks overdue.",
                      "type": "callout",
                      "title": "Pause Work On Severe Non-Payment",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What administrative detail collected at project kickoff drastically prevents invoice delays later?",
                      "options": [
                        "Favorite team snacks",
                        "Confirming exact accounts-payable email, PO requirement, and payment schedule upfront",
                        "Social media handles"
                      ],
                      "explanation": "Knowing the client’s exact billing workflow keeps payouts smooth.",
                      "correctIndex": 1
