              "lessons": [
                {
                  "id": "a815ed10-3e4a-26d3-fe54-79c1fec0ed1f",
                  "title": "Four Distinct Tiers of Editing",
                  "blocks": [
                    {
                      "text": "Developmental -> Line -> Copy -> Proof",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Professional publishing separates four focused lenses in descending zoom: **Developmental Editing** audits macro argument, audience fit, missing logic, and structure; **Line Editing** tunes flow, voice, transitions, and paragraph pacing; **Copyediting** enforces grammar, consistent capitalization/style sheets, and factual math/dates; **Proofreading** inspects final formatted layout/typesetting strictly for remaining surface typos and broken visual spacing.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Editorial Scope Creep",
                      "text": "Getting sucked into fixing minor comma punctuation during an early macro review instead of tackling overarching structural gaps first.",
                      "type": "definition"
                    },
                    {
                      "body": "Pass 1 (Dev): Cut redundant Section 3, move example into Section 1. Pass 2 (Line): Smooth jarring jump into Section 2. Pass 3 (Copy): Standardize `Q4` vs. `4th quarter` across document. Pass 4 (Proof): Inspect final PDF layout margins and typos.",
                      "type": "example",
                      "title": "Proper Pass Sequencing"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Agree clearly with clients or teammates WHICH pass level they requested before marking drafts.",
                        "Complete macro cuts completely before touching sentence punctuation.",
                        "Never do major rewriting during final layout Proofreading passes—keep layout stable cleanly!"
                      ],
                      "title": "Applying Four Distinct Tiers of Editing"
                    },
                    {
                      "text": "A junior editor submitted 94 tidy grammar tweaks on a whitepaper whose thesis literally contradicted its conclusion.",
                      "type": "case_study",
                      "title": "Buried Structural Flaw",
                      "takeaway": "Stepping back first for a 10-minute macro read spots contradictions immediately."
                    },
                    {
                      "text": "Literally use distinct focus passes—even skilled senior editors miss typos when trying to fix big-picture logic simultaneously.",
                      "type": "callout",
                      "title": "Separate Glasses Per Pass",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What distinguishes Copyediting cleanly from Line Editing?",
                      "options": [
                        "Copyediting trims long metaphors exclusively",
                        "Line Editing polishes sentence rhythm, tone, and clarity; Copyediting enforces mechanics, grammar, fact accuracy, and uniform house style rules",
                        "Both mean proofreading PDFs"
                      ],
                      "explanation": "Clear pass boundaries prevent wasted effort and keep standards objective cleanly.",
                      "correctIndex": 1
                    }
