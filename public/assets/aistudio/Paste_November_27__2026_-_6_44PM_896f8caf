                  "title": "Web Introductions That Stop Bounce",
                  "blocks": [
                    {
                      "text": "Agree-Promise-Preview (APP) Openings",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Keep blog intros fast—under 100 words. The APP technique opens by naming a shared frustration readers immediately nod along with (Agree), states clearly the surprising solution or method ahead (Promise), and outlines exactly what the article covers right below (Preview).",
                      "type": "paragraph"
                    },
                    {
                      "term": "APP Intro Formula",
                      "text": "Three-beat fast blog opener: Agree with reader frustration, Promise tangible outcome, and Preview specific proof/steps immediately ahead.",
                      "type": "definition"
                    },
                    {
                      "body": "Nobody enjoys chasing overdue client invoices three times (Agree). After automating two calm pre-due reminders, our studio cut late payouts from 34% to under 4% (Promise). Below are the exact calendar triggers and email wording we use (Preview).",
                      "type": "example",
                      "title": "Tight 75-Word APP Intro"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Cut opening broad definitions completely.",
                        "Validate reader frustration within sentence one or two.",
                        "Keep intro length lean—deliver section one above or near the first scroll."
                      ],
                      "title": "Applying Web Introductions That Stop Bounce"
                    },
                    {
                      "text": "A marketing blog opened a practical pricing guide with three paragraphs defining ancient bartering systems; bounce rate hit 82%.",
                      "type": "case_study",
                      "title": "Slow History Lesson Opener",
                      "takeaway": "Swapping in an immediate \"Why clients hesitate at Tier 2 pricing\" APP hook cut bounces in half."
                    },
                    {
                      "text": "Readers clicked your headline because they already care about the topic—jump straight into solving it.",
                      "type": "callout",
                      "title": "Start Inside Present Stakes",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What should a crisp blog introduction avoid doing in paragraphs 1–2?",
                      "options": [
                        "Validating reader pain quickly",
                        "Reciting broad historical definitions of an obvious concept everyone already knows",
                        "Previewing steps coming next"
                      ],
                      "explanation": "Wasting valuable opening lines on obvious definitions stalls impatient web visitors fast.",
                      "correctIndex": 1
                    }
