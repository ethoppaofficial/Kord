                {
                  "id": "48d6d7bf-f99d-85d9-853c-5fa776dcc6c2",
                  "title": "Involving Design & Engineering Early Inside Triads",
                  "blocks": [
                    {
                      "text": "Co-Creation Inside Product Triads",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Top product teams work collaboratively as equal **Product Triads (`Product Manager + Product Designer + Tech Lead`)** right from early Discovery: bringing engineers into occasional live customer calls (`they feel pain deeply firsthand!`) and inviting early feasibility ideation BEFORE finalizing designs—catching 4-week technical dead ends in five minutes (`\"Actually switching two filters achieves that in 3 hours safely instead of 3 weeks!\"`).",
                      "type": "paragraph"
                    },
                    {
                      "term": "Product Triad Collaboration",
                      "text": "Continuous early partnership uniting Product (`viability/value`), Design (`usability`), and Engineering (`feasibility/craft`) directly through discovery and framing rather than sequential handoff silos.",
                      "type": "definition"
                    },
                    {
                      "body": "Designer sketched complex live cross-workspace dragging; Tech Lead spotted in 2 minutes that adding a quick `\"Move to Workspace\"` modal delivered 100% user goal smoothly in 1/8th the effort!",
                      "type": "example",
                      "title": "Early Engineering Simplification"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Invite rotating engineers straight onto live customer observation sessions monthly.",
                        "Present problems and draft sketches early (`\"Rough v0 brainstorming—help break this!\"`) ahead of polishing pixel-perfect Figma deliverables.",
                        "Respect engineering craft estimates sincerely—never bargain arbitrary dates angrily without adjusting scope!"
                      ],
                      "title": "Applying Involving Design & Engineering Early Inside Triads"
                    },
                    {
                      "text": "Spend three silent weeks perfecting intricate custom animation designs, only for Tech Lead kickoff to flag a core third-party browser limitation making it impossible cleanly.",
                      "type": "case_study",
                      "title": "Over-The-Wall Waterfall Rework",
                      "takeaway": "Ten-minute early Triad check-ins save whole wasted design weeks instantaneously cleanly!"
                    },
                    {
                      "text": "When engineers flag steep effort (`\"4 weeks\"`), explore collaboratively (`\"What gives 80% of this relief inside 4 days?\"`)—never demand reckless shortcuts!",
                      "type": "callout",
                      "title": "Co-Own Trade-Offs Respectfully",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why include Tech Leads and Designers together straight inside early product Discovery rather than handing finished specs strictly down sequentially?",
                      "options": [
                        "Meetings run slower",
                        "Engineers spot dramatic simpler technical shortcuts early while firsthand user pain builds deeply shared ownership across all roles",
                        "Replaces unit tests"
