          "phases": [
            {
              "id": "f5315b8e-656e-1cde-eb91-fea055de051f",
              "title": "Module 1: Preparation, BATNA & Interests",
              "lessons": [
                {
                  "id": "810c2960-8e06-2f66-78f7-8a7a4e4832e0",
                  "title": "Interests vs. Fixed Positions",
                  "blocks": [
                    {
                      "text": "Looking Behind Opening Demands",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "A position is what someone demands (\"30% discount now\"). An interest is why they need it (quarterly cash-flow timing, lower launch risk, or predictable unit margins). When you probe interests gently, you discover non-price trades—like milestone billing, longer lock-in, or tighter scope—that satisfy both sides simultaneously.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Interest-Based Negotiation",
                      "text": "Focusing on underlying commercial, timeline, or risk needs rather than colliding endlessly over rigid surface numbers.",
                      "type": "definition"
                    },
                    {
                      "body": "Buyer demands 20% fee cut. Probe reveals cash-flow cap this quarter—offer two milestone split invoices + extended term at full fee.",
                      "type": "example",
                      "title": "Solving a Budget Impasse"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "List your core priorities in rank order.",
                        "Ask open \"What makes X important right now?\" questions.",
                        "Translate rigid numbers into underlying risks or timing constraints."
                      ],
                      "title": "Applying Interests vs. Fixed Positions"
                    },
                    {
                      "text": "A vendor and startup deadlocked for weeks on annual license price until discovering implementation speed mattered more than headline cost.",
                      "type": "case_study",
                      "title": "Software Contract Breakthrough",
                      "takeaway": "Adding priority onboarding at full list rate closed the contract inside 48 hours."
                    },
                    {
                      "text": "Gentle curiosity turns combative demands into collaborative puzzles.",
                      "type": "callout",
                      "title": "Ask \"What Problem Does That Solve?\"",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What separates an interest from a bargaining position?",
                      "options": [
                        "Interests are always smaller numbers",
                        "Positions are stated demands; interests are the underlying needs motivating those demands",
                        "Interests never change across industries"
                      ],
                      "explanation": "Understanding underlying needs unlocks creative non-zero-sum trades.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Uncovering real interests replaces deadlocks with flexible trade options.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "692aa469-1bc4-4cda-8e8e-c8e56fe807aa",
                      "url": "https://hbr.org/",
