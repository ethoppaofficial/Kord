            {
              "id": "2a261675-7f3d-7d6b-a874-692500b11561",
              "title": "Module 5: Ethical Storytelling & Voice Honesty",
              "lessons": [
                {
                  "id": "6268f436-d723-f868-5bba-6b2702e0189e",
                  "title": "Honest Framing & Consent Boundaries",
                  "blocks": [
                    {
                      "text": "Truthfulness & Dignified Attribution",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Ethical storytellers never fabricate composite quotes while calling them single people, never share identifiable client struggles without informed written consent, and never steal team wins as solo heroics. Framing real individuals with full agency preserves trust and human dignity.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Dignified Agency Framing",
                      "text": "Portraying subjects—especially customers or beneficiaries—as active, capable thinkers making smart choices rather than helpless victims saved by your brand.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Thanks to our support squad’s diagnostic script and Maya’s midnight database patch, service restored smoothly before 6 AM.\"",
                      "type": "example",
                      "title": "Respectful Attribution"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Confirm written permission—and verify real quotes—before publishing named stories.",
                        "Use transparent anonymized disclaimers if details are changed for privacy.",
                        "Credit teammates, guides, and partners honestly."
                      ],
                      "title": "Applying Honest Framing & Consent Boundaries"
                    },
                    {
                      "text": "A public ad claimed a small café doubled profit overnight when it actually grew 18% over six months; loyal readers flagged the mismatch publicly.",
                      "type": "case_study",
                      "title": "Backfired Exaggerated Case Study",
                      "takeaway": "Authentic 18% turnaround numbers resonate deeply because real people recognize genuine effort."
                    },
                    {
                      "text": "Real modest human breakthroughs feel ten times more believable than glossy inflated fairytales.",
                      "type": "callout",
                      "title": "True Doesn’t Mean Boring",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Which habit upholds strong ethical integrity in customer storytelling?",
                      "options": [
                        "Inventing emotional dialogue quotes to improve flow",
                        "Obtaining informed consent and sharing verified honest outcomes",
                        "Minimizing subjects’ own contributions"
                      ],
                      "explanation": "Consent and factual integrity protect human dignity and brand credibility equally.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Honesty and generosity of credit transform storytellers into trusted voices.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "a7258e74-4424-46fb-b56a-175e401da986",
                      "url": "https://owl.purdue.edu/",
                      "title": "Purdue OWL Creative & Rhetorical Guides",
                      "position": 1,
                      "resource_type": "guide"
                    },
                    {
                      "id": "91d2cd75-b604-43c6-95df-b034b2774405",
                      "url": "https://www.nngroup.com/",
                      "title": "Nielsen Norman Group UX & Copy Clarity",
                      "position": 2,
                      "resource_type": "research"
                    }
                  ],
                  "takeaways": [
                    "Secure explicit permission for identifiable stories",
                    "Never invent facts or fake quotes under nonfiction labels",
                    "Share genuine credit cleanly with teams"
                  ],
                  "objectives": [
                    "Analyze truthfulness & dignified attribution",
                    "Apply honest framing & consent boundaries in original writing"
                  ],
                  "est_minutes": 28,
                  "is_required": true,
                  "introduction": "Exaggerating metrics or dressing ordinary moments as fabricated miracles destroys long-term trust once audiences check facts.",
