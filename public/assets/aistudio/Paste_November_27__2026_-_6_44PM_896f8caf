                {
                  "id": "fd4a984d-3d68-6cae-98ac-2e50757591a1",
                  "title": "The First 10 Seconds: Confirm & Hook Fast",
                  "blocks": [
                    {
                      "text": "Zero-Latency Value Confirmation",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Viewers click because of a thumbnail/title promise; the first 5–10 seconds must confirm IMMEDIATELY they are in the exact right place—and raise stakes fast. Open in-action (\"This single email tweak cut late replies by half—here’s the broken line nobody fixes\") rather than slow warm-ups or begged subscriptions.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Cold Open Hook",
                      "text": "Opening audio/video straight inside stakes, bold visual contrast, or concrete promised result within the first 5–10 seconds before branding bumpers or housekeeping.",
                      "type": "definition"
                    },
                    {
                      "body": "Cut: 12s music bumper + \"Hey folks! Happy Thursday! Hope you’re great, today we discuss...\" Keep: Show torn invoice -> \"Chasing late payments costs solo studios 6 hours monthly. Let’s automate two polite reminders in three minutes.\"",
                      "type": "example",
                      "title": "Killing Slow Intros"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Match spoken sentence #1 tightly to title/thumbnail promise.",
                        "Start visually mid-demonstration or holding tangible proof.",
                        "Push \"Like/Subscribe\" gently mid-value or near close—never beg before giving value."
                      ],
                      "title": "Applying The First 10 Seconds: Confirm & Hook Fast"
                    },
                    {
                      "text": "Analytics showed 44% of new visitors left during a 14-second animated channel intro.",
                      "type": "case_study",
                      "title": "20-Second Logo Drop-Off",
                      "takeaway": "Dropping directly into the core problem on Frame 1 lifted 30-second retention from 54% to 81%."
                    },
                    {
                      "text": "Viewers skip straight past apologies about microphone setups or messy desks—start straight with value.",
