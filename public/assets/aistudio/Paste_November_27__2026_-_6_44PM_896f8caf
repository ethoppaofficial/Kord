              "lessons": [
                {
                  "id": "f6c5bd47-87ec-87c3-9b3e-c2eaec89e479",
                  "title": "Dangling Modifiers & Faulty Parallelism",
                  "blocks": [
                    {
                      "text": "Syntactic Alignment Repairs",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "An opening participial phrase (`\"After reviewing Q3 logs...\"`) MUST be followed immediately by the actor who actually reviewed them (`\"...our team found\"`, NEVER `\"...three bugs emerged\"`). Similarly, coordinate lists (`A, B, and C`) must hold identical grammatical structures throughout every item—all verbs, all noun phrases, or all full clauses.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Dangling Modifier",
                      "text": "An introductory descriptive phrase missing the matching logical subject right after the comma (\"Walking into the office, the printer jammed\"—printers don’t walk!).",
                      "type": "definition"
                    },
                    {
                      "body": "Dangling: \"Having finalized the slides, the projector failed.\" Fixed: \"Having finalized the slides, Maya saw the projector fail.\"",
                      "type": "example",
                      "title": "Fixing Modifiers & Lists"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Check every opening comma phrase immediately against the very next noun after the comma.",
                        "Inspect every bulleted list vertically—confirm parallel grammatical openings down the entire column.",
                        "Verify pronoun antecedents (`this`, `they`, `which`) have clear single preceding noun referents."
                      ],
                      "title": "Applying Dangling Modifiers & Faulty Parallelism"
                    },
                    {
                      "text": "\"When the manager met the intern, she updated her access token\" left policy auditors unsure whose permissions actually changed.",
                      "type": "case_study",
                      "title": "Ambiguous Pronoun Liability",
                      "takeaway": "Replacing ambiguous \"she\" with proper names resolved accountability instantaneously."
                    },
                    {
                      "text": "Run eyes straight down the first word of every bullet in a list; mismatched parts of speech leap out right away.",
                      "type": "callout",
                      "title": "Scan Vertical First Words",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Which sentence repairs the dangling modifier properly?",
                      "options": [
                        "Checking the analytics export, two broken filters appeared.",
                        "Checking the analytics export, Priya spotted two broken filters.",
                        "Two broken filters were checking the analytics export."
                      ],
                      "explanation": "Placing \"Priya\" immediately after the introductory participial phrase clarifies who checked the export cleanly.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Crisp syntactic alignment frees readers completely from double-taking confusing relationships.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "bbaa847c-abc6-435c-a613-e21e8a191c41",
