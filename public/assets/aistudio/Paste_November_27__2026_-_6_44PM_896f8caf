            {
              "id": "e062b7bd-b3c5-5775-c1e4-228d712dcb2f",
              "title": "Module 4: Meeting Professionalism & Video Presence",
              "lessons": [
                {
                  "id": "6b4a1b80-0a38-b27e-d9f6-1a2ac84f6262",
                  "title": "High-Value Meeting Participation",
                  "blocks": [
                    {
                      "text": "Entering Conversations Gracefully",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Prepare one question or observation from the pre-read before joining. Build onto others' ideas (\"Building on Maya's point, if we limit scope...\") and invite quieter peers in (\"Priya, you tested this flow last month—what did you notice?\"). Great contributors elevate the room's collective thinking rather than scoring solo points.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Bridge-Building Interjection",
                      "text": "Connecting your comment directly to what the previous speaker raised before introducing your new angle.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Building on Sam's timeline concern, could we run pilot QA in parallel on staging Monday?\"",
                      "type": "example",
                      "title": "Constructive Building"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Read agenda links 15 minutes beforehand.",
                        "Note 1 question or perspective to share early.",
                        "Never multitask visibly while colleagues present."
                      ],
                      "title": "Applying High-Value Meeting Participation"
                    },
                    {
                      "text": "A deeply skilled QA engineer rarely spoke in sprint reviews until preparing 1 concise risk highlight beforehand; product managers quickly relied on her voice.",
                      "type": "case_study",
                      "title": "The Quiet Expert Shift",
                      "takeaway": "Prepared short contributions reshape peer perception quickly."
                    },
                    {
                      "text": "Mentioning a colleague by name when echoing or adding to their idea strengthens rapport instantly.",
                      "type": "callout",
                      "title": "Use Names Warmly",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "How should you introduce your view smoothly when discussion moves quickly?",
                      "options": [
                        "Cut off the speaker loudly mid-word",
                        "Wait for a breath beat, link briefly to their point, and share one concise idea",
                        "Drop unrelated links silently in chat"
                      ],
                      "explanation": "Bridging smoothly shows listening discipline and respect.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Thoughtful participation raises team outcomes and visible leadership.",
                  "position": 1,
                  "resources": [
