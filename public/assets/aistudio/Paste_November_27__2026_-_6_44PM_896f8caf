                {
                  "id": "c79eb13c-9db9-dda4-36d2-3688c0bdee86",
                  "title": "Scope Clarity & Explicit Exclusions",
                  "blocks": [
                    {
                      "text": "Defining Exactly What Is Included—and Excluded",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Specify deliverables numerically (\"3 responsive landing sections, 2 rounds of consolidated revisions, final source handoff\") alongside explicit **Out-of-Scope** items (\"Stock photo licensing, extra pages, and ongoing monthly maintenance quoted separately\"). Tie delivery dates to client review SLAs (\"Timeline assumes feedback within 3 business days\") so client delays never shrink your work window silently.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Statement of Work (SOW)",
                      "text": "A clear written agreement defining project deliverables, milestones, revision limits, client responsibilities, and pricing terms before work begins.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Includes 2 consolidated revision rounds; additional feedback rounds billed at £55/hr after written sign-off.\"",
                      "type": "example",
                      "title": "Clear Revision Cap"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "State measurable deliverables instead of vague open-ended \"unlimited support\".",
                        "Tie timeline milestones to timely client assets and sign-offs.",
                        "Put agreed terms in writing before opening Figma or code editors."
                      ],
                      "title": "Applying Scope Clarity & Explicit Exclusions"
                    },
                    {
                      "text": "Pointing kindly to \"Out of scope: blog migration\" in the signed 1-page SOW turned an extra client request into a smooth £450 add-on invoice cleanly.",
                      "type": "case_study",
                      "title": "Saved 14 Unpaid Hours",
                      "takeaway": "Clarity protects friendships and margins alike."
                    },
                    {
                      "text": "Specify two consolidated feedback rounds so clients gather internal team notes once rather than dribbling 18 separate edits.",
