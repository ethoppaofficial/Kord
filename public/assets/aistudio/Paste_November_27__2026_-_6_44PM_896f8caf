                  "id": "6f95d296-3699-d0bd-5acd-c4bdbe328bf2",
                  "title": "The Power of Productive Silence",
                  "blocks": [
                    {
                      "text": "Holding Space Without Interrupting",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "After you ask a weighty question or reflect meaning accurately, speakers often go quiet for 3–5 seconds while weighing whether to share the honest truth. Filling that gap steals their thinking time. Staying comfortably quiet with steady open attention lets people talk past polite surfaces into real breakthroughs.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Productive Silence",
                      "text": "Intentional 3–5 second quiet interval allowing the speaker to formulate deeper honest reflection instead of rushed small talk.",
                      "type": "definition"
                    },
                    {
                      "body": "Ask: \"What would make this role feel unsustainable six months from now?\" -> Hold calm quiet gaze until they move past \"Nothing!\" to real constraint.",
                      "type": "example",
                      "title": "Waiting Through Coaching Silence"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Count silently to four when a speaker pauses thoughtfully.",
                        "Maintain gentle relaxed presence without fidgeting.",
                        "Notice how the second unprompted sentence holds the deepest insight."
                      ],
                      "title": "Applying The Power of Productive Silence"
                    },
                    {
                      "text": "Holding quiet space after a manager asked \"What nearly made you leave last year?\" uncovered solvable career clarity nobody had ever raised.",
                      "type": "case_study",
                      "title": "Exit vs. Stay Interview Gold",
                      "takeaway": "Patience unlocks unspoken truth effortlessly."
                    },
                    {
                      "text": "Calm posture communicates comfort rather than awkward waiting pressure.",
                      "type": "callout",
                      "title": "Relax Your Shoulders in Silence",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why is rushing to fill a 4-second pause after asking a deep question counterproductive?",
