                  "title": "Codifying Distinct Editorial Voice",
                  "blocks": [
                    {
                      "text": "Lightweight Brand Voice Principles",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Capture three actionable Voice Pillars (`Warm, Never Sloppy`, `Direct, Never Cold`, `Evidence-First, Never Hype`) backed by concrete Do/Don’t phrasing pairs (`We say: \"Run this quick check\" / We never say: \"Synergize paradigm shifts\"`). Clean boundaries keep multiple contributors sounding unmistakably cohesive.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Voice Attribute Pair",
                      "text": "Defining editorial style through crisp positive traits balanced immediately against explicit \"Not This\" guardrails (`Playful, not goofy`; `Authoritative, not aloof`).",
                      "type": "definition"
                    },
                    {
                      "body": "Attribute: Practical Mentor — Do use relatable client snags and plain math; Don’t boast guru infallibility or overuse slang exclamation points.",
                      "type": "example",
                      "title": "Crisp Voice Rule"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Pick max 3–4 distinctive adjectives paired with concrete boundary warnings.",
                        "Collect 5 real sentences exemplifying peak brand tone into a shared team style snippet.",
                        "Read final drafts purely checking voice consistency before hitting Publish."
                      ],
                      "title": "Applying Codifying Distinct Editorial Voice"
                    },
                    {
                      "text": "One guest writer sounded like an academic dissertation while Friday’s staff writer opened with emojis and slang, confusing subscribers.",
                      "type": "case_study",
                      "title": "Multi-Author Whiplash",
                      "takeaway": "A 1-page Do/Don’t style card aligned guest pitches cleanly in minutes."
                    },
                    {
                      "text": "Distinct voice grows out of honest viewpoint and crisp concrete details—never forced catchphrases.",
                      "type": "callout",
                      "title": "Voice Lives in Verbs and Examples",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why pair every brand voice adjective with a clear `\"Not This\"` contrast (`Warm, not goofy`)?",
