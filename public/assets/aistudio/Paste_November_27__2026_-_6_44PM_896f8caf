                  "blocks": [
                    {
                      "text": "Systematic End-to-End Verification",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Audit five pillars before shipping: 1) Auth & Admin Provisioning (no hardcoded admin emails, no default shared passwords, strict `service_role` checks), 2) Authorization & RLS (revoked anon/public access, column grants, active-account checks), 3) Data & Uploads (parameterized queries, signed private buckets), 4) Secrets & Bundles (zero server secrets in `src/`/`dist/`), 5) Dependencies & Logs (`npm audit`, immutable audit history).",
                      "type": "paragraph"
                    },
                    {
                      "term": "Defense in Depth",
                      "text": "Layering independent protections (UI validation + API/RPC guards + RLS + DB triggers/constraints) so a bypass at one layer still fails cleanly at the next.",
                      "type": "definition"
                    },
                    {
                      "body": "Protecting `profiles.role` with column grants + RLS `with check` + `BEFORE UPDATE` trigger means no single misconfiguration grants admin access.",
                      "type": "example",
                      "title": "Multi-Layer Role Lock"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Grep codebase for accidental credentials or unsafe sinks.",
                        "Verify all `SECURITY DEFINER` RPCs pin `set search_path = public`.",
                        "Run real Postgres tests proving unauthorized roles are rejected cleanly."
                      ],
                      "title": "Applying Pre-Launch Security Audit Checklist"
                    },
                    {
                      "text": "Auditing all database triggers uncovered an old email-based auto-promotion rule—replacing it forward-only with `service_role`-only provisioning closed the gap permanently.",
                      "type": "case_study",
                      "title": "Caught Legacy Admin Trigger",
                      "takeaway": "Audit assumptions early, not after launch."
                    },
                    {
                      "text": "When an app query fails (like PGRST201 or 403), fix the query or role workflow—never disable RLS or widen grants as a shortcut!",
                      "type": "callout",
                      "title": "Never Weaken Security to Fix Bugs",
                      "variant": "tip"
                    },
