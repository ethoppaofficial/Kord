                  "id": "dad301b7-1c41-923f-dece-6c56b90e2380",
                  "title": "Landmarks, Headings & Meaningful Markup",
                  "blocks": [
                    {
                      "text": "Semantic Tags Over Generic Containers",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Use <header>, <nav>, <main>, <article>, and <footer> to define page regions so assistive technologies jump straight to content. Keep a single <h1> per view followed by ordered <h2>/<h3> sections without skipping levels for font size.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Document Landmark",
                      "text": "An HTML5 region element (<main>, <nav>, <aside>) programmatically identifying major structural sections for keyboard and screen-reader navigation.",
                      "type": "definition"
                    },
                    {
                      "body": "Always use <button type=\"button\"> for actions rather than clickable <div> tags—native buttons inherit keyboard focus, Enter/Space activation, and disabled semantics automatically.",
                      "type": "example",
                      "title": "Button vs Div"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Sketch content outline using h1–h3 headings first.",
                        "Wrap primary page content inside one <main> landmark.",
                        "Reserve <div> and <span> strictly for styling wrappers without semantic meaning."
                      ],
                      "title": "Applying Landmarks, Headings & Meaningful Markup"
                    },
                    {
                      "text": "Replacing <div class=\"submit-btn\"> with a native <button type=\"submit\"> fixed keyboard form submission for 100% of assistive users immediately.",
                      "type": "case_study",
                      "title": "Broken Keyboard Checkout",
                      "takeaway": "Native HTML gives resilience for free."
                    },
                    {
                      "text": "Scan every page top-to-bottom as a table of contents—if headings skip levels, fix the markup and style size with CSS.",
                      "type": "callout",
                      "title": "Validate Heading Tree",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why is <button> superior to <div onclick=\"...\"> for triggering actions?",
                      "options": [
                        "Buttons render faster animations",
                        "Native buttons provide built-in keyboard focus, Enter/Space activation, and assistive role semantics",
                        "Divs cannot receive CSS classes"
                      ],
                      "explanation": "Native interactive elements preserve accessibility and keyboard control automatically.",
                      "correctIndex": 1
                    }
