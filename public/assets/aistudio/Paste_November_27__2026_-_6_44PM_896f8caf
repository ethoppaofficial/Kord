                {
                  "id": "003f0a7a-d112-e756-05e4-63c397cecddc",
                  "title": "Top, Middle & Bottom-of-Funnel Content",
                  "blocks": [
                    {
                      "text": "Balancing Discovery With Decision-Stage Assets",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Top-of-Funnel (TOFU) guides attract newcomers diagnosing broad symptoms; Middle-of-Funnel (MOFU) comparison playbooks and workflow templates help evaluators weigh solutions; Bottom-of-Funnel (BOFU) honest case studies, ROI breakdowns, and pricing/FAQ walk-throughs convert ready buyers.",
                      "type": "paragraph"
                    },
                    {
                      "term": "BOFU (Bottom-of-Funnel) Content",
                      "text": "High-intent assets—such as real client results, transparent trade-off comparisons, and implementation walk-throughs—built specifically for buyers close to choosing.",
                      "type": "definition"
                    },
                    {
                      "body": "Instead of writing 10 beginner glossary pages first, build 3 BOFU case/comparison pages + 3 MOFU templates + 4 TOFU pillars so traffic actually converts.",
                      "type": "example",
                      "title": "Balancing Content Mix"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Interview customer support or sales reps for the 10 toughest pre-purchase questions.",
                        "Turn every recurring sales objection into one permanent BOFU/MOFU article.",
                        "Link smoothly from educational TOFU guides upward toward MOFU checklists and BOFU demos."
                      ],
                      "title": "Applying Top, Middle & Bottom-of-Funnel Content"
                    },
                    {
                      "text": "A B2B HR startup had 90 broad career posts bringing 40k visitors and 4 demos monthly. Writing 8 honest \"X vs Y\" comparisons and onboarding case studies tripled demo bookings on 3k monthly views.",
                      "type": "case_study",
                      "title": "Fixing Top-Heavy Blog Burnout",
                      "takeaway": "Middle/Bottom assets close deals reliably."
                    },
                    {
                      "text": "Publish high-converting case studies and decision guides early so subsequent traffic has somewhere profitable to land.",
                      "type": "callout",
                      "title": "Build Bottom-Up First",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why can heavy blogs stuffed strictly with \"What is X?\" beginner articles fail to drive revenue?",
