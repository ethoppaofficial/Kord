                {
                  "id": "f79bea89-11b7-c4ba-f4b0-0b1f21854195",
                  "title": "Question Funneling: Broad to Concrete",
                  "blocks": [
                    {
                      "text": "Broad-Middle-Specific Funneling",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Start conversations broad (\"How is sprint collaboration feeling overall?\"), follow emerging signals into concrete exploration (\"Tell me more about the QA bottleneck you mentioned\"), and close narrow to verify precision (\"Which specific ticket type triggers that extra day of review?\"). Funneling prevents prematurely narrowing onto the wrong symptom.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Funnel Questioning",
                      "text": "Sequencing inquiry from wide open context questions through targeted probing down to specific verifiable criteria.",
                      "type": "definition"
                    },
                    {
                      "body": "Broad: \"How has onboarding gone?\" -> Probe: \"Which step slowed your team?\" -> Specific: \"How long did CSV mapping take on Tuesday?\"",
                      "type": "example",
                      "title": "Customer Churn Funnel"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Open wide with 1 non-directive question.",
                        "Follow energy—ask \"Tell me more about X\" when tension or hesitation surfaces.",
                        "Confirm specific facts and examples cleanly near the close."
                      ],
                      "title": "Applying Question Funneling: Broad to Concrete"
                    },
                    {
                      "text": "Support techs assumed a customer disliked UI colors until funnel questioning surfaced a broken permission link hidden in step 3.",
                      "type": "case_study",
                      "title": "Root Bug Uncovered via Funneling",
                      "takeaway": "Funneling reveals true bottlenecks calmly."
                    },
                    {
                      "text": "Notice brief pauses or vague words like \"tricky\" or \"weird\"—those are golden invitations to probe gently.",
                      "type": "callout",
                      "title": "Follow Hesitation Cues",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "In funnel questioning, when should narrow specific verification happen?",
                      "options": [
                        "Immediately as greeting sentence one",
                        "After broad context and middle exploration surface where real friction sits",
                        "Never"
                      ],
                      "explanation": "Broad discovery ensures specific questions target the real issue.",
                      "correctIndex": 1
