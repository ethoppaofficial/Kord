                  "title": "Taming Time, Randomness & Test Isolation",
                  "blocks": [
                    {
                      "text": "Injecting Clocks, Seeds & Fresh Fixtures",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Pass clock (`nowFn`), storage, and random/ID dependencies cleanly into functions or reset state strictly in `beforeEach`. Never leak mutated shared fixtures across tests so suites pass in any execution order.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Flaky Test",
                      "text": "An unreliable test that intermittently passes or fails without code changes due to hidden race conditions, real wall-clock drift, or shared state leakage.",
                      "type": "definition"
                    },
                    {
                      "body": "Testing timed quiz expiry by passing an expired `expiresAt` timestamp (`Date.now() - 40000`) rather than sleeping 60 seconds in CI.",
                      "type": "example",
                      "title": "Deterministic Clock Injection"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Reset `localStorage`/stores inside `beforeEach` hooks.",
                        "Avoid arbitrary `setTimeout(500)` sleeps; await explicit promises/microtasks.",
                        "Inject deterministic clocks for expiry/streak logic."
                      ],
                      "title": "Applying Taming Time, Randomness & Test Isolation"
                    },
                    {
                      "text": "Replacing `new Date()` assumptions with UTC-normalized deterministic dates fixed an intermittent weekly-chart test failure.",
                      "type": "case_study",
                      "title": "Midnight UTC Flake Fixed",
                      "takeaway": "Deterministic fixtures keep CI 100% trustworthy."
                    },
                    {
                      "text": "Never normalize clicking \"Re-run failed jobs\"—fix flaky tests immediately or trust erodes across the team.",
                      "type": "callout",
                      "title": "Quarantine or Fix Flakes Fast",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why are arbitrary sleep() calls inside tests considered an anti-pattern?",
                      "options": [
                        "They fail ESLint",
                        "They slow down test suites and still race inconsistently on loaded CI runners",
                        "Node lacks timers"
                      ],
                      "explanation": "Explicit promise awaits and deterministic timestamps are both faster and reliable.",
                      "correctIndex": 1
                    }
