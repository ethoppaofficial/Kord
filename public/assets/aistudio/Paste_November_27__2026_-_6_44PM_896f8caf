                      "resourceType": "Documentation"
                    }
                  ],
                  "publication_status": "published",
                  "completion_criteria": "Study the core frameworks in \"High-Velocity Business Emails\", verify the inline knowledge check, and apply the practical checklist."
                },
                {
                  "id": "8d532f81-f469-518c-a887-4241ca2c3018",
                  "title": "Polite Follow-Ups & Alignment Escalations",
                  "blocks": [
                    {
                      "text": "Value-Driven Follow-Up Craft",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "When an important response stalls, reply in-thread with updated context rather than firing generic \"Bumping this\" pings. Briefly restate the mutual benefit or upcoming dependency date calmly, and give an easy exit if priorities shifted.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Dependency Nudge",
                      "text": "A courteous follow-up noting how an unanswered item connects to a shared upcoming milestone without lecturing.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Hi Jordan—circling back on the invoice template below so Finance stays on schedule for Friday’s batch run. Let me know if Thursday 12 PM approval remains workable.\"",
                      "type": "example",
                      "title": "High-Class Nudge"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Keep thread context intact so they do not hunt old emails.",
                        "Skip passive-aggressive phrasing completely.",
                        "Offer an easy out on low-priority sales/partner outreach (\"Should we revisit in Q1?\")."
                      ],
                      "title": "Applying Polite Follow-Ups & Alignment Escalations"
                    },
                    {
                      "text": "\"As stated previously on Oct 3...\" escalated defensive tension on a vendor deal.",
                      "type": "case_study",
                      "title": "Passive-Aggressive Delay Loop",
                      "takeaway": "Warmly linking the nudge to shared launch readiness got contracts signed same afternoon."
                    },
                    {
                      "text": "Deleting passive reminders keeps relationships smooth while achieving faster execution.",
                      "type": "callout",
                      "title": "Drop \"Per My Last Email\"",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What is the strongest way to follow up on a stalled approval?",
                      "options": [
                        "Type \"Bumping this to the top\" alone",
                        "Reply in-thread calmly linking the item to upcoming milestone dates and proposing next step",
                        "Copy their supervisor immediately on reminder one"
                      ],
                      "explanation": "Linking cleanly to shared timing reminds partners gently why reply speed matters.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Thoughtful follow-ups preserve warmth while protecting execution deadlines.",
                  "position": 2,
                  "resources": [
                    {
                      "id": "614f34a9-068b-4456-81f1-b135da5452c9",
                      "url": "https://www.plainlanguage.gov/guidelines/",
                      "title": "Plain Language Guidelines",
