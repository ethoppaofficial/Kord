                {
                  "id": "6ca76ed1-8502-2ef3-5944-ca6e85edd795",
                  "title": "Never Read Your Slides Aloud",
                  "blocks": [
                    {
                      "text": "Voice Adds Story While Slides Anchor Proof",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Let slides show sparse visual proof, numbers, or crisp frameworks while your spoken voice provides narrative context, colorful user stories, and strategic inflection. Glance smoothly at presenter notes cleanly—maintain warm eye contact with people rather than staring backward onto bright projector walls.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Complementary Sync",
                      "text": "Designing spoken remarks to expand and explain the visual anchor on screen rather than parroting identical bullet text verbatim.",
                      "type": "definition"
                    },
                    {
                      "body": "Slide displays clean \"$42k -> $19k Support Cost\" graphic. Voice shares: \"Last fall a team of three spent mornings triaging password resets—cutting that step freed half our sprint.\"",
                      "type": "example",
                      "title": "Synchronized Slide-Voice Turn"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Ensure slides carry concise visual proof, never verbatim speech scripts.",
                        "Point/reference visuals smoothly (\"As shown on that middle bar...\").",
                        "Keep camera/room gaze natural toward listeners."
                      ],
                      "title": "Applying Never Read Your Slides Aloud"
                    },
                    {
                      "text": "Shrinking 80-word bullet slides down to stark visual anchors tripled client Q&A dialogue because nobody felt lectured from a teleprompter.",
                      "type": "case_study",
                      "title": "Captivated Client Pitch",
                      "takeaway": "Complementing visuals makes presentations feel conversational and alive."
                    },
                    {
                      "text": "Whenever advancing to an insightful chart, pause two beats calmly letting listeners absorb visuals before speaking over them.",
                      "type": "callout",
                      "title": "Silence Clicks for 2 Seconds",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why pause 1–2 seconds silently right after clicking to a rich new chart slide?",
                      "options": [
                        "Shows forgotten lines",
                        "Lets audience brains scan visual layout quickly before tuning cleanly back into your voice",
                        "Saves laptop battery"
                      ],
                      "explanation": "Short visual settling pauses protect simultaneous listening attention.",
