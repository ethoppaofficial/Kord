                  "blocks": [
                    {
                      "text": "Problem-Led Proposal Architecture",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Before detailing deliverables or schedules, quantify the current pain your audience experiences—lost hours, error rates, missed revenue, or compliance exposure. When problem stakes feel concrete, your proposed investment reads as smart risk reduction rather than extra work.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Scope Exclusion Clause",
                      "text": "An explicit bullet list specifying what a proposal does NOT cover to prevent informal creep later.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Manual invoice entry currently consumes 11 team hours weekly and triggers ~6% billing corrections. Automating import templates recovers 40+ staff hours monthly within three weeks.\"",
                      "type": "example",
                      "title": "Client Discovery Proposal Opening"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Anchor opening paragraphs on measurable current friction.",
                        "Tie every proposed deliverable back to resolving one stated pain point.",
                        "Spell out clear acceptance milestones and scope exclusions plainly."
                      ],
                      "title": "Applying Framing Value Before Features"
                    },
                    {
                      "text": "An operations analyst spent two pages explaining software UI buttons without tying them to quarterly close delays.",
                      "type": "case_study",
                      "title": "Feature-Heavy Stalled Pitch",
                      "takeaway": "Rewriting the top third around closing the quarter three days faster unlocked immediate budget."
                    },
                    {
                      "text": "Listing 3 clear exclusions protects client budgets and team morale politely without sounding defensive.",
                      "type": "callout",
                      "title": "Make \"Out of Scope\" Normal",
                      "variant": "tip"
                    },
