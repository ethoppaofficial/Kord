            {
              "id": "1a64a709-e521-9d66-54f9-0943b568ff6a",
              "title": "Module 3: Standard Operating Procedures (SOPs) & Guides",
              "lessons": [
                {
                  "id": "e2e28ca0-5418-e16a-67c3-fb1ca3e83f52",
                  "title": "Writing Unambiguous Procedural Steps",
                  "blocks": [
                    {
                      "text": "Action-First SOP Structure",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Great SOPs open with Purpose, Trigger Condition, Owner, and Prerequisites before stepping into strictly numbered actions. Begin every step with an observable imperative verb (\"Open\", \"Select\", \"Export\", \"Paste\") and state how the executor verifies success before proceeding.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Verification Checkpoint",
                      "text": "An explicit step confirming an expected result (\"Confirm status banner turns green\") before moving forward.",
                      "type": "definition"
                    },
                    {
                      "body": "1. Export monthly transactions as UTF-8 CSV from Reports > Billing. 2. Confirm row count matches Dashboard total before uploading to Finance folder.",
                      "type": "example",
                      "title": "Actionable Step Pair"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "List required permissions, logins, and tools before Step 1.",
                        "Put only one logical user action per numbered step.",
                        "Bold exact screen labels and menu paths consistently."
                      ],
                      "title": "Applying Writing Unambiguous Procedural Steps"
                    },
                    {
                      "text": "Only one team coordinator knew how to reconcile quarterly invoices because existing notes said \"run normal sync then clean issues\".",
                      "type": "case_study",
                      "title": "Tribal Knowledge Bottleneck",
                      "takeaway": "Shadowing them to produce a 9-step SOP enabled full backup coverage immediately."
                    },
                    {
                      "text": "Hand the SOP to someone unfamiliar with the process; every question they ask marks an unclear line in your doc.",
                      "type": "callout",
                      "title": "Test SOPs on a Fresh Teammate",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Which formatting rule keeps multi-step SOPs easiest to execute accurately?",
                      "options": [
                        "Narrative storytelling paragraphs combining 4 steps together",
                        "One numbered action per step beginning with a concrete imperative verb",
                        "Omitting permissions until the final line"
                      ],
                      "explanation": "Single-action imperative steps minimize skipped clicks during execution.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Actionable SOPs transform personal memory into dependable team capability.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "dae1756c-71f4-439c-b69c-510ea45b7f96",
                      "url": "https://owl.purdue.edu/",
                      "title": "Purdue OWL General Writing Resources",
                      "position": 1,
                      "resource_type": "guide"
                    },
                    {
                      "id": "dc72e5aa-db99-41ce-a397-5a55091ca808",
                      "url": "https://www.plainlanguage.gov/guidelines/",
                      "title": "Plain Language Guidelines",
                      "position": 2,
                      "resource_type": "documentation"
                    }
                  ],
                  "takeaways": [
                    "State prerequisites and trigger conditions upfront",
                    "Keep one clear verb action per numbered step",
                    "Add observable verification checks between risky steps"
                  ],
                  "objectives": [
                    "Explain action-first sop structure",
                    "Apply writing unambiguous procedural steps in original drafts"
                  ],
                  "est_minutes": 28,
                  "is_required": true,
                  "introduction": "Vague instructions like \"Verify account configuration appropriately\" leave new hires guessing what to click.",
                  "further_reading": [
