                      "url": "https://owl.purdue.edu/",
                      "title": "Purdue OWL Editing & Mechanics Handbook",
                      "position": 2,
                      "resource_type": "guide"
                    }
                  ],
                  "takeaways": [
                    "Check existing site coverage prior to briefing new topics",
                    "Differentiate overlapping themes cleanly by intent OR merge into one guide",
                    "Preserve equity via permanent `301` redirects on consolidations"
                  ],
                  "objectives": [
                    "Explain intent differentiation & merge strategy",
                    "Apply preventing keyword cannibalization cleanly"
                  ],
                  "est_minutes": 28,
                  "is_required": true,
                  "introduction": "Publishing three separate posts targeting nearly identical intent forces your own URLs to fight each other in search rankings.",
                  "further_reading": [
