              "lessons": [
                {
                  "id": "c14fa12b-f843-b6c6-b475-06ed232d20a4",
                  "title": "The Content Brief Eliminates Costly Rewrites",
                  "blocks": [
                    {
                      "text": "Alignment Before Keystrokes",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "A crisp 1-page Content Brief aligns intent ahead of drafting: states Target Audience Role & Pain, Working Title + Unique Strategic Angle (what others miss!), Required H2 Outline beats, Primary CTA target, Internal Link targets, and named Subject-Matter Expert (`SME`) interview notes or proof sources. Five minutes briefing saves five hours editing.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Editorial Content Brief",
                      "text": "A compact pre-drafting specification defining target reader stage, strategic differentiator, core questions answered, mandatory internal links, and proof sources.",
                      "type": "definition"
                    },
                    {
                      "body": "Include explicit field: `\"What must this post prove/show that generic articles skip?\"` -> `\"Include exact 3-row Excel vs. Automated CSV reconciliation error log.\"`",
                      "type": "example",
                      "title": "Brief Differentiation Prompt"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Require approved Brief sign-off BEFORE writers draft full prose.",
                        "Attach SME voice notes or raw customer ticket snippets straight inside briefs so writers don’t invent thin generalities.",
                        "Keep briefs concise (`1 page`)—don’t write the entire essay inside the instructions!"
                      ],
                      "title": "Applying The Content Brief Eliminates Costly Rewrites"
                    },
                    {
                      "text": "A freelance specialist wrote a generic beginner overview when leadership wanted a technical IT buyer comparison—wasting $600 and three weeks.",
                      "type": "case_study",
                      "title": "Three-Round Rewrite Loop",
                      "takeaway": "Implementing mandatory 1-page briefs trimmed average revision cycles cleanly from 3 passes down to 1 light polish."
                    },
                    {
                      "text": "Saying \"Skip defining what invoices are—open directly at reconciliation errors\" protects experienced readers instantly.",
                      "type": "callout",
                      "title": "Always Specify What NOT to Cover",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What makes a pre-draft Content Brief dramatically slash multi-round article rewrites?",
                      "options": [
                        "Assigning strict font names",
                        "Aligning reader stage, unique proof angle, SME inputs, and target action ahead of writing",
                        "Increasing target word limits blindly"
                      ],
                      "explanation": "Shared clarity upfront lets writers hit strategic mark right on draft one.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Sharp briefs empower contributors to produce distinct authoritative pieces reliably.",
                  "position": 1,
                  "resources": [
                    {
