                {
                  "id": "a3c3b324-ada6-5ef9-fa0e-2344330c9591",
                  "title": "Context, Structure & Few-Shot Clarity in Prompts",
                  "blocks": [
                    {
                      "text": "Explicit Role, Inputs, Constraints & Output Schema",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Strong AI workflows specify: 1) Exact task + audience, 2) Relevant input context only, 3) Explicit output format (JSON keys, Markdown table columns, word cap), 4) Handling uncertainty (\"If unsupported by the provided text, say Not Found rather than guessing\"), and 5) 1–2 concrete input/output examples.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Hallucination / Confabulation",
                      "text": "When a language model generates fluent, plausible-sounding facts, citations, or numbers unsupported by real input data or truth.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Extract top 3 user complaints using ONLY the pasted transcript; attach a verbatim quote beside each point or omit it.\"",
                      "type": "example",
                      "title": "Strict Citation Guard"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Separate instructions clearly from untrusted user data blocks.",
                        "Request explicit \"Insufficient data\" escapes to discourage guessing.",
                        "Provide 1 concise example of desired tone and format."
                      ],
                      "title": "Applying Context, Structure & Few-Shot Clarity in Prompts"
                    },
                    {
                      "text": "Forcing verbatim transcript quotes exposed two invented feature requests the model had extrapolated in earlier ungrounded runs.",
                      "type": "case_study",
                      "title": "Untruthful AI Summary Caught",
                      "takeaway": "Requiring source quotes catches hallucinations immediately."
                    },
                    {
                      "text": "Strip customer emails, API keys, and confidential credentials before sending text to external AI interfaces.",
                      "type": "callout",
                      "title": "Never Paste Private PII or Keys",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why add an explicit \"If not present in the source text, respond Unknown\" instruction to extraction prompts?",
                      "options": [
                        "Makes responses longer",
                        "Reduces confident fabrication when source data lacks an answer",
                        "Fixes JSON syntax"
                      ],
                      "explanation": "Giving models explicit permission to abstain cuts fabricated answers sharply.",
                      "correctIndex": 1
                    }
                  ],
