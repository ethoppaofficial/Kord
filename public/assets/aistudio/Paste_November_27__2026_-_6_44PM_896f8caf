                {
                  "id": "6c9fd43a-e5a6-13f0-6a5d-11f1209afb8a",
                  "title": "Reciprocity, Generosity & Social Proof",
                  "blocks": [
                    {
                      "text": "Investing Goodwill & Peer Validation",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Credibility grows every time you unblock a colleague quietly, document helpful shared notes, or share credit freely. When launching a new standard, partnering with one respected early adopter team provides authentic local proof (\"Marketing tested this checklist for two weeks and trimmed proofing delays 30%\")—far stronger than abstract theory.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Local Social Proof",
                      "text": "Demonstrating real early adoption wins inside a recognizable peer group rather than citing distant unfamiliar examples.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Rather than rolling out blind, Team Bravo tested this template on 4 clients and saved 5 hours weekly—here are their exact notes.\"",
                      "type": "example",
                      "title": "Pilot Champion Showcase"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Earn everyday goodwill before big asks arrive.",
                        "Partner with 1 credible peer team for honest pilot metrics.",
                        "Let peer champions tell their real experience openly."
                      ],
                      "title": "Applying Reciprocity, Generosity & Social Proof"
                    },
                    {
                      "text": "Instead of forcing developers to adopt a testing guide, QA paired with one eager team lead; seeing real bug drops made three other squads request onboarding.",
                      "type": "case_study",
                      "title": "Peer-Led Adoption Wave",
                      "takeaway": "Local proof spreads faster than top-down mandates."
                    },
                    {
                      "text": "Sharing one glitch the pilot hit and solved makes peer testimonials genuinely believable.",
                      "type": "callout",
                      "title": "Show Honest Bumps Too",
                      "variant": "tip"
                    },
