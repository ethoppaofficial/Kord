            {
              "id": "a2af6737-91e6-c30b-023b-6ef02a1a2c1e",
              "title": "Module 4: Academic Integrity, Paraphrasing & Attribution",
              "lessons": [
                {
                  "id": "0b667313-f84a-df2c-4761-0fc6f2ef1d64",
                  "title": "True Paraphrase vs. Mosaic Patchwriting",
                  "blocks": [
                    {
                      "text": "Concept-First Re-Encoding",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Genuine paraphrasing starts by understanding the core relationship deeply, looking away from the source completely, and writing the idea cleanly from memory in your own natural structural syntax suited to your paper’s focus—followed by full parenthetical attribution.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Patchwriting",
                      "text": "Improper paraphrasing that merely replaces scattered words with synonyms while copying the source sentence’s original structure and rhythm verbatim.",
                      "type": "definition"
                    },
                    {
                      "body": "Source: \"Algorithmic curation intensifies polarization by prioritizing outrage triggers.\" Patchwrite: \"Automated filtering increases division via ranking anger signals.\" True Paraphrase: \"Platforms amplify public division because engagement models reward emotionally provocative posts (Author, Year).\"",
                      "type": "example",
                      "title": "Patchwriting vs. True Paraphrase"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Read a paragraph completely, pause, and close or minimize the source window.",
                        "Explain what the author proved aloud in plain sentences fitting your section.",
                        "Compare back strictly to guarantee zero copied distinctive phrases remain and add exact citation."
                      ],
                      "title": "Applying True Paraphrase vs. Mosaic Patchwriting"
                    },
                    {
                      "text": "An honest student copied half a sentence structure while swapping nouns and got flagged by similarity checkers.",
                      "type": "case_study",
                      "title": "Accidental Citation Trap",
                      "takeaway": "Switching to look-away re-encoding dropped unquoted structural overlap to zero permanently."
                    },
                    {
                      "text": "Paraphrasing cleanly removes quotation marks—NEVER the citation itself; always credit the original thinker.",
                      "type": "callout",
                      "title": "Even Ideas Require Attribution",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What makes \"synonym-swapping\" inside a copied sentence structure still unacceptable academically?",
                      "options": [
                        "It lacks commas",
                        "Borrowing underlying phrasing syntax unchanged counts as patchwriting even with swapped words",
                        "Synonyms violate APA"
                      ],
                      "explanation": "Genuine paraphrasing re-expresses understood concepts cleanly in fresh original syntax plus attribution.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Understanding first and writing from clean distance safeguards originality automatically.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "45c65449-d594-4b75-948d-70b54ae456d6",
                      "url": "https://developers.google.com/tech-writing",
                      "title": "Google Technical Writing Courses",
