            {
              "id": "b9fa1823-0666-6c6b-f3e8-b5a716a8ce1d",
              "title": "Module 5: Salary, Contract & Stakeholder Negotiations",
              "lessons": [
                {
                  "id": "3e3736b3-5321-5db3-a7f0-8858dfb6b25b",
                  "title": "Negotiating Total Job Compensation",
                  "blocks": [
                    {
                      "text": "Warm Enthusiasm + Total Package Math",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Respectful job negotiation never threatens; it opens with clear excitement for the mission and team, anchors on documented value + market benchmarks, and looks beyond base pay alone: signing bonuses, hybrid flexibility, learning budgets, title clarity, and 6-month performance review bands.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Total Compensation Package",
                      "text": "The combined value of base salary, bonus, benefits, flexibility, development budget, and early review cycles.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Thrilled by the frontend team offer! Given my shipped accessibility portfolio and market median, could we explore £49k base—or £46k plus a 6-month milestone review?\"",
                      "type": "example",
                      "title": "Gracious Counter Script"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Express genuine enthusiasm before raising compensation.",
                        "Ask for the full written offer breakdown before countering.",
                        "Negotiate 2–3 levers respectfully in one consolidated message rather than drip-feeding asks."
                      ],
                      "title": "Applying Negotiating Total Job Compensation"
                    },
                    {
                      "text": "A candidate consolidated base band (+£3k) and a £1k equipment budget into one warm call—receiving full approval within 24 hours.",
                      "type": "case_study",
                      "title": "Consolidating Compensation Asks",
                      "takeaway": "One clean, grateful consolidation feels collaborative rather than greedy."
                    },
                    {
                      "text": "Avoid \"one more thing\" three days in a row—present your full holistic request neatly in a single clear turn.",
                      "type": "callout",
                      "title": "Bundle Your Asks Once",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why should you send all compensation questions in one consolidated response?",
                      "options": [
                        "It confuses HR teams",
                        "Repeated piecemeal asks frustrate hiring leads; one consolidated proposal looks prepared and fair",
                        "It bypasses tax checks"
