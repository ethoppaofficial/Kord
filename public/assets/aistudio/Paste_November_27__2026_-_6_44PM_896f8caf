                  "blocks": [
                    {
                      "text": "The Diataxis Framework",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Diataxis divides technical documentation cleanly along user intent: Tutorials (learning-oriented hands-on walk), How-To Guides (task-oriented problem steps), Reference (information-oriented accurate specs), and Explanation (understanding-oriented context/architecture). Keeping those four modes clearly separated stops novices from drowning and lets experienced engineers look up payloads fast.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Diataxis Framework",
                      "text": "A documentation taxonomy distinguishing Tutorials, How-To Guides, Reference manuals, and Conceptual Explanations by user purpose.",
                      "type": "definition"
                    },
                    {
                      "body": "Instead of cramming auth philosophy + SDK methods + first API call into \"Authentication.md\", publish \"Quickstart: First API Call\" (Tutorial), \"Rotate Expired Tokens\" (How-To), \"Auth HTTP Headers\" (Reference), and \"Why Short-Lived JWTs Matter\" (Explanation).",
                      "type": "example",
                      "title": "Splitting One Bloated Page"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Identify whether the reader wants to Learn, Do, Look Up, or Understand.",
                        "Keep long conceptual history out of step-by-step How-Tos—link to Explanation instead.",
                        "Keep Reference pages dry, consistent, and alphabetical without story fluff."
                      ],
                      "title": "Applying Separating Four Documentation Quadrants"
                    },
                    {
                      "text": "A startup quickstart spent 900 words explaining OAuth2 RFC specifications before showing a single working request.",
                      "type": "case_study",
                      "title": "Overwhelmed API Quickstart",
                      "takeaway": "Linking history out to an Explanation doc got first developers succeeding under 4 minutes."
                    },
                    {
                      "text": "When a panicked DevOps engineer searches \"Restart Billing Worker\", give crisp How-To steps immediately—save architecture history for later reading.",
