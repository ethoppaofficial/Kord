              "id": "b6013c97-0ee3-eac1-ca9c-482aae736ce5",
              "title": "Module 4: Internal Linking & Avoiding Cannibalization",
              "lessons": [
                {
                  "id": "aa7432a4-6ce8-3031-a699-90f46d67c7fd",
                  "title": "Contextual Internal Linking Architecture",
                  "blocks": [
                    {
                      "text": "Intentional Link Flow & Anchor Diversity",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Internal links carry both human readers and search crawlers along logical topical paths. Place natural contextual links early or mid-article using clear descriptive anchors naming the target topic (`\"our 1-page decision memo template\"`, not generic `\"read this\"`). Point links deliberately toward orphaned deep articles AND core conversion/pillar pages.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Orphan Page",
                      "text": "A live published URL possessing zero internal inbound links from other pages on your own site—making discovery nearly impossible for visitors and crawlers alike.",
                      "type": "definition"
                    },
                    {
                      "body": "Inside a blog post on Remote Onboarding, link naturally from \"setting Day-1 permissions\" straight to your detailed `IT Access Security Checklist` URL using clear descriptive anchor text.",
                      "type": "example",
                      "title": "Smart Internal Link Placement"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Whenever publishing any new article, immediately update 2–3 older popular posts to link gracefully forward into the new piece!",
                        "Vary natural anchor wording sensibly across internal links instead of stamping identical exact strings verbatim fifty times.",
                        "Check monthly for high-value Orphan Pages lacking internal entry links."
                      ],
                      "title": "Applying Contextual Internal Linking Architecture"
                    },
                    {
                      "text": "A brand’s best product comparison page received zero internal links from their highest-traffic tutorials, starving conversions completely.",
                      "type": "case_study",
                      "title": "Orphaned Revenue Guide",
                      "takeaway": "Adding natural contextual links across top-5 blog articles multiplied comparison views 4x in one month."
                    },
                    {
                      "text": "Publishing checklists should end cleanly with: \"Link into this new URL from 2 existing high-traffic related posts right now.\"",
                      "type": "callout",
                      "title": "Always Update Old Winners on Launch Day",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What is a simple, high-impact launch day habit every time a new cluster article publishes?",
                      "options": [
                        "Leave older posts untouched forever",
                        "Immediately add 2–3 natural contextual links FROM existing high-traffic related posts INTO the new URL",
                        "Duplicate the post onto a subdomain"
                      ],
                      "explanation": "Inbound internal links from strong existing pages feed discovery and reader flow instantaneously.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Thoughtful internal linking converts isolated blog pages into compounding discovery webs.",
