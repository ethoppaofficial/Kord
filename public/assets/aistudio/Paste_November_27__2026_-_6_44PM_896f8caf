            {
              "id": "f93670a4-fbb2-c7b7-c7e8-03b9f1538846",
              "title": "Module 4: Short-Form Vertical Reels & Tight Commercials",
              "lessons": [
                {
                  "id": "e9c9a499-2cec-9c85-b1aa-44ef51816530",
                  "title": "Vertical First-3-Second Scroll-Stoppers",
                  "blocks": [
                    {
                      "text": "Immediate Visual-Verbal Friction",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Short-form vertical scripts (Reels, Shorts, TikTok) fire three layers instantly on Frame 1: physical motion or arresting contrast visually, bold clean 4-word caption banner dead center-safe (`STOP MAKING THIS CV ERROR`), and a brisk immediate spoken hook skipping \"Hey guys\" totally.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Safe-Zone Captioning",
                      "text": "Keeping key visual subjects and burned-in hook titles comfortably clear of platform edge buttons, captions, and profile icons on 9:16 vertical screens.",
                      "type": "definition"
                    },
                    {
                      "body": "[Frame 1 Text: STOP BLAMING SLOW WI-FI] Spoken: \"Your laptop looks slow—yet three hidden startup apps actually eat half your memory before breakfast. Click here to see them...\"",
                      "type": "example",
                      "title": "Punchy 35-Second Micro-Lesson"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Begin strictly mid-action or on vivid contrast—zero empty inhale pauses before talking.",
                        "Keep burned-in opening visual text crisp (`3–6` words max) matching opening audio.",
                        "Delete slow closing goodbyes (\"Okay thanks for watching bye!\")—end crisply right on takeaway impact."
                      ],
                      "title": "Applying Vertical First-3-Second Scroll-Stoppers"
                    },
                    {
                      "text": "Pausing two seconds to adjust hair and say \"Hi everyone!\" guaranteed 80% swipe-away before word three.",
                      "type": "case_study",
                      "title": "Sluggish 4-Second Warmup Short",
                      "takeaway": "Cutting pre-speech frames and putting crisp problem text on Frame 1 lifted completion over 70%."
                    },
                    {
                      "text": "In short-form editing, trim dead breath ahead of your very first syllable so audio kicks instantly.",
                      "type": "callout",
                      "title": "Cut Greeting Air Cleanly",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What makes a vertical 40-second explainer fail before viewers reach the actual lesson?",
                      "options": [
                        "Crisp screen zoom",
                        "Opening with silent pause, camera adjustment, and \"Hey guys welcome...\" fluff",
                        "Short caption banners"
                      ],
                      "explanation": "Every wasted opening second in vertical feeds produces instant scroll-past drops.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Tight zero-waste opening mechanics earn full watch-through cleanly in vertical feeds.",
                  "position": 1,
