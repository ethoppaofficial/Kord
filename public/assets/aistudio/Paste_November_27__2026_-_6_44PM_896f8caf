                },
                {
                  "id": "a47a43b5-d277-761c-34c2-32ddd1fa2aa3",
                  "title": "BATNA, Walk-Away & ZOPA",
                  "blocks": [
                    {
                      "text": "Calculating Objective Walk-Away Leverage",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Your Best Alternative to a Negotiated Agreement (BATNA) is what you genuinely do next if no deal happens. A realistic BATNA sets your reservation point—below which accepting makes you worse off—and prevents desperate concessions. The Zone of Possible Agreement (ZOPA) exists where your minimum overlaps their maximum.",
                      "type": "paragraph"
                    },
                    {
                      "term": "BATNA (Best Alternative)",
                      "text": "Your concrete fallback option outside the current negotiation, which determines true walk-away confidence.",
                      "type": "definition"
                    },
                    {
                      "body": "If you have two warm prospects paying £65/hr (BATNA), you negotiate calmly on a £75/hr pitch without panic discounting to £45/hr.",
                      "type": "example",
                      "title": "Freelance Rate Check"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Document two concrete fallback paths before talks.",
                        "Strengthen your BATNA beforehand by sourcing backup options.",
                        "Set a written walk-away line privately and commit never to cross it impulsively."
                      ],
                      "title": "Applying BATNA, Walk-Away & ZOPA"
                    },
                    {
                      "text": "Because a consultant verified an alternative 3-month contract first, she calmly held her £8,000 retainer rate—and the client accepted.",
                      "type": "case_study",
                      "title": "Panic Discount Avoided",
                      "takeaway": "Confidence comes from genuine preparation, not bluffing."
                    },
                    {
                      "text": "Building a second candidate pipeline or supplier quote is the strongest negotiation move you can make.",
                      "type": "callout",
                      "title": "Strengthen BATNA First",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why is a written reservation price essential before entering price talks?",
                      "options": [
                        "To print and hand to the opponent",
                        "To stop emotional momentum from pushing you into losing deals below your fallback",
                        "To prove stubbornness"
                      ],
                      "explanation": "Knowing your floor protects margins under live pressure.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Clear fallback math replaces negotiation anxiety with calm steadiness.",
                  "position": 2,
