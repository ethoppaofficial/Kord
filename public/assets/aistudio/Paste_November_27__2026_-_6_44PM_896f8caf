              "lessons": [
                {
                  "id": "cb646c37-25f7-d983-30d9-27d3602985b3",
                  "title": "Showing Your Work Beats Abstract Advice",
                  "blocks": [
                    {
                      "text": "Original Craft Proof & Mini-Teardowns",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Any bot can recite standard advice (\"Use contrast cleanly\"); trusted blogs walk readers step-by-step through messy actual work—showing draft v1 mistakes beside v2 fixes, explaining WHY one headline won, and sharing authentic results. One authentic annotated example outweighs five pages of preaching.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Annotated Teardown",
                      "text": "Walking readers transparently through real artifacts (a campaign spreadsheet, email draft, or UI layout) while marking exact choices made and why.",
                      "type": "definition"
                    },
                    {
                      "body": "Preach: \"Write clear blog subheads.\" Show: \"Originally I titled this section `Metrics` (skipped by 70% of reviewers). Renaming it `3 Metrics Showing When Posts Actually Retain Readers` clarifies exact value.\"",
                      "type": "example",
                      "title": "Show vs. Preach Paragraph"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Add at least one genuine original example inside every H2 section.",
                        "Share failures and false starts honestly alongside polished wins.",
                        "Draw simple custom flow sketches or screenshots rather than cheesy unrelated stock handshakes."
                      ],
                      "title": "Applying Showing Your Work Beats Abstract Advice"
                    },
                    {
                      "text": "Pasting glossy smiling office stock photos added zero teaching value while slowing mobile loads.",
                      "type": "case_study",
                      "title": "Generic Stock Photo Clutter",
                      "takeaway": "Swapping stock clutter for two clean annotated spreadsheet captures doubled bookmark saves."
                    },
                    {
                      "text": "One hand-annotated chart, screenshot arrow, or concise table beats ten decorative Unsplash office photos every single time.",
