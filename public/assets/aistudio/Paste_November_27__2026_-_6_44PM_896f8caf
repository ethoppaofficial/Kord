                {
                  "id": "97783328-5531-8769-132c-ab8ffb8ca607",
                  "title": "Technical Style Clarity Rules",
                  "blocks": [
                    {
                      "text": "Present Tense & Unambiguous Phrasing",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Standard technical style guides (Google Developer Documentation Style Guide) advise plain active present tense: \"Click **Export** to download the CSV.\" Avoid cute idioms (\"piece of cake\"), regional slang, or ambiguous pronouns (\"it displays that\") across multilingual global developer teams.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Present Tense Spec Rule",
                      "text": "Describing deterministic software behavior in simple present tense (\"The endpoint returns 201\") rather than hypothetical future (\"will return\").",
                      "type": "definition"
                    },
                    {
                      "body": "Wordy: \"If you should run into errors, it will show a warning banner.\" Crisp: \"If validation fails, the form displays an error banner.\"",
                      "type": "example",
                      "title": "Clean Technical Polish"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Convert \"will + verb\" behaviors into clean simple present tense.",
                        "Replace vague pronouns (\"it\", \"this\") with explicit concrete nouns (\"the parser\", \"this flag\").",
                        "Drop distracting humor or idioms that mis-translate globally."
                      ],
                      "title": "Applying Technical Style Clarity Rules"
                    },
                    {
                      "text": "\"Restart the worker and clear the cache until it stops failing\" left engineers unsure whether \"it\" meant the worker or the upstream gateway.",
                      "type": "case_study",
                      "title": "Confusing Ambiguous \"It\"",
                      "takeaway": "Naming exact component nouns resolved confusion cleanly."
                    },
                    {
                      "text": "Define domain acronyms (`RBAC` -> Role-Based Access Control) on first page mention before abbreviating cleanly.",
                      "type": "callout",
                      "title": "Spell Acronyms Out Once",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why favor simple present tense (\"The API returns 404\") over future tense (\"The API will return 404\")?",
                      "options": [
                        "Future tense breaks HTTP specs",
                        "Present tense reads crisper, matches deterministic behavior, and translates cleanly worldwide",
                        "Present tense uses more adjectives"
                      ],
                      "explanation": "Direct present phrasing simplifies global technical readability immediately.",
                      "correctIndex": 1
                    }
