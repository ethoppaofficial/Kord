                  "blocks": [
                    {
                      "text": "Pre-Agreed Downside Triggers",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "When building annual budgets, sketch three honest scenarios ahead of emotion: **Base Case** (expected steady course), **Upside Case** (where bonus cash invests safely without permanent fixed bloat), and **Downside Emergency Plan (`Scenario C`)** pre-defining exact cost pauses if cash runway falls below `X months` or revenue trails target `Y%` for two straight months—eliminating painful frozen procrastination later.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Pre-Committed Financial Trigger",
                      "text": "An objective pre-agreed numeric threshold (`\"If cash reserve dips below 8 weeks of payroll, pause Phase-2 tooling upgrades immediately\"`) decided calmly upfront to prevent emotional paralysis during downturns.",
                      "type": "definition"
                    },
                    {
                      "body": "Trigger: Trailing 60-day gross margin falls below target by >15%. Pre-agreed Action: Freeze non-revenue discretionary subscriptions, convert bonus hires to project contractors, intensify high-margin renewal outreach immediately.",
                      "type": "example",
                      "title": "Clear Pre-Agreed Brake Rule"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Decide exact painful expense trims calmly on sunny days before crisis ever arrives.",
                        "Keep clear priority stack distinguishing Essential Revenue Engines from Nice-to-Have overhead.",
                        "Track literal cash runway weeks every single Friday continuously."
                      ],
                      "title": "Applying Pre-Committed Scenario A / B / C Financial Triggers"
                    },
                    {
                      "text": "Founders kept hoping slow sales would magically rebound next month for seven straight months—draining final emergency cash until forced abrupt layoffs occurred.",
                      "type": "case_study",
                      "title": "Slow Bleeding Procrastination",
                      "takeaway": "Clear pre-committed Downside Trigger gates protect survival cleanly early!"
                    },
                    {
                      "text": "When tightening belts calmly, never accidentally slash the exact customer service or direct outreach muscles bringing cash in!",
                      "type": "callout",
                      "title": "Protect Sales Engines During Cuts",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why write exact Scenario C cost-pause triggers calmly during annual planning instead of improvising mid-crisis?",
                      "options": [
                        "Saves spreadsheet tabs",
                        "Pre-committed objective thresholds bypass emotional denial and delay, preserving critical survival cash weeks earlier",
                        "Replaces bank loans"
                      ],
                      "explanation": "Objective calm guardrails enable swift decisive protection long before insolvency looms.",
