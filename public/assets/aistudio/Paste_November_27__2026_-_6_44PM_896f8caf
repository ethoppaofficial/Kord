            {
              "id": "16c1c799-ee25-a536-1901-b04fee770e6a",
              "title": "Module 3: Writing About Numbers & Financial Cases",
              "lessons": [
                {
                  "id": "c25708b3-96c8-9ad8-0046-162c56f1f7a7",
                  "title": "Insight Headlines Over Pure Data Dumps",
                  "blocks": [
                    {
                      "text": "Action-Title Data Narration",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Instead of descriptive table titles (\"Support Ticket Breakdown\"), write assertive takeaway titles (\"Onboarding Friction Drove 62% of Q3 Support Rise\"). Commentary underneath should interpret WHY metrics moved and what decision follows—never merely type out numbers already visible in cells.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Action Title",
                      "text": "A chart or section heading stating the central business insight rather than naming the raw topic label.",
                      "type": "definition"
                    },
                    {
                      "body": "Weak: \"Monthly Churn Rate Jan–Jun\". Action Title: \"Churn Halved From 6% to 3% After Guided Setup Rollout\".",
                      "type": "example",
                      "title": "Descriptive vs. Action Title"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Identify the single surprising shift or pattern in the numbers.",
                        "Turn that insight into the chart/table headline.",
                        "Keep prose underneath focused on drivers and recommended next move."
                      ],
                      "title": "Applying Insight Headlines Over Pure Data Dumps"
                    },
                    {
                      "text": "A manager narrated \"January was $42k, February was $45k, March was $44k...\" across three dull paragraphs.",
                      "type": "case_study",
                      "title": "Unread Metrics Deck",
                      "takeaway": "Condensing into \"Q1 revenue stabilized around $44k while seasonal dip narrowed 50%\" won immediate strategic praise."
                    },
                    {
                      "text": "Summarize the pattern, root driver, and business consequence—let the table display individual cells cleanly.",
                      "type": "callout",
                      "title": "Never Read Tables Aloud in Prose",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What belongs in prose beside a financial table?",
                      "options": [
                        "Repeating every table cell inside sentences",
                        "Explaining root causes behind shifts and recommended operational response",
                        "Hiding negative variance completely"
                      ],
                      "explanation": "Narratives explain WHY metrics moved and what to do about them.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Insight-led titles ensure charts and numbers immediately clarify decisions.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "51a6e976-f951-46cd-8b2e-2505093c7972",
                      "url": "https://owl.purdue.edu/",
                      "title": "Purdue OWL General Writing Resources",
                      "position": 1,
                      "resource_type": "guide"
                    },
                    {
                      "id": "53081389-3da2-4671-8551-a74a6731f519",
                      "url": "https://www.plainlanguage.gov/guidelines/",
                      "title": "Plain Language Guidelines",
                      "position": 2,
                      "resource_type": "documentation"
                    }
                  ],
                  "takeaways": [
                    "Replace generic chart labels with insight statements",
                    "Explain underlying causes rather than reciting table cells",
                    "End numeric blocks with recommended adjustments"
                  ],
                  "objectives": [
                    "Explain action-title data narration",
                    "Apply insight headlines over pure data dumps in original drafts"
                  ],
                  "est_minutes": 28,
                  "is_required": true,
                  "introduction": "Writing \"Q3 Revenue Table\" above a spreadsheet forces every reader to hunt for what actually changed.",
                  "further_reading": [
                    {
