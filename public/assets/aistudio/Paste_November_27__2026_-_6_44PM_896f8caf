              "activities": [
                {
                  "id": "9db52070-b681-6948-5057-621da636433c",
                  "title": "1-Page Executive Summary",
                  "phase_id": "b1f04c2d-1b38-39ae-9317-5a680dde54fa",
                  "position": 1,
                  "lesson_id": "8637c600-49f5-72ce-050c-187fc8e60a0f",
                  "resources": [],
                  "description": "Condense an imagined or real multi-part project audit into a tight 250-word executive summary.",
                  "est_minutes": 30,
