              "lessons": [
                {
                  "id": "9b466548-52e6-706e-dd26-d0691609994f",
                  "title": "Qualifying Beyond Friendly Curiosity",
                  "blocks": [
                    {
                      "text": "Pain, Decision Power & Compelling Event",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Your biggest competitor rarely turns out to be Rival Company B—it is **Status Quo / Doing Nothing (`40–60%` of B2B pipelines die cleanly here!)**. Protect your calendar ruthlessly by verifying: Is pain urgent enough to change NOW (**Compelling Event / Deadline**)? Who signs/influences checks (**Economic Buyer & Champion**)? What exact steps must happen between today and start date (**Decision Process**)?",
                      "type": "paragraph"
                    },
                    {
                      "term": "Compelling Event",
                      "text": "A concrete external deadline or mounting operational consequence (`new compliance cutoff, peak hiring surge, expiring legacy license`) forcing real action by a specific calendar date rather than floating \"someday\".",
                      "type": "definition"
                    },
                    {
                      "body": "\"Setting aside pricing for a moment—if your team still uses manual spreadsheets six months from now, is that okay operationally, or does something important break before spring?\"",
                      "type": "example",
                      "title": "Testing Compelling Urgency Kindly"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Verify how this organization previously bought similar software/services (`\"Walk me through the last time your team onboarded a new vendor—who reviewed security/contracts?\"`).",
                        "Identify true internal **Champions** who actively push your deal when you aren’t in the room—never mistake friendly information-collectors for Champions!",
                        "Respect time graciously: disqualify mismatches kindly (`\"Based on X, timing feels early—happy to share clean DIY checklist now and reconnect Q3!\"`)."
                      ],
                      "title": "Applying Qualifying Beyond Friendly Curiosity"
                    },
                    {
                      "text": "Spent 12 demo hours tailoring custom PDF mocks for an enthusiastic mid-level coordinator—only to learn Day 40 their CFO froze all outside software spend six months earlier!",
                      "type": "case_study",
                      "title": "Dead \"Friendly Manager\" Pipeline",
                      "takeaway": "Asking politely upfront `\"How do tools over $X typically clear budget approval on your team?\"` prevents zero-authority dead-ends completely!"
                    },
                    {
                      "text": "Build clear cost-of-delay urgency calmly—not hype pressure—by exploring what staying stuck costs over the next 6 months!",
                      "type": "callout",
                      "title": "Your #1 Rival Is Inaction",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What typically destroys more B2B sales pipelines than losing head-to-head against a direct competitor?",
                      "options": [
                        "Typos on pricing PDFs",
                        "Stalling out passively into `\"No Decision / Status Quo Inertia\"` due to missing compelling urgency or unclear internal buying steps",
                        "Short discovery calls"
                      ],
                      "explanation": "Without real cost-of-inaction urgency and mapped approval steps, friendly deals quietly stall forever.",
                      "correctIndex": 1
                    }
                  ],
