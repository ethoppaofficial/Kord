                {
                  "id": "d15e8f75-f6da-c351-e845-6c8f7f70baa2",
                  "title": "Managing Distraction & Attentional Hygiene",
                  "blocks": [
                    {
                      "text": "Visible Presence Signals",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Attention is visible. Turning slightly away from bright monitors, silencing notifications, nodding naturally at key beats, and keeping notes minimal signal safety. Even on audio calls, zero keyboard clatter and crisp verbal markers (\"Keep going—that detail on onboarding matters\") assure speakers you are genuinely present.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Visible Attention Signals",
                      "text": "Intentional posture, device silencing, and brief verbal affirmations showing the speaker they hold undivided focus.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Give me ten seconds to close my Slack tabs so I can focus completely on this walkthrough.\"",
                      "type": "example",
                      "title": "Closing Laptop Lid Respectfully"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Silence notifications before 1:1 conversations.",
                        "Ask brief permission before taking brief notes.",
                        "Reflect focus warmly through eye contact and calm stillness."
                      ],
                      "title": "Applying Managing Distraction & Attentional Hygiene"
                    },
                    {
                      "text": "Moving weekly check-ins away from open Slack screens cut awkward brevity and helped a quiet designer surface early burnout cleanly.",
                      "type": "case_study",
                      "title": "1:1 Trust Transformation",
                      "takeaway": "Visible focus unlocks candid conversations immediately."
                    },
                    {
                      "text": "Saying \"Jotting a quick keyword so I don't miss it\" stops downward glances from looking like texting.",
                      "type": "callout",
                      "title": "Announce Note-Taking",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why mention aloud why you are writing during a serious 1:1 conversation?",
                      "options": [
                        "To show fast typing speed",
                        "So the speaker knows you are capturing their insight rather than answering unrelated chats",
                        "To end the meeting faster"
                      ],
                      "explanation": "Transparent context prevents mistaken feelings of distraction.",
