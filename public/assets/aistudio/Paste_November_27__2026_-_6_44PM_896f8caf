                },
                {
                  "id": "df60bae8-13d1-c47e-2c66-94735b9454bf",
                  "title": "Writing Crisp Decision Asks",
                  "blocks": [
                    {
                      "text": "Action Tagging & Decision Ownership",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Every business message serves one of four goals: Inform, Align, Consult, or Approve. Naming the goal explicitly prevents passive delays. When requesting approval, quantify risk if delayed, state exact approval scope, and give a sensible default deadline (\"Unless objections arise by Thursday noon, we will proceed with Option A\").",
                      "type": "paragraph"
                    },
                    {
                      "term": "Silent Approval Default",
                      "text": "Clearly stating a reasonable action path and deadline so low-risk decisions do not stall indefinitely in overflowing inboxes.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Approve Option B (£1,800 sprint contractor) by Wednesday 3 PM to protect Friday launch; silent approval defaults to staging only.\"",
                      "type": "example",
                      "title": "Sharp Sign-Off Request"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Pick one primary intent tag: FYI, Input, or Approve.",
                        "Highlight deadline and consequence of inaction.",
                        "Name one single person responsible for signing off."
                      ],
                      "title": "Applying Writing Crisp Decision Asks"
                    },
                    {
                      "text": "Emailing \"Leadership team\" asking \"thoughts?\" led four directors to assume another peer would answer.",
                      "type": "case_study",
                      "title": "Diffused Responsibility Delay",
                      "takeaway": "Addressing one owner (\"@Tariq for final sign-off, @Mina for input\") got resolution in two hours."
                    },
                    {
                      "text": "Even when copying five stakeholders, explicitly name the single decider in line one.",
                      "type": "callout",
                      "title": "One Primary Decider",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why does addressing an email broadly to \"Team — thoughts?\" stall action?",
                      "options": [
                        "Too many bullet points",
                        "Bystander effect diffuses accountability so everyone assumes someone else will reply",
                        "Email servers throttle group threads"
                      ],
                      "explanation": "Naming a specific decider and clear deadline drives prompt resolution.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Explicit ownership and deadlines eliminate invisible decision bottlenecks.",
                  "position": 2,
                  "resources": [
                    {
                      "id": "fbf7687a-9d54-4743-a329-e2fe3f6ddf96",
                      "url": "https://www.mindtools.com/",
                      "title": "Communicating Clearly in Workplaces",
                      "position": 1,
                      "resource_type": "article"
                    },
                    {
                      "id": "1f004c7d-b1f8-43ba-9d2c-04d18ad45bad",
                      "url": "https://www.gov.uk/guidance/content-design",
                      "title": "Service Writing & Clear Communication Standards",
                      "position": 2,
                      "resource_type": "documentation"
                    }
                  ],
                  "takeaways": [
                    "Tag message intent explicitly",
                    "Name one primary decision-maker",
                    "Quantify the impact of waiting"
                  ],
                  "objectives": [
                    "Explain action tagging & decision ownership",
                    "Apply writing crisp decision asks in everyday scenarios"
                  ],
                  "est_minutes": 28,
                  "is_required": true,
                  "introduction": "Even well-researched updates stall when readers are unsure whether you want approval, feedback, or merely awareness.",
                  "further_reading": [
                    {
                      "url": "https://www.mindtools.com/",
