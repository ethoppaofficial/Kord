                  "blocks": [
                    {
                      "text": "Clean Separation & Written Agreements",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Even as a solo weekend builder, open one dedicated business bank checking lane immediately, reserve ~20–30% of net profits automatically into a quiet tax account, and put simple plain-language **Written Scope Agreements** (`Deliverables, Timeline, Total Price, Payment Schedule, Ownership Rights, Cancellation Terms`) in place before starting client builds.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Commingling Risk",
                      "text": "Blending personal everyday spending and business revenue inside one bank account—obscuring real business profitability and complicating legal/tax accountability.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Milestone 1 ($1,000 due at kickoff); Milestone 2 ($1,000 due upon Staging Review approval within 5 days). Includes up to two consolidated revision rounds.\"",
                      "type": "example",
                      "title": "Simple Plain Scope Clause"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Dedicate one separate business checking account from dollar one.",
                        "Sweep tax reserves automatically monthly—never accidentally spend tax funds as \"profit\"!",
                        "Confirm written agreement terms cleanly via signed PDF or explicit email confirmation ahead of every engagement."
                      ],
                      "title": "Applying Day-1 Financial & Contract Hygiene"
                    },
                    {
                      "text": "A thriving first-year solo studio spent 100% of gross payouts on living upgrades and studio gear—getting blindsided by an unexpected $9,000 tax balance.",
                      "type": "case_study",
                      "title": "April Tax Shock",
                      "takeaway": "Auto-sweeping 25% of every cleared client payment into a Tax Vault eliminates panic completely."
                    },
                    {
                      "text": "Check plain official regional portals (`sba.gov` or local small-business chambers) for clear licensing and registration basics—avoid informal hallway rumors!",
                      "type": "callout",
                      "title": "Verify Official Local Rules Early",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why separate business bank flows and auto-reserve taxes strictly from client dollar one?",
