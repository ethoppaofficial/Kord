            {
              "id": "15a41479-bfba-f2f3-46fb-f6607a003698",
              "title": "Module 5: Responsive Architecture & Developer Handoff",
              "lessons": [
                {
                  "id": "cb8e28ac-0726-d9df-7835-81b47e500cb3",
                  "title": "Designing Mobile-First & Reflowing Complex Layouts",
                  "blocks": [
                    {
                      "text": "Thoughtful Breakpoint Adaptation",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Design cleanly across core breakpoints (`375px Mobile -> 768px Tablet -> 1280px+ Desktop`). Collapse multi-column grids smoothly into single-column scrollable stacks (`1fr`), convert cramped data tables into structured summary cards or intentional scrollable regions, stack sidebars into accessible menu drawers, and verify long translated/dynamic user names truncate or wrap gracefully without breaking layouts.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Stress-Testing Edge Content",
                      "text": "Testing UI layouts with realistic awkward copy—very long names, zero-item empty states, 3-line titles—rather than idealized short \"John Doe\" dummy strings.",
                      "type": "definition"
                    },
                    {
                      "body": "Desktop displays crisp 6-column Invoice Table; Mobile `<640px` transforms each invoice row into a clean stacked card prioritizing ID, Status Badge, Amount, and View button.",
                      "type": "example",
                      "title": "Table-to-Card Mobile Reflow"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Build 375px mobile frame alongside 1440px desktop frame during design.",
                        "Stress-test cards with 2x longer realistic titles and error banners.",
                        "Confirm sticky bottom bars never cover last list entries cleanly."
                      ],
                      "title": "Applying Designing Mobile-First & Reflowing Complex Layouts"
                    },
                    {
                      "text": "Testing realistic German/long user titles mid-design caught clipping inside fixed-height `48px` card headers—switching to flexible vertical padding eliminated truncation permanently.",
                      "type": "case_study",
                      "title": "Avoiding Broken Launch Cards",
                      "takeaway": "Flexible layouts survive real production content calmly."
                    },
                    {
                      "text": "Never lock text cards to rigid fixed pixel heights (`height: 160px`); let content breathe naturally downwards cleanly.",
                      "type": "callout",
                      "title": "Ban Fixed Pixel Heights on Text Containers",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What common design mistake causes broken clipping once UI mocks move into live production?",
                      "options": [
                        "Using 8px spacing grids",
                        "Designing strictly around short fake names inside rigid fixed-height containers rather than testing realistic long titles",
