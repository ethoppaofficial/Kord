            {
              "id": "1ff52294-3db7-bd75-0512-3f35df32001c",
              "title": "Module 3: E-E-A-T & Demonstrating Genuine Human Expertise",
              "lessons": [
                {
                  "id": "e2987ee0-9b1e-23e1-df06-1657b91bd6b8",
                  "title": "Proving Firsthand Experience (The Extra \"E\")",
                  "blocks": [
                    {
                      "text": "Original Artifacts & Lived Nuance",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Google’s **E-E-A-T** quality concepts (`Experience, Expertise, Authoritativeness, Trustworthiness`) weigh firsthand proof heavily: original non-stock product photos/screenshots, unexpected failure notes discovered only by doing the work, real quantitative test logs (`\"We tested 5 plugins on a 10MB page—Plugin C added 420ms\"`), and transparent author credentials linked visibly to real profiles.",
                      "type": "paragraph"
                    },
                    {
                      "term": "E-E-A-T Signals",
                      "text": "Observable markers proving content springs from real hands-on Experience, domain Expertise, broader recognition (Authoritativeness), and factual transparent Trustworthiness.",
                      "type": "definition"
                    },
                    {
                      "body": "Thin: \"Tool B works fast and helps small teams.\" Experienced: \"In our 14-day test across 1,200 invoices, Tool B flagged 98% of duplicate PO numbers—though manual tax edits still require two extra clicks.\"",
                      "type": "example",
                      "title": "Thin Summary vs. Experience Proof"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Include specific pros AND honest edge-case drawbacks in tool reviews—flawless praise reads like fake affiliate fluff!",
                        "Add clean real author bylines with genuine practitioner context plus Last Updated verification dates.",
                        "Cite original primary statistics, official docs, or research institutions directly instead of looping vague blog echoes."
                      ],
                      "title": "Applying Proving Firsthand Experience (The Extra \"E\")"
                    },
                    {
                      "text": "A comparison listing \"10 Best Tools\" summarized marketing taglines identically without testing pricing tiers; traffic dropped 75% in helpful-content updates.",
