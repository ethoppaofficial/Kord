                {
                  "id": "9fffc03e-2880-f2ff-db48-9d55d0c94d51",
                  "title": "Choosing the Right Story Archetype",
                  "blocks": [
                    {
                      "text": "Origin, Cautionary & Customer Turnarounds",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Three practical story modes carry most professional communication: Origin Stories (why a conviction or team exists), Customer Turnarounds (how a clear method solved painful friction), and Honest Failure Lessons (what a past slip taught us). Selecting the right archetype prevents mismatched mood.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Cautionary Story",
                      "text": "A narrative spotlighting an overlooked error or false assumption to help peers spot hidden traps early.",
                      "type": "definition"
                    },
                    {
                      "body": "Onboarding new hires -> Origin Story. Pitching leadership risk controls -> Cautionary Story. Selling skeptical clients -> Customer Turnaround.",
                      "type": "example",
                      "title": "Selecting Archetype by Goal"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Identify what belief or habit you want shifted in the listener.",
                        "Choose Origin, Turnaround, or Cautionary tone cleanly.",
                        "Avoid painting yourself as effortless genius—make the method or partner the hero."
                      ],
                      "title": "Applying Choosing the Right Story Archetype"
                    },
                    {
                      "text": "Telling a triumphant personal brag story during a team post-mortem alienated burnt-out peers.",
                      "type": "case_study",
                      "title": "Tone-Deaf Victory Lap",
                      "takeaway": "Switching to a candid personal lesson learned invited open collaboration immediately."
                    },
                    {
                      "text": "Position yourself or your product strictly as the helpful guide unlocking the protagonist’s win.",
                      "type": "callout",
                      "title": "Make Listeners or Customers the Hero",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "When pitching a new process to cautious buyers, who belongs in the hero role?",
                      "options": [
