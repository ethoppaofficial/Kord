              "lessons": [
                {
                  "id": "f71fdb23-0450-479a-062a-1c8679cfddcf",
                  "title": "The Micro-Arc Inside Every Scene",
                  "blocks": [
                    {
                      "text": "Scene Turn & Value Shift",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Every effective scene shifts status cleanly: if a character enters hopeful, they exit cornered, relieved-yet-compromised, or holding risky knowledge. Structuring scenes around Goal, Resistance, and an Earned Turn guarantees forward motion.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Scene Turn",
                      "text": "The critical beat inside a scene where expectations reverse or stakes escalate, leaving relationships altered permanently.",
                      "type": "definition"
                    },
                    {
                      "body": "Enter: Hoping to borrow truck keys quietly. Obstacle: Uncle reveals he already promised the truck to a buyer. Exit: Protagonist secretly pockets spare key, shifting from innocent to complicit.",
                      "type": "example",
                      "title": "Micro Value Shift"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "State how the scene begins vs. how it ends differently.",
                        "Drop polite greeting small talk—enter scenes one beat later than natural.",
                        "Exit cleanly right after the shift lands; resist over-explaining afterward."
                      ],
                      "title": "Applying The Micro-Arc Inside Every Scene"
                    },
                    {
                      "text": "Two characters spent 600 words ordering lattes and summarizing last chapter before mentioning the missing contract.",
                      "type": "case_study",
                      "title": "Coffee Shop Filler",
                      "takeaway": "Starting directly as the folder slid empty across the table saved 400 dead words."
                    },
                    {
                      "text": "Cut introductory greetings and goodbye walks; enter right inside rising friction and cut on the impact line.",
                      "type": "callout",
                      "title": "Arrive Late, Leave Early",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What proves a creative scene actually belongs in the story?",
                      "options": [
                        "It describes wardrobe accurately",
                        "Conditions, stakes, or relationships visibly shift between opening and ending",
                        "It includes five metaphors"
                      ],
                      "explanation": "Every scene should alter story trajectory rather than restating existing states.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Micro-arcs keep narrative momentum tight page after page.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "9d5ca0df-0766-43b0-b072-ede56e781af4",
                      "url": "https://owl.purdue.edu/",
                      "title": "Purdue OWL Creative & Rhetorical Guides",
                      "position": 1,
                      "resource_type": "guide"
                    },
                    {
                      "id": "e98785c1-659b-4af1-99b9-d0970c2f333c",
                      "url": "https://www.nngroup.com/",
                      "title": "Nielsen Norman Group UX & Copy Clarity",
                      "position": 2,
                      "resource_type": "research"
                    }
                  ],
                  "takeaways": [
                    "Verify clear status change per scene",
                    "Enter scenes close to friction",
                    "Exit right on the turn without lingering summary"
                  ],
                  "objectives": [
                    "Analyze scene turn & value shift",
                    "Apply the micro-arc inside every scene in original writing"
                  ],
                  "est_minutes": 28,
                  "is_required": true,
                  "introduction": "Scenes where characters chat pleasantly and leave unchanged stall narrative energy completely.",
                  "further_reading": [
                    {
                      "url": "https://owl.purdue.edu/",
