                  "id": "fe980bc4-7837-1d95-58b2-125c53fcc1f0",
                  "title": "Picking Honest High-Signal Charts",
                  "blocks": [
                    {
                      "text": "Matching Visual Form to Data Question",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Use horizontal or vertical Bar Charts when comparing ranked categories cleanly; Line Charts strictly for continuous change across time; crisp Side-by-Side Big Numbers when comparing just two states (Before vs. After). Kill 3D effects and heavy dark gridlines completely—start bar axes strictly at zero so size comparisons stay 100% honest.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Direct Data Labeling",
                      "text": "Placing exact values directly at bar tips or line ends so audiences stop bouncing eyes back and forth to cluttered axis grids and side legends.",
                      "type": "definition"
                    },
                    {
                      "body": "Drop vertical gridlines + axis numbers entirely; label exact \"£14k / £22k / £31k\" straight atop each clean bar tip.",
                      "type": "example",
                      "title": "Decluttering a Quarterly Bar Chart"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Pick Bar for comparisons, Line for time trends.",
                        "Start bar value axes strictly at zero.",
                        "Label key points and series directly on charts rather than distant box legends."
                      ],
                      "title": "Applying Picking Honest High-Signal Charts"
                    },
                    {
                      "text": "Cutting decorative frames and labeling series lines directly on chart edges cut board Q&A time wasted on \"Which blue line is Q2?\" permanently.",
                      "type": "case_study",
                      "title": "Immediate Metric Comprehension",
                      "takeaway": "Direct labels remove decoding friction smoothly."
                    },
                    {
                      "text": "Human eyes struggle judging subtle pie angles—ranked horizontal bars make precision comparisons effortless.",
                      "type": "callout",
                      "title": "Retire Multi-Slice Pie Charts",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why should bar charts comparing volume ALWAYS start their value axis cleanly at zero?",
                      "options": [
                        "Zero fills blank screen",
                        "Truncated non-zero bar baselines visually exaggerate minor percentage differences misleadingly",
                        "Fonts align nicer"
                      ],
                      "explanation": "Visual integrity preserves honest comparison clarity cleanly.",
                      "correctIndex": 1
