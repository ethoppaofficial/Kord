                  "blocks": [
                    {
                      "text": "Structured Interviews & Tiny Work Samples",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Great charming talkers sometimes freeze at messy daily reality, while quiet diligent gems shine when tested fairly! Add one crisp **paid realistic 15–30 minute Work Sample** (`draft a reply to this simulated unhappy customer ticket`, `organize these 15 messy order rows`, `assemble mock prep box`) alongside identical behavioral questions across candidates—evaluating actual judgment cleanly over intuition bias.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Structured Work-Sample Check",
                      "text": "A short realistic hands-on simulation mimicking everyday job decisions given uniformly to finalists so real capability and clarity shine cleanly past smooth interview charm.",
                      "type": "definition"
                    },
                    {
                      "body": "Give candidates 15 minutes reading 3 realistic noisy customer emails: ask them literally how they’d reply calmly to each—seeing empathy, tone, and clarity instantaneously!",
                      "type": "example",
                      "title": "Customer Care Work Sample"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Write clear 5-bullet role outcomes BEFORE posting any job opening—stop copying generic internet templates!",
                        "Ask identical structured past-behavior scenarios across finalists (`\"Tell me about fixing a mistake nobody noticed yet\"`).",
                        "Verify real past references constructively (`\"In what exact environment does Alex shine brightest?\"`)."
                      ],
                      "title": "Applying Hiring Slowly With Real Work-Sample Checks"
                    },
                    {
                      "text": "Hired a charismatic sales coordinator purely over shared hobbies—discovering Week 2 they detested updating detailed customer logs cleanly.",
                      "type": "case_study",
                      "title": "Gut-Feeling Hire Regret",
                      "takeaway": "Simple practical workflow previews align true job enjoyment cleanly upfront for BOTH sides!"
                    },
                    {
                      "text": "If asking finalists to invest meaningful project testing time, pay a modest fair honorarium cleanly—respect signals top-tier employer class instantly!",
                      "type": "callout",
                      "title": "Pay Fairly for Any Work Test Over 15 Min",
                      "variant": "tip"
                    },
