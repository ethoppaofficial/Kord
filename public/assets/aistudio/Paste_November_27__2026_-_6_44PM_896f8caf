                  ],
                  "est_minutes": 28,
                  "is_required": true,
                  "introduction": "Guilty ramblings or silent non-replies frustrate colleagues far worse than an honest polite boundary delivered fast.",
                  "further_reading": [
                    {
                      "url": "https://www.plainlanguage.gov/guidelines/",
                      "title": "Plain Language Guidelines & Actionable Email Tips",
