                {
                  "id": "43c04a6f-8b97-d0de-2d54-2b2ae2113ccb",
                  "title": "Impact-vs-Effort Triage Discipline",
                  "blocks": [
                    {
                      "text": "Quick Wins vs. Strategic Traps",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Score candidate remedies cleanly across User/Mission Impact vs. True Build/Change Effort (including engineering, training, and risk). Harvest high-impact/low-effort Quick Wins immediately this week, schedule high-impact/high-effort Strategic Projects deliberately, ruthlessly drop Low-Impact \"Money Pits\", and refuse to confuse \"Looks Busy\" with \"Fixes Root Cause\".",
                      "type": "paragraph"
                    },
                    {
                      "term": "Quick Win Quadrant",
                      "text": "High-leverage practical fixes requiring minimal cost or transition time that build immediate relief and momentum inside days.",
                      "type": "definition"
                    },
                    {
                      "body": "Week 1: clarify broken FAQ labels (Quick Win, 2h). Weeks 2–6: build automated billing webhook (Strategic Fix). Drop: custom theme animations (Money Pit).",
                      "type": "example",
                      "title": "Choosing Order Cleanly"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Score impact strictly against target problem metric.",
                        "Include hidden coordination/training cost in Effort score.",
                        "Limit active team focus to 1–2 fixes at once."
                      ],
                      "title": "Applying Impact-vs-Effort Triage Discipline"
                    },
                    {
                      "text": "Sorting a 24-item backlog onto Impact-vs-Effort eliminated nine shiny distractions and let one lean team solve 75% of ticket lag cleanly in four weeks.",
                      "type": "case_study",
                      "title": "Focused Quarterly Recovery",
                      "takeaway": "Subtraction accelerates true mastery fast."
                    },
                    {
                      "text": "Low-impact, high-effort complex projects silently drain months while leaving main user pain untouched.",
                      "type": "callout",
                      "title": "Avoid \"Thankless Tasks\"",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Which quadrant should teams prioritize executing FIRST when capacity runs tight?",
                      "options": [
                        "High Effort, Low Impact",
                        "High Impact, Low Effort (Quick Wins)",
                        "Maximum complexity overhaul immediately"
                      ],
                      "explanation": "Quick wins generate immediate customer relief and earn credibility for deeper upgrades.",
                      "correctIndex": 1
                    }
