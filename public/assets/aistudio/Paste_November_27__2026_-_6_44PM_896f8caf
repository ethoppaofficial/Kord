            {
              "id": "7ae76796-1287-dfbc-b050-2c448eab42f0",
              "title": "Module 3: Word Choice, Tone & Precision",
              "lessons": [
                {
                  "id": "69d9f767-4825-0cb5-27fa-542721bc75b4",
                  "title": "Concrete Vocabulary Over Fluff",
                  "blocks": [
                    {
                      "text": "Specificity & Lean Diction",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Precise nouns and measurable evidence persuade readers far faster than inflated adjectives. Saying \"response latency fell from 900ms to 180ms\" carries authority that \"performance was hugely better\" never achieves. Stripping throat-clearing openers like \"It is important to note that\" keeps every line potent.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Deadwood Phrases",
                      "text": "Stock multi-word fillers (\"due to the fact that\", \"at this point in time\") easily replaced by single crisp words (\"because\", \"now\").",
                      "type": "definition"
                    },
                    {
                      "body": "\"In order to\" -> \"to\"; \"in the event that\" -> \"if\"; \"a large number of\" -> \"many\"; \"prior to\" -> \"before\".",
                      "type": "example",
                      "title": "Compressing Five Common Fillers"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Search drafts for \"very\", \"really\", \"actually\", and \"basically\".",
                        "Replace vague magnitude words with concrete metrics or examples.",
                        "Delete opening meta-commentary and start straight at the point."
                      ],
                      "title": "Applying Concrete Vocabulary Over Fluff"
                    },
                    {
                      "text": "A 4-page agency brochure repeated \"best-in-class seamless solutions\" nine times with zero client numbers.",
                      "type": "case_study",
                      "title": "Bloated Vendor Pitch",
                      "takeaway": "Replacing buzzwords with three real workflow metrics doubled inquiry replies."
                    },
                    {
                      "text": "Cross out the first sentence of your first draft—nine times out of ten, sentence two is your true opening.",
