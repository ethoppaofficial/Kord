              "id": "2ae532bb-cf12-4987-7f8b-ee7f4740cd1e",
              "title": "Module 1: Subject Lines & Mobile Scannability",
              "lessons": [
                {
                  "id": "c9a31904-d806-3953-beec-bd456bf821f2",
                  "title": "High-Signal Subject Lines",
                  "blocks": [
                    {
                      "text": "Topic-Action-Deadline Subjects",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Inbox triage happens in two seconds on mobile preview screens showing roughly the first 35–45 characters. Great business subjects put urgency tags first, specific project noun second, and target dates cleanly at the end: `[Approve by Thu 4 PM] Q4 Onboarding Copy`. Never bury key asks inside huge vague subjects.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Inbox Triage Tag",
                      "text": "Bracketed prefix labels (`[Action Required]`, `[FYI]`, `[Decision Needed Wed]`) signaling immediately whether an email demands timely action or passive awareness.",
                      "type": "definition"
                    },
                    {
                      "body": "Vague: \"Invoice stuff\". Crisp: \"[Confirm Wire Details by Fri] Acme Invoice #1042\".",
                      "type": "example",
                      "title": "Subject Upgrade Pair"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Front-load the critical noun or action inside the first 5 words.",
                        "Include exact project codes or dates when referencing ongoing tasks.",
                        "Start a brand-new subject thread whenever topic intent shifts completely instead of reusing stale Re: chains."
                      ],
                      "title": "Applying High-Signal Subject Lines"
                    },
                    {
                      "text": "An urgent venue contract sat unopened for two days under subject `\"Re: Lunch notes from Tuesday\"`.",
                      "type": "case_study",
                      "title": "Lost Urgent Approval",
                      "takeaway": "Splitting urgent approvals cleanly into fresh `[Sign-Off Needed Today] Venue Deposit` emails got immediate responses cleanly."
                    },
                    {
                      "text": "Don’t reply onto a month-old pizza logistics thread to ask about quarterly tax invoices—launch a fresh labeled subject.",
                      "type": "callout",
                      "title": "Refresh Subjects When Topics Drift",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Which subject line lets a busy manager triage urgency most accurately on a phone?",
                      "options": [
                        "Question regarding project",
                        "Re: Checking in",
                        "[Decision Needed Thu] Approve Stage 2 Budget ($4k)"
                      ],
                      "explanation": "Bracketed urgency, specific topic, and deadline front-load total clarity immediately.",
                      "correctIndex": 2
                    }
                  ],
                  "videos": [],
                  "summary": "Sharp subject lines respect recipient attention and lift response times noticeably.",
                  "position": 1,
