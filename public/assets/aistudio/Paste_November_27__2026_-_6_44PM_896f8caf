                  "blocks": [
                    {
                      "text": "High-Trust Manager Updates",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Managing up means adapting cleanly to how your manager makes decisions—bulleted weekly recaps, early risk alerts with proposed options, and clear 1:1 agendas prepared ahead of time. Bringing a problem paired with two candidate options signals ownership; dumping raw confusion forces your manager to think for both of you.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Managing Up",
                      "text": "Proactively giving your manager the visibility, options, and early warnings they need to support your success and shield the team.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Top priority: Q3 onboarding guide. Decision needed: approve 2-week user pilot? Blocker option: A) recruit 5 existing customers or B) 5 fresh signups (recommend A).\"",
                      "type": "example",
                      "title": "Pre-1:1 Prep Note"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Send 1:1 topics 2 hours ahead so your manager arrives ready.",
                        "Summarize completed wins concisely alongside current priorities.",
                        "Surface uncertainties early with preferred next step."
                      ],
                      "title": "Applying Managing Up Effectively"
                    },
                    {
                      "text": "A newly promoted analyst adopted 4-bullet Friday digests for her director, cutting check-in interruptions from 6 daily pings to one focused 15-minute sync.",
                      "type": "case_study",
                      "title": "From Overwhelmed to Trusted",
                      "takeaway": "Predictability buys autonomy fast."
                    },
                    {
