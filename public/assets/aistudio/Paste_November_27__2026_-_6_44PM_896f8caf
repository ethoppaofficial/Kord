            {
              "id": "0d7209a5-e472-65fd-ccba-80732328f003",
              "title": "Module 2: Brand Purpose, Promise & Personality Guardrails",
              "lessons": [
                {
                  "id": "98fa870a-97a5-9c04-f6a8-3ea5c46735c1",
                  "title": "Ditching Empty \"Mission Fluff\" for Sharp Promises",
                  "blocks": [
                    {
                      "text": "Observable Brand Promises",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Swap inflated abstract clichés for an **Observable Brand Promise**—something a customer can genuinely check whether you kept Tuesday morning (`Domino’s legendary \"Fresh hot pizza in 30 minutes or free\"` reshaped an industry because anyone held a wristwatch!). Pair ONE unforgettable central promise cleanly with **3 Supporting Proof Pillars** proving WHY buyers safely trust it.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Observable Brand Promise",
                      "text": "A concrete clear core commitment customers genuinely test in everyday experience—anchoring messaging, product trade-offs, and employee choices seamlessly.",
                      "type": "definition"
                    },
                    {
                      "body": "Fluff: \"Dedicated to transformative excellence.\" Observable: \"Plain-English financial closes delivered reliably every 5th business day—zero accounting jargon guaranteed.\"",
                      "type": "example",
                      "title": "Fluff vs. Observable Promise"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Ban hollow corporate fillers (`world-class, cutting-edge, holistic, bespoke, seamless`) completely out of your brand sheet!",
                        "Make sure your central promise directly anchors ONE operational priority teams actually sacrifice secondary work to uphold.",
                        "Back every brand pillar immediately with tangible verifiable behavior (`how customers witness it live`)."
                      ],
                      "title": "Applying Ditching Empty \"Mission Fluff\" for Sharp Promises"
                    },
                    {
                      "text": "Twelve employees couldn’t recite a single line of their brand’s poetic 85-word philosophy paragraph posted on website footers.",
                      "type": "case_study",
                      "title": "Forgettable Slogan Graveyard",
                      "takeaway": "Switching internally strictly to `\"Zero-Surprise Quotes · Delivered Friday\"` unified sales, support, and ops decisions instantaneously!"
                    },
                    {
                      "text": "Test your brand promise by covering your company name mentally with a fierce competitor’s logo—if it still sounds totally interchangeable, sharpen until distinctly yours!",
                      "type": "callout",
                      "title": "Could a Competitor Stamp Their Logo Over It?",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What test instantly exposes a weak generic brand slogan or mission claim?",
                      "options": [
                        "Measuring pixel height",
                        "Covering your company name with your top three rivals’ names—if it reads interchangeably for all of them, differentiation is zero",
                        "Checking rhyme schemes"
                      ],
                      "explanation": "True positioning claims sound distinctly owned by your unique operating promise alone.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Concrete verifiable promises cut through noisy markets cleanly while guiding every staff member.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "c5fb35c2-bff3-4c27-a739-b31ea6ad1b47",
                      "url": "https://hbr.org/",
                      "title": "Harvard Business Review Customer & Brand Strategy",
