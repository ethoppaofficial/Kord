                {
                  "id": "1eb2c22a-a91d-9426-a8ec-3fce9a2bddc0",
                  "title": "Document Anatomy, Landmarks, and Semantic Tags",
                  "blocks": [
                    {
                      "id": "fe21-1",
                      "text": "Why Semantics Beat Generic Div Soup",
                      "type": "heading"
                    },
                    {
                      "id": "fe21-2",
                      "text": "Replacing meaningless <div> wrappers with semantic landmarks gives assistive technology users instant keyboard shortcuts to jump straight to main content or navigation. Similarly, using <button type=\"button\"> instead of a clickable <div> provides keyboard Enter/Space support and focusability automatically.",
                      "type": "paragraph"
                    },
                    {
                      "id": "fe21-3",
                      "code": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Harbour Bakery — Fresh Sourdough Daily</title>\n</head>\n<body>\n  <header>\n    <nav aria-label=\"Primary\">\n      <a href=\"/\">Harbour Bakery</a>\n      <a href=\"#menu\">Menu</a>\n      <a href=\"#contact\">Contact</a>\n    </nav>\n  </header>\n  <main>\n    <section aria-labelledby=\"hero-title\">\n      <h1 id=\"hero-title\">Stone-Milled Bread Baked Every Morning</h1>\n    </section>\n  </main>\n  <footer>\n    <p>&copy; 2026 Harbour Bakery</p>\n  </footer>\n</body>\n</html>",
                      "type": "code",
                      "title": "Accessible Semantic Page Skeleton",
                      "language": "html"
                    },
                    {
                      "id": "fe21-4",
                      "type": "knowledge_check",
                      "prompt": "Which element should you use for an interactive action that opens a mobile menu without navigating to a URL?",
                      "options": [
                        "<div class=\"btn\">",
                        "<a href=\"#\">",
                        "<button type=\"button\">"
                      ],
                      "explanation": "<button type=\"button\"> natively supports keyboard focus, Enter/Space activation, and assistive screen-reader announcements.",
                      "correctIndex": 2
                    }
                  ],
                  "videos": [],
                  "summary": "Semantic landmarks create an accessible document backbone before a single line of CSS is written.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "fdd18887-e3c8-4c85-aa7e-cbb073ed2db5",
                      "url": "https://developer.mozilla.org/en-US/docs/Web/HTML/Element",
                      "title": "MDN: HTML Elements Reference",
                      "position": 1,
                      "resource_type": "article"
                    }
                  ],
                  "takeaways": [
                    "Include <meta name=\"viewport\"> on every page",
