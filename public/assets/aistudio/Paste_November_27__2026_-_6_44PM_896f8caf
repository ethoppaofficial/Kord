                  "blocks": [
                    {
                      "text": "Completeness, Uniqueness & Sanity Bounds",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Always profile raw tables first: check row counts, distinct IDs (catch duplicate joins inflating revenue), null rates, date formats (`YYYY-MM-DD` vs `MM/DD`), and outliers. Document cleaning rules transparently so stakeholders can reproduce every reported metric.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Data Profiling",
                      "text": "Inspecting distributions, null percentages, duplicate keys, and valid ranges across every column prior to analytical aggregation.",
                      "type": "definition"
                    },
                    {
                      "body": "Joining `courses` to `course_skills` without deduplicating multiplied lesson minutes by 3x on multi-skill courses!",
                      "type": "example",
                      "title": "Join Multiplication Trap"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Verify primary key uniqueness after every table join.",
                        "Inspect min/max/null counts on numeric and date fields.",
                        "Separate raw source sheets from cleaned analytical views."
                      ],
                      "title": "Applying Profiling Dirtiness Before Running Formulas"
                    },
                    {
                      "text": "Deduplicating multiple browser tabs by `user_id` revealed true weekly active learners were 1,240 rather than 3,100 event rows.",
                      "type": "case_study",
                      "title": "Inflated Active Users",
                      "takeaway": "Count entities (`COUNT(DISTINCT user_id)`), not raw join rows."
                    },
                    {
                      "text": "Cross-check one summed total against raw database counts after every transformation.",
                      "type": "callout",
                      "title": "Check Totals Against Source",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What commonly causes SQL JOIN queries to inflate summed totals unexpectedly?",
                      "options": [
                        "UTF-8 encoding",
                        "One-to-many or many-to-many joins duplicating parent rows before SUM()",
                        "Using descending ORDER BY"
                      ],
                      "explanation": "Always verify join cardinality or aggregate before joining to avoid double-counting.",
                      "correctIndex": 1
                    }
