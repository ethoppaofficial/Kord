                {
                  "id": "eac611ad-9288-13fe-3497-f9cb9195246c",
                  "title": "Calm Go-Live Playbooks & Phased Rollouts",
                  "blocks": [
                    {
                      "text": "Staged Rollouts & Safe Reversibility",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Think ahead cleanly like an airline pilot using a **Go-Live Runbook**: launch major workflows progressively (**Internal Team Test -> 10% Beta Cohort -> 100% Full Rollout**) whenever possible, designate clear **Go / No-Go Checkpoints** 24 hours out, monitor vital live metrics closely for the first 2 hours, and always prepare a verified 5-minute **Rollback Plan** before hitting go!",
                      "type": "paragraph"
                    },
                    {
                      "term": "Phased / Canary Rollout",
                      "text": "Releasing significant updates gradually to internal staff or tiny 5–10% real-user cohorts first so unexpected defects affect tiny slices cleanly before full wide launch.",
                      "type": "definition"
                    },
                    {
                      "body": "09:00 Internal staff test OK -> 10:00 Open to 10% new signups -> Check error logs + support tickets at 12:00 -> Clear Go signal -> Flip to 100% at 14:00 cleanly!",
                      "type": "example",
                      "title": "Calm Launch Runbook"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Hold crisp 10-minute `Go / No-Go` checkpoints cleanly BEFORE customer launch announcements blast!",
                        "Wait verifying live systems cleanly for 1–2 hours BEFORE hitting send on loud marketing emails!",
                        "Always test reverting (`Rollback Plan`) at least mentally before deploying irreversible database or workflow cuts!"
                      ],
                      "title": "Applying Calm Go-Live Playbooks & Phased Rollouts"
                    },
                    {
                      "text": "Marketing fired 40,000 `\"New Portal Is Live!\"` promotional emails at 8:00 AM while Engineering hit a 4-hour server delay—driving thousands straight onto broken pages!",
                      "type": "case_study",
                      "title": "Premature Blast Embarrassment",
                      "takeaway": "Wait strictly for verified live `\"All Systems Green\"` confirmation before releasing promotion sends!"
                    },
                    {
                      "text": "Ship quiet live -> verify smooth real checks -> THEN fire loud announcements!",
                      "type": "callout",
                      "title": "Sequence Launch Ahead of Megaphone",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why verify live updates quietly with internal users or small cohorts BEFORE firing large customer promo emails?",
                      "options": [
                        "Emails load faster afternoons",
                        "Confirms real production flows work smoothly end-to-end before driving massive peak traffic into unseen launch glitches",
                        "Saves graphic design hours"
                      ],
                      "explanation": "Decoupling technical go-live from promotional hype protects brand reputation cleanly from launch-hour bugs.",
                      "correctIndex": 1
                    }
                  ],
