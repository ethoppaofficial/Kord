                {
                  "id": "99efd117-ba25-26b7-a044-dbc075669a35",
                  "title": "Non-Negotiable UI Accessibility Design",
                  "blocks": [
                    {
                      "text": "Designing Inclusive Digital Products From Day 1",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Enforce `>= 4.5:1` contrast for normal text (`>= 3:1` for UI icons/borders), preserve unmistakable keyboard `:focus-visible` outlines, never rely solely on color to signal validation (`red border` MUST pair with clear error text/icon!), maintain `44x44px` minimum tap targets, and keep form labels visible above inputs—never inside disappearing placeholders.",
                      "type": "paragraph"
                    },
                    {
                      "term": "WCAG AA Accessibility Baseline",
                      "text": "Design minimums guaranteeing usable legibility and interaction: 4.5:1 text contrast, explicit field labels, non-color-only errors, and visible keyboard focus indicators.",
                      "type": "definition"
                    },
                    {
                      "body": "Visible `<label>` above input -> `44px` input height -> crisp red border + warning icon + \"Enter a valid UK postcode\" error text directly beneath.",
                      "type": "example",
                      "title": "Inclusive Form Pattern"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Verify foreground/background colors via WebAIM contrast tool during palette creation.",
                        "Design explicit Hover, Active, Disabled, and Keyboard Focus rings in every component kit.",
                        "Ensure mobile tap targets never crowd closer than 8px apart."
                      ],
                      "title": "Applying Non-Negotiable UI Accessibility Design"
                    },
                    {
                      "text": "Increasing tiny 12px light-grey radio terms and 28px checkboxes up to crisp dark slate 16px labels inside 48px clickable rows cut mobile checkout drop-offs by 19%.",
                      "type": "case_study",
                      "title": "Recovering Lost Mobile Checkouts",
                      "takeaway": "Accessible ergonomics improves usability for everyone cleanly."
                    },
                    {
                      "text": "Once users tap an input, placeholder text vanishes—leaving users with short working memory unsure what field they are typing in.",
                      "type": "callout",
                      "title": "Never Use Placeholders as Labels",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why is disabling browser focus outlines (`outline: none`) without replacing them a critical UX flaw?",
                      "options": [
                        "Makes buttons turn green",
                        "Keyboard and switch-device users lose all visual feedback showing which link or form button is currently active",
                        "Scrollbars break"
                      ],
                      "explanation": "Visible `:focus-visible` rings keep non-mouse navigation clear and usable.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Accessible design removes silent friction across eyesight, mobility, and hectic mobile contexts.",
                  "position": 2,
                  "resources": [
                    {
