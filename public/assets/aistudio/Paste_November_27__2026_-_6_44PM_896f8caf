                    },
                    {
                      "term": "Process Conflict",
                      "text": "Disagreements over who owns decisions, handoff rules, or review gates rather than disagreement over the end goal itself.",
                      "type": "definition"
                    },
                    {
                      "body": "Shift \"Design never cares about deadlines!\" to \"Our handoff checklist lacks a 48-hour QA freeze—let's fix the timeline gate together.\"",
                      "type": "example",
                      "title": "Redirecting Sniping"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Separate person from process symptom.",
                        "Confirm shared goal early.",
                        "Notice whether conflicting team KPIs triggered the friction."
                      ],
                      "title": "Applying Task vs. Relationship Conflict"
                    },
                    {
                      "text": "Weekly clashes between Sales and Billing disappeared once shared onboarding fields were made mandatory before contract close.",
                      "type": "case_study",
                      "title": "Sales-Ops Handoff Feud",
                      "takeaway": "Fix unclear processes instead of lecturing teammates."
                    },
                    {
                      "text": "80% of workplace \"personality clashes\" sit atop missing handoff rules or contradictory team targets.",
