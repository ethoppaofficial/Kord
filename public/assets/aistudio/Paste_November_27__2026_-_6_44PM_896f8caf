                {
                  "id": "4572708d-859d-600e-70ea-bacf784eb0ec",
                  "title": "Blending Numbers Seamlessly Into Narrative",
                  "blocks": [
                    {
                      "text": "Story-First Data Framing",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Follow the rhythm: Story hook creates human care -> One crisp statistic proves the problem is widespread -> Story resolution demonstrates how the fix works. Placing data inside human scale (\"enough wasted hours each month to staff two full clinics\") bridges intellect and empathy effortlessly.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Data Humanization",
                      "text": "Translating cold abstract metrics into familiar human scale or lived consequences inside a narrative frame.",
                      "type": "definition"
                    },
                    {
                      "body": "\"That single typo triggered 1,400 calls—nearly one frantic phone call every three minutes across an entire shift.\"",
                      "type": "example",
                      "title": "Humanizing Support Numbers"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Use no more than 1–2 headline stats inside a short spoken story.",
                        "Convert large opaque totals into relatable per-day or per-team scale.",
                        "Reconnect right back to your central character after citing proof."
                      ],
                      "title": "Applying Blending Numbers Seamlessly Into Narrative"
                    },
                    {
                      "text": "A presenter paused an inspiring mentor tale to read nine demographic percentages aloud.",
                      "type": "case_study",
                      "title": "Spreadsheet Mid-Story Crash",
                      "takeaway": "Focusing strictly on one scaling figure kept tears and strategic conviction unified."
                    },
                    {
                      "text": "Compare before vs. after directly (\"Dropped from 9 days to 4 hours\") so numbers feel kinetic.",
                      "type": "callout",
