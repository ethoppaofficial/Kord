              "lessons": [
                {
                  "id": "16cda052-b47a-0857-e526-a0d2a21fbcee",
                  "title": "Rules vs Supervised vs Unsupervised Learning",
                  "blocks": [
                    {
                      "text": "Problem Types & Simple Baselines First",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Start with clear heuristics or SQL rules first. Use supervised classification (predict categories: churn/no-churn) or regression (predict continuous number: hours to finish) when labeled historical examples exist; use clustering when grouping unlabeled patterns. Always benchmark ML against a dead-simple baseline.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Baseline Heuristic",
                      "text": "A simple, fast rule-based benchmark (like predicting the majority class or 7-day moving average) proving whether a complex ML model actually adds real value.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Any learner inactive > 14 days\" sets a clear 72% baseline before investing in gradient-boosted models.",
                      "type": "example",
                      "title": "Simple Churn Baseline"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Confirm whether clean historical labels exist before choosing supervised ML.",
                        "Build and measure a rule baseline first.",
                        "Verify predictions actually map to an actionable intervention."
                      ],
                      "title": "Applying Rules vs Supervised vs Unsupervised Learning"
                    },
                    {
                      "text": "A 5-line SQL threshold achieved 91% of a proposed ML pipeline’s value in 2 hours instead of 6 weeks.",
                      "type": "case_study",
                      "title": "Unneeded ML Project Saved",
                      "takeaway": "Simplicity wins whenever heuristics suffice."
                    },
                    {
                      "text": "Never build a prediction score unless a team or workflow knows exactly what to do when the score is high.",
                      "type": "callout",
                      "title": "Know What You Will Act On",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why build a simple rule-based baseline before training a complex machine learning model?",
                      "options": [
                        "Required by Python",
                        "Establishes an honest minimum bar proving whether ML complexity delivers meaningful lift",
                        "Cleans CSV headers"
                      ],
                      "explanation": "Simple baselines expose when complexity fails to outperform basic rules.",
                      "correctIndex": 1
                    }
                  ],
