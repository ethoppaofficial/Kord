            {
              "id": "edf119cf-8fb2-5572-37ae-32c145efa471",
              "title": "Module 3: Structured Interview Preparation & STAR Storytelling",
              "lessons": [
                {
                  "id": "7edc4954-7260-c66b-ebe4-2cdfe7d3597b",
                  "title": "The STAR Method Without Rambling",
                  "blocks": [
                    {
                      "text": "20% Context, 60% Your Action, 20% Result",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Allocate STAR timing deliberately: **Situation + Task (2 sentences)** setting stakes quickly, **Action (bulk of the story)** detailing specific steps *you* took using clear \"I\" statements and trade-offs weighed, and **Result (1–2 sentences)** summarizing outcome plus what you learned. Prepare 5 adaptable stories covering initiative, conflict, tight deadlines, failure recovery, and learning quickly.",
                      "type": "paragraph"
                    },
                    {
                      "term": "STAR Framework",
                      "text": "Structured storytelling pattern organizing behavioral answers cleanly into Situation, Task, Action, and Result.",
                      "type": "definition"
                    },
                    {
                      "body": "\"S/T: Course filtering broke on mobile 24h before launch. A: I isolated an overlapping CSS rule, wrote a quick check at 375px, and paired a regression check. R: Zero layout defects shipped and QA passed early.\"",
                      "type": "example",
                      "title": "Crisp Bug Recovery Story"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Spend max 20 seconds on background setup.",
                        "Speak specifically in \"I did X because Y\" rather than hiding behind vague \"we\".",
                        "Practice aloud under 90–120 seconds per answer."
                      ],
                      "title": "Applying The STAR Method Without Rambling"
                    },
                    {
                      "text": "Once the candidate shifted from \"we redesigned it\" to \"I mapped the 3 checkout bottlenecks and wrote the mobile tests\", interviewers leaned in immediately.",
                      "type": "case_study",
                      "title": "Vague Group Answer",
                      "takeaway": "Ownership clarity wins behavioral interviews."
                    },
                    {
                      "text": "When asked about a mistake, pick a real one, own it without blaming teammates, and highlight the system/habit you changed permanently.",
                      "type": "callout",
                      "title": "Prep Failure With Grace",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Where should most of your speaking time go inside a STAR interview story?",
                      "options": [
                        "5 minutes of company history",
                        "The specific Actions you took, decisions made, and reasoning behind them",
                        "Listing software prices"
                      ],
                      "explanation": "Interviewers evaluate your personal judgment, execution, and ownership inside the Action phase.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "A compact bank of practiced STAR stories keeps you calm and authentic under pressure.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "c1475f51-2d0a-4cee-bb71-0d124ef74726",
                      "url": "https://hbr.org/topic/subject/career-planning",
                      "title": "Harvard Business Review: Career & Resume Guides",
                      "position": 1,
                      "resource_type": "articles"
                    },
                    {
                      "id": "f32319a7-8213-47a6-9cca-e717a6adf676",
                      "url": "https://handbook.gitlab.com/handbook/company/culture/all-remote/",
                      "title": "GitLab Handbook: Asynchronous & Remote Collaboration",
                      "position": 2,
                      "resource_type": "guide"
                    }
                  ],
                  "takeaways": [
                    "Draft 5 versatile STAR stories",
                    "Spend 60% of time on your specific Action",
                    "Own mistakes plus systemic fixes honestly"
                  ],
                  "objectives": [
                    "Understand 20% context, 60% your action, 20% result",
                    "Apply the star method without rambling in real career scenarios"
                  ],
                  "est_minutes": 28,
                  "is_required": true,
                  "introduction": "Spending 3 minutes explaining team background leaves 20 seconds for what YOU actually did.",
                  "further_reading": [
                    {
                      "url": "https://hbr.org/topic/subject/career-planning",
                      "title": "Harvard Business Review: Career & Resume Guides",
                      "source": "hbr.org",
                      "resourceType": "Articles"
                    },
                    {
                      "url": "https://handbook.gitlab.com/handbook/company/culture/all-remote/",
                      "title": "GitLab Handbook: Asynchronous & Remote Collaboration",
                      "source": "handbook.gitlab.com",
                      "resourceType": "Guide"
                    }
                  ],
                  "publication_status": "published",
                  "completion_criteria": "Study the core frameworks in \"The STAR Method Without Rambling\", verify the inline knowledge check, and apply the practical checklist."
                },
                {
                  "id": "00addda9-610a-bbab-91e7-cd20d416e770",
                  "title": "Portfolio Walkthroughs & High-Signal Candidate Questions",
                  "blocks": [
                    {
                      "text": "2-Minute Walkthroughs & Thoughtful Reverse Questions",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "When walking through portfolio work live, start with a 30-second high-level outcome overview before diving into constraints and trade-offs—check in (\"Would you like me to go deeper into the architecture or testing flow?\"). Close interviews with specific questions about first-90-day success, team workflows, or real challenges facing the role.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Reverse Interview Question",
                      "text": "A thoughtful candidate question assessing role expectations, team habits, and success metrics while demonstrating genuine domain curiosity.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Looking ahead 90 days into this role, what concrete problem or metric would make you feel confident the new hire succeeded?\"",
                      "type": "example",
                      "title": "Strong Closing Question"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Prepare a 2-minute overview + deeper technical/craft layer for your top project.",
                        "Bring 3 tailored questions never answered by basic homepage scrolling.",
                        "Send a brief, warm thank-you note referencing one specific discussion insight within 24 hours."
                      ],
                      "title": "Applying Portfolio Walkthroughs & High-Signal Candidate Questions"
                    },
                    {
                      "text": "Checking in before diving deep into code details kept a 30-minute panel engaged rather than glazed over on slide 2.",
                      "type": "case_study",
                      "title": "Collaborative Interview Vibe",
                      "takeaway": "Treat walkthroughs as two-way conversations."
                    },
                    {
                      "text": "Saying \"I haven’t used Tool X yet, though here’s how I solved a parallel problem with Tool Y and how I’d ramp up\" builds massive trust.",
                      "type": "callout",
                      "title": "Never Bluff Unknown Answers",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What makes an ending candidate question stand out positively to hiring managers?",
                      "options": [
