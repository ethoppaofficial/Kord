            {
              "id": "55cc9f07-4ac9-40f0-6708-3fb351f2cdda",
              "title": "Module 4: Early Distribution, Launches & Community Pull",
              "lessons": [
                {
                  "id": "820918e6-f4b1-ce57-eccd-10600f655e49",
                  "title": "Launching Repeatedly Over \"One Big Day\"",
                  "blocks": [
                    {
                      "text": "Modular Incremental Launches",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Nobody cares enough to steal an unvalidated rough v1 idea—building quietly behind closed doors simply forfeits months of precious user feedback! Instead, launch lightly and repeatedly: Private 10-User Alpha -> Niche Community Beta -> v1 Launch -> Public Milestone Feature Releases -> Customer Case Spotlight. Every minor release earns fresh learning and community curiosity smoothly.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Stealth Mode Fallacy",
                      "text": "Hiding unvalidated startup builds rigidly secret out of fear competitors will copy ideas, starving early discovery of vital free user testing and trust.",
                      "type": "definition"
                    },
                    {
                      "body": "Week 2: Share raw demo video inside 2 niche Slack groups for 8 honest critiques. Week 5: Open free clean mini-calculator tool publicly. Week 9: Launch paid v1 cohort smoothly with 4 real user testimonials!",
                      "type": "example",
                      "title": "Smart Rolling Launch Cadence"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Share honest early prototypes inside small high-trust niche spaces right from Month 1.",
                        "Capture email waitlists early directly on helpful niche templates or mini-tools.",
                        "Launch cleanly to different adjacent sub-communities across steady months rather than burning one single loud announcement."
                      ],
                      "title": "Applying Launching Repeatedly Over \"One Big Day\""
                    },
                    {
                      "text": "Spent $40k building secretly for 9 months—launched smoothly with press wires to receive 14 signups and zero active repeat users because assumptions missed actual buyer timing.",
                      "type": "case_study",
                      "title": "Silent Stealth Reveal",
                      "takeaway": "Early messy transparent testing beats quiet isolation unconditionally."
                    },
                    {
                      "text": "Execution nuance and intimate user intimacy protect builders infinitely better than secret passwords early on!",
                      "type": "callout",
                      "title": "Ideas Are Cheap; Real User Loops Win",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why does keeping an unvalidated first startup secretly in \"stealth mode\" usually backfire?",
                      "options": [
                        "Servers decay offline",
                        "Starves the founding team of real early buyer corrections while assuming non-existent competitors care before traction exists",
                        "Costs legal patents"
                      ],
                      "explanation": "Speed of genuine market contact outweighs hypothetical secrecy concerns dramatically.",
