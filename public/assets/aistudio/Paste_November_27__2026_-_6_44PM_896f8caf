                    {
                      "term": "Big-Number Callout",
                      "text": "Displaying a commanding statistic prominently paired with crisp 6-word context instead of burying key gains inside sentence bullets.",
                      "type": "definition"
                    },
                    {
                      "body": "Swap 4 long step bullets into four numbered left-to-right stage blocks with concise verbs underneath each step.",
                      "type": "example",
                      "title": "Turning Process Bullets Into Flow"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Detect 4+ stacked bullets—ask \"Is this sequence, comparison, or metric callout?\"",
                        "Match shape to logic (side-by-side for vs., left-right for sequence).",
                        "Trim redundant articles and filler phrasing inside boxes."
                      ],
