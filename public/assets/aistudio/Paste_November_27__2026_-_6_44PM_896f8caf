                },
                {
                  "id": "d62861ab-d1b1-bda0-5bc2-a80a022d812c",
                  "title": "The Scannable Subhead Spine",
                  "blocks": [
                    {
                      "text": "Vertical Subhead Continuity",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "If a hurried visitor skims strictly your hero headline, bold section subheads, and closing CTA, they should still grasp the entire core argument—Problem -> Solution -> Proof -> How it Works -> Offer. Subheadings function as miniature billboards keeping scanners hooked.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Subhead Spine",
                      "text": "Designing every bold section heading so reading subheads alone top-to-bottom communicates your complete persuasive argument cleanly.",
                      "type": "definition"
                    },
                    {
                      "body": "1. Still Chasing Late Invoices Manually? 2. Automate Calm Reminders Clients Actually Pay On. 3. Trusted by 1,200 Freelance Studios. 4. Start Your 14-Day Free Trial.",
                      "type": "example",
                      "title": "Connected Subhead Flow"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Read only your page’s H1 and H2 lines sequentially.",
                        "Eliminate empty labels like \"Features\", \"About Us\", or \"Testimonials\".",
                        "Turn every label into a benefit statement or objection-clearing answer."
                      ],
                      "title": "Applying The Scannable Subhead Spine"
                    },
                    {
                      "text": "An attractive page used bare headings (\"Overview\", \"Pricing\", \"FAQ\"); heatmaps showed readers skipping straight past text blocks.",
                      "type": "case_study",
                      "title": "Generic H2 Dead Zones",
                      "takeaway": "Rewriting section headers as clear promises boosted scroll engagement 45%."
                    },
                    {
                      "text": "Replace \"Testimonials\" with \"Why Finance Teams Switched From Spreadsheets\".",
                      "type": "callout",
                      "title": "Banish Pure One-Word Section Labels",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "How do you test whether page subheadings pull scanners effectively?",
                      "options": [
                        "Check font sizes match",
                        "Read H1 and H2 lines top-to-bottom alone—ensure the full pitch flows clearly",
                        "Verify paragraphs sit below 10 words"
                      ],
                      "explanation": "Independent subhead continuity ensures even fast scanners absorb your full value proposition.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Persuasive subhead spines guarantee scanners absorb your pitch even in ten seconds.",
                  "position": 2,
