            {
              "id": "c7125415-eae3-24aa-f8bd-6d3b549bea0c",
              "title": "Module 4: Probabilistic Thinking & Steelmanning",
              "lessons": [
                {
                  "id": "22f4503e-3958-0533-adf7-ff184e63d8c1",
                  "title": "Base Rates & Realistic Forecasting",
                  "blocks": [
                    {
                      "text": "Combining Inside View & Outside Base Rates",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Inside view estimates each step optimistically (\"Should finish in 10 days\"). Outside view asks: \"Across the last 12 similar client migrations in our company, what percentage finished under 10 days?\" Anchoring on external base rates cuts chronic optimism error in budgets, launch plans, and hiring cycles.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Base-Rate Anchor",
                      "text": "Looking first at objective historical frequency across comparable outside cases before tuning estimates for unique project context.",
                      "type": "definition"
                    },
                    {
                      "body": "Inside guess: 2 weeks. Outside history across last 8 integrations: median 4.5 weeks due to QA cycles. Plan cleanly for 4 weeks.",
                      "type": "example",
                      "title": "Realistic Launch Estimate"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Log actual vs. estimated dates on last 5 projects.",
                        "Pull realistic historical baseline medians first.",
                        "Adjust modestly only with proven structural speedups."
                      ],
                      "title": "Applying Base Rates & Realistic Forecasting"
                    },
                    {
                      "text": "Adding a 30-second base-rate check onto kickoff forms eliminated repeated missed quarter targets across three delivery squads.",
                      "type": "case_study",
                      "title": "End of Chronic Launch Slips",
                      "takeaway": "Historical realism beats optimistic wishful guessing consistently."
                    },
                    {
                      "text": "External historical frequency beats detailed optimistic task-level spreadsheets nearly every time.",
                      "type": "callout",
                      "title": "Ask \"What Happened Last 5 Times?\"",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "How does checking \"outside base rates\" curb project planning optimism?",
                      "options": [
                        "Ignores current team improvements",
                        "Grounds unrealistic step-by-step guesses in true historical outcomes across comparable prior projects",
                        "Doubles project staff automatically"
                      ],
                      "explanation": "Past frequency keeps planning realistic and dependable.",
                      "correctIndex": 1
                    }
