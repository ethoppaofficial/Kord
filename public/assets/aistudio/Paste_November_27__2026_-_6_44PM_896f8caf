                {
                  "id": "7db6ca93-44d2-0dfe-9548-b1076df184c2",
                  "title": "The Rolling 90-Day Reset Rhythm",
                  "blocks": [
                    {
                      "text": "Rolling Planning Cadence",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Keep strategic mission steady across 1–3 years while updating literal operating plans smoothly every 90 days on a **Rolling Forecast** (`always modeling clean next 4 quarters ahead` rather than slamming into December cliffs!). Each Quarter Review takes half a day cleanly: Audit actual drivers vs. targets -> Retire finished goals -> Refresh Scenario C cash buffers -> Lock sharp top 2–3 next bets.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Rolling 4-Quarter Forecast",
                      "text": "Continuously sliding financial and capacity planning forward one new quarter at every quarterly reset rather than relying solely on a shrinking static Jan–Dec annual calendar.",
                      "type": "definition"
                    },
                    {
                      "body": "Late March Half-Day Review: Close Q1 actual conversion math (update 14% target -> real 11% observed), add Q1-next-year column onto forecast sheet, confirm cash triggers, lock Q2 OKRs cleanly!",
                      "type": "example",
                      "title": "Clean Rolling Reset Day"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Hold quarterly resets off everyday reactive chat pings for calm clear reflection.",
                        "Replace flawed forecast assumptions promptly the moment real market conversion numbers speak.",
                        "Keep planning documents strictly lightweight—spend 95% time executing for customers, 5% planning clearly!"
                      ],
                      "title": "Applying The Rolling 90-Day Reset Rhythm"
                    },
                    {
                      "text": "Department heads scrambled desperately in November blowing unneeded budgets just to \"protect next year’s line item\", wasting firm capital.",
                      "type": "case_study",
                      "title": "Rigid Annual Budget Waste",
                      "takeaway": "Rolling milestone-driven planning allocates funds sensibly straight to live opportunities year-round."
                    },
                    {
                      "text": "Never let clever spreadsheets become a comfy excuse procrastinating hard customer conversations!",
                      "type": "callout",
                      "title": "Spend 95% Building, 5% Tuning",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why favor a Rolling Forecast over static fixed Jan–Dec budgets?",
                      "options": [
                        "Prevents changing calendar apps",
                        "Maintains an unbroken 12-month planning horizon while quickly folding real observed unit trends into upcoming decisions",
                        "Avoids tracking cash"
                      ],
                      "explanation": "Continuous rolling updates eliminate year-end forecasting cliffs and rigid outdated assumptions.",
