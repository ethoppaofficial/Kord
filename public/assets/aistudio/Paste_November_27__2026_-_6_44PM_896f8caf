                  "title": "MECE Problem Decomposition",
                  "blocks": [
                    {
                      "text": "Mutually Exclusive, Collectively Exhaustive Trees",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "MECE issue trees slice messy troubles (\"Why did Q3 renewals slip?\") into distinct, non-overlapping buckets covering every possibility—for example Splitting Revenue into New Volume vs. Renewal Rate, then splitting Renewal Rate by Price Pushback, Product Bug Churn, or Missing Check-ins. Clean branches let teams rule out false leads swiftly using quick data checks.",
                      "type": "paragraph"
                    },
                    {
                      "term": "MECE Principle",
                      "text": "Structuring problem sub-parts so categories never overlap ambiguously (Mutually Exclusive) while covering 100% of causes (Collectively Exhaustive).",
                      "type": "definition"
                    },
                    {
                      "body": "Wait Time = Queue Routing Lag + Rep Investigation Time + Escalation Approval Lag. Measure each slice separately.",
                      "type": "example",
                      "title": "Slicing Support Slowness MECE"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Pick one logical cut axis (time sequence, math formula, or segment).",
                        "Check zero overlap between branches.",
                        "Verify all plausible causes fit somewhere cleanly."
                      ],
                      "title": "Applying MECE Problem Decomposition"
                    },
                    {
                      "text": "Splitting total revenue cleanly into Traffic x Signup x Activation x Retention showed traffic rose while Activation collapsed—focusing entire sprint accurately.",
                      "type": "case_study",
                      "title": "Pinpointing Silent Revenue Leaks",
                      "takeaway": "Issue trees shrink giant chaos within ten minutes."
                    },
                    {
                      "text": "Revenue = Volume x Margin or Time = Setup + Work + Wait guarantee clean MECE splits naturally.",
                      "type": "callout",
                      "title": "Follow Math Formulas Where Possible",
                      "variant": "tip"
                    },
