                },
                {
                  "id": "74724c9f-1d95-a8e1-1075-53daa62872ff",
                  "title": "Completion Rates, Length & Sample Skew",
                  "blocks": [
                    {
                      "text": "Clean Sampling & Short Focused Polls",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Every extra question silently drops real completion rates and degrades late-item attention (`straight-lining`). Cap operational surveys strictly at **5–8 laser-focused items (~3 minutes)**, place screening/context up front while keeping demographics gently optional at the end, and examine **WHO answered** honestly (Did 80% come purely from super-fans in one giveaway group while silent churned users stayed invisible?).",
                      "type": "paragraph"
                    },
                    {
                      "term": "Selection / Survivorship Bias",
                      "text": "Drawing skewed conclusions about an entire market solely from respondents easily reached—such as happy loyal social followers—while systematically missing frustrated non-buyers or churned leavers.",
                      "type": "definition"
                    },
                    {
                      "body": "Polling your own active Instagram followers `\"What do you think of our pricing?\"` wildly underestimates cold outsider confusion—always recruit outside warm fan pools!",
                      "type": "example",
                      "title": "Spotting Fan-Echo Surveys"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Trim every single question failing the test: `\"Which exact decision changes depending on option A vs option B?\"`",
                        "Keep open-ended text boxes tightly sparse (`1–2 max`) so respondents don’t burn out.",
                        "Audit response channel source cleanly to check non-response skew!"
                      ],
                      "title": "Applying Completion Rates, Length & Sample Skew"
                    },
                    {
                      "text": "Surveying active annual loyalty members gave cheerful feedback supporting a 20% price hike—yet new prospects bounced cleanly off the updated checkout page because newcomer trust differed starkly from loyal veterans!",
                      "type": "case_study",
                      "title": "Biased Pricing Poll",
                      "takeaway": "Always segment loyal existing users distinctly away from fresh cold target segments!"
                    },
                    {
                      "text": "Opening honestly with `\"4 quick multiple-choice questions (~90 seconds)\"` lifts response rates substantially cleanly!",
                      "type": "callout",
                      "title": "State Honest Completion Minutes",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why can polling strictly current loyal newsletter subscribers badly mislead new-product pricing research?",
                      "options": [
                        "Newsletter emails lag",
                        "Survivorship/Selection bias reflects enthusiastic existing insiders rather than skeptical unfamiliar cold buyers",
                        "Subscribers dislike surveys"
                      ],
                      "explanation": "Insiders hold pre-built trust cold prospects lack completely when judging unfamiliar offers.",
                      "correctIndex": 1
                    }
