                {
                  "id": "c13a9b3d-faac-2ce0-8a51-022855103053",
                  "title": "Natural Expansion & Net Revenue Retention (NRR)",
                  "blocks": [
                    {
                      "text": "Needs-Triggered Cross-Sell & Referral Timing",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "**Net Revenue Retention (`NRR`)** measures total recurring revenue retained from an existing cohort after accounting for churn MINUS expansion upgrades (`Seats + Upgrades + Add-ons`). When `NRR > 100%`, businesses literally grow cleanly even with zero brand-new cold customers! Pitch upgrades strictly when verified usage hits natural ceiling limits OR right after winning verified QBR praise—never ahead of solid core value.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Net Revenue Retention (NRR)",
                      "text": "Percentage of recurring revenue remaining from an existing customer cohort after subtracting cancellations/downgrades and adding expansions/upgrades (`>100%` signals self-compounding cohort growth).",
                      "type": "definition"
                    },
                    {
                      "body": "Client smoothly runs at 95% seat utilization AND hits strong QBR savings -> Timely helpful note: `\"Noticed two Marketing coordinators keep borrowing logins—want clean separate seats bundled cleanly under existing rates ahead of Q4?\"`",
                      "type": "example",
                      "title": "Ethical Triggered Expansion"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Wait rigidly until Core Health = Green ahead of suggesting upgrades or referrals—fix wobbles FIRST!",
                        "Ask warmly for peer referrals strictly immediately after high-satisfaction wins (`CSAT 5/5` or enthusiastic QBR feedback).",
                        "Reward thoughtful referrals gracefully (`account credits, charitable match, VIP beta peeks`) keeping terms simple."
                      ],
                      "title": "Applying Natural Expansion & Net Revenue Retention (NRR)"
                    },
                    {
                      "text": "Pitching advanced multi-department bundles to a client still struggling to fix basic onboarding bugs sparked immediate full contract cancellation.",
                      "type": "case_study",
                      "title": "Tone-Deaf Premature Upsell",
                      "takeaway": "Green Health ALWAYS gates Expansion outreach cleanly!"
                    },
                    {
                      "text": "Tracking `(Starting Cohort ARR + Expansion - Contraction - Churn) / Starting Cohort ARR` highlights retention strength far better than gross sales noise!",
                      "type": "callout",
                      "title": "Compute Cohort NRR Quarterly",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What strict prerequisite MUST hold before customer success teams introduce upgrade or cross-sell options to an account?",
                      "options": [
