            {
              "id": "23fdbb2a-006f-22d6-b111-96453bb7a7cb",
              "title": "Module 5: Executive Summaries, Tone & Polish",
              "lessons": [
                {
                  "id": "0ece36f7-00d8-e8c1-1277-0b845127b321",
                  "title": "Mastering the Executive Summary",
                  "blocks": [
                    {
                      "text": "Self-Contained Condensation",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "An authentic Executive Summary mirrors the entire report in miniature (~10% of total body length): one line of context/scope, headline metrics and core root findings, and the top prioritized recommendations with estimated cost/timeline. Crucially, NEVER introduce fresh claims or numbers in an Executive Summary missing from the body.",
                      "type": "paragraph"
                    },
                    {
                      "term": "No-New-Data Rule",
                      "text": "Strict reporting discipline guaranteeing every statistic, recommendation, and scope detail summarized upfront appears verified inside the main body below.",
                      "type": "definition"
                    },
                    {
                      "body": "Contains: (1) Why we ran the review, (2) Key quantified headline gap (`34% delay on handoff`), (3) Recommended fix (`Rec 1–2`), (4) Resource need (`2 weeks dev`).",
                      "type": "example",
                      "title": "Executive Summary Checklist"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Draft the Executive Summary strictly LAST after finalizing all body figures.",
                        "Verify numeric figures word-for-word against body charts.",
                        "Keep summary tone crisp, scannable, and bullet-assisted for fast board review."
                      ],
                      "title": "Applying Mastering the Executive Summary"
                    },
                    {
                      "text": "Late edits updated body findings from 14% to 19%, yet nobody refreshed page-one Executive Summary still printing 14%.",
                      "type": "case_study",
                      "title": "Summary-Body Mismatch Slip",
                      "takeaway": "Running a post-edit page-one consistency pass saves embarrassing review corrections."
                    },
                    {
                      "text": "Wait until final numbers stabilize before writing your opening Executive Summary.",
                      "type": "callout",
                      "title": "Write Page One Last",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Which rule strictly governs content inside a reliable Executive Summary?",
                      "options": [
                        "Tease findings vaguely so readers open page 8",
                        "Every claim and statistic summarized upfront must match verified data detailed inside the main report",
                        "Add fresh bonus numbers for flair"
                      ],
                      "explanation": "Summaries condense verified body evidence faithfully rather than teasing or inventing claims.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Tightly matched executive summaries earn instant authority across busy leadership.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "556f9dc4-d90a-48ac-ac8b-ce4ec54e030b",
                      "url": "https://developers.google.com/tech-writing",
                      "title": "Google Technical Writing Courses",
                      "position": 1,
                      "resource_type": "documentation"
                    },
                    {
                      "id": "58759c32-e150-405b-b449-6772141d052b",
                      "url": "https://owl.purdue.edu/",
                      "title": "Purdue OWL Academic & Research Guides",
                      "position": 2,
                      "resource_type": "guide"
                    }
                  ],
                  "takeaways": [
                    "Draft opening summaries strictly after final body polish",
                    "Include scope, core findings, and priority actions together",
                    "Audit 100% numeric consistency top to bottom"
                  ],
                  "objectives": [
                    "Explain self-contained condensation",
                    "Apply mastering the executive summary cleanly"
                  ],
                  "est_minutes": 28,
                  "is_required": true,
                  "introduction": "Many analysts write \"Introductions\" masquerading as Executive Summaries—leaving out actual findings and recommendations completely.",
                  "further_reading": [
                    {
