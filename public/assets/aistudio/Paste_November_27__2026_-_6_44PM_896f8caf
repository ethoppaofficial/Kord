              "lessons": [
                {
                  "id": "f3361733-0bde-0dc9-f835-7cfdc1e1c11f",
                  "title": "Simple Living RAID Logs That Prevent Surprises",
                  "blocks": [
                    {
                      "text": "Risks vs. Issues & Early Warning Triggers",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Effective managers maintain a tight active **Top-5 RAID List**: **Risks** (`things that MIGHT go wrong -> prevent early!`), **Assumptions** (`beliefs accepted without proof yet -> validate Day 3!`), **Issues** (`broken right now -> assign immediate owner!`), and **Dependencies** (`waiting on outside teams/vendors`). Every critical Risk pairs an **Early Warning Trigger** with concrete preventive steps!",
                      "type": "paragraph"
                    },
                    {
                      "term": "RAID Log",
                      "text": "Compact living project tracker separating Risks (future threats), Assumptions (untested beliefs), Issues (current active blockers), and Dependencies (external handoffs).",
                      "type": "definition"
                    },
                    {
                      "body": "Risk: Primary API vendor sandbox throttles exports. Preventive Action (`Week 1`): Run real payload volume test Wednesday (`Early Trigger`) instead of waiting until Integration Week 5!",
                      "type": "example",
                      "title": "Sharp Preventive Risk Entry"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Keep active focus tight strictly around the Top 5–7 highest-impact threats—never bury teams under 60 trivial guesses.",
                        "Test fragile **Assumptions** (`\"Assuming clean CSV formatting exists\"`) FIRST during Week 1 before designing around garbage!",
                        "Review top Risks for literally 5 minutes every weekly team sync!"
                      ],
                      "title": "Applying Simple Living RAID Logs That Prevent Surprises"
                    },
                    {
                      "text": "A 5-week analytics rollout assumed CRM customer IDs matched billing emails cleanly—discovering Week 4 that 40% didn’t match froze launch cleanly by three weeks.",
                      "type": "case_study",
                      "title": "Fatal Unverified Assumption",
                      "takeaway": "Testing dirty data assumptions Day 2 costs 30 minutes and saves weeks!"
                    },
                    {
                      "text": "Don’t build pretty polish atop untested external data or unproven partner specs—spike the ugliest technical/vendor unknown Week 1!",
                      "type": "callout",
                      "title": "Validate Riskiest Assumptions First",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What separates a risky \"Assumption\" inside a RAID log from a confirmed \"Issue\"?",
                      "options": [
                        "Severity color only",
                        "An Assumption is an unproven belief carrying hidden failure danger if false (must test early!), whereas an Issue is an active problem happening right now",
                        "Issues carry lower priority"
                      ],
                      "explanation": "Surfacing and testing dangerous assumptions during Week 1 prevents sudden devastating Week-5 issues.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Focused weekly risk hygiene defuses crises peacefully weeks before launch stress peaks.",
                  "position": 1,
                  "resources": [
