                {
                  "id": "98b40e38-e917-250c-fc7f-09d59ff89908",
                  "title": "Punctuation Precision: Hyphens, Dashes & Quotes",
                  "blocks": [
                    {
                      "text": "Compound Modifiers & Dash Discipline",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Join compound adjectives standing BEFORE a noun with a hyphen (`a well-tested process`, `high-trust team`, `two-year contract`) so readers don’t stumble over double words—skip the hyphen cleanly AFTER the noun (`the process is well tested`) and never hyphenate `-ly` adverbs (`widely accepted policy`). Distinguish hyphens (`well-known`), en-dashes (`2024–2026` ranges), and em-dashes (`clarity—not speed—wins`) purposefully.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Compound Modifier Rule",
                      "text": "Hyphenating two or more words acting together as one unified descriptor immediately before a noun (`\"short-term fix\"`, `\"data-driven brief\"`), while omitting hyphens after verbs unless dictionary-fixed.",
                      "type": "definition"
                    },
                    {
                      "body": "Ambiguous: \"small business owner\" vs. \"small-business owner\". Fixed clearly: \"low-cost onboarding plan\" vs. \"onboarding plan with low cost\".",
                      "type": "example",
                      "title": "Solving Reading Stumbles With Hyphens"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Test before-noun pairs: if neither word alone modifies the noun correctly, hyphenate them together (`\"real-time report\"`).",
                        "Check `-ly` adverbs never carry accidental hyphens (`\"highly rated tool\"`, not `\"highly-rated tool\"`).",
                        "Enforce uniform em-dash spacing globally (either closed `word—word` or spaced `word — word`, never mixed!)."
                      ],
                      "title": "Applying Punctuation Precision: Hyphens, Dashes & Quotes"
                    },
                    {
                      "text": "Reading `\"five year old contracts\"` tripped readers momentarily before settling `\"five-year-old contracts\"` vs `\"five year-old contracts\"`.",
                      "type": "case_study",
                      "title": "Confused Financial Headline",
                      "takeaway": "Crisp compound hyphenation prevents garden-path reading stumbles instantly."
                    },
                    {
                      "text": "Audit document quotes globally so curly typographic quotes never collide weirdly with straight programmer apostrophes.",
                      "type": "callout",
                      "title": "Smart vs. Straight Quotes",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Which phrase uses compound hyphenation strictly accurately?",
                      "options": [
