            {
              "id": "f2f875a1-51a9-d831-2eaf-ae6eebe030e9",
              "title": "Module 4: Rapid Testing, Trade-Offs & Guardrail Metrics",
              "lessons": [
                {
                  "id": "e0409d86-41b0-1465-4498-9ecfbedfded5",
                  "title": "Testing Fixes Fast Before Full Rollout",
                  "blocks": [
                    {
                      "text": "Cheap Reversible Pilot Loops",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Before rebuilding full pipelines or rewriting global SOPs, run a tight 7-to-14-day pilot on one slice (20 new signups, 1 region, or 2 support reps) with explicit baseline comparison and clear go/adjust/kill thresholds. Discovering edge gaps on 20 cases saves cleaning up 2,000 later.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Guardrail Metric",
                      "text": "A secondary health metric monitored alongside primary targets to confirm solving Problem A didn't quietly wreck Quality or Safety B.",
                      "type": "definition"
                    },
                    {
                      "body": "Goal: cut support reply time under 2 hours (Target) WITHOUT increasing ticket reopen rates above 6% (Guardrail).",
                      "type": "example",
                      "title": "Speed With Quality Guardrail"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Define primary win metric + secondary quality guardrail.",
                        "Test on small representative slice first.",
                        "Compare cleanly against prior baseline weeks."
                      ],
                      "title": "Applying Testing Fixes Fast Before Full Rollout"
                    },
                    {
                      "text": "Tracking \"reopen rate\" guardrail exposed how a canned macro speed-up caused half-answered customers to reply angry twice—prompting better clarity before scaling.",
                      "type": "case_study",
                      "title": "Prevented Bad Policy Rollout",
                      "takeaway": "Guardrail metrics keep incentives honest permanently."
                    },
                    {
                      "text": "Measuring speed alone breaks accuracy fast; guardrails balance velocity safely.",
                      "type": "callout",
                      "title": "Always Pair Speed Goals With Quality Checks",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why pair every primary speed/volume KPI with a secondary Guardrail Metric?",
                      "options": [
                        "Fills empty spreadsheet rows",
                        "Catches harmful shortcuts where rushing primary numbers silently degrades accuracy, satisfaction, or cost",
                        "Slows pilots purposefully"
                      ],
                      "explanation": "Balanced metrics protect real holistic user health cleanly.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Pilot discipline paired with guardrails ensures clean reliable progress.",
                  "position": 1,
                  "resources": [
