                },
                {
                  "id": "0d9caf77-0949-ee5c-7dc3-a7b16160f1c3",
                  "title": "Action-Led Meeting Recaps",
                  "blocks": [
                    {
                      "text": "Decisions, Owners & Deadlines Formatting",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Colleagues revisit meeting notes for three items only: What did we decide? Who owns what next? What remains unresolved? Structuring recaps into those exact three buckets takes under five minutes and turns conversation into tracked execution.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Action Item Tuple",
                      "text": "Every follow-up item written as three mandatory components: Concrete Deliverable + Single Owner Name + Target Date.",
                      "type": "definition"
                    },
                    {
                      "body": "Decision: Launch beta to 50 users first. Action: Tariq to export user cohort list by Thu 4 PM. Open Question: Support staffing for weekend window.",
                      "type": "example",
                      "title": "Action-Led Recap Line"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Split capture strictly into Decisions, Action Items, and Open Questions.",
                        "Assign one primary owner—never \"Team\"—to each action.",
                        "Send recaps within 2 hours while details remain fresh."
                      ],
                      "title": "Applying Action-Led Meeting Recaps"
                    },
                    {
                      "text": "\"Follow up on onboarding form\" sat undone for two weeks because three people assumed someone else grabbed it.",
                      "type": "case_study",
                      "title": "Ownerless Action Drift",
                      "takeaway": "Adding explicit single owners pushed task completion past 90%."
                    },
                    {
                      "text": "If two colleagues collaborate, name one accountable driver who makes sure it ships.",
                      "type": "callout",
                      "title": "One Owner Rule",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What makes a meeting action item unreliable?",
                      "options": [
                        "Naming two dates",
                        "Assigning ownership vaguely to \"everyone\" or omitting a due date",
                        "Using bullet lists"
                      ],
                      "explanation": "Shared ownership without a primary driver creates diffusion of responsibility.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Structured recaps convert meeting talk into predictable delivery.",
                  "position": 2,
                  "resources": [
                    {
                      "id": "aeea39f2-2044-48e6-a46f-68b44fc1383c",
                      "url": "https://www.plainlanguage.gov/guidelines/",
                      "title": "Plain Language Guidelines",
