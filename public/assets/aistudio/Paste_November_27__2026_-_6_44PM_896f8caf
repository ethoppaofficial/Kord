                {
                  "id": "ee98eb21-f83a-6623-70a2-041f5c649351",
                  "title": "Rescuing Yellow Accounts & Respectful Exit Interviews",
                  "blocks": [
                    {
                      "text": "Diagnostic Value Re-Alignment & Gracious Exits",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "When Health slips Yellow **60–90 days early**, skip sales-y pitches and send a candid executive/success review note: `\"Noticed usage dipped after Q2 shifts—let’s take 15 mins purely mapping how to get your team full ROI from unused features you already pay for.\"` When an account genuinely must leave (`budget shutdown, acquired`), handle exits warmly and gracefully—capturing honest unvarnished **Exit Feedback**, returning clean data smoothly, and welcoming peaceful future boomerangs!",
                      "type": "paragraph"
                    },
                    {
                      "term": "Graceful Boomerang Exit",
                      "text": "Treating departing canceling customers with zero guilt, frictionless export support, and warm sincere gratitude so they gladly return or refer peers cleanly once needs rebound months later.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Hi Jordan — Checking in proactively ahead of Q4: noticed your team hasn’t switched on automated invoice tags yet, which usually recovers 4 hrs/wk. Happy to jump on a 15-min setup pass with your coordinator Tuesday?\"",
                      "type": "example",
                      "title": "Value-First Yellow Rescue"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Intervene cleanly 60–90 days ahead of renewal windows—never wait for cancellation notice day!",
                        "Offer helpful re-onboarding clinics instead of instant panic discounting.",
                        "Make canceling dignified and effortless while logging genuine structured root exit reasons (`Price vs Missing Fit vs Budget Shutdown vs Poor Support`)."
                      ],
                      "title": "Applying Rescuing Yellow Accounts & Respectful Exit Interviews"
                    },
                    {
                      "text": "Forcing unhappy users through three hidden confirmation mazes and defensive phone retention calls sparked furious public warnings blocking referrals for years.",
                      "type": "case_study",
                      "title": "Hostile Exit Wall Backlash",
                      "takeaway": "Dignified gracious exits bring astonishing numbers of former buyers happily back within 12 months!"
                    },
                    {
                      "text": "Almost 15–25% of consumer/SMB churn stems simply from expired credit cards (`Dunning Failure`)—clean gentle pre-expiry reminders recover painless revenue instantly!",
                      "type": "callout",
                      "title": "Track Involuntary Churn Separately",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What makes proactive 60-day pre-renewal value workshops radically more effective than last-minute cancellation-call 40% discounts?",
                      "options": [
                        "Discounts break budgets cleanly",
