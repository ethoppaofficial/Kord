                {
                  "id": "a8dd4590-8958-ce7d-6a22-3fc088c0e086",
                  "title": "Flawless Sales-to-Onboarding Handoff",
                  "blocks": [
                    {
                      "text": "Preserving Discovery Intelligence Post-Sale",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Every brilliant detail unearthed across sales—urgent core frustrations, skeptical stakeholders, sensitive custom boundaries, exact target win metrics—must flow seamlessly straight into **Customer Success / Delivery** via a crisp **Handoff Brief** AND a warm 5-minute live intro! Never over-promise silent custom side-favors verbally without logging them explicitly in contracts and handoffs.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Sales-to-Delivery Handoff Brief",
                      "text": "A concise structured internal note transferred straight upon signature documenting exact Buyer Success Metrics, Stated Pains, Key Stakeholders, Sensitive Politics, and Signed Scope Exclusions so delivery starts informed Day 1.",
                      "type": "definition"
                    },
                    {
                      "body": "Kickoff call opens cleanly: \"Jordan briefed me thoroughly on your Thursday payroll friction and target Nov 1 cutoff—let’s skip re-explaining everything and dive straight into importing step one!\"",
                      "type": "example",
                      "title": "High-Trust Warm Welcome"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Prohibit undocumented secret verbal side promises—put agreed items cleanly inside written SOWs cleanly.",
                        "Summarize Top 3 Success Targets + Sensitive Risk Flags concisely inside shared CRM handoff templates before kickoff.",
                        "Check back casually Day 45 personally (\"How did onboarding smooth out against expectations?\")—opening warm referrals effortlessly!"
                      ],
                      "title": "Applying Flawless Sales-to-Onboarding Handoff"
                    },
                    {
                      "text": "Sales promised `\"Zero manual CSV work ever\"`, failed to inform engineering, and onboarding immediately sent a 10-page manual setup template—triggering instant Week-2 refund fury!",
                      "type": "case_study",
                      "title": "Post-Close Whiplash Churn",
                      "takeaway": "Tight aligned Sales-Delivery truth ensures signed buyers turn cleanly into thrilled lifetime promoters!"
                    },
                    {
                      "text": "Staying present the first 5 minutes of Kickoff Call bridges personal trust seamlessly across to customer success partners cleanly!",
                      "type": "callout",
                      "title": "Intro Delivery Warmly Before Signing Off",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What guarantees newly signed customers experience instant confidence rather than \"starting over from scratch\" during Onboarding Call #1?",
                      "options": [
                        "Mailing automated policy PDFs",
                        "Transferring a crisp Sales Handoff Brief detailing diagnosed pain goals, key stakeholders, and scope boundaries ahead of warm Kickoff intro",
                        "Offering zero kickoff calls"
                      ],
                      "explanation": "Continuity honors the customer’s discovery investment and sets early delivery wins cleanly in motion.",
