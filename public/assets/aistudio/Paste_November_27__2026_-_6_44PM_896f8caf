                {
                  "id": "37c3b27f-95b1-a87a-97f7-518e599409ae",
                  "title": "Writing Analytical Callouts & Signposting",
                  "blocks": [
                    {
                      "text": "Lead-In, Insight Title & Takeaway Triad",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Anchor every table or graphic inside prose with three smooth moves: (1) Brief lead-in introducing scope (\"Table 2 compares onboarding completion across Q2 cohorts\"), (2) Action-title heading highlighting main trend (\"Cohort B Retention Outpaced Cohort A by 19 Points\"), and (3) Concise interpretive sentence explaining WHY it occurred and what follows next.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Figure Narrative Triad",
                      "text": "Introducing a visual by context, summarizing its headline insight visually, and interpreting operational implications immediately below.",
                      "type": "definition"
                    },
                    {
                      "body": "\"As shown in Figure 1, mobile abandonments peak specifically on step three (52%), matching the unvalidated postcode bug fixed Tuesday.\"",
                      "type": "example",
                      "title": "Interpreting Without Over-Reciting"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Always reference figures explicitly (`See Table 1`) right ahead of where they appear.",
                        "Summarize pattern direction rather than typing out every single row numerically.",
                        "Call out notable anomalies or outliers honestly rather than glossing over them."
                      ],
                      "title": "Applying Writing Analytical Callouts & Signposting"
                    },
                    {
                      "text": "A smooth monthly upward trend chart showed one bizarre February plunge with zero explanatory footnote.",
                      "type": "case_study",
                      "title": "Unexplained Outlier Chart",
                      "takeaway": "Adding one brief note explaining a 6-day warehouse snow closure saved 15 minutes of executive guessing."
                    },
                    {
                      "text": "Readers immediately zoom onto jagged dips or spikes—briefly name known external factors directly inside captions.",
                      "type": "callout",
                      "title": "Explain Anomalies Explicitly",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "How should report prose accompany a clear visual table or chart?",
                      "options": [
                        "Avoid mentioning the chart completely",
                        "Introduce context, summarize core trend insight, and explain notable anomalies briefly without repeating every cell",
                        "Read every single cell numerically in paragraphs"
                      ],
                      "explanation": "Synthesizing core drivers and outliers maximizes value without tedious repetition.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Cohesive framing turns figures into unambiguous narrative anchors.",
                  "position": 2,
                  "resources": [
                    {
                      "id": "864e5497-9c63-4352-a936-54914fcb0bbb",
                      "url": "https://owl.purdue.edu/",
                      "title": "Purdue OWL Academic & Research Guides",
