              "lessons": [
                {
                  "id": "828a3e52-f9c0-e78a-d199-dcac94b407e9",
                  "title": "Reflective Meaning Over Parroting",
                  "blocks": [
                    {
                      "text": "Synthesizing Core Meaning",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Parroting repeats verbatim words (\"So you're mad about Friday's form\"). Genuine reflection distills essence in your own crisp words (\"It sounds like changing form fields late without QA risk checks threatens launch accuracy—am I tracking right?\"). Done gently, it lets speakers correct tiny nuances right away.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Essence Paraphrase",
                      "text": "Restating the speaker's core concern and constraint concisely in fresh words to confirm shared comprehension.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Got it—the delay itself isn't the blocker, it's not knowing whether Legal approves by Thursday. Did I read that cleanly?\"",
                      "type": "example",
                      "title": "Natural Summary Check"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Distill core claim + core stake concisely.",
                        "Use natural openings (\"If I'm tracking...\", \"Sounds like...\").",
                        "Check accuracy modestly so they feel invited to refine."
                      ],
                      "title": "Applying Reflective Meaning Over Parroting"
                    },
                    {
                      "text": "Reflective summarizing caught a nuance where the client cared deeply about GDPR storage location, not price.",
                      "type": "case_study",
                      "title": "Saved Partnership Review",
                      "takeaway": "Reflecting accurately uncovers unspoken priorities fast."
                    },
                    {
                      "text": "Vary \"So what I hear you saying...\" with warmer natural language (\"Let me check if I caught the crux...\").",
                      "type": "callout",
                      "title": "Drop Robotic Stems",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What distinguishes true paraphrasing from robotic parroting?",
                      "options": [
                        "Repeating exact sentences louder",
                        "Distilling core meaning and stakes concisely in your own clear words",
                        "Changing the topic completely"
                      ],
                      "explanation": "Fresh concise distillation proves authentic mental engagement.",
