          "id": "e5bb191c-155b-4478-ab83-450a3ae4777a",
          "slug": "academic-writing-evidence-synthesis",
          "title": "Academic Writing & Evidence Synthesis",
          "phases": [
            {
              "id": "7ddfeb80-4448-5be6-3d34-5c93fa32c903",
              "title": "Module 1: Arguable Theses & Research Questions",
              "lessons": [
                {
                  "id": "c7566161-31dc-2cd8-5490-e9ffb660ec40",
                  "title": "Beyond Summary: Making an Arguable Claim",
                  "blocks": [
                    {
                      "text": "Tension, Scope & Contestability",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Academic arguments enter an active scholarly conversation: they take a clear analytical stance someone reasonable might counter with alternate evidence. A tight thesis names WHAT relationship exists, WHY/HOW it operates under bounded conditions, and WHAT significance follows.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Contestable Thesis",
                      "text": "An analytical claim asserting an interpretive, causal, or comparative relationship that requires evidence to verify rather than simple dictionary consensus.",
                      "type": "definition"
                    },
                    {
                      "body": "Factual summary: \"Urban heat islands raise city temperatures.\" Arguable thesis: \"While tree canopy targets lower midday surface heat, pairing reflective street coatings reduces nighttime retention three times faster in dense transit corridors.\"",
                      "type": "example",
                      "title": "Weak vs. Arguable Thesis"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Narrow population, timeframe, and geographic/system scope aggressively.",
                        "Test your claim by asking \"Could an informed scholar reasonably argue the opposite?\"",
                        "End introduction cleanly on the focused claim + analytical roadmap."
                      ],
                      "title": "Applying Beyond Summary: Making an Arguable Claim"
                    },
                    {
                      "text": "An undergraduate paper summarized fifteen water policies chronologically with zero organizing argument, earning middling evaluation despite thorough reading.",
                      "type": "case_study",
                      "title": "Descriptive Essay Trap",
                      "takeaway": "Inserting an evaluative comparison thesis organizing policies by cost-per-gallon shifted the entire paper into A-grade synthesis."
                    },
                    {
                      "text": "Subordinating a fair counter-view (\"Although [alternative], [your stance] holds because [mechanism]\") guarantees instant argumentative depth.",
                      "type": "callout",
                      "title": "Use the \"Although X, Y because Z\" Lens",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Which statement works best as a strong academic thesis?",
                      "options": [
                        "Remote schooling uses computers and video tools.",
                        "Although live video lectures aid initial orientation, asynchronous worked examples raise retention significantly more for first-year quantitative learners.",
                        "Online courses are very popular today."
                      ],
                      "explanation": "It balances a nuanced concession against a specific, testable, evidence-requiring claim.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Focused contestable theses anchor entire papers into purposeful analytical inquiry.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "a46f9d99-a72d-49db-af6f-0f7ca7d274b9",
                      "url": "https://developers.google.com/tech-writing",
                      "title": "Google Technical Writing Courses",
                      "position": 1,
                      "resource_type": "documentation"
                    },
                    {
                      "id": "ce50cbc2-2dde-449b-a2d6-d43fb5d52df7",
                      "url": "https://owl.purdue.edu/",
                      "title": "Purdue OWL Academic & Research Guides",
                      "position": 2,
                      "resource_type": "guide"
                    }
                  ],
                  "takeaways": [
                    "Trade pure fact summary for arguable causal/comparative claims",
                    "Bound scope clearly by context and population",
                    "Incorporate realistic counter-perspectives cleanly"
                  ],
                  "objectives": [
                    "Explain tension, scope & contestability",
                    "Apply beyond summary: making an arguable claim cleanly"
                  ],
                  "est_minutes": 28,
                  "is_required": true,
                  "introduction": "\"Renewable energy has grown rapidly since 2015\" states an undisputed fact—not an academic thesis anyone can meaningfully examine.",
                  "further_reading": [
                    {
                      "url": "https://developers.google.com/tech-writing",
                      "title": "Google Technical Writing Courses",
                      "source": "developers.google.com",
                      "resourceType": "Documentation"
                    },
                    {
