              "lessons": [
                {
                  "id": "d0435dc7-bcbb-d530-1c19-5cae5fc5a352",
                  "title": "Listening to Understand vs. Listening to Reply",
                  "blocks": [
                    {
                      "text": "Silencing Mental Rehearsal",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "True active listening suspends your inner narrator while the other person finishes their complete thought. Common derailers—like turning someone's stress into your own story (\"Oh, that happened to me too!\"), jumping immediately into advice, or evaluating before finishing—cut speakers off right before they share the real core issue.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Premature Fixing",
                      "text": "Offering rushed solutions inside the first 60 seconds before understanding whether the speaker needs brainstorming, empathy, or constraint clarification.",
                      "type": "definition"
                    },
                    {
                      "body": "Instead of \"Just send them an email!\", wait and ask: \"What feels trickiest about approaching them on this?\"",
                      "type": "example",
                      "title": "Pause Before Fixing"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Keep posture relaxed and gaze warm.",
                        "Wait one full second after they pause before starting.",
                        "Notice when your mind tries jumping to personal anecdotes."
                      ],
                      "title": "Applying Listening to Understand vs. Listening to Reply"
                    },
                    {
                      "text": "A junior rep talked 65% of discovery calls until switching to open inquiry; prospect sharing revealed budget expansion nobody had mentioned.",
                      "type": "case_study",
                      "title": "Discovery Call Turnaround",
                      "takeaway": "Less talking literally discovers hidden commercial opportunities."
                    },
                    {
                      "text": "Counting \"one-thousand-one\" after a speaker stops lets them add their deepest point—which often comes right after a brief pause.",
                      "type": "callout",
                      "title": "Bite Your Tongue Gently for One Beat",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What happens most commonly when a listener jumps into fast advice in the first minute?",
                      "options": [
                        "The speaker feels deeply understood",
                        "The real underlying constraint stays hidden while generic fixes miss the mark",
                        "Conversations finish with better alignment"
                      ],
                      "explanation": "Rushed fixes usually solve the symptom rather than the core problem.",
                      "correctIndex": 1
                    }
