              "lessons": [
                {
                  "id": "006c9719-490c-73ed-1474-16cf179c55cb",
                  "title": "Partnerships Fail Without Rep Enablement",
                  "blocks": [
                    {
                      "text": "Frictionless 2-Minute Partner Toolkits",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Frontline partner reps hold 50 tasks daily—never hand them a 40-page training manual! Build one sharp **1-Page Cheat Sheet**: exact \"Spot the Trigger\" clues (`\"When your customer sighs about spreadsheet reconciliation delays...\"`), 2 clear disqualification warnings (saving wasted intros), and a ready-to-paste 3-line warm email intro template they fire in 15 seconds.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Partner Trigger Phrase",
                      "text": "Specific exact words a partner hears naturally inside client calls signaling ideal warm moment to introduce your solution effortlessly.",
                      "type": "definition"
                    },
                    {
                      "body": "Give partner reps exact copy-paste blurb: `\"Hi Maya — Copying Jordan at ClearLedger here; they solved exact inventory CSV headaches we discussed cleanly for two peers in 10 days. Worth a 15-min peek?\"`",
                      "type": "example",
                      "title": "Copyable Intro Snippet"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Keep partner playbooks down strictly onto ONE single scannable visual card.",
                        "Train partner reps in quick 15-minute live story roleplays centered on THEIR client wins—not dry product demos.",
                        "Celebrate and highlight the very first closed joint win loudly back to their team channel immediately!"
                      ],
                      "title": "Applying Partnerships Fail Without Rep Enablement"
                    },
                    {
                      "text": "Two mid-sized SaaS firms celebrated an alliance publicly yet closed just 1 joint sale in six months because reps didn’t know when or how to mention it.",
                      "type": "case_study",
                      "title": "Drawer-Collected Partnership",
                      "takeaway": "Running a crisp 15-min rep lunch + sharing 3 exact customer trigger lines sparked 11 referrals next month."
                    },
                    {
                      "text": "The harder it feels to write a warm intro email from memory, the fewer intros partner reps ever send!",
                      "type": "callout",
                      "title": "Make Intros 15-Second Copy-Paste Easy",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What single enablement asset drives frontline partner referrals fastest after launch?",
                      "options": [
                        "A 45-page technical whitepaper",
                        "A crisp 1-page Cheat Sheet listing exact customer trigger phrases plus a 3-line copy-paste intro snippet",
