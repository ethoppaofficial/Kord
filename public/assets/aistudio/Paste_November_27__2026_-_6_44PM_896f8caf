                    {
                      "url": "https://www.plainlanguage.gov/guidelines/",
                      "title": "Plain Language Guidelines",
                      "source": "plainlanguage.gov",
                      "resourceType": "Documentation"
                    }
                  ],
                  "publication_status": "published",
                  "completion_criteria": "Study the core frameworks in \"Writing Unambiguous Procedural Steps\", verify the inline knowledge check, and apply the practical checklist."
                },
                {
                  "id": "ec002411-b5a3-cc70-62ef-d72a156faf1c",
                  "title": "Maintaining Living Team Documentation",
                  "blocks": [
                    {
                      "text": "Versioning, Ownership & Pruning Habits",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "An SOP without an owner and a review date ages into clutter within months. Adding lightweight metadata—Doc Owner, Last Verified Date, and Change Summary—alongside clear archival markers keeps shared knowledge trustworthy.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Document Freshness Header",
                      "text": "A brief metadata line naming owner role, last verified date, and linked system version at the top of operational docs.",
                      "type": "definition"
                    },
                    {
                      "body": "Owner: Operations Lead · Last Verified: Oct 2026 · System: Billing v4.",
                      "type": "example",
                      "title": "Freshness Header Line"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Assign one named role owner—never a vague team alias.",
                        "Set a light quarterly calendar check to verify core workflows.",
                        "Archive obsolete guides visibly instead of leaving duplicate drafts live."
                      ],
                      "title": "Applying Maintaining Living Team Documentation"
                    },
                    {
                      "text": "Three slightly different expense guides lived in Drive, triggering incorrect reimbursements monthly.",
                      "type": "case_study",
                      "title": "Conflicting Wiki Pages",
                      "takeaway": "Consolidating into one canonical doc with freshness tags cut errors to zero."
                    },
                    {
                      "text": "Link back to master policies rather than copying paragraphs across five separate pages where updates miss four copies.",
                      "type": "callout",
                      "title": "Single Source of Truth",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "How should teams prevent duplicate instructions from drifting out of sync?",
                      "options": [
                        "Copy instructions into every project folder separately",
                        "Maintain one canonical doc and link to it cleanly across folders",
                        "Remove modification dates"
                      ],
                      "explanation": "Canonical links ensure an update made once fixes instructions everywhere.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Disciplined maintenance keeps internal knowledge alive and trusted.",
                  "position": 2,
                  "resources": [
                    {
                      "id": "8ca24fed-7c50-4114-8b4e-1cfed1645983",
                      "url": "https://www.plainlanguage.gov/guidelines/",
                      "title": "Plain Language Guidelines",
                      "position": 1,
                      "resource_type": "documentation"
                    },
                    {
                      "id": "4d7e093d-7147-4c86-abfb-3443ced9a92e",
                      "url": "https://www.gov.uk/guidance/content-design",
                      "title": "Content Design & Writing Standards",
                      "position": 2,
                      "resource_type": "guide"
                    }
                  ],
                  "takeaways": [
                    "Tag docs with clear role owner and verified date",
                    "Link canonical pages instead of duplicating text",
                    "Archive deprecated instructions promptly"
                  ],
                  "objectives": [
                    "Explain versioning, ownership & pruning habits",
                    "Apply maintaining living team documentation in original drafts"
                  ],
                  "est_minutes": 28,
                  "is_required": true,
                  "introduction": "Outdated wikis silently teach wrong habits and quickly cause teams to abandon written docs altogether.",
                  "further_reading": [
