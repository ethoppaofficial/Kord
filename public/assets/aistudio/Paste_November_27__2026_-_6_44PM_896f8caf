                  "title": "Show Don’t Narrate the Screen (\"See-Say\" Balance)",
                  "blocks": [
                    {
                      "text": "Complementary Audio-Visual Counterpoint",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Great video never says \"As you can see on this red bar chart...\"—it lets B-roll, motion callouts, or screen captures illustrate the exact proof WHILE voice explains WHY it matters or shares story stakes underneath. Writing explicit `[VISUAL / SFX]` cues alongside dialogue prevents blank talking-head fatigue.",
                      "type": "paragraph"
                    },
                    {
                      "term": "See-Say Complementarity",
                      "text": "Designing spoken narration to explain meaning, stakes, or surprise while paired visuals show concrete demonstration rather than duplicating words verbatim.",
                      "type": "definition"
                    },
                    {
                      "body": "Weak: Voice says \"Click File, then Export, then CSV\" over static face. Strong: Screen animates `File -> Export -> CSV` cleanly while voice says \"Export cleanly as UTF-8 so foreign accents don’t scramble in Excel.\"",
                      "type": "example",
                      "title": "Weak vs. Smart Pairing"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Map visual layers directly alongside every spoken paragraph.",
                        "Strip redundant visual descriptions (\"look at the blue square\") out of spoken lines.",
                        "Save key spoken lines solely for emotion, contrast, and crucial mental shifts."
                      ],
                      "title": "Applying Show Don’t Narrate the Screen (\"See-Say\" Balance)"
                    },
                    {
                      "text": "Holding one unmoving webcam angle for three straight minutes of explanation lost 65% of viewers by minute one.",
                      "type": "case_study",
                      "title": "3-Minute Static Talking Head",
                      "takeaway": "Cutting cleanly every 8–12 seconds to screen demos, simple sketches, and close crops tripled completion cleanly."
                    },
                    {
                      "text": "For software or how-to videos, storyboard key screen states first, then script short voiceovers guiding viewer eyes cleanly.",
                      "type": "callout",
                      "title": "Write Visual Cues First Sometimes",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What defines strong audio-visual balance in an instructional video script?",
                      "options": [
                        "Describing aloud every exact image color visible on frame",
                        "Voice carrying causal explanation/meaning while visual frames demonstrate concrete steps or proof",
                        "Zero B-roll changes"
                      ],
                      "explanation": "Audio and video accomplish more together when carrying complementary layers rather than repeating identically.",
                      "correctIndex": 1
                    }
