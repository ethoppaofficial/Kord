            {
              "id": "8d9f58a4-878f-6f66-a879-4d331e71d1b1",
              "title": "Module 1: Qualitative vs. Quantitative Research Sequencing",
              "lessons": [
                {
                  "id": "a22d11ee-1942-4cf0-a9f5-f2a3b8c8c1cf",
                  "title": "Explore With Interviews, Validate With Numbers",
                  "blocks": [
                    {
                      "text": "Qual First, Quant Second Discipline",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Qualitative open conversations (`8–15 deep 30-min interviews`) reveal **unknown unknowns**—surprising customer phrases, emotional triggers, and weird hacks you never thought to put on a checkbox list. Only AFTER qualitative themes stabilize cleanly do you deploy structured Quantitative surveys (`n >= 100`) or live funnel metrics measuring exact prevalence across broader segments!",
                      "type": "paragraph"
                    },
                    {
                      "term": "Exploratory-to-Confirmatory Sequence",
                      "text": "Using small-sample open qualitative interviews first to discover authentic variables and buyer vocabulary before running larger quantitative surveys to measure segment weights reliably.",
                      "type": "definition"
                    },
                    {
                      "body": "Team almost asked survey respondents \"Would you prefer Dark Mode or Charts?\" -> 8 interviews revealed nobody even logged in daily—they desperately needed automated Friday PDF emails sent straight to clients!",
                      "type": "example",
                      "title": "Avoiding Survey Blindness"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Start every major unknown research initiative with 6–10 unscripted open conversations.",
                        "Borrow exact verbatim customer nouns straight from interviews to populate quantitative survey answer options.",
                        "Never treat 5 enthusiastic interview quotes as proof 80% of the entire market feels identically!"
                      ],
                      "title": "Applying Explore With Interviews, Validate With Numbers"
                    },
                    {
                      "text": "A fitness brand polled 1,200 people ranking five app icons—failing completely to include an open write-in option where buyers begged for basic beginner video pacing.",
                      "type": "case_study",
                      "title": "1,000-Response Wrong-Question Survey",
                      "takeaway": "Eight initial exploratory calls prevent giant useless survey builds completely."
                    },
                    {
                      "text": "Notice where interviewees lean forward, sigh loudly, or speak twice as fast—raw emotion flags your true research gold!",
                      "type": "callout",
                      "title": "Listen for Emotional Energy Spikes",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why run 8–12 open qualitative interviews BEFORE designing a broad multiple-choice market survey?",
                      "options": [
                        "Interviews cost zero dollars always",
