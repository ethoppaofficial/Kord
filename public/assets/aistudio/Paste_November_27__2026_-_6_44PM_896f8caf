                {
                  "id": "abede27c-f80e-c34e-6237-dbd49c5cbad4",
                  "title": "Translating Prose Into Visual Diagrams",
                  "blocks": [
                    {
                      "text": "Diagrams, Flows & Visual Hierarchy",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Strong Visual Communication picks the right graphic form for the data: step-by-step process lines for sequences, 2x2 matrices for trade-offs, swimlanes for multi-actor handoffs, and crisp comparison grids for plan choices. Use consistent directional arrows, generous whitespace around labels, and clear figure/ground contrast.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Visual Encoding Choice",
                      "text": "Selecting the exact diagram structure (Timeline, Flowchart, Swimlane, Comparison Grid) matching the underlying conceptual relationship cleanly.",
                      "type": "definition"
                    },
                    {
                      "body": "Replacing 400 legal words with a 3-column visual step path (`Request < 14 Days -> Instant Automated Check -> Refunded in 3 Days`) slashed support confusion cleanly.",
                      "type": "example",
                      "title": "Fixing Tangled Refund Policy"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Identify the core relationship: sequence, hierarchy, comparison, or decision branch.",
                        "Limit text inside each diagram node to ~5–8 scannable words.",
                        "Align boxes strictly along clean invisible vertical/horizontal grids."
                      ],
                      "title": "Applying Translating Prose Into Visual Diagrams"
                    },
                    {
                      "text": "Sketching a clean 4-node swimlane showing Patient vs. Clinic vs. Lab responsibilities cut pre-appointment phone inquiries by 42%.",
                      "type": "case_study",
                      "title": "Clarity Without Calling Support",
                      "takeaway": "Visual communication turns hidden rules visible effortlessly."
                    },
                    {
                      "text": "If arrows and groupings rely strictly on subtle pastel colors, bold strokes and clear labels fix accessibility instantly.",
                      "type": "callout",
                      "title": "Test Diagrams on Greyscale Print",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "When should dense operational text be replaced or paired with a visual diagram?",
                      "options": [
                        "Whenever readers need to understand multi-step sequences, decision branches, or cross-team handoffs rapidly",
                        "Only inside printed books",
                        "When budgets disallow fonts"
                      ],
                      "explanation": "Spatial grouping and arrows reveal flow relationships vastly faster than linear prose.",
