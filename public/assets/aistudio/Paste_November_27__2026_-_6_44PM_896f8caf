            {
              "id": "64660d3b-46ff-46da-d3b8-519209e7c020",
              "title": "Module 4: Running Crisp Execution Cadence & Communication",
              "lessons": [
                {
                  "id": "dc3475d6-8049-1b2d-15a7-38bdf7340341",
                  "title": "Meeting Discipline: Async Updates vs. Real Huddles",
                  "blocks": [
                    {
                      "text": "Purposeful Synchronous vs. Asynchronous Cadence",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Reserve live synchronous video/room minutes STRICTLY for **debates, ambiguous trade-offs, creative brainstorming, and fast unblocking**—push purely informational \"what I finished\" status cleanly to structured async updates (`15:00 check-in thread: Done / Next / Any Blocker`). When live **Standups** run, hold rigidly **<=15 minutes walking the Board RIGHT-TO-LEFT (`items closest to Done/Launch first!`)**, never endlessly reading left-column ideas!",
                      "type": "paragraph"
                    },
                    {
                      "term": "Right-to-Left Board Walk",
                      "text": "Reviewing active work from cards closest to completion/Launch backward rather than person-by-person monologues—surfacing final-mile blockers immediately.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Ignore Column 1 backlog—let’s inspect the 3 items stuck in Staging Review first: who needs a quick decision right now so these clear today?\"",
                      "type": "example",
                      "title": "Crisp 12-Min Board Walk"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Ban monologues inside standups—every speaker flags strictly current progress and concrete blockers.",
                        "Take side-debates cleanly offline (`\"Let’s park API naming—Maya and Sam stay 5 mins after!\"`) releasing everyone else on time.",
                        "Keep one single visible Source-of-Truth board updating live cleanly (`no duplicate secret tracking sheets`)."
                      ],
                      "title": "Applying Meeting Discipline: Async Updates vs. Real Huddles"
                    },
                    {
                      "text": "A 10-person weekly standup drifted regularly past 75 minutes debating random design whims while developers stared helplessly at clocks.",
                      "type": "case_study",
                      "title": "90-Minute \"Standup\" Bloat",
                      "takeaway": "Walking active near-Done tickets strictly in 12 minutes recovered 8+ productive team hours every single week!"
                    },
                    {
                      "text": "Focusing standups on moving cards across columns (`\"What moves Card #4 today?\"`) sparks collaboration instead of defensive individual status defenses!",
                      "type": "callout",
                      "title": "Walk Work, Not People",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why walk a project task board RIGHT-TO-LEFT (`Review/Testing -> In Progress`) during brief daily/weekly standups?",
                      "options": [
                        "Alphabetical sorting looks neater",
                        "Focuses urgent team energy immediately onto near-finished work blocked inches from Done rather than endlessly chatting new backlog ideas",
                        "Prevents editing earlier cards"
                      ],
                      "explanation": "Finishing started work closes real value cleanly before accumulating half-finished inventory.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Disciplined cadence keeps entire teams aligned effortlessly while guarding precious maker hours.",
