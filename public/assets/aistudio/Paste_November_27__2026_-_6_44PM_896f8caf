                  "blocks": [
                    {
                      "text": "Problem -> Research -> Iteration -> Outcome",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Strong case studies read cleanly in 3 minutes: (1) Context & Broken Baseline, (2) Crucial Discovery (\"Interviews showed users feared hidden fees\"), (3) Early Rejected Sketches & Why Pivot Happened, (4) Tested Usability Fix, and (5) Final Accessible System + Measured Result. Showing messy pivots proves genuine judgment.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Design Rationale Case Study",
                      "text": "Concise visual narrative demonstrating WHY design choices evolved from initial assumptions through research and usability testing to final outcomes.",
                      "type": "definition"
                    },
                    {
                      "body": "Opened with \"62% mobile cart drop-off\", showed 3 rough checkout sketches, explained the Severity 1 hidden shipping fix uncovered in User #2 test, and closed with clean +28% checkouts.",
                      "type": "example",
                      "title": "Strong Case Arc"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Lead with real problem stakes rather than tool lists (\"I opened Figma...\").",
                        "Include 1 before/after comparison highlighting specific clarity fixes.",
                        "Own honest constraints (\"Given 2-week build limit, we shipped Option B cleanly\")."
                      ],
                      "title": "Applying Telling Problem-First Design Stories"
                    },
