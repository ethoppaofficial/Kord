                  "publication_status": "published",
                  "completion_criteria": "Study the core frameworks in \"Matching Medium to Stakes\", verify the inline knowledge check, and apply the practical checklist."
                },
                {
                  "id": "1993a690-1abc-ffea-e65a-948dbe1a28a6",
                  "title": "Scannable Async Structure",
                  "blocks": [
                    {
                      "text": "Visual Hierarchy in Everyday Messages",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Readers scan first and read second. Using a clear subject line, bulleted options with pros/cons, bold decision labels, and white space lets a reader grasp a 200-word update in 15 seconds. Whenever possible, present a recommended path alongside alternatives instead of dumping an open question.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Decision-First Layout",
                      "text": "Organizing written updates with summary headline, structured bullets for supporting facts, and bold action items at top or bottom.",
                      "type": "definition"
                    },
                    {
                      "body": "Recommend Option B (staged rollout) because it avoids weekend support risk; Option A launches Friday with higher overtime cost. Approve Option B?",
                      "type": "example",
                      "title": "Presenting Options Cleanly"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Limit paragraphs to 3 lines maximum.",
                        "Use numbered lists for sequences and bullets for parallel points.",
                        "Pair every raised problem with at least one concrete proposed option."
                      ],
                      "title": "Applying Scannable Async Structure"
                    },
                    {
                      "text": "An important compliance change was hidden inside paragraph four of a 500-word memo, resulting in 60% missed deadlines.",
                      "type": "case_study",
                      "title": "Buried Deadline Email",
                      "takeaway": "Highlighting deadlines in the subject and opening bullet raised completion above 95%."
                    },
                    {
                      "text": "Read your message on a narrow mobile width mentally: if it looks like a solid wall of ink, split it up.",
                      "type": "callout",
                      "title": "Preview Before Send",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "How should you present choices to a busy manager in writing?",
                      "options": [
                        "Send raw brain-dump notes and ask what they think",
                        "Summarize 2–3 options briefly and state your recommended option with rationale",
                        "Hide options inside an attached 12-page file without summary"
                      ],
                      "explanation": "Recommendations paired with crisp trade-offs speed decisions cleanly.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Clean visual formatting helps readers absorb exact priorities effortlessly.",
                  "position": 2,
                  "resources": [
                    {
                      "id": "605878d8-b7ec-403d-8493-8285fa7b2d93",
                      "url": "https://www.mindtools.com/",
                      "title": "Communicating Clearly in Workplaces",
                      "position": 1,
