              "lessons": [
                {
                  "id": "c6c7972f-ced5-ce94-3807-19192f7577ac",
                  "title": "Lightweight Relationship Memory Systems",
                  "blocks": [
                    {
                      "text": "Remembering Context Effortlessly",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Keep a simple private spreadsheet or notes table recording where you met someone, what project excited them, subtle life details (\"Launching podcast Oct\", \"Moving to Bristol\"), and when you last touched base. Remembering \"Hey—how did October's podcast launch feel?\" four months later makes colleagues feel extraordinarily valued.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Personal Relationship Ledger",
                      "text": "Private lightweight notes capturing context, shared interests, and helpful updates so follow-ups feel deeply thoughtful rather than mechanical.",
                      "type": "definition"
                    },
                    {
                      "body": "Name | Role/Org | Met Via | Personal Note (\"Rebuilding checkout Q3; runner\") | Last Ping & Next Idea.",
                      "type": "example",
                      "title": "Clean Five-Column Note"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Log 2 crisp context lines immediately after good chats.",
                        "Review 5 entries weekly on Friday mornings.",
                        "Reach out only when genuine spark, congrats, or useful link fits naturally."
                      ],
                      "title": "Applying Lightweight Relationship Memory Systems"
                    },
                    {
                      "text": "Checking a simple 40-person private tracker every other Friday kept dozens of cross-industry friendships thriving effortlessly across five job cycles.",
                      "type": "case_study",
                      "title": "Five-Year Sustained Ties",
                      "takeaway": "Memory tools amplify genuine care cleanly."
                    },
                    {
                      "text": "Never add acquaintances to automated bulk marketing newsletters—send brief human 1:1 notes instead.",
                      "type": "callout",
                      "title": "Zero Robotic Mass Blasts",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why record brief personal/project context right after memorable professional chats?",
