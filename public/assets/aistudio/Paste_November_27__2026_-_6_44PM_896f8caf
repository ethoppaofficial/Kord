              "lessons": [
                {
                  "id": "93d6653c-d424-2019-1cbc-503b3e46f011",
                  "title": "Welcoming Objections With Curiosity",
                  "blocks": [
                    {
                      "text": "Clarify, Validate, Reframe",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "A tough objection usually hides a helpful warning you missed. Pause, verify what underlying failure scenario worries them (\"Is it server cost, or weekend support risk?\"), validate valid constraints sincerely, and offer data or scoped adjustments targeting that exact fear.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Diagnostic Objection Handling",
                      "text": "Probing the specific mechanism behind a listener's doubt before rushing into canned defensive rebuttals.",
                      "type": "definition"
                    },
                    {
                      "body": "\"When you say Q4 feels risky, is the main worry holiday traffic load or onboarding capacity for new reps?\"",
                      "type": "example",
                      "title": "Digging Below \"Too Risky\""
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Welcome hard questions with calm appreciation.",
                        "Ask clarifying nuance before answering broadly.",
                        "Never fake confidence over an accurate flaw they spotted."
                      ],
                      "title": "Applying Welcoming Objections With Curiosity"
                    },
                    {
                      "text": "A skeptical QA manager objected sharply to launch speed until the presenter thanked him, scoped a staged toggle flag per his feedback, and handed him launch sign-off control.",
                      "type": "case_study",
                      "title": "Skeptic Turned Co-Sponsor",
                      "takeaway": "Honoring real expertise transforms skeptics into guardians."
                    },
                    {
                      "text": "Say \"You're right about holiday support coverage—here is how we cap blast radius\" before defending other points.",
                      "type": "callout",
                      "title": "Agree With True Slices",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What happens when you probe the specific worry behind \"This looks too risky\"?",
                      "options": [
                        "You uncover exact actionable risk to mitigate instead of arguing abstractly",
                        "You annoy every speaker",
                        "You look unprepared"
                      ],
                      "explanation": "Precision inquiry turns vague blocks into solvable design constraints.",
