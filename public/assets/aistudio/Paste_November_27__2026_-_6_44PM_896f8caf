            {
              "id": "ddc13f12-57ea-69c9-61f5-097c0acbec79",
              "title": "Module 3: Paragraph Logic & Scholarly Hedge Tone",
              "lessons": [
                {
                  "id": "1c68c456-8f77-26aa-4e19-29f14ae5d645",
                  "title": "MEAL Paragraph Architecture",
                  "blocks": [
                    {
                      "text": "Main Idea, Evidence, Analysis, Link",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Strong academic body paragraphs run the MEAL engine cleanly: Main claim (topic sentence), Evidence (cited data/studies/examples), Analysis (explaining mechanism, significance, or limitation of that evidence), and Link (bridging back to core thesis or next step). Analysis—never raw citation—should occupy the strongest share.",
                      "type": "paragraph"
                    },
                    {
                      "term": "MEAL Paragraph",
                      "text": "Analytical paragraph schema uniting Main claim, cited Evidence, writer’s explicit Analysis explaining meaning, and closing Link to broader thesis.",
                      "type": "definition"
                    },
                    {
                      "body": "Claim: Feedback timing shapes persistence. Evidence: Chen (2024) found 48-hr rubric delays cut resubmission 22%. Analysis: Delayed clarity weakens recall before learners revise mental models. Link: Rapid formative loops thus anchor retention gains.",
                      "type": "example",
                      "title": "Complete MEAL Sequence"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Keep topic claim concise and conceptual.",
                        "Verify every citation receives explicit explanatory interpretation—never stop right after a parenthetical citation.",
                        "Maintain clear logical bridges to adjacent paragraphs."
                      ],
                      "title": "Applying MEAL Paragraph Architecture"
                    },
                    {
                      "text": "A policy paper routinely ended paragraphs immediately on `(World Bank, 2022).`, forcing readers to guess why the statistic mattered.",
                      "type": "case_study",
                      "title": "Citation-Closing Truncation",
                      "takeaway": "Adding 2 sentences of mechanism analysis transformed summary notes into sharp reasoning."
                    },
                    {
                      "text": "Let your own analytical interpretation close paragraphs cleanly after presenting evidence.",
                      "type": "callout",
                      "title": "Never End Paragraphs on Raw Citations Alone",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Which element makes up the writer’s core original intellectual contribution inside a MEAL paragraph?",
                      "options": [
                        "Main topic label alone",
                        "Analysis explaining how/why the cited evidence proves or nuances the broader claim",
                        "Reference list styling"
                      ],
                      "explanation": "Evidence supplies raw material; analysis builds scholarly argument.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Consistent MEAL structure ensures every paragraph proves rather than merely reports.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "952ce04f-d4b3-4c98-a3d8-8f3b3dc80962",
                      "url": "https://developers.google.com/tech-writing",
