                      ],
                      "title": "Applying Topical Relevance Without Robotic Keyword Stuffing"
                    },
                    {
                      "text": "An affiliate site jammed `\"best ergonomic chair office\"` 29 times inside 800 words; human readers left disgusted and rankings collapsed smoothly on core quality updates.",
                      "type": "case_study",
                      "title": "Penalized Keyword Robot",
                      "takeaway": "Rewriting naturally around lumbar geometry, armrest clearance, and multi-month wear logs restored lasting growth."
                    },
                    {
