                  "blocks": [
                    {
                      "text": "Matching Capital Path to Business Physics",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Venture Capital suits capital-heavy tech or winner-take-all network platforms needing multi-year upfront R&D targeting giant billion-dollar exits—demanding relentless hyper-growth and eventual exit/IPO liquidity. Conversely, profitable B2B services, vertical tools, and boutique consumer brands often thrive vastly happier **bootstrapped from customer cash**—keeping 100% ownership, steady dividends, and calm long-term sovereignty.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Runway Calculation",
                      "text": "Current cash reserves divided cleanly by net monthly cash burn (`Expenses - Collected Revenue`), showing literally how many months a startup survives before requiring new revenue or fresh cash.",
                      "type": "definition"
                    },
                    {
                      "body": "Bank Cash: $60,000 | Monthly Expenses: $14,000 | Collected Revenue: $6,000 -> Net Burn = `$8,000/mo` -> Exact Runway = `60,000 / 8,000 = 7.5 Months`!",
                      "type": "example",
                      "title": "Clean Runway Math"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Never mistake raising investor dollars for achieving Product-Market Fit—revenue from happy buyers proves fit.",
                        "Only raise external capital cleanly with concrete milestone uses (`reach $25k MRR`, not `\"cover generic rent\"`).",
                        "Calculate both Default Dead vs. Default Alive trajectory realistically every quarter."
                      ],
                      "title": "Applying Should This Startup Raise Capital—Or Bootstrap?"
                    },
                    {
                      "text": "Raised $500k early at steep valuation on a solid niche tool meant for $1.5M/yr calm profits—burn stress wrecked founder harmony chasing artificial hyper-scale.",
                      "type": "case_study",
                      "title": "Diluted Zombie Startup",
                      "takeaway": "Picking the right capital engine honors real business physics cleanly!"
                    },
                    {
                      "text": "Every dollar paid willingly by happy buyers carries zero equity dilution and validates demand cleanly!",
                      "type": "callout",
                      "title": "Customer Revenue Is Best Funding",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "How do you compute exact Startup Cash Runway accurately?",
                      "options": [
                        "Total sales bookings divided by team size",
                        "Current spendable cash balance divided by net monthly cash burn (Expenses minus Cash Collected)",
                        "Annual target revenue multiplied by 12"
                      ],
                      "explanation": "Net burn accounts honestly for collected revenues offsetting monthly spending.",
