                  "blocks": [
                    {
                      "text": "Authentication & Engagement-First List Health",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Authenticate sending domains properly (`SPF`, `DKIM`, `DMARC`), earn explicit permission (ideally double opt-in or verifiable captcha protection), make one-click unsubscribes prominent, and sunset chronically inactive contacts (`0 opens across 120–180 days`) gracefully with a simple re-engagement check before suppressing them cleanly.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Domain Authentication (SPF/DKIM/DMARC)",
                      "text": "DNS records cryptographically proving to Gmail/Outlook servers that your email marketing tool is genuinely authorized to send on your domain’s behalf.",
                      "type": "definition"
                    },
                    {
                      "body": "No opens in 120 days -> send 1 concise \"Still want our Tuesday tips? Click here to stay, otherwise we’ll tidy you off cleanly\" -> suppress non-responders.",
                      "type": "example",
                      "title": "Clean Sunset Workflow"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Configure custom sending domain + SPF/DKIM/DMARC before sending bulk mail.",
                        "Never buy scraped third-party lists.",
                        "Monitor bounce rates (<2%) and spam complaints (<0.1%) relentlessly."
                      ],
                      "title": "Applying Deliverability Hygiene: Inbox Placement First"
                    },
                    {
                      "text": "Suppressing 3,800 dead cold addresses on a 9,000-person list lifted open rates from 11% to 38% and restored primary inbox placement within three weeks.",
                      "type": "case_study",
                      "title": "Rescuing Gmail Promotions/Spam Collapse",
                      "takeaway": "Quality subscribers drive inbox reputation directly."
                    },
                    {
                      "text": "Easy visible unsubscribe links let uninterested readers leave peacefully instead of clicking \"Report Spam\" which damages your whole domain.",
                      "type": "callout",
                      "title": "Love Clean Unsubscribes",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why does pruning chronically unengaged subscribers improve email marketing results?",
                      "options": [
                        "Bigger lists always pay lower prices",
                        "Mailbox providers reward high open/click ratios with primary inbox placement while inactive dead weight drags sender reputation down",
