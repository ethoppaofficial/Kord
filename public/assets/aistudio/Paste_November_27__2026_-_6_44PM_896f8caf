                {
                  "id": "981096f9-6cf5-b28e-8215-ca7c60605182",
                  "title": "Bootstrapped Cash Runway & Smart Milestones",
                  "blocks": [
                    {
                      "text": "Cash Timing & Lean Resource Discipline",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Profit is accounting math; cash in the bank keeps lights alive. Bootstrapping founders defend cash flow fiercely: collect upfront deposits (`50% upfront / 50% milestone` or recurring monthly auto-pay), favor variable tools over long fixed office/equipment leases early, and stage spending strictly behind unlocked revenue milestones.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Working Capital Crunch",
                      "text": "Running out of immediate spendable cash—even amidst brisk client orders—because cash goes out for labor/supplies weeks ahead of customer invoices clearing.",
                      "type": "definition"
                    },
                    {
                      "body": "Instead of signing a $1,200/mo annual warehouse lease ahead of demand, partner on pay-per-pallet flexible storage strictly until monthly shipments exceed 400 units sustainably.",
                      "type": "example",
                      "title": "Cash-Protecting Milestone Rule"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Secure 40–50% upfront deposits before launching bespoke service work.",
                        "Rent or outsource fixed machinery/space early instead of tying scarce cash into rigid leases.",
                        "Track literal weekly cash balance separately alongside projected invoices."
                      ],
                      "title": "Applying Bootstrapped Cash Runway & Smart Milestones"
                    },
                    {
                      "text": "A small apparel label landed a dream wholesale order—and nearly folded paying factories upfront 60 days ahead of retail store Net-60 payout.",
                      "type": "case_study",
                      "title": "Growth Cash Trap",
                      "takeaway": "Negotiating staged factory deposits + early-pay retail discounts saved survival cleanly."
                    },
                    {
                      "text": "Skip embossed office stationery, custom offices, and premature payroll until recurring customer cash cleanly supports them twice over.",
                      "type": "callout",
                      "title": "Delay Vanity Overhead",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What financing habit protects cash timing safely when launching service or product ventures?",
                      "options": [
                        "Paying 100% supplier costs months upfront with zero customer deposits",
                        "Collecting upfront client deposits/pre-orders and favoring variable flexible tools ahead of rigid leases",
                        "Ignoring invoice payment delays"
                      ],
                      "explanation": "Matching cash inflow timing ahead of outflow protects fragile early survival cleanly.",
