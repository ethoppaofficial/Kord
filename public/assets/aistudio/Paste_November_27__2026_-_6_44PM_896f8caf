            {
              "id": "5cfb6947-e5fc-ee4d-6312-e6b457709254",
              "title": "Module 4: `To`, `CC`, `BCC` & Inbox Hygiene Etiquette",
              "lessons": [
                {
                  "id": "158b6dc1-d2ad-54af-400c-7d798f3eb138",
                  "title": "Mastering `To`, `CC`, and `BCC` Clarity",
                  "blocks": [
                    {
                      "text": "Clear Address Field Contracts",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "`To:` strictly names individuals expected to read AND take action/respond. `CC:` keeps interested observers transparently informed with zero response expected. `BCC:` protects recipient email privacy during group broadcasts (`To: Undisclosed`) OR allows politely removing copied introducers cleanly (\"Moving Alex to BCC to spare your inbox—thanks for connecting us!\"). Never secretly `BCC` a manager to \"spy\" on a peer conversation.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Transparent BCC Move",
                      "text": "Courteously moving an introducer into `BCC` right on reply #1 while thanking them publicly so they know they are cleanly excused from ongoing logistics.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Thanks for introducing us, Priya! Moving you to BCC so we spare your inbox while Sam and I lock Tuesday’s agenda.\"",
                      "type": "example",
                      "title": "Introducing Smoothly"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Put only action-owners inside `To:`.",
                        "State explicitly inside line one if adding someone new mid-thread (\"+Adding @Tariq from Finance to confirm receipt terms\").",
                        "Never use `BCC` covertly on interpersonal conflicts."
                      ],
                      "title": "Applying Mastering `To`, `CC`, and `BCC` Clarity"
                    },
                    {
                      "text": "A coordinator secretly `BCC`ed a client’s VP on a petty disagreement; the VP accidentally hit \"Reply All\", exposing the covert copy immediately.",
                      "type": "case_study",
                      "title": "Secret BCC Backfire",
                      "takeaway": "Keep `CC` and `BCC` etiquette strictly ethical and transparent always."
                    },
                    {
                      "text": "Always write `+Adding Dana` or `-Moving Sam to BCC` right at top so nobody gets blindsided scanning headers.",
                      "type": "callout",
                      "title": "Announce Thread Additions",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Who belongs cleanly inside the `To:` field of a cross-functional action email?",
                      "options": [
                        "All 18 department members for awareness",
                        "Strictly the 1–2 people expected to execute or answer the request",
                        "Hidden supervisors"
                      ],
                      "explanation": "Restricting `To:` prevents bystander inertia while `CC:` keeps observers informed.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Disciplined addressing prevents \"Reply All\" storms and builds unmistakable workplace trust.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "607d409f-2017-42ab-9526-5c7f9eb99fa5",
