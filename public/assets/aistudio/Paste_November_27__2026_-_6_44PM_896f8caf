                    {
                      "text": "Controlled Comparisons & Recommendation Memos",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Account for confounding variables (prior experience, self-selection) before claiming one factor caused an outcome. Frame analytical memos around: Question -> Evidence & Sample Size -> Caveats -> Concrete Recommended Action.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Confounding Variable",
                      "text": "An unmeasured factor (like prior coding experience) influencing both an observed behavior and the final outcome simultaneously.",
                      "type": "definition"
                    },
                    {
                      "body": "Learners who toggle dark mode aren’t smarter—experienced developers simply customize settings more often!",
                      "type": "example",
                      "title": "Confounded Correlation"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Lead analytical summaries with the decision question answered.",
                        "Flag sample size (`n`) and potential confounders explicitly.",
                        "Recommend testable actions rather than vague observations."
                      ],
                      "title": "Applying Correlation vs Causation & Decision Framing"
                    },
                    {
                      "text": "Reporting \"38% of dropouts stall before Module 2 Activity #1 (n=210); recommend adding a 5-min guided example\" led to an immediate fix.",
                      "type": "case_study",
                      "title": "Actionable Dropout Readout",
                      "takeaway": "Insights matter only when tied to concrete next steps."
