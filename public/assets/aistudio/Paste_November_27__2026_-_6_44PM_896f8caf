                  "blocks": [
                    {
                      "text": "Stakeholder-Adapted Messaging",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "One raw update rarely fits all three audiences cleanly. Executives scan bottom-line trade-offs; operational peers need exact handoff requirements; external partners need calm milestones free of internal shorthand. Tailoring the same core facts ensures zero noise reaches the wrong room.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Internal Shorthand Risk",
                      "text": "Using internal project code names, acronyms, or unresolved debate phrasing inside external client messages.",
                      "type": "definition"
                    },
                    {
                      "body": "Internal: \"Auth refactor blocked on DevOps env.\" External: \"We are completing environment verification tomorrow morning to ensure secure login stability before Friday testing.\"",
                      "type": "example",
                      "title": "Translating Internal Notes Outward"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Scrub internal jargon and acronyms before emailing clients.",
                        "Compress operational minutiae into strategic risks when writing to leadership.",
                        "Keep team instructions rich in exact file paths, owners, and criteria."
                      ],
                      "title": "Applying Adapting Voice Up, Down & Sideways"
                    },
                    {
                      "text": "An engineering vendor emailed \"P0 blocker in K8s ingress\" to a retail owner, sparking unnecessary panic.",
                      "type": "case_study",
                      "title": "Acronym Confusion Externally",
                      "takeaway": "Translating technical states into business readiness keeps partners calm and informed."
                    },
                    {
                      "text": "For multi-month projects, agree on one plain glossary of feature names so marketing, product, and clients stay aligned.",
                      "type": "callout",
                      "title": "Maintain a Terms Glossary",
                      "variant": "tip"
                    },
