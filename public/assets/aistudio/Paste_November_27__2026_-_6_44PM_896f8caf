            {
              "id": "b1f04c2d-1b38-39ae-9317-5a680dde54fa",
              "title": "Module 4: Executive Summaries & Stakeholder Briefs",
              "lessons": [
                {
                  "id": "11d43190-591f-d7ba-39e5-f20fd247aef0",
                  "title": "True Summaries vs. Empty Trailers",
                  "blocks": [
                    {
                      "text": "Standalone Executive Condensation",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "A real executive summary must deliver the core conclusions, numbers, and recommended path independently—not tease what awaits inside later chapters. An executive who reads ONLY page one should gain 80% of the strategic value.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Abstract Trailer Error",
                      "text": "Describing what a report will discuss (\"This brief examines Q4 shipping options\") instead of stating what was actually found and chosen.",
                      "type": "definition"
                    },
                    {
                      "body": "Trailer: \"We analyzed warehouse delays and cost alternatives.\" Standalone: \"Splitting Midwest shipments across two regional hubs cuts 2-day delivery misses by 70% at net neutral cost.\"",
                      "type": "example",
                      "title": "Trailer vs. Standalone Summary"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Write your executive summary AFTER finalizing full body analysis.",
                        "Include key metrics, top recommendation, cost, and implementation dates directly.",
                        "Cut vague meta-verbs like \"explores\", \"discusses\", or \"evaluates\"."
                      ],
                      "title": "Applying True Summaries vs. Empty Trailers"
                    },
                    {
                      "text": "A 24-page market study opened with a 1-paragraph \"trailer\" overview; busy directors put it aside unread.",
                      "type": "case_study",
                      "title": "Skipped Strategy Report",
                      "takeaway": "Rewriting page one with crisp findings and numbers revived the entire initiative."
                    },
                    {
                      "text": "Replace passive descriptions of the document with direct claims about the business itself.",
                      "type": "callout",
                      "title": "Banish \"This Report Examines\"",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why is \"This memo analyzes vendor pricing options\" a weak executive opening?",
                      "options": [
                        "It states the document’s topic without revealing the actual verdict or numbers",
                        "It is too short",
                        "It reveals budget too early"
                      ],
                      "explanation": "Readers want answers immediately, not a table-of-contents teaser.",
                      "correctIndex": 0
                    }
                  ],
                  "videos": [],
                  "summary": "Standalone executive summaries earn immediate mindshare at leadership level.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "241f74cf-1376-4e83-a91e-4ff76f53dfe4",
                      "url": "https://owl.purdue.edu/",
                      "title": "Purdue OWL General Writing Resources",
                      "position": 1,
                      "resource_type": "guide"
                    },
                    {
                      "id": "3b6c86f8-702a-4588-adfd-38fcc5141f74",
                      "url": "https://www.plainlanguage.gov/guidelines/",
                      "title": "Plain Language Guidelines",
                      "position": 2,
                      "resource_type": "documentation"
                    }
                  ],
                  "takeaways": [
                    "Banish meta-descriptions like \"This report explores...\"",
                    "Embed headline metrics and final pick directly on page one",
                    "Draft summaries last so details stay exact"
                  ],
                  "objectives": [
                    "Explain standalone executive condensation",
                    "Apply true summaries vs. empty trailers in original drafts"
                  ],
                  "est_minutes": 28,
                  "is_required": true,
                  "introduction": "\"This report reviews our customer service metrics and offers recommendations\" tells an executive zero actionable news.",
                  "further_reading": [
