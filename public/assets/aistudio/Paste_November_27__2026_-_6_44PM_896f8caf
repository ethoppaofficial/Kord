                {
                  "id": "f459b0cc-a781-d697-5932-c5b382ee2b60",
                  "title": "Peer Accountability & Recognition",
                  "blocks": [
                    {
                      "text": "Private Critique, Public Recognition",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Never criticize a colleague's slip in a crowded Slack channel or public meeting when a quiet DM fixes it cleanly. Conversely, always attribute credit visibly in public channels when a teammate helps solve a blocker or saves a launch. This balance fosters generous reciprocity across every team.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Credit Amplification",
                      "text": "Explicitly naming teammates' contributions in public recaps and leadership summaries so quiet contributors get fair visibility.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Big thanks to @Liam for catching the mobile table overflow bug late yesterday—saved our Thursday demo.\"",
                      "type": "example",
                      "title": "Giving Meaningful Recognition"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Share operational corrections privately 1:1 with kindness.",
                        "Keep public recognition specific—name the action and positive impact.",
                        "Avoid backhanded compliments."
                      ],
                      "title": "Applying Peer Accountability & Recognition"
                    },
                    {
                      "text": "A team lead made specific Friday public shout-outs a habit; cross-team help requests rose because unseen work started getting noticed.",
                      "type": "case_study",
                      "title": "Culture Shift Through Specific Praise",
                      "takeaway": "Specific recognition reinforces helpful collaboration automatically."
                    },
                    {
                      "text": "Acknowledge analysts, QA testers, or support reps whose behind-the-scenes fixes enabled visible wins.",
                      "type": "callout",
                      "title": "Credit Quiet Helpers",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Where should constructive correction for a peer's minor mistake normally take place?",
                      "options": [
                        "In the main company announcements channel",
                        "Privately 1:1 with respectful focus on improvement",
                        "During an all-hands Q&A"
                      ],
                      "explanation": "Private 1:1 candor protects dignity while resolving errors faster.",
                      "correctIndex": 1
