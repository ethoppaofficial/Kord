                {
                  "id": "b1bdfc40-5af0-54f2-82b7-3948064082d4",
                  "title": "Task Batching, Buffers & Honest Estimation",
                  "blocks": [
                    {
                      "text": "Context-Switch Reduction & Buffer Reality",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Group similar shallow tasks (email replies, invoice checks, expense forms) into one 30-minute afternoon batch instead of sprinkling them across all day. Estimate task duration realistically (add ~25–30% buffer for reviews/surprises) and cap daily top focus blocks at 3–4 hours of true deep cognitive load.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Context-Switching Tax",
                      "text": "The hidden 15–20 minute cognitive reload penalty paid every time you jump between unrelated tasks like coding, chat, and invoices.",
                      "type": "definition"
                    },
                    {
                      "body": "Handling all scheduling, expenses, and routine email replies between 15:30–16:15 freed uninterrupted 3-hour morning focus blocks.",
                      "type": "example",
                      "title": "Afternoon Admin Batch"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Batch shallow admin chores into dedicated daily windows.",
                        "Leave 20% unscheduled buffer in weekly calendars for surprises.",
