                },
                {
                  "id": "7e46b149-b1e1-8ac3-8583-97354a3525a1",
                  "title": "Reliable Availability & Working Boundaries",
                  "blocks": [
                    {
                      "text": "Predictable Focus & Out-of-Office Hygiene",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Publish clear calendar working hours, set Slack statuses when deep-focusing or away, and leave crisp coverage handoffs before annual leave (\"For urgent client launches, @Nina has full context; non-urgent messages answered Monday morning\"). Predictable boundaries allow colleagues to plan around your time peacefully.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Coverage Handoff Brief",
                      "text": "Short pre-leave note naming active tasks, fallback contacts, and expected response return date.",
                      "type": "definition"
                    },
                    {
                      "body": "Calendar blocked 9–11 AM for analysis; OOO auto-reply lists exact return date and named deputy for urgent customer blockers.",
                      "type": "example",
                      "title": "Clean OOO & Focus Signposting"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Set accurate working hours on team calendars.",
                        "Brief your fallback peer live before taking leave.",
                        "Honor peer OOO boundaries equally by scheduling non-urgent emails for their return morning."
                      ],
                      "title": "Applying Reliable Availability & Working Boundaries"
                    },
                    {
                      "text": "Taking ten minutes to send a 1-page vacation coverage sheet eliminated frantic midnight calls for a lead developer.",
                      "type": "case_study",
                      "title": "Relaxed Leave Handover",
                      "takeaway": "Planned visibility enables true rest and smooth continuity."
                    },
                    {
                      "text": "If you finish work late evening, use Schedule Send for 8:30 AM local time so colleagues never feel pressured at night.",
                      "type": "callout",
                      "title": "Schedule-Send Respectfully",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "How do you take leave professionally without creating team panic?",
                      "options": [
                        "Log off silently at 5 PM Friday",
                        "Share a concise coverage list naming fallback contacts for urgent issues ahead of time",
                        "Check emails hourly during vacation"
                      ],
                      "explanation": "Prepared coverage briefs protect team continuity and allow real rest.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Clear boundaries sustain consistent high performance over the long run.",
                  "position": 2,
                  "resources": [
                    {
                      "id": "48ce2cfa-322e-4617-9be3-9966417361c2",
                      "url": "https://www.mindtools.com/",
                      "title": "Communicating Clearly in Workplaces",
