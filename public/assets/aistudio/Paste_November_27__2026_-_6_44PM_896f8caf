              "lessons": [
                {
                  "id": "53813e62-b8cb-d5a9-1dfa-4961fbcb55db",
                  "title": "Escaping the \"Feature Factory\" Trap",
                  "blocks": [
                    {
                      "text": "Outcomes Over Output Volume",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "As Melissa Perri and Marty Cagan emphasize: **Features are liabilities until proven to drive customer outcomes**—every button adds future maintenance cost, UI clutter, and user confusion! Great Product Managers measure success NOT by `\"How many tickets shipped Friday?\"` (`Output`), but `\"Did onboarding activation lift from 42% to 60%?\"` (`Outcome`). Say no bravely to 80% of random requests so top 20% bets receive genuine craft!",
                      "type": "paragraph"
                    },
                    {
                      "term": "Feature Factory",
                      "text": "A product team judged solely on velocity and shipped ticket volume without validating whether released features actually solve user pains or shift retention outcomes.",
                      "type": "definition"
                    },
                    {
                      "body": "Enterprise client demands: `\"Build us a custom Friday CSV mailer button!\"` Weak PM: Builds button directly. Strong PM probes why -> Learns client merely needs automatic weekly budget discrepancy alerts -> Ships simpler lightweight Slack/Email threshold alert solving it cleanly for 500 users instead!",
                      "type": "example",
                      "title": "Saying \"Why?\" Behind Customer Requests"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Probe EVERY raw user/sales feature demand twice asking `\"Walk me through what you’re trying to accomplish when clicking that button?\"`",
                        "Keep visible team goals strictly phrased as **User Behavior Shifts**, never `\"Ship Dashboard v2\"`.",
                        "Practice pruning neglected dead UI features used by `<1%` of accounts quietly each year!"
                      ],
                      "title": "Applying Escaping the \"Feature Factory\" Trap"
                    },
                    {
                      "text": "Saying yes obediently to every vocal client request buried a simple bookkeeping app under 60 confusing toggles—tanking new user comprehension cleanly.",
                      "type": "case_study",
                      "title": "60-Button Bloated Settings Menu",
                      "takeaway": "Auditing usage telemetry and pruning clutter restored effortless 5-minute onboarding satisfaction overnight!"
                    },
                    {
                      "text": "Listen intently 100% to user frustrations; own product architecture decisions carefully with engineering and design!",
                      "type": "callout",
                      "title": "Customers Are Experts in Pain, Rarely Solutions",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What core mistake turns ambitious software teams into exhausting \"Feature Factories\"?",
                      "options": [
                        "Writing automated tests",
                        "Measuring success purely by shipped feature count rather than verifying real customer pain relief and retention shifts",
                        "Running 2-week sprints"
                      ],
                      "explanation": "Shipping unvalidated buttons adds complexity faster than value unless tied explicitly to user outcomes.",
                      "correctIndex": 1
                    }
