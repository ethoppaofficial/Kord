                    {
                      "text": "Minimal Reproduction & Root-Cause Tracing",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Before editing code, capture exact steps to reproduce, inspect Network response / Console stack trace / DB query output, bisect whether failure happens in UI state, API contract, or database constraint, fix the underlying cause cleanly, and add a regression test.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Regression Test",
                      "text": "An automated test specifically recreating a fixed bug scenario so future code changes can never silently reintroduce it.",
                      "type": "definition"
                    },
                    {
                      "body": "Checking the actual HTTP 400 payload revealed a PostgREST ambiguous foreign-key hint error rather than an empty-state UI issue.",
                      "type": "example",
                      "title": "Tracing API Failures"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Write down exact input + observed vs expected output first.",
                        "Verify whether issue persists in fresh incognito/cleared state.",
                        "Write one deterministic test failing before the fix and passing after."
                      ],
                      "title": "Applying Reproducing & Isolating Bugs Methodically"
                    },
                    {
                      "text": "Catching an API error with console.log([]) hides failures; fixing the underlying foreign-key hint restores real data permanently.",
                      "type": "case_study",
                      "title": "Root Fix vs Symptom Patch",
                      "takeaway": "Never swallow errors just to silence UI alerts."
                    },
                    {
                      "text": "Copy exact error strings and HTTP codes first—they usually pinpoint the broken layer immediately.",
                      "type": "callout",
                      "title": "Read Exact Error Messages",
                      "variant": "tip"
                    },
