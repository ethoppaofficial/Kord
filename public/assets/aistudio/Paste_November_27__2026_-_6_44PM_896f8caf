            {
              "id": "a1c4dbde-d79c-6101-bf97-f55b4b642600",
              "title": "Module 4: Listening to Non-Verbal Signals & Silence",
              "lessons": [
                {
                  "id": "6fedadd5-81e8-fac2-5c7b-4568f90495aa",
                  "title": "Clusters Over Single Gestures",
                  "blocks": [
                    {
                      "text": "Responsible Non-Verbal Awareness",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Never read one isolated gesture as definitive proof of deceit or hostility. Look for shifts in baseline clusters—sudden hesitation right when timeline budgets appear, rapid glancing toward exits paired with tight voice—and verify gently with calm open questions rather than accusing silently.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Baseline Shift",
                      "text": "Noticeable change from a person's normal relaxed speaking posture, speed, or vocal warmth when a specific sensitive topic arises.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Notice you paused a moment when mentioning Q3 support hours—does that estimate feel tight right now?\"",
                      "type": "example",
