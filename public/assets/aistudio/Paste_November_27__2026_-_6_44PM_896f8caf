                    {
                      "id": "6924f20b-97fe-4c2f-89f5-922dad3a3af0",
                      "url": "https://www.gov.uk/guidance/content-design",
                      "title": "Content Design & Writing Standards",
                      "position": 2,
                      "resource_type": "guide"
                    }
                  ],
                  "takeaways": [
                    "Separate Decisions from Action Items and Open Questions",
                    "Give every action one named driver and deadline",
                    "Publish recaps the same day"
                  ],
                  "objectives": [
                    "Explain decisions, owners & deadlines formatting",
                    "Apply action-led meeting recaps in original drafts"
                  ],
                  "est_minutes": 28,
                  "is_required": true,
                  "introduction": "Chronological transcripts (\"Jane mentioned X, then Bob agreed...\") bury real commitments inside wall-of-text paragraphs.",
                  "further_reading": [
