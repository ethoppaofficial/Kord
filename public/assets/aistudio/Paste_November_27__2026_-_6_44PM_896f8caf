            {
              "id": "69306c4f-d646-20b7-1927-7f9654f46a9c",
              "title": "Module 3: Visualizing Data & Narrative Integration",
              "lessons": [
                {
                  "id": "c19e7199-0446-da02-5acd-52c9773823b0",
                  "title": "Choosing Tables vs. Simple Charts Wisely",
                  "blocks": [
                    {
                      "text": "Purposeful Data Presentation",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Use clean horizontal bar charts to compare category rankings (`Ticket Volume by Region`), line charts strictly to track continuous change over time (`Monthly Defect Rate Jan–Sep`), and compact bold-aligned tables when exact values and multi-column specs matter. Avoid 3D tilt, rainbow clutter, and multi-slice pie charts beyond 3 categories.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Chart-to-Task Fit",
                      "text": "Selecting exact visual encodings—line for time trends, bar for category magnitude comparison, clean table for exact lookups—to minimize distortion.",
                      "type": "definition"
                    },
                    {
                      "body": "Replace an 8-slice pie showing referral shares (`12%, 11%, 14%, 9%...`) with a clean horizontal bar chart sorted high-to-low with exact value labels.",
                      "type": "example",
                      "title": "Replacing Cluttered Pie Charts"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Use one muted base color plus ONE bright accent color highlighting the problem/target bar.",
                        "Start numeric value axes cleanly at zero on bar charts so ratios never distort.",
                        "Label bars/lines directly whenever possible instead of forcing eye ping-pong to distant legends."
                      ],
                      "title": "Applying Choosing Tables vs. Simple Charts Wisely"
                    },
                    {
                      "text": "Setting a bar axis from 94% to 98% made a tiny 2% drop appear as a 50% catastrophic cliff crash.",
                      "type": "case_study",
                      "title": "Truncated Y-Axis Scare",
                      "takeaway": "Restoring zero-baseline scaling and plain direct labels restored honest proportional perspective instantly."
                    },
                    {
                      "text": "Placing numeric values directly beside bars removes mental color-matching friction immediately.",
                      "type": "callout",
                      "title": "Direct Data Labels Beat Legends",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Which display choice communicates exact ranking across 7 defect categories most clearly?",
                      "options": [
                        "3D exploded pie chart",
                        "Sorted horizontal bar chart using single accent highlighting and direct data labels",
                        "Unformatted paragraph listing numbers"
                      ],
                      "explanation": "Sorted bars leverage human visual length comparison effortlessly.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Clean visual restraint lets data patterns speak with crystal honesty.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "4f829245-0358-4532-b946-056bc47e2f91",
                      "url": "https://developers.google.com/tech-writing",
                      "title": "Google Technical Writing Courses",
