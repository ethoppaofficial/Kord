                },
                {
                  "id": "203e6a95-efe0-d873-5a78-fac215a3f5ce",
                  "title": "Thoughtful Follow-Ups & Looping Back",
                  "blocks": [
                    {
                      "text": "Polite Persistent Cadence",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Following up politely once at Day 4–5 and once gently at Day 12 recovers roughly half of missed conversations cleanly. Reply inside the original thread so context stays visible, share one quick fresh update or note (\"Thought this Q4 template might help...\"), and close calmly (\"Won’t clog your inbox further—wish you a smooth launch!\") without guilt.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Breakup / Close-Loop Note",
                      "text": "A final gracious follow-up email releasing pressure cleanly while keeping doors warmly open for future timing without passive resentment.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Hi Dan — Following up one final time in case Q4 planning buried this below. No worries at all if timing isn’t right now; feel free to reach back anytime in spring. Wishing your launch great momentum!\"",
                      "type": "example",
                      "title": "Gracious Close-Loop Email"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Wait 3–5 business days before gentle bump #1.",
                        "Stay strictly courteous—never complain \"You still haven’t replied.\"",
                        "Stop gracefully after two thoughtful bumps rather than pestering endlessly."
                      ],
                      "title": "Applying Thoughtful Follow-Ups & Looping Back"
                    },
                    {
                      "text": "\"Just wondering if my emails are landing in spam since you haven’t responded?\" irritated a warm client prospect.",
                      "type": "case_study",
                      "title": "Guilt-Tripping Bump Fail",
                      "takeaway": "Warm non-needy check-ins keep doors comfortably open even months later."
                    },
                    {
                      "text": "For cold outreach, limit politely to 1–2 gentle follow-ups total before archiving respectfully.",
                      "type": "callout",
                      "title": "Two Bumps Max Cold",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "How should a courteous final follow-up treat an unresponsive busy contact?",
                      "options": [
                        "Accuse them subtly of ignoring messages",
                        "Gracefully close the loop, release inbox pressure, and keep future doors open warmly",
                        "Send 6 rapid pings in two days"
                      ],
                      "explanation": "Polite exit emails often trigger apologies and warm replies right when pressure vanishes.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Respectful cadence recovers missed opportunities cleanly while protecting personal brand warmth.",
                  "position": 2,
                  "resources": [
                    {
                      "id": "3eeff4d3-0bfd-4842-9bf1-b6eecc095a98",
