                  "id": "55f66221-0268-c376-811a-58f3f50db72a",
                  "title": "Outcome OKRs vs. Disguised To-Do Lists",
                  "blocks": [
                    {
                      "text": "Objectives & Measurable Key Results",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Pair qualitative inspiring **Objectives** (\"Make First-Week Client Onboarding Effortless\") cleanly with 2–4 quantitative **Key Results** measuring genuine customer or business shift (\"Lift Day-14 active usage from 48% to 70%\"; \"Cut onboarding setup support tickets by 35%\"). Let Initiatives/Tasks remain flexible beneath so teams pivot quickly if tactic A flops while keeping the true Result target steady!",
                      "type": "paragraph"
                    },
                    {
                      "term": "Activity vs. Outcome KR",
                      "text": "Measuring raw output done (`\"Host 4 webinars\"`) versus real desired market or behavioral impact achieved (`\"Generate 60 qualified pipeline evaluations from live clinics\"`).",
                      "type": "definition"
                    },
                    {
                      "body": "Activity Trap: \"Launch new onboarding video series.\" Outcome KR: \"Reduce median time-to-first-completed-project from 9 days down to 3 days.\"",
                      "type": "example",
                      "title": "Upgrading Weak KRs"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Test every Key Result: could we hit 100% of this target and still see zero business improvement? If yes, rewrite toward outcome!",
                        "Limit team/company Objectives tightly (`2–3 max per quarter`) with crisp named KR drivers.",
                        "Score honestly (`0.0–1.0`) at quarter end without hiding behind excuses—treat misses strictly as tuning signals."
                      ],
                      "title": "Applying Outcome OKRs vs. Disguised To-Do Lists"
                    },
                    {
                      "text": "Marketing nailed every single promised checklist item (`12 emails, 4 videos, 2 guides`), yet missed qualified demos completely because conversion messaging missed buyer doubts.",
                      "type": "case_study",
                      "title": "100% Tasks Done, Zero Revenue Move",
                      "takeaway": "Outcome-centered tracking forces mid-quarter course adjustments quickly!"
                    },
                    {
                      "text": "If targeting `\"Double ticket close speed\"`, pair cleanly with `\"Maintain CSAT satisfaction >= 4.7/5\"` so reps don’t rush messy partial closures!",
                      "type": "callout",
                      "title": "Pair Quality Guardrails Too",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Which statement works properly as an outcome-oriented Key Result rather than a task checklist?",
                      "options": [
                        "Write 15 cold outreach templates by Friday",
                        "Lift qualified discovery call conversion from 11% to 18% while holding CSAT above 4.6",
                        "Schedule weekly sync calendar blocks"
                      ],
                      "explanation": "Outcome KRs verify tangible customer/commercial lift paired with safety quality bounds.",
