                {
                  "id": "48f4c25a-5865-cea0-8287-d46da90ba0cc",
                  "title": "Compound Interest, High-APR Debt & Financial Safety",
                  "blocks": [
                    {
                      "text": "Clearing High-Cost Debt & Automating Reserves",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Understand compounding both ways: high-interest consumer debt grows aggressively against you, while steady diversified long-term saving compounds in your favor. Prioritize building a starter emergency cushion -> paying minimums on all debts -> aggressively clearing highest-APR debt (avalanche) or smallest balance for momentum (snowball), while keeping reliable insurance/basic protections intact.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Debt Avalanche vs Snowball",
                      "text": "Avalanche pays off highest interest rate first (saves maximum money); Snowball pays off smallest balance first (builds fast psychological wins).",
                      "type": "definition"
                    },
                    {
                      "body": "Paying only minimums on a £2,000 card at 24% APR drains hundreds in pure interest every year compared to knocking it out first.",
                      "type": "example",
                      "title": "Hidden APR Drain"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "List every debt balance, minimum payment, and APR cleanly in one view.",
                        "Keep a small £500–£1,000 starter cushion so small car/laptop repairs don’t add fresh debt.",
                        "Beware predatory \"buy-now-pay-later\" installment stacking."
                      ],
                      "title": "Applying Compound Interest, High-APR Debt & Financial Safety"
                    },
                    {
                      "text": "Halting discretionary spending for 4 months while clearing a 26% credit card freed £180/month permanently into savings.",
                      "type": "case_study",
                      "title": "Cleared Revolving Trap",
                      "takeaway": "Killing high-APR interest gives an instant guaranteed return."
                    },
                    {
                      "text": "Check health, equipment, and professional liability expectations before scaling larger client contracts.",
                      "type": "callout",
                      "title": "Verify Basic Risk Cover",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why prioritize clearing 22% APR credit-card debt right after establishing a starter emergency buffer?",
                      "options": [
                        "Cards expire monthly",
                        "Paying off 22% interest gives a guaranteed risk-free 22% return far above standard bank savings rates",
                        "Improves font rendering"
                      ],
                      "explanation": "Eliminating high-APR compounding frees permanent monthly cash flow.",
                      "correctIndex": 1
                    }
