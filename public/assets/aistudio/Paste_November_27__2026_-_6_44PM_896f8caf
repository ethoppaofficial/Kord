                {
                  "id": "e34db216-9d71-df0b-00de-459622b85335",
                  "title": "Building Long-Term Credibility Capital",
                  "blocks": [
                    {
                      "text": "Accountability After the Yes",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Never pitch boldly and vanish once others shoulder execution. Stay engaged alongside implementers, report outcomes honestly—even when results hit 70% instead of 100%—and adjust transparently. People gladly back leaders whose pitches match real-world follow-through.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Credibility Capital",
                      "text": "Earned trust accumulated over repeated cycles where promised benefits match actual measured outcomes cleanly.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Two months post-rollout: ticket resolution sped up 24% (target was 30%); onboarding videos lagged—recording shorter 60s clips this week.\"",
                      "type": "example",
                      "title": "60-Day Honest Follow-Up"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Commit upfront to a 30/60-day result readout.",
                        "Acknowledge shortfalls candidly alongside wins.",
                        "Share credit generously with everyone executing."
                      ],
                      "title": "Applying Building Long-Term Credibility Capital"
                    },
                    {
                      "text": "Because an analyst sent transparent 60-day post-launch scorecards showing both wins and lessons, leadership green-lit her next three initiatives rapidly.",
                      "type": "case_study",
                      "title": "High-Trust Change Agent",
                      "takeaway": "Integrity after the yes builds permanent influence."
                    },
                    {
                      "text": "True influence finishes when the promised benefit visibly reaches users or teammates.",
                      "type": "callout",
                      "title": "Measure Outcomes, Not Applause",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What builds the strongest credibility capital for future proposals?",
                      "options": [
                        "Launching exciting decks and moving quickly before results appear",
                        "Delivering honest 30/60-day follow-up scorecards covering real wins and shortfalls",
                        "Never proposing measurable targets"
                      ],
                      "explanation": "Honest post-launch accountability makes stakeholders eager to trust you again.",
                      "correctIndex": 1
                    }
                  ],
