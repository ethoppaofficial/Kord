              "lessons": [
                {
                  "id": "336d780f-1268-d337-40df-40af9a2ca645",
                  "title": "Why \"Show Up and Throw Up\" Feature Demos Fail",
                  "blocks": [
                    {
                      "text": "Diagnose Thoroughly Before Prescribing",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Think strictly like a respected specialist physician: a doctor who writes prescriptions within ten seconds of greeting you destroys trust instantly! **Consultative Sales** spends 60–70% of early engagement unpacking the buyer’s actual current bottleneck, messy impact costs, failed previous attempts, and real workflow priorities—presenting ONLY the exact 2–3 relevant capabilities solving THEIR stated pain.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Premature Pitching Trap",
                      "text": "Jumping straight into product screen tours or pricing sheets before uncovering why the prospect even carved out 30 minutes today or what broken metrics hurt them most.",
                      "type": "definition"
                    },
                    {
                      "body": "Prospect: \"Show me your platform!\" Consultative Rep: \"Gladly—so I only highlight workflows genuinely relevant to you instead of touring irrelevant menus for 20 minutes, could we spend 5 minutes clarifying how your onboarding runs today and what feels clunkiest?\"",
                      "type": "example",
                      "title": "Diagnostic Hold-Back"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Pause screen-sharing completely during the first half of Call #1.",
                        "Agree a transparent **Upfront Contract** setting agenda, time window, and explicit permission for BOTH sides to say \"Not a fit!\" politely.",
                        "Tailor subsequent demo steps strictly backwards from the exact 2–3 frustrations the buyer just confirmed!"
                      ],
                      "title": "Applying Why \"Show Up and Throw Up\" Feature Demos Fail"
                    },
                    {
                      "text": "An enthusiastic rep rattled smoothly through 24 feature buttons for 28 minutes, asked \"Any questions?\" at minute 29, heard \"Send pricing!\", and got ghosted forever.",
                      "type": "case_study",
                      "title": "30-Minute Ghosted Tour",
                      "takeaway": "Listening first uncovers genuine buying urgency while cutting demo length in half!"
                    },
                    {
                      "text": "Saying warmly `\"If by minute 20 this doesn’t look like a clear practical fit, zero awkwardness saying no!\"` drops buyer defensive shields instantly!",
                      "type": "callout",
                      "title": "Make \"No\" Safe Right at Minute One",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why avoid launching straight into a full product feature walkthrough during Minute 2 of a sales call?",
                      "options": [
                        "Screens lag visually",
                        "Without diagnosing actual buyer pain first, blind feature tours waste time on irrelevant menus and miss emotional buying hooks",
                        "Clients dislike software"
                      ],
                      "explanation": "Diagnosing first aligns demos laser-tightly onto what specific buyer metrics actually need fixing.",
                      "correctIndex": 1
                    }
