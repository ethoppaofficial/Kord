                  "title": "Sharpening, Stabilization & Subtle Audio Mastering",
                  "blocks": [
                    {
                      "text": "Subtle Final Finishing Discipline",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Inspect final timelines calmly for quiet distracting flaws: dial digital stabilization gently (5–15% smoothness, never 50% warpy corners), run mild voice noise-reduction preserving natural room breath rather than robotic tin-can artifacts, check framing eye-line consistency across talking cuts, and keep graphics sharp without blurry soft scaling.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Audio Over-Processing Artifact",
                      "text": "Cranking harsh automated noise-removal sliders up to 100%, turning human voices thin, metallic, and underwater sounding.",
                      "type": "definition"
                    },
                    {
                      "body": "Noise reduction kept cleanly around 15–25% + gentle high-pass filter cutting <80Hz air-conditioner rumble keeps human voices rich and effortless cleanly.",
                      "type": "example",
                      "title": "Gentle Polish Calibration"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Apply gentle high-pass filters (<80Hz) removing desk bumps and AC hum before harsh AI denoisers.",
                        "Keep digital punch-in zooms <= 120% on 1080p timelines so resolution stays razor-sharp.",
                        "Inspect transitions carefully in full-screen playback before final render."
                      ],
                      "title": "Applying Sharpening, Stabilization & Subtle Audio Mastering"
                    },
                    {
                      "text": "Backing harsh noise-removal down from 85% to 20% paired with light acoustic blanket behind the mic restored natural vocal warmth instantly.",
                      "type": "case_study",
                      "title": "Avoiding Tin-Can Podcast Voice",
                      "takeaway": "Subtle cleanup beats heavy aggressive filters consistently."
                    },
                    {
                      "text": "Tiny corner flicker, dead-frame flashes, and off-center titles vanish unseen on small timeline windows—always watch 100% full-screen once.",
                      "type": "callout",
                      "title": "Watch Full-Screen Once Prior to Export",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What causes voices in over-edited videos to sound thin, choppy, and metallic?",
                      "options": [
                        "Recording close to curtains",
                        "Over-aggressive 100% automated noise-reduction stripping natural vocal frequencies alongside room noise",
                        "Using J-cuts"
                      ],
                      "explanation": "Gentle low-rumble filtering plus light denoising preserves natural human warmth cleanly.",
                      "correctIndex": 1
