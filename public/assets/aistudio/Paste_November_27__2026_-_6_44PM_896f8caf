              "lessons": [
                {
                  "id": "c5dbc024-fbc5-d524-d135-dda8b6d8935c",
                  "title": "Proof That Actually Proves Something",
                  "blocks": [
                    {
                      "text": "Before-After Testimonial Anatomy",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Persuasive testimonials follow an implicit arc: what skepticism the customer felt beforehand, what concrete metric or change happened after switching, and who they are (real role/context). Curating specific proof beats collecting fifty vague compliments.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Specific Social Proof",
                      "text": "Customer quotes highlighting measurable outcomes, overcome doubts, and verifiable buyer identity rather than generic adjectives.",
                      "type": "definition"
                    },
                    {
                      "body": "Weak: \"Awesome onboarding tool!\" Strong: \"I thought switching would take weeks, yet we migrated 120 client docs in one afternoon and saved 4 hours weekly.\"",
                      "type": "example",
                      "title": "Weak vs. Specific Testimonial"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Ask satisfied customers \"What almost stopped you from trying this?\"",
                        "Keep authentic voice warts-and-all rather than stiff corporate edits.",
                        "Match testimonial types cleanly to section objections (speed quote near setup steps)."
                      ],
                      "title": "Applying Proof That Actually Proves Something"
                    },
                    {
                      "text": "Twelve identical one-liners (\"5 stars!\") took up an entire footer without lowering buyer doubt on complex software.",
                      "type": "case_study",
                      "title": "Invisible Praise Wall",
                      "takeaway": "Replacing them with three sharp before/after case snippets lifted checkout completions cleanly."
                    },
                    {
                      "text": "Never ask \"Write a testimonial\"; ask \"What surprised you after week one, and what specific result changed?\"",
                      "type": "callout",
                      "title": "Ask Targeted Feedback Questions",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Which testimonial converts skeptical new buyers most effectively?",
                      "options": [
                        "\"Best team ever, five stars!\" — Anonymous",
                        "\"I worried migration would disrupt Friday payroll, yet setup took 25 minutes and cut errors to zero.\" — Ops Lead",
                        "\"Great design and friendly site!\""
                      ],
                      "explanation": "Voicing prior skepticism plus measurable shift mirrors how wary prospects actually think.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Specific honest customer stories build rock-solid buyer confidence.",
                  "position": 1,
                  "resources": [
                    {
