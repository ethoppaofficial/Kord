                  "blocks": [
                    {
                      "text": "Fast DOM & Router Journey Verification",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Maintain a lean set of fast end-to-end journey tests covering core user flows: login -> route protection -> enroll -> quiz/submission -> admin review -> logout cleanup. Pair lightweight DOM harness integration tests for fast feedback with real browser checks on critical UI changes.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Critical User Journey (CUJ)",
                      "text": "An essential end-to-end user workflow (like Signup -> Enroll -> Submit -> Logout) whose failure directly breaks core product value.",
                      "type": "definition"
                    },
                    {
                      "body": "Mounting the SPA router for Admin vs Learner sessions in tests verifies role isolation and popstate logout locks in under 1 second.",
                      "type": "example",
                      "title": "Auth Isolation Harness"
                    },
                    {
                      "type": "steps",
                      "items": [
