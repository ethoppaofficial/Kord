              "lessons": [
                {
                  "id": "3fc831ce-ade4-87cc-d23b-eb77925c59a3",
                  "title": "Definition of Done (`DoD`) & Acceptance Clarity",
                  "blocks": [
                    {
                      "text": "Objective Shared Acceptance Criteria",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Establish a clear project-wide **Definition of Done (`DoD`)** PLUS task-level **Acceptance Criteria** up front: work counts genuinely `Done` strictly once built AND reviewed AND tested across realistic edge cases AND documented for handoff teams (`Support/Sales/Ops`). Never allow silent `\"95% Done\"` limbo hiding unreviewed loose ends!",
                      "type": "paragraph"
                    },
                    {
                      "term": "Definition of Done (DoD)",
                      "text": "A crisp shared quality checklist every deliverable MUST satisfy (`tested, peer-reviewed, mobile/edge checked, team briefed`) before moving into Completed status.",
                      "type": "definition"
                    },
                    {
                      "body": "Task: Pricing Page Refresh -> Done strictly when: 1) Desktop + Mobile views checked (`375px & 1280px`), 2) Checkout tax totals verify against live Stripe sandbox, 3) Support FAQ doc links updated, 4) Zero console/link errors!",
                      "type": "example",
                      "title": "Crystal Acceptance Criteria"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Write 3–4 plain bullet Acceptance checks right inside every major milestone card before build begins.",
                        "Hold fast non-negotiable `\"Code/Content Freeze\"` buffer windows ahead of live releases purely for clean testing!",
                        "Loop Customer Support / Frontline Ops into brief 10-minute sneak-peek walkthroughs 48 hours pre-launch!"
                      ],
                      "title": "Applying Definition of Done (`DoD`) & Acceptance Clarity"
                    },
                    {
                      "text": "Product shipped a shiny login change Friday at 4pm without telling Customer Support—Monday morning opened to 200 confused ticket storms with zero agent scripts!",
                      "type": "case_study",
                      "title": "The Unbriefed Support Flood",
                      "takeaway": "Pre-launch frontline previews eliminate opening-day chaos almost effortlessly cleanly!"
                    },
                    {
                      "text": "Deploying complex structural shifts at 4pm Friday guarantees ruined weekends—launch core changes early Tuesday/Wednesday mornings!",
                      "type": "callout",
                      "title": "Never Ship Fridays Without Weekend Coverage",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why lock a shared \"Definition of Done\" across teams before execution begins rather than letting makers improvise completion?",
                      "options": [
                        "Slows creative freedom",
                        "Eliminates ambiguous `\"90% done\"` blind spots by verifying testing, review, edge cases, and team readiness uniformly before launch",
                        "Replaces project briefs"
                      ],
                      "explanation": "Clear uniform completion criteria keep rushed gaps from leaking straight onto real customers.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Explicit quality gates turn frantic release nights into boring, confident Tuesday mornings.",
                  "position": 1,
