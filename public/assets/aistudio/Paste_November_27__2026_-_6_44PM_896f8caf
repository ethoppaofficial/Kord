                  "blocks": [
                    {
                      "text": "Explicit Labels, Fieldsets & Inline Errors",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Bind every <input> explicitly via <label for=\"...\">, select semantic input types (email, url, tel) for mobile keyboards, and associate inline validation errors via aria-describedby so errors remain readable alongside inputs.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Programmatic Label",
                      "text": "A <label for=\"input-id\"> association linking descriptive text directly to its form control so clicking or focusing announces the field cleanly.",
                      "type": "definition"
                    },
                    {
                      "body": "Place concise error messages right below invalid fields with role=\"alert\" instead of generic top-page alerts.",
                      "type": "example",
                      "title": "Inline Error Binding"
                    },
                    {
                      "type": "steps",
                      "items": [
