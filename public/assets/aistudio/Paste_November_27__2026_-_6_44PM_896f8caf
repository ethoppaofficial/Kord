                  "id": "f99b6e99-3143-71eb-9e67-85bb5a6281e9",
                  "title": "Sunk-Cost & Availability Traps",
                  "blocks": [
                    {
                      "text": "Clean Zero-Based Re-Evaluation",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Sunk-cost fallacy mutters \"We already spent six months and £30k—we cannot stop now!\" Rational critical thinkers treat past spent cost as unrecoverable history and ask strictly forward: \"Knowing everything true today, if we started fresh tomorrow, would we invest next month's £10k here?\" If no, pivot gracefully cleanly right now.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Clean-Slate Question",
                      "text": "\"If I were hired fresh today with zero prior history on this project, would I fund continuing it?\"—neutralizing sunk-cost pride cleanly.",
                      "type": "definition"
                    },
                    {
                      "body": "Despite spending £8,000 building custom video assets, halting poor-ROI distribution freed next month's £6k immediately for higher-intent channels.",
                      "type": "example",
                      "title": "Cutting a Failing Ad Channel"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Separate ego pride from sunk project hours.",
                        "Apply the \"starting fresh tomorrow\" forward ROI test.",
                        "Treat pivoting cleanly as smart capital stewardship, never weakness."
                      ],
                      "title": "Applying Sunk-Cost & Availability Traps"
                    },
                    {
                      "text": "Shutting down an unused reporting module after objective 90-day reviews saved 15 maintenance hours weekly for high-demand features.",
                      "type": "case_study",
                      "title": "Early Sunset Wins",
                      "takeaway": "Pivoting frees trapped team energy cleanly."
                    },
                    {
                      "text": "Availability bias over-weights vivid dramatic memories (one angry shout) over calm typical patterns (98% happy completions).",
                      "type": "callout",
                      "title": "Audit Recent Drama Weighting",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "How does asking \"Would we start this initiative fresh today given current facts?\" solve the Sunk-Cost Fallacy?",
                      "options": [
                        "It forgets historical metrics carelessly",
                        "It removes past unrecoverable money/pride from forward-looking opportunity cost math",
                        "It guarantees refund checks"
                      ],
                      "explanation": "Forward opportunity cost ignores unrecoverable past effort.",
                      "correctIndex": 1
