                      "url": "https://www.gov.uk/guidance/content-design",
                      "title": "Content Design & Writing Standards",
                      "position": 2,
                      "resource_type": "guide"
                    }
                  ],
                  "takeaways": [
                    "Surface unit assumptions clearly in one line",
                    "Include conservative vs. base outcomes",
                    "Highlight simple break-even thresholds"
                  ],
                  "objectives": [
                    "Explain downside-base-upside framing",
                    "Apply honest assumptions & sensitivity ranges in original drafts"
                  ],
                  "est_minutes": 28,
                  "is_required": true,
                  "introduction": "Single-point business forecasts look precise on paper yet crumble as soon as one assumption moves 10%.",
                  "further_reading": [
