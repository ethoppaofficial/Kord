                {
                  "id": "738535a1-3daf-5efa-6687-447bbc2fd8ba",
                  "title": "The Five-Beat Applied Story Arc",
                  "blocks": [
                    {
                      "text": "Context-Disruption-Struggle-Insight-Shift",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Applied stories fit almost any room in five crisp steps: (1) Familiar Context, (2) Unexpected Disruption raising stakes, (3) Failed first try / Struggle revealing false assumptions, (4) Turning-point Insight, and (5) Concrete Transformation. Keeping setup brief saves time for the rich struggle and turnaround.",
                      "type": "paragraph"
                    },
                    {
                      "term": "5-Beat Applied Arc",
                      "text": "Streamlined story blueprint moving swiftly from Context and Disruption through Honest Struggle to Earned Insight and Transformation.",
                      "type": "definition"
                    },
                    {
                      "body": "1. Context: Boutique bakery launching online cakes. 2. Disruption: 40% damaged frosting in transit. 3. Struggle: Extra foam actually trapped heat and melted icing. 4. Insight: Switched to chilled parchment collars. 5. Shift: Damage fell below 2%.",
                      "type": "example",
                      "title": "Quick 90-Second Case Story"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Spend max 15% of length on initial setup.",
                        "Include at least one honest dead-end effort in Beat 3.",
                        "Connect Beat 4 insight directly to your audience’s takeaway."
                      ],
                      "title": "Applying The Five-Beat Applied Story Arc"
                    },
                    {
                      "text": "A vendor case study boasted \"Client installed app and sales doubled Monday!\"—audiences dismissed it as fake.",
                      "type": "case_study",
                      "title": "Zero-Struggle \"Miracle\" Case Study",
                      "takeaway": "Sharing the messy two-week data cleanup hurdle built instant trust."
                    },
                    {
                      "text": "Never spend three minutes explaining the office neighborhood before trouble arrives.",
                      "type": "callout",
                      "title": "Keep Setup Fast",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why include an honest initial struggle or failed attempt in case stories?",
                      "options": [
                        "To prove incompetence",
                        "Struggle builds trust and makes the eventual discovery feel genuinely earned",
                        "To double presentation time"
                      ],
                      "explanation": "Instant frictionless success reads like advertising hype, not authentic insight.",
