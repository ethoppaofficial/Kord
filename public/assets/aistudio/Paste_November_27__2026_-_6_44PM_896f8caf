                  "blocks": [
                    {
                      "text": "Writer-Side Page Experience Discipline",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Writers heavily shape user satisfaction signals: keep opening paragraphs crisp so helpful text shows immediately above mobile scroll lines (zero giant hero banners pushing actual content off phones!), compress clean descriptive images (`bluf-memo-comparison.webp`, never `IMG_4920.png`) with informative `alt` text, and respect crisp line breaks avoiding sticky ad clutter.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Above-the-Fold Value Visibility",
                      "text": "Ensuring mobile visitors see the article title, concise lead hook, and meaningful opening section immediately without scrolling past giant empty hero posters or intrusive banners.",
                      "type": "definition"
                    },
                    {
                      "body": "Filename: `diataxis-quadrant-chart.webp` (compressed <120KB). Alt: `\"Four-quadrant Diataxis documentation chart separating Tutorials, How-Tos, Reference, and Explanation.\"`",
                      "type": "example",
                      "title": "Clean Image Hygiene"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Check finished previews in mobile responsive inspector width before publishing.",
                        "Name uploaded media files descriptively with lowercase hyphens rather than camera gibberish.",
                        "Keep key comparison tables horizontally scrollable (`overflow-x-auto`) or cleanly stacked so phones don’t break sideways!"
                      ],
                      "title": "Applying Mobile UX & Reader Satisfaction Signals"
                    },
                    {
                      "text": "A 6-column comparison table overflowed off mobile edges, forcing horizontal screen zoom and driving mobile bounce rate up 40%.",
                      "type": "case_study",
                      "title": "Broken Mobile Comparison Table",
                      "takeaway": "Testing phone view caught layout pinching cleanly ahead of launch."
                    },
                    {
                      "text": "Most organic discovery starts on narrow mobile screens—verify paragraph flow and tables cleanly there every time.",
