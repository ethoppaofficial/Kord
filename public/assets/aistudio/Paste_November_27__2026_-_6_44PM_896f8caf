                    },
                    {
                      "id": "61294fdc-59e6-4fb6-9b2e-e8670219d122",
                      "url": "https://www.gov.uk/guidance/content-design",
                      "title": "Service Writing & Clear Communication Standards",
                      "position": 2,
                      "resource_type": "documentation"
                    }
                  ],
                  "takeaways": [
                    "Aim for steady conversational speed around 135–150 wpm",
                    "Use half-second pauses at transitions",
                    "Close declarative points without upward question inflection"
                  ],
                  "objectives": [
                    "Explain pacing, pausing & emphasis control",
                    "Apply pace, pauses & vocal presence in everyday scenarios"
                  ],
                  "est_minutes": 28,
                  "is_required": true,
                  "introduction": "How cleanly you pace and emphasize ideas shapes how much attention listeners retain.",
                  "further_reading": [
                    {
                      "url": "https://www.mindtools.com/",
