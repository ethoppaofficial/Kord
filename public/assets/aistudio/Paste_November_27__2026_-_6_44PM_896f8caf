                  "blocks": [
                    {
                      "text": "Continuous Calibration & Feedback Loops",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Strong communicators treat clarity as a measurable craft: reviewing sent messages that caused confusion, gathering feedback from trusted peers, and checking whether teams leave interactions energized and clear. Small 5% improvements in framing and recap compound across hundreds of interactions a year.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Communication Audit",
                      "text": "Periodic review of recent threads, meetings, and feedback signals to remove recurring friction habits.",
                      "type": "definition"
                    },
                    {
                      "body": "Review five sent emails or Slack threads where follow-up questions happened; notice whether asks, context, or dates were missing.",
                      "type": "example",
                      "title": "Monthly Clarity Check"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Track recurring clarifications peers ask you.",
                        "Test one concise habit per week (e.g., bolded asks or recap notes).",
                        "Solicit direct feedback from trusted colleagues on meeting clarity."
                      ],
                      "title": "Applying Building a Personal Communication Standard"
                    },
                    {
                      "text": "A graduate analyst adopted BLUF recaps and clear visual formatting; within two quarters managers entrusted her with client briefings.",
                      "type": "case_study",
                      "title": "Early-Career Accelerator",
                      "takeaway": "Visible clarity earns high-trust responsibilities faster than raw tenure."
                    },
                    {
                      "text": "Wait thirty seconds on high-stakes messages, reread strictly as the receiver, then hit send.",
                      "type": "callout",
                      "title": "Edit Twice, Send Once",
                      "variant": "tip"
                    },
