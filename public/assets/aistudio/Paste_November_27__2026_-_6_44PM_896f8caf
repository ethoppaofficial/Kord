                  "blocks": [
                    {
                      "text": "Single-Bubble Chat vs. Threaded Context",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Sending \"Hey\" alone followed by silence interrupts colleagues twice. Combining greeting, complete question, and needed context in one clear bubble (\"Hi Sam—quick check on Q2 invoice #402: should VAT stay exempt? Needed before 3 PM.\") lets colleagues respond asynchronously with zero interruption lag.",
                      "type": "paragraph"
                    },
                    {
                      "term": "No-Hello Principle",
                      "text": "Bundling a warm greeting together with the actual context and question in one message so peers never wait passively after a bare \"Hey\".",
                      "type": "definition"
                    },
                    {
                      "body": "Good: \"Morning Dana! Could you share the staging link for Onboarding v2 when free? Aiming to run QA at 2 PM.\"",
                      "type": "example",
                      "title": "Bundling Requests Cleanly"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Avoid orphan greetings like \"Hi\" or \"Quick question?\" alone.",
                        "Reply inside existing Slack/Teams threads instead of cluttering main channels.",
                        "Double-check To, CC, and attachment presence before hitting Send."
                      ],
                      "title": "Applying Chat & Email Hygiene"
                    },
                    {
                      "text": "An engineering pod adopted No-Hello and strict threading; focus interruptions dropped by a third in two weeks.",
                      "type": "case_study",
                      "title": "Notification Fatigue Cure",
                      "takeaway": "Respectful message packaging saves collective team bandwidth daily."
                    },
                    {
                      "text": "Read the attachment filename out loud mentally before pressing send to avoid embarrassing \"oops, forgot to attach\" loops.",
                      "type": "callout",
                      "title": "Check Attachments First",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why does sending only \"Hi, got a minute?\" slow down remote teams?",
                      "options": [
