                      ],
                      "title": "Applying Avoiding Bureaucracy & Maintaining Strategic Clarity"
                    },
                    {
                      "text": "\"Marketing & Sales Jointly Own Lead Activation\" resulted in three quiet months where neither director prioritized fixes.",
                      "type": "case_study",
                      "title": "Committee Diffusion Trap",
                      "takeaway": "Naming single primary owners clears alignment politely overnight!"
