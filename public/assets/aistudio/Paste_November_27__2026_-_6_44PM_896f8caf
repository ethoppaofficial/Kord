                {
                  "id": "73916caf-b4da-01b7-1f74-80a2beb9e101",
                  "title": "Defining Scope, Period & Methodology Transparently",
                  "blocks": [
                    {
                      "text": "Terms of Reference & Data Hygiene",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Early in any analytical report, clarify precisely what was evaluated, across which exact timeframe (`Jan 1 – Jun 30, 2026`), using what sampling or source logs (`1,420 resolved tickets excluding spam duplicates`), and note major constraints cleanly. Transparent scope builds immediate reviewer confidence.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Scope Boundary Note",
                      "text": "A crisp upfront statement specifying exact observation dates, sample counts, inclusions/exclusions, and collection methods behind report metrics.",
                      "type": "definition"
                    },
                    {
                      "body": "Period: Q3 2026 | Sample: 840 checkout sessions (mobile + desktop) | Excluded: 22 internal QA test runs | Source: Analytics Export Oct 2.",
                      "type": "example",
                      "title": "Concise Methods Box"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Always anchor percentages with raw denominator counts (`32% [n = 64 of 200]`).",
                        "Disclose missing dates, outages, or changed tracking definitions honestly.",
                        "Keep methodological explanation brief—under 150 words inside the main body unless technical review demands more."
                      ],
                      "title": "Applying Defining Scope, Period & Methodology Transparently"
                    },
                    {
                      "text": "\"Refund requests rose 100% in August!\" turned out to represent an increase from 1 ticket to 2.",
                      "type": "case_study",
                      "title": "Misleading Percentage Spike",
                      "takeaway": "Always reporting raw counts alongside percentages (`n = 2 vs. 1`) stops false panic completely."
                    },
                    {
                      "text": "Percentages without denominators disguise tiny samples and destroy numerical trust.",
                      "type": "callout",
                      "title": "Always Show Sample Size `n`",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why pair every report percentage with raw sample counts (`n = ...`)?",
                      "options": [
                        "Looks visually symmetrical",
                        "Small-sample swings look misleadingly dramatic as percentages unless sample size stays visible",
                        "Reduces chart clarity"
                      ],
                      "explanation": "Showing `n` keeps analytical rigor transparent and prevents misinterpretation.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Brief upfront scope and honest denominators ground report conclusions in verifiable reality.",
                  "position": 2,
                  "resources": [
