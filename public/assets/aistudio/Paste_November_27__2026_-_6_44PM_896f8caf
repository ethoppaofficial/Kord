                  "publication_status": "published",
                  "completion_criteria": "Study the core frameworks in \"Turning Metrics Into Insight\", verify the inline knowledge check, and apply the practical checklist."
                },
                {
                  "id": "b166b9b7-0179-c87f-1d91-c19db92a050e",
                  "title": "Honest RAG Status Reporting",
                  "blocks": [
                    {
                      "text": "Transparent Red/Amber/Green Signals",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Green means on track with zero help needed; Amber means a credible risk exists with an active recovery plan; Red means deadline, budget, or scope will break unless leadership intervenes. Honest Amber signals early show maturity and give sponsors room to help cleanly before disaster hits.",
                      "type": "paragraph"
                    },
                    {
                      "term": "RAG Discipline",
                      "text": "Consistent traffic-light reporting paired with explicit criteria, root cause, recovery plan, and escalation need.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Status: AMBER (API latency 480ms vs 200ms target). Recovery: caching patch ships Thursday; escalate only if load test Friday exceeds 250ms.\"",
                      "type": "example",
                      "title": "Writing a High-Trust Amber Update"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Define Green, Amber, and Red thresholds upfront.",
                        "State path-to-green steps and date for every Amber item.",
                        "Be specific when asking leadership to unblock Red items."
                      ],
                      "title": "Applying Honest RAG Status Reporting"
                    },
                    {
                      "text": "Green on the outside, red on the inside—a CRM rollout reported Green for eight weeks before collapsing on go-live morning.",
                      "type": "case_study",
                      "title": "The Watermelon Project",
                      "takeaway": "Adopting early Amber flags cut surprise post-mortems across all departments."
                    },
                    {
                      "text": "Management respects leaders who surface problems with a plan while time remains to fix them.",
                      "type": "callout",
                      "title": "Never Paint Red Green",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "When should a project status accurately shift from Green to Amber?",
                      "options": [
                        "Only after the deadline has passed",
                        "As soon as a credible blocker threatens target scope, budget, or timeline—even if a recovery plan is underway",
                        "Only when asked directly by the CEO"
                      ],
                      "explanation": "Early Amber signals give stakeholders visibility while recovery is still affordable.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Candid status reporting builds long-term executive confidence.",
                  "position": 2,
                  "resources": [
                    {
                      "id": "664db0c6-6dfe-4f5c-97e5-c6d36d5e308c",
                      "url": "https://www.mindtools.com/",
                      "title": "Communicating Clearly in Workplaces",
                      "position": 1,
                      "resource_type": "article"
                    },
                    {
                      "id": "cd6c424c-7a55-4fe0-b63f-4c104610771a",
                      "url": "https://www.gov.uk/guidance/content-design",
                      "title": "Service Writing & Clear Communication Standards",
                      "position": 2,
                      "resource_type": "documentation"
                    }
                  ],
                  "takeaways": [
                    "Anchor RAG ratings in objective criteria",
                    "Always pair Amber/Red with recovery steps and dates",
                    "Escalate blocked Red issues early with clear options"
                  ],
                  "objectives": [
                    "Explain transparent red/amber/green signals",
                    "Apply honest rag status reporting in everyday scenarios"
                  ],
                  "est_minutes": 28,
                  "is_required": true,
                  "introduction": "Turning a failing project \"Green\" until launch week surprises leadership and breaks trust.",
                  "further_reading": [
