                  "blocks": [
                    {
                      "text": "The Integrative Summarizer Role",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "One of the highest-value moves in any crowded room is acting as the calm synthesizer: pausing a looping debate to articulate what Marketing needs, what Engineering fears, and the exact single bridge question uniting both. Speakers relax instantly when someone proves every voice was genuinely absorbed.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Integrative Synthesis",
                      "text": "Concise neutral recap uniting differing speakers' key constraints so a group can pivot from circular debate into shared design.",
                      "type": "definition"
                    },
                    {
                      "body": "\"So Design prioritizes readable typography while Engineering needs single-sprint scope; how can we ship clean core headings Monday and custom animations later?\"",
                      "type": "example",
                      "title": "Bridging Siloed Views"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Note each speaker's core \"must-have\" rather than loud side points.",
                        "Name shared goals uniting both sides.",
                        "Ask one clear forward-looking design question."
                      ],
                      "title": "Applying Synthesizing Multi-Party Discussions"
                    },
                    {
                      "text": "Summarizing all three warring teams' constraints cleanly on a shared whiteboard instantly revealed a consensus phased compromise.",
                      "type": "case_study",
                      "title": "Two-Hour Debate Resolved in 4 Minutes",
                      "takeaway": "Group listening unlocks invisible consensus rapidly."
                    },
                    {
                      "text": "Speak clearly as the integrative listener once main voices have aired once—everyone feels relieved for clarity.",
                      "type": "callout",
                      "title": "Wait Until Peak Noise Softens",
                      "variant": "tip"
