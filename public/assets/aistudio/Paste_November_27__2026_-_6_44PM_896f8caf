            {
              "id": "6cb74937-974b-4df6-c819-3937aff785e4",
              "title": "Module 2: Commercial Storytelling & Data Reporting",
              "lessons": [
                {
                  "id": "0eb50ea1-410a-914e-a819-3afef6eb1ee9",
                  "title": "Turning Metrics Into Insight",
                  "blocks": [
                    {
                      "text": "Descriptive vs. Diagnostic Metrics",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Numbers without context have zero meaning. Saying \"Bounce rate was 64%\" tells a leader nothing until you state baseline comparison, cause, and action: \"Landing bounce jumped from 48% to 64% after Tuesday's mobile banner change; rolling back image weight recovers £900/day in ad spend.\" Lead with the insight headline, not the column label.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Action Title",
                      "text": "Using chart or section headings that state the takeaway insight (\"Organic signups rose 18% after pricing FAQ simplification\") rather than topic labels (\"Signup Chart\").",
                      "type": "definition"
                    },
                    {
                      "body": "Replace \"Q3 Churn Numbers\" with \"Enterprise churn stayed flat at 1.4%, while SMB churn rose to 4.1% driven by onboarding gaps.\"",
                      "type": "example",
                      "title": "Replacing Topic Headings"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Compare every number against target or prior period.",
                        "State the primary driver in plain language.",
                        "Pair every negative variance with a concrete corrective hypothesis."
                      ],
                      "title": "Applying Turning Metrics Into Insight"
                    },
                    {
                      "text": "A marketing coordinator showed ten raw Google Analytics screenshots; board members debated formatting instead of strategy.",
                      "type": "case_study",
                      "title": "The Confusing Board Deck",
                      "takeaway": "Replacing screenshots with three insight headlines plus target deltas shifted discussion straight to budget allocation."
                    },
                    {
                      "text": "Always show \"+12% vs. plan\" or \"-£3.4k vs. budget\" so readers see direction instantaneously.",
                      "type": "callout",
                      "title": "Annotate Deltas Visually",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Which heading works best above a weekly revenue chart?",
                      "options": [
                        "Revenue Figures Oct 1–14",
                        "Direct web revenue outperformed target by +14% following email reactivation",
                        "Dashboard Screenshot Export"
                      ],
                      "explanation": "Action headlines tell busy readers the takeaway before inspecting the numbers.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Insights connect quantitative metrics directly to practical business action.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "401beff2-dfd0-449e-b139-fe6e1249d939",
                      "url": "https://www.plainlanguage.gov/guidelines/",
                      "title": "Plain Language Guidelines & Clarity Principles",
                      "position": 1,
                      "resource_type": "guide"
                    },
                    {
                      "id": "406540c4-9cf9-43a4-865b-b8a1603f6062",
                      "url": "https://www.mindtools.com/",
                      "title": "Communicating Clearly in Workplaces",
                      "position": 2,
                      "resource_type": "article"
                    }
                  ],
                  "takeaways": [
                    "Benchmark numbers against clear targets",
                    "Use insight-first section headlines",
                    "Always pair a risk metric with an owner and next action"
                  ],
                  "objectives": [
                    "Explain descriptive vs. diagnostic metrics",
                    "Apply turning metrics into insight in everyday scenarios"
                  ],
                  "est_minutes": 28,
                  "is_required": true,
                  "introduction": "Pasting a table of twenty metrics asks busy stakeholders to act as their own analysts.",
                  "further_reading": [
