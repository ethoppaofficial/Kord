            {
              "id": "dbfb24b5-e6b4-1685-0fbf-36920ccc6fef",
              "title": "Module 4: Prototyping & Lightweight Usability Testing",
              "lessons": [
                {
                  "id": "a174013f-9f2d-e5e6-0eb1-95f6432e3b76",
                  "title": "Running Unbiased Think-Aloud Usability Tests",
                  "blocks": [
                    {
                      "text": "Non-Leading Scenarios & Observing Silence",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Never point at buttons or hint (\"Click the blue export icon there!\"). Give 4–5 representative participants realistic open scenarios (\"You booked Tuesday by mistake—show me how you’d move it to Thursday\") and ask them to narrate aloud while staying respectfully quiet even when they hesitate. Hesitations expose exact design flaws effortlessly.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Leading Test Prompt",
                      "text": "Accidentally tipping off test users by quoting exact button labels inside your scenario prompt (e.g., \"Go to Settings and click Migrate Plan\").",
                      "type": "definition"
                    },
                    {
                      "body": "Biased: \"Click Filters and select Intermediate.\" Neutral: \"Imagine you want courses suited for someone who already knows basics—how would you narrow this list?\"",
                      "type": "example",
                      "title": "Clean Unbiased Prompt"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Write 3 realistic goal scenarios free of UI button names.",
                        "Test 5 target participants individually (often reveals ~80% of glaring usability snags!).",
                        "Note exact pauses, wrong clicks, and verbal confusion calmly without defending the design."
                      ],
                      "title": "Applying Running Unbiased Think-Aloud Usability Tests"
                    },
                    {
                      "text": "Watching 4 users hesitate over \"Ledger Sync\" vs. \"Connect Bank\" exposed internal accounting jargon instantly—renaming one button fixed completion rate to 100% cleanly.",
                      "type": "case_study",
                      "title": "One Label Fix Saved 60% Support",
                      "takeaway": "Real observation humbles assumptions in five minutes."
                    },
                    {
                      "text": "When a user says \"Oh I guess I’m silly for missing that button\", smile kindly—that miss is 100% the interface’s feedback, never the user’s fault.",
                      "type": "callout",
                      "title": "Never Defend Your Design During Tests",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why should usability test facilitators resist jumping in to help the moment a tester pauses for 5 seconds?",
                      "options": [
                        "Silence saves time",
                        "Observing how users scan and guess when confused pinpoints broken hierarchy and unclear labels truthfully",
                        "Testers dislike talking"
                      ],
                      "explanation": "Rescuing testers hides the exact real-world friction users experience alone at home.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Listening quietly to five users uncovers priceless clarity fixes prior to build spend.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "1b64ab83-db9c-4ef9-8dee-85c5504ad0ff",
                      "url": "https://www.nngroup.com/articles/",
