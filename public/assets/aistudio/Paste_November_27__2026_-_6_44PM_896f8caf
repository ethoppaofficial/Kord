              "lessons": [
                {
                  "id": "a2509f5a-2f9e-5aa5-ea4c-076231a2b057",
                  "title": "Authentic Personalization Over Template Spam",
                  "blocks": [
                    {
                      "text": "Specific Relevance + Small First Ask",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Cold emails earn replies when recipients spot genuine context fast: reference ONE specific article line, talk idea, or company launch genuinely tied to why you chose THEM—never generic compliments. Pair short context (2 lines) with clear value or an ultra-light ask (\"15-minute chat Tuesday morning or via email—happy either way\").",
                      "type": "paragraph"
                    },
                    {
                      "term": "Micro-Ask Principle",
                      "text": "Requesting a tiny, low-effort initial step (a quick 10-minute advice call or binary yes/no reply) rather than demanding a 60-minute pitch or full portfolio critique upfront.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Hi Elena — Your Tuesday breakdown on Postgres connection pooling saved our team hours testing pgBouncer. I’m transitioning from QA into backend engineering and would value 10 minutes hearing how you evaluated mid-size teams’ setups—zero rush if your week is packed.\"",
                      "type": "example",
                      "title": "Clean Cold Outreach Example"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Prove in line one you actually read or observed their work specifically.",
                        "Keep entire cold emails strictly under 110 words.",
                        "Give a graceful no-pressure exit (\"Completely understand if bandwidth is tight\")."
                      ],
                      "title": "Applying Authentic Personalization Over Template Spam"
                    },
                    {
                      "text": "Sending four biographical paragraphs plus two resume PDFs cold to a stranger got deleted unread.",
                      "type": "case_study",
                      "title": "1,000-Word Life Story Pitch",
                      "takeaway": "Cutting down to 85 sharp words focused on one shared interest achieved a 45% reply rate cleanly."
                    },
                    {
                      "text": "Hold heavy PDFs until interest warms; short plain text earns vastly higher deliverability and reads faster.",
                      "type": "callout",
                      "title": "No Big Attachments Cold",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What earns highest reply rates on cold networking or mentor outreach?",
                      "options": [
                        "Six paragraphs detailing childhood awards",
                        "Specific genuine relevance in line one paired with an under-100-word respectful micro-ask",
                        "Bold urgent follow-ups daily"
                      ],
                      "explanation": "Demonstrating authentic homework while demanding minimal initial time respects busy strangers deeply.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Concise thoughtful outreach opens doors effortlessly without automated spam cues.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "f65df1fc-3a4c-4143-b0af-2316d9feb8cc",
