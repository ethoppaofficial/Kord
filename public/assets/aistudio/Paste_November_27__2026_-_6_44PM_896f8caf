                {
                  "id": "a5a8b723-afa8-2792-c9ab-2cd178845810",
                  "title": "Taming Long Forwards & Time-Zone Scheduling",
                  "blocks": [
                    {
                      "text": "Top-Summary Forwards & Clear Time Zones",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Whenever forwarding a complex history, write a crisp 3-bullet `TL;DR` summary right above the forward divider stating: Current State, What Remains Contested, and Exact Help Needed from the recipient. When proposing meeting windows globally, always specify clear time zones (`Thu 10:00 AM EST / 3:00 PM GMT`) alongside a calendar link fallback if preferred.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Forward Digest Rule",
                      "text": "Writing a concise 3-line summary above any forwarded thread so recipients never wade through twenty raw nested replies first.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Hi Lee — Short summary of thread below: 1. Client wants Stage 2 split into May/June. 2. Legal approved clause 4. Need your pricing sign-off by Thu 2 PM before sending final quote.\"",
                      "type": "example",
                      "title": "Clean Forward Lead"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Summarize multi-reply chains strictly in 2–4 lines before hitting Forward.",
                        "Scrub sensitive internal side-comments before forwarding threads externally!",
                        "Name explicit time zones cleanly on every proposed meeting window."
                      ],
                      "title": "Applying Taming Long Forwards & Time-Zone Scheduling"
                    },
                    {
                      "text": "Forwarding a long chain outward accidentally left an earlier employee joke buried in Message #7 visible to the buyer.",
                      "type": "case_study",
                      "title": "Leaked Internal Snark",
                      "takeaway": "Always inspect/trim old nested thread histories—or start a fresh summary email—when crossing external boundaries."
                    },
                    {
                      "text": "Almost always safer to copy just clean facts into a fresh external email than forwarding internal raw chains verbatim.",
                      "type": "callout",
                      "title": "Start Fresh Moving Outward",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What danger hides when forwarding long internal threads directly to an external vendor or client?",
                      "options": [
                        "Extra font styles",
                        "Old candid internal notes buried far below in nested quotes leaking externally",
                        "Faster send speed"
                      ],
                      "explanation": "Nested quoted replies routinely expose private internal debate accidentally.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Clean forward abstracts and time-zone specificity cut confusion cleanly across global teams.",
                  "position": 2,
                  "resources": [
