                  "blocks": [
                    {
                      "text": "Testing Real Collaborations at Architectural Seams",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Reserve test doubles for true external boundaries (network clients, clocks, remote storage). Use real domain logic (`assessmentEngine`, `progressionEngine`, `validators`) and real in-memory DBs (PGlite) wherever feasible so integration bugs surface honestly.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Mock / Test Double Fidelity",
                      "text": "How closely a simulated dependency matches the real error codes, shape, and behavior of the production system.",
                      "type": "definition"
                    },
                    {
                      "body": "Asserting a mock Supabase client captures exact `.select()` constraint strings catches ambiguous relationship regressions early while real PGlite tests validate SQL syntax.",
                      "type": "example",
                      "title": "PostgREST Contract Check"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Mock at module boundaries (Supabase client), not inner pure helpers.",
                        "Verify mock clients assert query structure, not just happy return objects.",
                        "Pair thin repository tests with real DB/integration tests."
                      ],
                      "title": "Applying Stubs, Fakes & The Over-Mocking Trap"
                    },
                    {
                      "text": "A mocked auth test returned `{ role: \"admin\" }` even after real SQL tightened column grants—only a real Postgres actor test exposed the grant mismatch.",
                      "type": "case_study",
                      "title": "False Green Mock",
                      "takeaway": "Never let mocks lie about DB permissions."
                    },
                    {
                      "text": "Asserting behavior/state outcomes stays resilient across refactors far better than counting exact helper call frequencies.",
                      "type": "callout",
                      "title": "Prefer Fakes Over Fragile Call-Count Mocks",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What is the main danger of mocking away the entire database and validation layer in every test?",
                      "options": [
                        "Slows startup",
                        "Tests stay green even when SQL queries, constraints, or schemas break in production",
                        "Increases bundle size"
                      ],
                      "explanation": "Testing against real schemas/engines catches genuine integration mismatches.",
