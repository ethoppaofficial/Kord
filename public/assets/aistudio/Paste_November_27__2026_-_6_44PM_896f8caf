                  "blocks": [
                    {
                      "text": "Roles, Vesting & Candid Cadences",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "If launching alongside partners, establish crystal-clear agreements early BEFORE revenue arrives: exact primary ownership lanes (`Product vs. Sales/Ops`), explicit time expectations (`15 hrs/wk nights` vs `full-time`), fair **vesting schedules** (earning equity cleanly over 3–4 years with a 1-year cliff so someone quitting Month 2 doesn’t keep 50% forever!), and bi-weekly candid founder health retros.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Equity Vesting Cliff",
                      "text": "A standard protective agreement ensuring co-founders earn ownership shares gradually over time (commonly 4 years with a 1-year initial cliff) rather than holding permanent shares if departing early.",
                      "type": "definition"
                    },
                    {
                      "body": "With standard 4-year vesting + 1-year cliff, if a co-founder moves away cleanly after 5 months for family reasons, unvested equity returns cleanly to active builders without bitter lawsuits.",
                      "type": "example",
                      "title": "Preventing Dead Equity"
                    },
                    {
                      "type": "steps",
                      "items": [
