              "lessons": [
                {
                  "id": "a81c1754-108b-da5e-5e21-813e80ade38b",
                  "title": "Branded House vs. House of Brands Simplicity",
                  "blocks": [
                    {
                      "text": "Scalable Brand Architecture Rules",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Most growing small-to-mid businesses thrive tremendously as a unified **Branded House (`FedEx Express / FedEx Ground / FedEx Freight`; `Google Workspace / Maps / Drive`)** where EVERY new offer inherits immediate shared trust, unified design systems, and consolidated marketing focus—instead of burning millions nurturing unrelated sub-brands (`House of Brands`, suited mostly when giant conglomerates target radically clashing price/lifestyle audiences simultaneously like luxury vs budget).",
                      "type": "paragraph"
                    },
                    {
                      "term": "Branded House Architecture",
                      "text": "Uniting all products, tools, and services cleanly under ONE primary master brand identity with plain clear descriptive sub-labels (`Kord Foundations`, `Kord Pro`) so equity compounds together smoothly.",
                      "type": "definition"
                    },
                    {
                      "body": "Instead of naming a new service `\"ZingFlow\"`, `\"BreezeKit\"`, and `\"NovaDeck\"` separately forcing buyers to re-learn who owns what, stay crystal simple: `\"Northwind Core\"`, `\"Northwind Analytics\"`, `\"Northwind Academy\"`!",
                      "type": "example",
                      "title": "Clean Master-Brand Expansion"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Default firmly to unified **Branded House** simplicity + clear descriptive functional modifiers for every early expansion.",
                        "Reserve separate sub-brands strictly if an experimental venture carries extreme reputational risk or totally opposite luxury/budget clash.",
                        "Keep sub-product labels cleanly descriptive (`Pro`, `Studio`, `Enterprise`, `Starter`) rather than forcing customers to decode cryptic fantasy words!"
                      ],
                      "title": "Applying Branded House vs. House of Brands Simplicity"
                    },
                    {
                      "text": "A thriving 15-person B2B software firm invented four cute disconnected mascot names across tools—existing loyal users didn’t even realize the company sold those three other tools!",
                      "type": "case_study",
                      "title": "Fractured Sub-Brand Confusion",
                      "takeaway": "Unifying everything cleanly under master branding boosted multi-product cross-adoption cleanly within 90 days!"
                    },
                    {
                      "text": "Clear descriptive suffixes (`Studio, Analytics, Teams`) reduce buyer friction cleanly—save pure creativity for your single primary master brand!",
                      "type": "callout",
                      "title": "Descriptive Modifiers Beat Cute Coinages",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why should growing companies nearly always default to a unified \"Branded House\" naming architecture rather than launching separate disconnected brands per feature?",
                      "options": [
                        "Saves ink fees",
                        "Every product inherits existing trust instantly and all marketing dollars compound equity onto ONE recognizable master brand instead of fragmenting",
                        "Domains forbid sub-pages"
                      ],
                      "explanation": "Unified brand architecture multiplies awareness return across every campaign automatically.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Simple unified brand naming focuses scarce attention directly where long-term equity compounds fastest.",
