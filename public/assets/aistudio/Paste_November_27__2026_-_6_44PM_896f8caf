            {
              "id": "ac25c5d7-89be-8845-ab4f-df55b3d76157",
              "title": "Module 3: Writing Crisp Lean PRDs & Specs Engineers Love",
              "lessons": [
                {
                  "id": "807f9f43-9211-39d5-bc0e-4f6913fc9a94",
                  "title": "Anatomy of a Crystal-Clear Lean PRD",
                  "blocks": [
                    {
                      "text": "Problem-Anchored Concise Product Specs",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Modern **Lean PRDs (`1–2 crisp pages`)** specify crystal clarity on **WHAT problem matters and WHY** (`Problem + Real User Quotes/Telemetry`), **Measurable Success + Safety Guardrail Metrics** (`\"Lift setup completion +15% WITHOUT raising support errors\"`), concise **Acceptance Criteria / Core Flows**, critical **Empty / Loading / Error / Permission Edge States**, and explicit **Non-Goals (Out of Scope Now)** so engineers stay unleashed designing smart clean technical paths rather than blindly typing out rigid UI specs!",
                      "type": "paragraph"
                    },
                    {
                      "term": "Product Non-Goals Block",
                      "text": "An explicit section inside a PRD strictly declaring enticing related edge features deliberately NOT included in this initial release (`\"No batch CSV multi-currency conversions in v1\"`) so engineering timelines stay sharply protected.",
                      "type": "definition"
                    },
                    {
                      "body": "Never write just `\"Show user invoices\"`! Specify clearly: Empty State (`New user with 0 invoices -> show friendly CTA button`), Error State (`Timeout -> keep draft intact + display calm Retry!`), Role Permission (`Read-only Viewer cannot trigger delete`).",
                      "type": "example",
                      "title": "Handling Empty & Error States Upfront"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Include actual design wireframes or quick rough sketches straight inside the PRD—never walls of spatial prose!",
                        "List explicit **Out-of-Scope Non-Goals** firmly so small \"helpful additions\" don’t quietly double sprint estimates.",
                        "Run collaborative **Product Triad Reviews** (`PM + Designer + Tech Lead`) EARLY while ideas feel malleable (`Day 2`, not after final UI pixel polish!)."
                      ],
                      "title": "Applying Anatomy of a Crystal-Clear Lean PRD"
                    },
                    {
                      "text": "Specs described ONLY the shiny happy path—causing three frantic extra sprint days mid-QA figuring out permissions, pagination past 50 items, and expired-session error recovery.",
                      "type": "case_study",
                      "title": "Missed Error-State Launch Delay",
                      "takeaway": "Listing 5 crisp Edge Cases straight in Lean PRDs accelerates clean accurate engineering estimates instantaneously!"
                    },
                    {
                      "text": "Reviewing all four states per screen ahead of coding cuts late QA surprises cleanly by 70%!",
                      "type": "callout",
                      "title": "Always Specify Four States: Happy, Empty, Loading, Error",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why include an explicit `\"Non-Goals / Out of Scope\"` list directly inside concise Lean PRDs?",
                      "options": [
                        "Shortens QA scripts",
                        "Prevents accidental scope creep mid-sprint and protects engineers from guessing extra unrequested flexibility",
                        "Eliminates user interviews"
                      ],
                      "explanation": "Clear boundaries keep engineering clean, simple, and predictable cleanly on schedule.",
                      "correctIndex": 1
                    }
