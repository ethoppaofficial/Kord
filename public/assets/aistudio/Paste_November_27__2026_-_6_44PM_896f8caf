                {
                  "id": "853157ac-d541-1f76-a529-5369b42bcb36",
                  "title": "High-Converting Joint Campaigns & Co-Selling",
                  "blocks": [
                    {
                      "text": "Unified Problem-Led Co-Marketing",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Great co-marketing unites both partners cleanly around solving ONE shared customer journey seamlessly (\"End-to-End Holiday Fulfillment: Smooth Storefront Checkout + Stress-Free Warehouse Shipping\"). Co-sell live only when true strategic deals demand joint technical credibility—establishing clear pre-call roles (`Lead Driver vs. Specialist Backup`) ahead of the client Zoom.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Pre-Call Co-Sell Alignment",
                      "text": "Spending 10 minutes privately ahead of joint prospect meetings locking exact agenda flow, discovery lead, handoff cues, and who handles follow-up notes cleanly.",
                      "type": "definition"
                    },
                    {
                      "body": "Do NOT split slides into separate sales ads; weave one unified 35-minute practical clinic solving shared workflow problems, closing together on a shared diagnostic checklist offer.",
                      "type": "example",
                      "title": "Seamless Co-Webinar Framing"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Craft joint marketing strictly around combined customer outcome—never disjointed solo ad turns.",
                        "Align lead-sharing consent transparently on signup checkboxes (`\"Opt in to resources from both partners\"`).",
                        "Debrief 5 minutes straight after every co-sell call to sharpen handoffs continuously."
                      ],
                      "title": "Applying High-Converting Joint Campaigns & Co-Selling"
                    },
                    {
                      "text": "During a joint enterprise demo, both partner reps talked over each other presenting pricing inconsistently right in front of buyers.",
                      "type": "case_study",
                      "title": "Awkward Mid-Call Step-On",
                      "takeaway": "Running tight 10-minute pre-call role alignment keeps joint pitches sharp and authoritative cleanly."
                    },
                    {
                      "text": "Always clarify clearly on co-hosted event registrations who receives follow-up contact permissions—spamming attendees kills partner brand equity cleanly!",
                      "type": "callout",
                      "title": "Respect Opt-In Consent Explicitly",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "How should co-marketing partners structure a joint workshop or webinar for maximum buyer engagement?",
                      "options": [
                        "Split time awkwardly into two separate 25-minute company sales pitches",
                        "Collaborate seamlessly around one unified workflow journey solving shared customer pain end-to-end",
                        "Hide each other’s roles completely"
                      ],
                      "explanation": "Unified practical storytelling demonstrates authentic synergy rather than back-to-back ads.",
