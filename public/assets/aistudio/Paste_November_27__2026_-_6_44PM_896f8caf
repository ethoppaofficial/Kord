            {
              "id": "80cc4690-0d66-2ab2-99eb-6b22ac3a1d00",
              "title": "Module 3: Value Storytelling, Tailored Demos & Proposals",
              "lessons": [
                {
                  "id": "2c58e4b6-3c40-1238-3a6f-8b9f102a2628",
                  "title": "Tailored Demos: Backwards From Buyer Pain",
                  "blocks": [
                    {
                      "text": "Show Value First, Click Second",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Keep live product or portfolio walkthroughs crisp (`15–20 min` interactive, stopping frequently for dialogue!). Open every demo segment stating: `\"You shared earlier that [Exact Problem] costs Maya 6 hours every Thursday—let me show strictly the 2-step workflow resolving that cleanly\"` (`Tell -> Show -> Tie Back`). Leave obscure unrequested admin menus quietly hidden unless asked!",
                      "type": "paragraph"
                    },
                    {
                      "term": "Tell-Show-Verify Loop",
                      "text": "Framing each demo screen explicitly around a previously stated buyer frustration (`Tell`), showing strictly those relevant 2–3 clicks cleanly (`Show`), and immediately checking resonance (`\"How would this fit your Thursday routine?\"`).",
                      "type": "definition"
                    },
                    {
                      "body": "Skip setting up user themes, general team profiles, or old export settings -> Jump directly onto automated reconciliation report -> Pause -> \"Notice how messy mismatches flag visually right here—does that match what slowed Finance down last week?\"",
                      "type": "example",
                      "title": "Cutting 40-Min Clutter to 15-Min Gold"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Limit slides or demo modules strictly to TOP 3 stated buyer priorities.",
                        "Speak in outcomes while hovering cursors cleanly (`never click erratically fast across nested menus!`).",
                        "Leave 10 full buffer minutes deliberately for unhurried buyer questions and next-step alignment."
                      ],
                      "title": "Applying Tailored Demos: Backwards From Buyer Pain"
                    },
                    {
                      "text": "Showcasing 12 advanced enterprise modules during a basic SMB call made buyers gasp `\"Wait—this looks way too complicated and expensive for our 6-person clinic!\"` and bolt immediately!",
                      "type": "case_study",
                      "title": "Lost Deal Over Dashboard \"Extras\"",
                      "takeaway": "Showing ONLY clean relevant simplicity doubled SMB close rates cleanly overnight!"
                    },
                    {
                      "text": "Cluttered unrequested complexity secretly terrifies busy small/mid-size buyers into sticking with safe familiar Excel!",
                      "type": "callout",
                      "title": "More Features Shown = Lower Close Rates",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why can showcasing extra bonus features a buyer never asked for actually HURT closing odds?",
                      "options": [
                        "Software lags visually",
                        "Unrequested complexity makes buyers worry the tool feels overwhelming, hard to train teams on, and bloated beyond budget",
                        "Violates contracts"
                      ],
                      "explanation": "Laser-focused simple demos build quiet confidence that implementation stays fast and calm.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Focused outcome-anchored walkthroughs create clear mental ownership before price even appears.",
                  "position": 1,
                  "resources": [
                    {
