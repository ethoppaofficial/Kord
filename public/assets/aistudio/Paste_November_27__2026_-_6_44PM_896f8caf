                },
                {
                  "id": "2fcf466d-19c0-edb8-c726-050a826d0835",
                  "title": "Attribution Discipline & Citation Mechanics",
                  "blocks": [
                    {
                      "text": "Clean Traceability Across Styles",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Whether a discipline assigns APA (author-date focus on currency), MLA (author-page humanities focus), or Chicago/IEEE footnotes, the universal goal stays identical: enable any reader to trace every external claim or data figure straight back to its exact origin unambiguously.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Cross-Verification Audit",
                      "text": "Verifying that 100% of in-text parenthetical citations match an entry in References/Bibliography and vice versa without orphans.",
                      "type": "definition"
                    },
                    {
                      "body": "Record full DOI/URL, page range, edition, and publication year immediately when taking initial notes—never hunt missing metadata 11 PM before submission.",
                      "type": "example",
                      "title": "Maintaining Citation Integrity"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Log bibliographic details completely inside reference managers or notes on Day 1.",
                        "Verify exact author spelling, year parity, and quotation page numbers.",
                        "Confirm every bibliography entry actually appears cited in text (no padded uncited works)."
                      ],
                      "title": "Applying Attribution Discipline & Citation Mechanics"
                    },
                    {
                      "text": "Submitting a draft with three cited claims missing from the bibliography and four unread titles padded into References triggered grade penalties.",
                      "type": "case_study",
                      "title": "Phantom Reference Audit",
                      "takeaway": "Running a quick bi-directional citation check clears traceability flaws cleanly."
                    },
                    {
                      "text": "Read original studies directly whenever possible rather than blindly copying someone else’s summary interpretation (\"as cited in...\").",
                      "type": "callout",
                      "title": "Verify Primary Over Secondary",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What should every reference-list check verify prior to final academic submission?",
                      "options": [
                        "References sit alphabetically strictly by title",
                        "Every in-text citation maps cleanly 1:1 to a complete bibliography entry and zero broken metadata remains",
                        "All citations come from blogs"
                      ],
                      "explanation": "Bi-directional verification guarantees transparent scholarly traceability.",
                      "correctIndex": 1
