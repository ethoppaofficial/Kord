                  "blocks": [
                    {
                      "text": "Zero-Assumption Fact Verification",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Treat every proper noun, company capitalization (`iPhone`, `PostgreSQL`, `HubSpot`), job title, historical year, weekday-date pairing, and direct quotation as guilty until verified directly against a primary source. Check direct quotes word-for-word against transcripts or originals—never paraphrase lazily inside quotation marks!",
                      "type": "paragraph"
                    },
                    {
                      "term": "Weekday-Date Mismatch Check",
                      "text": "Checking an actual calendar to verify any explicitly paired weekday and calendar date (`\"Monday, Nov 16\"`) actually align in that specific year.",
                      "type": "definition"
                    },
                    {
                      "body": "Confirm `LinkedIn` (capital I), `GitHub` (capital H), and guest surname diacritics or hyphenations strictly against official profiles rather than guessing from memory.",
                      "type": "example",
                      "title": "Brand & Name Verification"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Highlight every single number, date, URL, person name, and quote inside Copyediting Pass 3.",
                        "Verify weekday/date alignment on an actual calendar.",
                        "Click EVERY hyperlink cleanly in incognito browser windows to guard against dead `404`s or internal draft redirect links!"
                      ],
                      "title": "Applying Every Proper Noun, Date & Quote Checked"
                    },
                    {
                      "text": "A conference newsletter promoted keynote speaker `\"Jonah Michaels\"` when her name was `\"Joanna Michaelis\"`, forcing humiliating public retractions.",
