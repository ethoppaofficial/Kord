              "lessons": [
                {
                  "id": "f1e22174-e85d-ebb5-eb29-ca76504fe7b7",
                  "title": "Facilitator Neutrality & Active Balance",
                  "blocks": [
                    {
                      "text": "Holding Fair Space for Both Sides",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "As mediator, enforce equal uninterrupted airtime, reflect both speakers' core stakes neutrally with identical care, and resist rushing to impose your favorite solution. People abide dramatically longer by agreements they co-crafted than rulings forced down upon them.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Multi-Partial Neutrality",
                      "text": "Showing equal empathy and diagnostic curiosity toward each conflicting side rather than cold aloofness or favoring a closer peer.",
                      "type": "definition"
                    },
                    {
                      "body": "Summarize Party A's constraints accurately, ask confirmation, then give identical balanced attention to Party B.",
                      "type": "example",
                      "title": "Balanced Equal Reflections"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Open with clear shared commitment rules.",
                        "Alternate who opens based on context without favoring friends.",
                        "Stay strictly non-defensive if tested by either party."
                      ],
                      "title": "Applying Facilitator Neutrality & Active Balance"
                    },
                    {
                      "text": "Neutral mediation helped two senior specialists who hadn't spoken directly in months agree on API contract rules in 40 minutes.",
                      "type": "case_study",
                      "title": "Cross-Team Trust Restored",
                      "takeaway": "Fair structure outperforms informal hallway gossip."
                    },
                    {
                      "text": "Do not allow brainstorming solutions until both parties confirm the mediator captured their core concerns fairly.",
                      "type": "callout",
                      "title": "Summarize Before Solving",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What kills mediator credibility fastest in the opening ten minutes?",
                      "options": [
                        "Setting equal speaking time rules",
                        "Visibly siding with one participant or proposing solutions before hearing both fully",
