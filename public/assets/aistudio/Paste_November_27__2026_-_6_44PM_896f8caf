            {
              "id": "1c2a48b9-5bbe-513c-352d-bc8371c6b71f",
              "title": "Module 6: Business Writing System & Portfolio Pack",
              "lessons": [
                {
                  "id": "6e34c7a5-0785-cbee-aeff-088f08d61bd4",
                  "title": "Executive Polish & Precision Editing",
                  "blocks": [
                    {
                      "text": "Active Voice, Concrete Nouns & Hedge Removal",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Polished business prose prefers active actors (\"Finance approved the budget\") over passive fog (\"The budget was approved\"), concrete metrics over fuzzy qualifiers (\"three days\" vs. \"shortly\"), and tight sentences under 22 words. Removing nervous hedges like \"I just kind of feel maybe\" multiplies authority instantly without sounding arrogant.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Hedge Elimination",
                      "text": "Trimming apologetic or diluting qualifiers (\"just\", \"maybe\", \"kind of\", \"actually\") when stating factual observations or solid recommendations.",
                      "type": "definition"
                    },
                    {
                      "body": "Change \"I just wanted to maybe check in quickly to see if you had time\" to \"Checking in on the rollout timeline we discussed Tuesday—does May 12 still work for team onboarding?\"",
                      "type": "example",
                      "title": "Sharpening a Sales Follow-Up"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Highlight and remove unnecessary \"just\" and \"kind of\" hedges.",
                        "Convert passive verbs into explicit subject-verb-object statements.",
                        "Keep average sentence length under 20 words."
                      ],
                      "title": "Applying Executive Polish & Precision Editing"
                    },
                    {
                      "text": "A coordinator spent three minutes cutting passive phrases and hedges from her weekly updates; VP feedback praised sudden clarity and executive poise.",
                      "type": "case_study",
                      "title": "Credibility Jump via Editing",
                      "takeaway": "Crisp editing alters perceived seniority almost overnight."
                    },
                    {
                      "text": "Run a quick mental scan for \"just\" before sending important emails—it almost always weakens valid requests.",
                      "type": "callout",
                      "title": "The \"Just\" Search Check",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Which revision demonstrates sharper business polish?",
                      "options": [
                        "It was felt by our team that maybe we could delay somewhat.",
                        "Our team recommends shifting launch by 48 hours to complete security regression checks.",
                        "I just wanted to sort of suggest delaying if ok."
                      ],
                      "explanation": "Active voice plus specific rationale conveys crisp professionalism.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Disciplined editing sharpens executive presence in every workplace document.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "c3ae1bb6-3c64-40c6-93e4-a4f861c08bce",
                      "url": "https://www.plainlanguage.gov/guidelines/",
                      "title": "Plain Language Guidelines & Clarity Principles",
                      "position": 1,
                      "resource_type": "guide"
                    },
                    {
                      "id": "b270bbad-3cfb-40cd-9b8c-69e692a0e329",
                      "url": "https://www.mindtools.com/",
                      "title": "Communicating Clearly in Workplaces",
                      "position": 2,
                      "resource_type": "article"
                    }
                  ],
                  "takeaways": [
                    "Prefer active voice with named owners",
                    "Trim weak conversational hedges",
                    "Pair assertions with specific timeframes and numbers"
                  ],
                  "objectives": [
                    "Explain active voice, concrete nouns & hedge removal",
                    "Apply executive polish & precision editing in everyday scenarios"
                  ],
                  "est_minutes": 28,
                  "is_required": true,
                  "introduction": "Small sloppiness—unclear pronouns, bloated hedging, or missing labels—quietly undermines executive readiness.",
                  "further_reading": [
                    {
                      "url": "https://www.plainlanguage.gov/guidelines/",
                      "title": "Plain Language Guidelines & Clarity Principles",
                      "source": "plainlanguage.gov",
                      "resourceType": "Guide"
                    },
                    {
                      "url": "https://www.mindtools.com/",
                      "title": "Communicating Clearly in Workplaces",
                      "source": "mindtools.com",
                      "resourceType": "Article"
                    }
                  ],
                  "publication_status": "published",
                  "completion_criteria": "Study the core frameworks in \"Executive Polish & Precision Editing\", verify the inline knowledge check, and apply the practical checklist."
                },
                {
                  "id": "56b990b6-e65b-d278-f76d-3253c6256c3f",
                  "title": "Templates & Scalable Communication Habits",
                  "blocks": [
                    {
                      "text": "Systematizing Communication Excellence",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Instead of staring at a blank email every Friday or before every project review, build lightweight templates for weekly RAG digests, decision memos, client kickoffs, and incident notices. Consistent predictable formats train colleagues and leaders to find answers quickly, raising operational speed across your entire organization.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Template Standardization",
                      "text": "Maintaining crisp repeatable outlines for common business updates so cognitive energy focuses on strategy and truth rather than formatting.",
                      "type": "definition"
                    },
                    {
                      "body": "Headline (Green/Amber/Red) -> Top 3 Wins -> Risks & Mitigations -> Decisions Needed -> Next Week Milestones.",
                      "type": "example",
                      "title": "Standard Weekly Update Block"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Identify your 3 highest-frequency recurring business updates.",
                        "Draft clean 5-part outlines for each.",
                        "Review every quarter to trim outdated sections readers ignore."
                      ],
                      "title": "Applying Templates & Scalable Communication Habits"
