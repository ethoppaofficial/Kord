            {
              "id": "eb4454e1-1f11-a06a-fc80-24bc7178f3ee",
              "title": "Module 5: Boundaries, Reliability & Accountability",
              "lessons": [
                {
                  "id": "b5b67cf1-81b4-8a1d-3310-de49a16b907c",
                  "title": "Owning Mistakes Without Drama",
                  "blocks": [
                    {
                      "text": "Accountability + Fix + Prevention",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Strong ownership avoids both blame-shifting (\"Operations gave me wrong data\") and excessive self-flagellation (\"I am terrible at spreadsheets\"). State plainly what went wrong, what immediate fix is applied, whether clients/numbers were impacted, and one concrete system tweak (e.g., adding a checksum formula) preventing repeats.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Clean Post-Error Triad",
                      "text": "Three-part recovery message: what happened, how it is fixed right now, and what checklist/guardrail prevents recurrence.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Heads-up: Q3 totals in v1 doubled August renewals due to a duplicate join. Fixed v2 is attached with updated totals, and I added a unique-ID validation row to catch repeats.\"",
                      "type": "example",
                      "title": "Transparent Error Recovery"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Verify impact scope calmly before notifying affected leads.",
                        "Own your piece directly without blaming tools or juniors.",
                        "Add a structural check rather than promising \"I will try harder\"."
                      ],
                      "title": "Applying Owning Mistakes Without Drama"
                    },
                    {
                      "text": "Spotting a misconfigured price link within 20 minutes and immediately notifying stakeholders with a fix prevented major billing cleanup and earned praise for integrity.",
                      "type": "case_study",
                      "title": "Trust Gained From Fast Candor",
                      "takeaway": "Fast calm correction multiplies confidence."
                    },
                    {
                      "text": "\"I will be more careful\" fails later; \"I added a pre-send QA row\" prevents repeats permanently.",
                      "type": "callout",
                      "title": "Systems Beat Willpower",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What makes a mistake recovery message feel genuinely trustworthy?",
                      "options": [
                        "Promising vaguely to pay better attention next time",
                        "Explaining the fix now plus adding a concrete guardrail against recurrence",
                        "Blaming software glitches silently"
                      ],
                      "explanation": "Concrete prevention steps reassure teams that the issue is truly closed.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Calm, system-focused ownership turns mistakes into proof of maturity.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "b3377281-b475-47c3-863b-20d76c02d612",
                      "url": "https://www.plainlanguage.gov/guidelines/",
                      "title": "Plain Language Guidelines & Clarity Principles",
                      "position": 1,
                      "resource_type": "guide"
                    },
                    {
                      "id": "15ce24a1-3c9d-4cad-8d97-0b7b3c259da6",
                      "url": "https://www.mindtools.com/",
                      "title": "Communicating Clearly in Workplaces",
                      "position": 2,
                      "resource_type": "article"
                    }
                  ],
                  "takeaways": [
                    "State mistakes plainly without blaming peers",
                    "Deliver the immediate corrected version fast",
                    "Establish a simple system check against repeats"
                  ],
                  "objectives": [
                    "Explain accountability + fix + prevention",
                    "Apply owning mistakes without drama in everyday scenarios"
                  ],
                  "est_minutes": 28,
                  "is_required": true,
                  "introduction": "Errors happen on busy teams; how fast and cleanly you own and repair them defines trust.",
                  "further_reading": [
