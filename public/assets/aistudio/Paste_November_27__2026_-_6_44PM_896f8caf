                  "blocks": [
                    {
                      "text": "Dual-Control Financial Hygiene",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Zero-trust paranoia isn’t required—just basic timeless **Dual Financial Controls**: separate who approves invoices from who executes bank payments (`or require owner glance on monthly untouched bank PDFs directly!`); enforce dual verification via voice call before altering ANY vendor bank routing details (`BEC wire fraud` hits small firms daily!); and maintain disciplined untouched **Tax Reserve Accounts** collecting sales/income obligations monthly.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Segregation of Duties",
                      "text": "Splitting authority so no single individual both issues/approves vendor bills AND independently reconciles or signs outgoing bank payments without a second pair of eyes reviewing raw bank statements.",
                      "type": "definition"
                    },
                    {
                      "body": "Accountant receives realistic urgent email `\"From CEO: Please wire $12k rush to new vendor routing today!\"` -> Mandatory **Callback Protocol** (dialing known saved phone numbers—never replying to email!) stops 100% of spoof wire theft cold!",
                      "type": "example",
                      "title": "Defeating Business Email Compromise (BEC)"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Review raw bank statements directly yourself monthly even when delegating daily bookkeeping.",
                        "Enforce mandatory known-number phone callbacks ahead of EVERY bank routing change or unusual rush wire.",
                        "Hold distinct untouched checking vaults for Taxes (`Sales Tax / Payroll / Income Reserve`) strictly off-limits for daily operations."
                      ],
                      "title": "Applying Simple Financial Controls, Tax Discipline & Fraud Defense"
                    },
                    {
                      "text": "A small studio lost $18,400 wiring a forged supplier \"updated bank details\" email request that skipped voice confirmation.",
                      "type": "case_study",
                      "title": "Spoofed Vendor Wire Loss",
                      "takeaway": "Simple 30-second verbal voice verification protects cash reserves effortlessly forever!"
                    },
                    {
                      "text": "Collected Sales/VAT taxes legally belong to tax agencies from Day 1—sweep them cleanly out of checking immediately!",
                      "type": "callout",
                      "title": "Never Spend Sales Tax as Revenue",
                      "variant": "tip"
                    },
