                  "id": "fe727ba2-1c0c-c0bd-14bf-f4a67d4ad634",
                  "title": "Reverse Outlining & Final Paper Alignment",
                  "blocks": [
                    {
                      "text": "Macro Alignment & Final Review Protocol",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Before submitting any essay, thesis chapter, or grant proposal, build a clean paragraph-by-paragraph reverse outline: extract the 1-sentence claim of every paragraph in order. Checking that sequence against your introduction thesis exposes forgotten signposts, duplicated themes, or sudden non-sequiturs immediately.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Macro Alignment Audit",
                      "text": "Verifying strict logical alignment between Research Question, Opening Thesis, Reverse-Outlined Body Paragraphs, and Final Discussion Conclusions.",
                      "type": "definition"
                    },
                    {
                      "body": "Discovering via reverse outline that paragraphs 6–8 focus strictly on teacher pay rather than curriculum time signals you must either narrow the thesis or rebalance body sections cleanly.",
                      "type": "example",
                      "title": "Catching Silent Thesis Drift"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Summarize every paragraph in 10 words strictly from what appears inside it.",
                        "Compare sequence cleanly against your intro promise.",
                        "Verify transitions explicitly connect sections instead of abrupt topic jumps."
                      ],
                      "title": "Applying Reverse Outlining & Final Paper Alignment"
                    },
                    {
                      "text": "Drafted over three weeks, a policy capstone shifted subtly from rural transport costs to general urban zoning midway through.",
                      "type": "case_study",
                      "title": "Drifted Capstone Chapter",
                      "takeaway": "A 20-minute reverse outline spotlighted the split and reunited intro thesis and conclusion smoothly."
                    },
                    {
                      "text": "Print just your abstract, section headings, and closing synthesis—do they form an airtight logical thread?",
