                  "blocks": [
                    {
                      "text": "Human Confusable Watchlist & Visual Fit",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Keep a sharp conscious eye on classic English traps: `affect` (usually verb: influence) vs. `effect` (usually noun: result); `complement` (completes well) vs. `compliment` (praise); `it's` (it is) vs. `its` (possessive); `fewer` (countable items: fewer tickets) vs. `less` (bulk quantity: less clutter); `ensure` (guarantee) vs. `insure` (financial policy). Visually inspect final exports for awkward broken URLs, ragged widows/orphans, and missing page alignment.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Widows & Orphans",
                      "text": "Isolated single header lines stranded at page bottom (`orphan`) or lone final words sitting awkwardly atop fresh printed/PDF pages (`widow`).",
                      "type": "definition"
                    },
                    {
                      "body": "\"The software updates **complement** (`not compliment`) existing tools to **ensure** (`not insure`) teams face **fewer** (`not less`) errors and see clear **effects** (`not affects`).\"",
                      "type": "example",
                      "title": "High-Alert Confusables Check"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Maintain a personal Search-List of top 10 dangerous valid-word typos (`manager/manger`, `public/pubic`, `assess/asses`, `from/form`, `casual/causal`).",
                        "Audit line breaks across PDF exports checking headings stay paired tightly beside their opening paragraph.",
                        "Verify numbered steps (`1, 2, 3, 4`) actually ascend continuously without duplicate `3, 3` or skipped gaps!"
                      ],
                      "title": "Applying Notorious Homophones, Confusables & Layout Slips"
                    },
                    {
                      "text": "Removing Step 3 during a late copyedit left printed instructional steps reading `1, 2, 4, 5` in a final client guide.",
                      "type": "case_study",
                      "title": "Mangled Number Sequence",
                      "takeaway": "Always scan numeric sequences (`1..N`, `Table 1..4`, `Fig 1..3`) vertically before shipping."
                    },
                    {
                      "text": "One structural cut late in review frequently breaks manual Table/Figure/Step numbering silently—check sequences dedicatedly!",
                      "type": "callout",
                      "title": "Always Verify Number Sequences Last",
                      "variant": "tip"
                    },
