              "lessons": [
                {
                  "id": "93057f72-042d-cf2a-503d-0bc232bd9bee",
                  "title": "Receiving Critique With Poise",
                  "blocks": [
                    {
                      "text": "Curiosity Over Defensiveness",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Natural instinct makes us explain away errors the moment feedback starts. Strong professionals thank the giver, ask one clarifying example to make sure they understand the exact bar, pause before replying, and follow up two weeks later showing the adjusted behavior. Even messy 20%-valid feedback holds gold if mined calmly.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Feedback Separation",
                      "text": "Distinguishing your permanent self-worth as a capable human from a temporary work product or communication habit that needs tuning.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Thanks for flagging that pacing felt rushed—which specific slide or transition felt fastest so I tighten it next week?\"",
                      "type": "example",
                      "title": "Calm Clarifying Questions"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Listen silently until the speaker finishes.",
                        "Paraphrase the key adjustment back without debating intent.",
                        "Say thank you and document 1 concrete next behavior."
                      ],
                      "title": "Applying Receiving Critique With Poise"
                    },
                    {
                      "text": "After receiving candid notes on over-explaining in client meetings, a specialist practiced 30-second answers and asked her manager to observe two weeks later.",
                      "type": "case_study",
                      "title": "Turning Tough Review Into Promotion",
                      "takeaway": "Closing the feedback loop proves coachability rapidly."
                    },
                    {
                      "text": "Requests like \"Could you share one example?\" help vague feedback turn concrete immediately.",
