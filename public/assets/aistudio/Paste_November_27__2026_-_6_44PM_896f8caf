                },
                {
                  "id": "c7dc9465-0f3c-db24-585c-fd0e320d9ed9",
                  "title": "Features, Target Leakage & Train/Validation/Test Splits",
                  "blocks": [
                    {
                      "text": "Strict Split Hygiene & Avoiding Future Leakage",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Split data chronologically or by user into Train (fit parameters), Validation (tune features/hyperparameters), and held-out Test (final unbiased check). Guard ruthlessly against **target leakage**—including features only known AFTER the event happens (e.g., using `completed_at` or `refund_status` to predict day-1 churn!).",
                      "type": "paragraph"
                    },
                    {
                      "term": "Target (Data) Leakage",
                      "text": "Accidentally feeding information into model training features that would not exist at real prediction time in production, creating fake 99% accuracy.",
                      "type": "definition"
                    },
                    {
                      "body": "Keep all attempts by the same `user_id` inside one split rather than letting the same user appear in both Train and Test!",
                      "type": "example",
                      "title": "User-Grouped Splits"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Freeze held-out Test data until all tuning finishes.",
                        "Inspect top model features—suspiciously perfect features almost always indicate leakage.",
                        "Use time-based splits for forecasting/progression problems."
                      ],
                      "title": "Applying Features, Target Leakage & Train/Validation/Test Splits"
                    },
                    {
                      "text": "A dropout model achieved 98% AUC until feature inspection revealed it used `certificate_issued_date`—which is null for dropouts!",
                      "type": "case_study",
                      "title": "Leakage Expose",
                      "takeaway": "Always inspect suspiciously high accuracy immediately."
                    },
                    {
                      "text": "Compute averages, imputation medians, and normalizers strictly on Train data, then apply them to Validation/Test.",
                      "type": "callout",
                      "title": "Fit Scalers on Train Only",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why must imputation medians and scalers be computed strictly on the training split rather than the whole dataset?",
                      "options": [
                        "Faster GPU math",
                        "Computing stats across Test rows leaks distribution information from held-out evaluation data",
                        "Prevents null strings"
                      ],
                      "explanation": "Test splits must remain completely unseen during preprocessing and training.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Clean splits and zero leakage keep ML evaluations honest.",
