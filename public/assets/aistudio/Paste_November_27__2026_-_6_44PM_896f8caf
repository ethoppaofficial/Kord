                      "title": "Purdue OWL Academic & Research Guides",
                      "position": 2,
                      "resource_type": "guide"
                    }
                  ],
                  "takeaways": [
                    "Use lines for trends, sorted bars for comparisons, tables for exact lookup",
                    "Keep bar axes anchored at zero",
                    "Use restraint: one highlight color plus direct numeric labels"
                  ],
                  "objectives": [
                    "Explain purposeful data presentation",
                    "Apply choosing tables vs. simple charts wisely cleanly"
                  ],
                  "est_minutes": 28,
                  "is_required": true,
                  "introduction": "Decorative 3D pie charts with nine tiny slices obscure reality instead of illuminating trends.",
