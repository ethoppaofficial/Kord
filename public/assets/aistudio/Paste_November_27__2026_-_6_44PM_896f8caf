                      "resourceType": "Guide"
                    }
                  ],
                  "publication_status": "published",
                  "completion_criteria": "Study the core frameworks in \"Mastering the Executive Summary\", verify the inline knowledge check, and apply the practical checklist."
                },
                {
                  "id": "f6694582-28e7-3aeb-109c-4949df0fd01c",
                  "title": "Impartial Tone & Visual Scan Polish",
                  "blocks": [
                    {
                      "text": "Consistent Typography & Neutral Register",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Readable reports respect visual breathing room: uniform heading hierarchies, generous table padding, crisp bulleted takeaways, consistent numeric precision (`18.4%` vs. `18%`), and calm objective vocabulary. Readers subconsciously equate tidy formatting with analytical thoroughness.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Visual Precision Parity",
                      "text": "Maintaining consistent decimal rounding, date style (`Oct 14, 2026`), currency marks, and heading capitalization across every single page.",
                      "type": "definition"
                    },
                    {
                      "body": "Round cleanly to 1 decimal consistently (`14.2%`, `28.0%`) instead of mixing `14%` with `28.431%` in adjacent table rows.",
                      "type": "example",
                      "title": "Consistent Style Cleanliness"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Standardize decimal places and units inside every table column.",
                        "Place informative headers and page numbers cleanly on multi-page exports.",
                        "Replace emotional punctuation (`!`, `...`) strictly with calm declarative periods."
                      ],
                      "title": "Applying Impartial Tone & Visual Scan Polish"
                    },
                    {
                      "text": "An audit table mixed `0.42`, `45%`, and `1/3` inside adjacent rows, distracting finance directors completely.",
                      "type": "case_study",
                      "title": "Mixed Decimal Clutter",
                      "takeaway": "Standardizing cleanly onto aligned percentages made comparisons effortless immediately."
                    },
                    {
                      "text": "Never let a heading sit stranded at page bottom while its table drops onto the next page alone.",
                      "type": "callout",
                      "title": "Inspect Exported PDF Page Breaks",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why enforce identical decimal places and unit formatting down every report table column?",
                      "options": [
                        "Makes pages longer",
                        "Uniform precision speeds side-by-side mental scanning cleanly without distraction",
                        "Replaces legends"
