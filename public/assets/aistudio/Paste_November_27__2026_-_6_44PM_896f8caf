                {
                  "id": "542eec7e-4110-053a-44bd-bfd06a319411",
                  "title": "Sustainable Editorial Calendars & Governance",
                  "blocks": [
                    {
                      "text": "Flexible Theme Sprints & Style Governance",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Anchor calendars on realistic quarterly **Campaign Themes** rather than panicked Tuesday blank slots. Hold two distinct editorial queues cleanly: `Scheduled Strategic Pillars` (predictable evergreen depth) plus nimble `Timely Slots` reserved smoothly for product launches or real market shifts—governed by one accessible living Style & Brand Guide.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Two-Track Calendar",
                      "text": "Balancing predictable long-lead cornerstone production (`75% capacity`) against dedicated nimble reaction buffers (`25% capacity`) for surprise product updates or trends.",
                      "type": "definition"
                    },
                    {
                      "body": "Weeks 1 & 3: Cornerstone Cluster Releases + Social/Email Atomization. Week 2: Existing Asset ROT Refresh. Week 4: Customer Case Teardown + Strategic Buffer.",
                      "type": "example",
                      "title": "Healthy Monthly Rhythm"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Never fill calendars 100% rigid—protect buffer weeks for updates and launches.",
                        "Keep all briefs, status tags, and canonical URLs inside one visible shared workspace.",
