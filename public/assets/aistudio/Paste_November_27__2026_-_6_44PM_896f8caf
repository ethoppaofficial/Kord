                {
                  "id": "6e2edc50-2049-c612-dd75-97b2c85af625",
                  "title": "Subject-Matter Experts (SMEs) & Editorial Workflows",
                  "blocks": [
                    {
                      "text": "15-Minute SME Extraction Pipelines",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Instead of begging busy engineers, founders, or designers to \"write us a guest article\" (which stalls for months), book structured **15-minute recorded audio interviews** with three targeted scenario questions. Writers transcribe messy brilliance cleanly into polished prose and route drafts back strictly for 10-minute factual review—keeping pipeline velocity crisp.",
                      "type": "paragraph"
                    },
                    {
                      "term": "SME Extraction Interview",
                      "text": "Short focused 15-minute conversational Q&A capturing practitioner war stories, edge cases, and genuine nuance cleanly for a skilled writer to shape into finished articles.",
                      "type": "definition"
                    },
                    {
                      "body": "1. \"What mistake do newcomers commit every single time here?\" 2. \"Walk through a recent weird edge case.\" 3. \"When is the textbook rule actually wrong?\"",
                      "type": "example",
                      "title": "Three Sharp SME Questions"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Send 3 concrete story-prompt questions 24 hours ahead (never demand blank writing!).",
                        "Record clean audio/transcript and build a clear structured draft for quick verification.",
                        "Keep workflow stages lean cleanly: `Brief -> SME Sync -> Draft -> Structural Edit -> Factual Check -> Published`."
                      ],
                      "title": "Applying Subject-Matter Experts (SMEs) & Editorial Workflows"
                    },
                    {
                      "text": "Four engineering leaders missed twelve consecutive deadlines trying to find Friday hours to draft posts.",
                      "type": "case_study",
                      "title": "Stalled Founder Blog Queue",
                      "takeaway": "Switching to 15-minute Tuesday coffees shipped eight authoritative technical case studies smoothly in two months."
                    },
                    {
                      "text": "Too many simultaneous committee editors water bold clarity into bland compromise—name ONE factual SME and ONE voice editor.",
                      "type": "callout",
                      "title": "Use One Factual Approver, Not Five",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "How do efficient teams capture busy engineers’ or founders’ true expertise without stalling deadlines?",
                      "options": [
                        "Send blank Google Docs demanding 1,500 words weekly",
                        "Run crisp 15-minute recorded practitioner interviews and assign skilled editors to draft + fact-check cleanly",
                        "Publish unedited Slack dumps"
                      ],
                      "explanation": "Low-friction extraction protects practitioners’ time while locking authentic depth into copy.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Lightweight extraction workflows and minimal approval gates sustain unstoppable editorial quality.",
