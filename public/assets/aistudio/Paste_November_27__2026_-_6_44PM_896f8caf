            {
              "id": "fb0cc3ef-d64d-83ee-8ece-c5b471483c03",
              "title": "Module 5: Translating Strategy into Quarterly Execution",
              "lessons": [
                {
                  "id": "06bbed1f-3350-fc06-70a2-4a053568c7d9",
                  "title": "Why Good Strategies Die Inside Bloated OKR Spreadsheets",
                  "blocks": [
                    {
                      "text": "Ruthless Quarterly Focus & Leading Indicators",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Effective execution picks strictly **1–3 Overarching Strategic Bets per Quarter**—never 12! Track **Leading Input Indicators** (`actions teams genuinely control THIS Tuesday`, e.g., `\"20 live customer problem interviews + Day-3 onboarding setup >70%\"`) closely alongside lagging results (`annual revenue`), paired cleanly with **Guardrail Metrics** ensuring speed never silently cannibalizes retention or quality!",
                      "type": "paragraph"
                    },
                    {
                      "term": "Leading vs. Lagging Indicators",
                      "text": "Leading inputs measure controllable early behaviors predicting success soon (`setup completion, qualified demos`), whereas Lagging metrics measure backward final results months later (`annual profit, churn`).",
                      "type": "definition"
                    },
                    {
                      "body": "Goal: Double organic client growth cleanly. Quarterly Bet: Launch sharp industry case-study engine (`Leading: 2 verified studies/mo + 15 referral asks/wk; Guardrail: Keep existing client CSAT >=4.7/5`).",
                      "type": "example",
                      "title": "Balanced Strategic Bet"
                    },
                    {
                      "type": "steps",
                      "items": [
