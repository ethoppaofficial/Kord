                  "blocks": [
                    {
                      "text": "Actionable Written Critique",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Great written feedback separates structural observations (`Priority / Blocking`) from optional cosmetic polish (`Nitpick / Optional`), anchors comments on exact section names or quotes, explains WHY a reader stumbled (\"Moving from pricing to tech specs felt sudden\"), and highlights two concrete things working strongly already.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Blocking vs. Optional Tagging",
                      "text": "Prefixing peer feedback bullets clearly as `[Must Fix]`, `[Suggestion]`, or `[Minor Nit]` so creators prioritize urgent edits effortlessly.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Strong narrative hook on page 1!\n• [Must Fix] Section 3 still cites Q2 pricing ($49); verify if $59 applies.\n• [Suggestion] Consider moving Figure 2 higher so timeline jumps make instant sense.\"",
                      "type": "example",
                      "title": "Clear Tagged Review Note"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Open with specific genuine strengths observed—not hollow fluff.",
                        "Label blocking factual/clarity issues distinctly from stylistic taste preferences.",
                        "Offer concrete improvement ideas rather than vague dissatisfaction."
                      ],
                      "title": "Applying Written Peer Review & Feedback Requests"
                    },
                    {
                      "text": "Returning 28 unmarked comma edits alongside two fatal broken logic flaws caused a junior writer to overlook the critical fix.",
                      "type": "case_study",
                      "title": "Demoralizing Nitpick Avalanche",
                      "takeaway": "Grouping strictly into Top 2 Structural Priorities + 3 Minor Polishes unlocked fast revision smoothly."
                    },
                    {
                      "text": "Mark personal phrasing preferences gently (`Optional preference`) so teammates retain creative ownership.",
