              "lessons": [
                {
                  "id": "279a05b6-d748-72f7-527c-4540667eb58f",
                  "title": "Audience-First Message Framing",
                  "blocks": [
                    {
                      "text": "Designing Messages Around Listener Context",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Effective communicators start by diagnosing the knowledge gap between sender and receiver. When you share an update with a peer, they may need step-by-step technical context; when you brief a manager, they need impact on timeline and the exact decision required. Framing the core ask in the first two sentences reduces cognitive strain and builds immediate trust.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Curse of Knowledge",
                      "text": "Cognitive bias where an expert assumes listeners already share background context, acronyms, and constraints that were never stated aloud.",
                      "type": "definition"
                    },
                    {
                      "body": "Instead of writing \"The API thing is delayed until we check the partner doc\", write \"Checkout release moves from Thursday to Monday because partner webhook specs changed; approve shifting QA to Monday 9:00 AM?\"",
                      "type": "example",
                      "title": "Rewriting a Vague Project Update"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Name the receiver and the concrete decision or awareness they need.",
                        "State your main point and timeline impact in sentence one.",
                        "List supporting facts only where they justify the recommendation.",
                        "End with explicit owner, deadline, and confirmation prompt."
                      ],
                      "title": "Applying Audience-First Message Framing"
                    },
                    {
                      "text": "A product designer sent six Slack paragraphs about color tokens without mentioning whether developers should pause work. Four engineers paused unnecessarily.",
                      "type": "case_study",
                      "title": "Cross-Team Launch Misalignment",
                      "takeaway": "Explicitly labeling messages as FYI, Input Needed, or Decision Required prevents wasted team hours."
                    },
                    {
                      "text": "Start messages with \"[Decision needed by 4 PM]\" or \"[FYI - no action]\" so busy teammates triage accurately.",
                      "type": "callout",
                      "title": "Label the Ask Early",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What is the best cure for the Curse of Knowledge before sending an update?",
                      "options": [
                        "Using longer sentences with more adjectives",
                        "Stating background context, impact, and explicit next action upfront",
                        "Waiting until a weekly meeting to mention blockers"
                      ],
                      "explanation": "Explicit context and a clear ask close the gap between what you know and what the listener needs.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Framing messages for the listener turns scattered thoughts into actionable clarity.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "09df61ff-83a9-4840-b7db-63624882c319",
                      "url": "https://www.plainlanguage.gov/guidelines/",
                      "title": "Plain Language Guidelines & Clarity Principles",
                      "position": 1,
