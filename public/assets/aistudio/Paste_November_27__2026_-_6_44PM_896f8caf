                    },
                    {
                      "id": "d8c962bd-a116-43c8-b5d6-b765d72195dc",
                      "url": "https://www.nngroup.com/",
                      "title": "Nielsen Norman Group UX & Copy Clarity",
                      "position": 2,
                      "resource_type": "research"
                    }
                  ],
                  "takeaways": [
                    "Write 10+ headline options before choosing",
                    "Follow the Rule of One focus",
                    "Pre-answer primary hesitation inside subheads"
                  ],
                  "objectives": [
                    "Analyze specificity, value & qualifier design",
                    "Apply headline mechanics that earn reading in original writing"
                  ],
                  "est_minutes": 28,
                  "is_required": true,
                  "introduction": "As David Ogilvy noted, five times more people read the headline than read body copy—so weak headlines waste everything below.",
                  "further_reading": [
