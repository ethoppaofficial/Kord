            {
              "id": "224a23fb-baed-111f-17cc-d2e55e5b08c2",
              "title": "Module 4: Client & Cross-Department Communication",
              "lessons": [
                {
                  "id": "4c9f3c3e-ed43-8dae-8dfa-ce0a0050dbcd",
                  "title": "Client Expectation & Scope Care",
                  "blocks": [
                    {
                      "text": "Proactive Milestone & Scope Hygiene",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Great account communicators set explicit definitions of \"done\" before work begins, recap every call within two hours, and surface scope trade-offs politely the moment extra requests appear. Framing scope control as protecting the client's primary launch goal preserves partnership warmth while preventing unpaid scope creep.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Change-Order Framing",
                      "text": "Acknowledging a client's new idea enthusiastically while explaining its impact on timeline/budget and offering clean phased options.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Great idea adding custom analytics! To keep your October 15 launch on schedule, let us keep Phase 1 locked and scope analytics as a 1-week Phase 2 add-on for £1,200.\"",
                      "type": "example",
                      "title": "Handling Late Feature Add-Ons"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Confirm exact acceptance criteria in kickoffs.",
                        "Send structured Friday client recaps even during quiet build weeks.",
                        "Quote timeline and price options the same day extra work is requested."
                      ],
                      "title": "Applying Client Expectation & Scope Care"
                    },
                    {
                      "text": "Going quiet for two weeks while fixing bugs led a client to assume nothing was progressing and demand a refund call.",
                      "type": "case_study",
                      "title": "The Silent Friday Gap",
                      "takeaway": "Predictable weekly Friday recaps cut anxiety calls nearly to zero."
                    },
                    {
                      "text": "Consistent Friday notes build deeper client trust than sporadic surprise bursts.",
                      "type": "callout",
                      "title": "Predictability Beats Perfection",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "How should you respond the day a client requests extra unbudgeted features?",
                      "options": [
                        "Silently absorb the extra hours until delivery fails",
                        "Affirm the idea and offer clear Phase 2 pricing or timeline trade-offs immediately",
                        "Refuse bluntly with legal contract quotes"
                      ],
                      "explanation": "Timely phased options protect relationship goodwill and schedule integrity.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Proactive predictability prevents scope creep and protects client trust.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "49898751-4b42-4747-acea-a368d41abf83",
                      "url": "https://www.plainlanguage.gov/guidelines/",
                      "title": "Plain Language Guidelines & Clarity Principles",
                      "position": 1,
                      "resource_type": "guide"
                    },
                    {
                      "id": "6c574aaa-989e-4295-a39e-8522ae02ab33",
                      "url": "https://www.mindtools.com/",
                      "title": "Communicating Clearly in Workplaces",
                      "position": 2,
                      "resource_type": "article"
                    }
                  ],
                  "takeaways": [
                    "Never let silent gaps form during active delivery",
                    "Surface scope impacts immediately with constructive phases",
                    "Recap verbal client agreements in writing promptly"
                  ],
                  "objectives": [
                    "Explain proactive milestone & scope hygiene",
                    "Apply client expectation & scope care in everyday scenarios"
                  ],
                  "est_minutes": 28,
                  "is_required": true,
                  "introduction": "Client relationships rarely sour over high prices; they sour over surprise delays and vague deliverables.",
                  "further_reading": [
                    {
                      "url": "https://www.plainlanguage.gov/guidelines/",
