                {
                  "id": "d9143a1d-31bf-5c99-82a5-b768fb0643c6",
                  "title": "Integrating Quotations & Avoiding Dropped Quotes",
                  "blocks": [
                    {
                      "text": "Signal Phrases, Paraphrase & Quote Sandwiches",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Paraphrase empirical data and general background cleanly in your own analytical voice, reserving direct quotes strictly when exact wording matters (legal text, contested terminology, vivid primary testimony). Always embed quotes with framing signal phrases introducing speaker credibility and analytical interpretation afterward.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Dropped Quote",
                      "text": "A standalone verbatim quotation inserted abruptly as its own sentence without an introductory signal phrase or follow-up explanation.",
                      "type": "definition"
                    },
                    {
                      "body": "Dropped: \"Algorithms embed historical bias.\" Integrated: As Noble (2018) demonstrates in examining search ranking defaults, commercial metrics routinely \"embed historical bias\" (p. 44) unless audited externally.",
                      "type": "example",
                      "title": "Framing a Key Quote"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Prefer faithful deep paraphrasing over heavy quotation patches.",
                        "Frame essential short quotes inside your own grammatical sentence.",
                        "Follow every quoted claim with analysis connecting it back to your thesis."
                      ],
                      "title": "Applying Integrating Quotations & Avoiding Dropped Quotes"
                    },
                    {
                      "text": "Over 35% of a submitted term paper consisted of multi-sentence block quotes leaving little visible student reasoning.",
                      "type": "case_study",
                      "title": "Quote-Heavy Undergrad Paper",
                      "takeaway": "Paraphrasing findings tightly and spotlighting brief key phrases raised voice ownership dramatically."
                    },
                    {
                      "text": "If an author states plain numerical facts cleanly paraphrasable, summarize concisely in your own words with full citation.",
                      "type": "callout",
                      "title": "Quote Only Distinct Language",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "When is direct verbatim quotation strongly preferable to paraphrasing?",
                      "options": [
                        "For ordinary statistical sample sizes",
                        "When analyzing precise legal wording, distinctive conceptual definitions, or primary-source voices",
                        "To fill page minimums"
                      ],
                      "explanation": "Paraphrase standard facts; quote verbatim strictly when exact language carries analytical weight.",
                      "correctIndex": 1
