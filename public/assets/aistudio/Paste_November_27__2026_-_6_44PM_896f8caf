                {
                  "id": "819314f1-fc13-6bff-6e19-32ae20879a24",
                  "title": "Confirmation & Survivorship Bias",
                  "blocks": [
                    {
                      "text": "Searching Actively for Disconfirming Evidence",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Confirmation bias filters out warning signs contradicting what we hope works; survivorship bias studies winning founders or features while forgetting hundreds of identical-looking failures buried quietly. Deliberately assigning a \"disconfirming check\"—looking specifically for where similar launches stumbled—sharpens judgment drastically.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Survivorship Bias",
                      "text": "Drawing flawed conclusions solely from visible survivors while ignoring invisible failures sharing identical traits.",
                      "type": "definition"
                    },
                    {
                      "body": "Studying why 10 power users stayed without checking why 90 onboarding accounts quit week one hides critical landing flaws completely.",
                      "type": "example",
                      "title": "Examining Lost Customers Alongside Wins"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Seek out 3 strong facts contradicting your preferred thesis.",
                        "Inspect dropouts, lost deals, and quiet failures equally.",
                        "Keep objective decision criteria locked before reading results."
                      ],
                      "title": "Applying Confirmation & Survivorship Bias"
                    },
                    {
                      "text": "Instead of copying competitors' winning flashy landing headers, studying churned exit notes revealed simple missing pricing clarity fixed conversion overnight.",
                      "type": "case_study",
                      "title": "Turnaround Retention Diagnosis",
                      "takeaway": "Studying dropouts yields sharper diagnosis than copying celebrity wins."
                    },
                    {
                      "text": "Ask before locking big choices: \"What exact observable fact would prove our favorite plan wrong?\"",
                      "type": "callout",
                      "title": "Run a Mandatory Disconfirmation Check",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What critical blind spot defines Survivorship Bias?",
                      "options": [
