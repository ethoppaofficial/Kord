                {
                  "id": "513196da-46c3-134e-cb20-7ed42a6e9414",
                  "title": "Smoke Tests & Wizard-of-Oz MVPs",
                  "blocks": [
                    {
                      "text": "Validating Pull Before Coding Infrastructure",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Choose the lightest tool matching your current question: **Smoke Test Landing Pages** test messaging resonance & signup intent honestly (`\"Early-access checkout test\"` transparently disclosing upcoming pilot dates); **Wizard-of-Oz MVPs** show a crisp manual front-end while humans secretly process tasks manually behind the curtain for test #1–15 (`Dropbox famously used a clean 3-minute explainer video before syncing live cross-OS drivers!`).",
                      "type": "paragraph"
                    },
                    {
                      "term": "Wizard-of-Oz MVP",
                      "text": "Delivering a seamless front-end user experience powered discreetly behind the scenes by manual human workflows before investing months automating backend algorithms.",
                      "type": "definition"
                    },
                    {
                      "body": "Testing an \"AI Receipt Categorizer\" MVP? Let users upload photos into a tidy simple web form while founders manually classify rows inside Google Sheets overnight—discovering exact weird receipt formats buyers send before training models!",
                      "type": "example",
                      "title": "Manual Backend Magic"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Ask honestly: \"How could we deliver this exact outcome inside 72 hours WITHOUT building custom databases yet?\"",
                        "Maintain radical quality on the narrow promised front experience—never confuse sloppy bugs with lean speed!",
                        "Use manual runs intentionally to spot edge cases automating cleanly later."
                      ],
                      "title": "Applying Smoke Tests & Wizard-of-Oz MVPs"
                    },
                    {
                      "text": "Engineers built complex automated PDF invoice OCR engines for months before testing 20 real users—only to discover users happily exported native CSVs already!",
                      "type": "case_study",
                      "title": "Six-Month Unseen Parser",
                      "takeaway": "Wizard-of-Oz runs kill unnecessary engineering cleanly early."
                    },
                    {
                      "text": "On smoke/waitlist tests, be candid (`\"Join Q1 Founding Pilot Cohort\"`)—never fake broken checkout buttons angrily deceiving visitors.",
                      "type": "callout",
                      "title": "Never Trivialize User Trust",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What makes a Wizard-of-Oz MVP smarter than rushing straight into full backend automation?",
                      "options": [
                        "Hides product pricing forever",
                        "Surfaces real messy user inputs and validates true habit pull before committing expensive engineering months",
                        "Avoids customer conversations"
                      ],
                      "explanation": "Human-powered test loops learn messy real workflows while validating genuine user value upfront.",
