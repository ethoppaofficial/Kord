                  "blocks": [
                    {
                      "text": "Neutralizing Perceived Harshness",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Short messages like \"Why wasn't this sent?\" read sharply on screen even when typed hurriedly between calls. Adding one small neutral cushion (\"Thanks for flagging—when can we expect the revised export?\") preserves directness without sparking defensiveness. Equally important: assume clumsy phrasing by stressed peers stems from hurry, not malice, until proven otherwise.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Generous Interpretation Rule",
                      "text": "Defaulting to reading ambiguous written messages charitably (\"probably rushed\") and clarifying calmly rather than reacting defensively.",
                      "type": "definition"
                    },
                    {
                      "body": "Replace \"This still isn't fixed.\" with \"Quick check on the login patch—curious where things stand before noon customer calls?\"",
                      "type": "example",
                      "title": "Softening Urgent Pings"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Read hurried replies aloud warmly before hitting Send.",
                        "Never fire back emotional messages when annoyed—draft in notes, wait 20 minutes.",
                        "Add brief appreciation when colleagues help across teams."
                      ],
                      "title": "Applying Managing Digital Tone & Emotional Neutrality"
                    },
                    {
                      "text": "Two coordinators almost escalated a phrasing misunderstanding to HR until a manager asked both to speak live for three minutes.",
                      "type": "case_study",
                      "title": "Preventing Email Flame Wars",
                      "takeaway": "Tone friction evaporates fast once people hear real voices."
                    },
                    {
                      "text": "Whenever a message raises your pulse, draft your reply in a local scratchpad and wait twenty minutes before touching Send.",
                      "type": "callout",
                      "title": "Twenty-Minute Cooling Buffer",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What is the safest immediate habit when you receive a curt, frustrating workplace email?",
                      "options": [
                        "Reply within 30 seconds matching their curtness",
                        "Pause, draft offline if needed, interpret charitably, or clarify calmly live",
                        "Forward it broadly to peers to vent"
