                {
                  "id": "27fc5114-c942-4aea-297b-21e17c225431",
                  "title": "Avoiding Bureaucracy & Maintaining Strategic Clarity",
                  "blocks": [
                    {
                      "text": "Single-Page Transparency & Clear Owners",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Guard operational clarity fiercely as teams expand: every goal holds ONE clear accountable owner (`D` Driver), plans live in one shared readable source rather than hidden conflicting folders, and meetings exist solely to clear friction or align clear tradeoffs—never pure theater. Keep customer feedback wired directly back into quarterly reviews forever.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Single-Accountable Owner Rule",
                      "text": "Ensuring every quarterly Key Result, hiring milestone, and risk mitigation carries strictly ONE named primary driver—never vague multi-person shared ownership.",
                      "type": "definition"
                    },
                    {
                      "body": "KR2: Lift active Day-14 user setup from 48% to 70% — Owner: Priya (Onboarding Lead) · Support: Engineering & Support.",
                      "type": "example",
                      "title": "Clean Accountability Tag"
