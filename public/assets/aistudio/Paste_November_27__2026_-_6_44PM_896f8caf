                  "blocks": [
                    {
                      "text": "Agenda-First Calls & Pre-Reads",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Never host a meeting purely to read updates aloud—send written updates async. Reserve live calls for messy disagreements, sensitive feedback, brainstorming, or team bonding. Every meeting invite requires: 1) Clear decision/goal, 2) 3-bullet agenda, 3) Optional status—only invite true decision-makers and contributors.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Meeting Pre-Read",
                      "text": "A short 1-page summary shared before a call (or read quietly in the first 5 minutes) so live discussion focuses purely on debate and decisions.",
                      "type": "definition"
                    },
                    {
                      "body": "\"No open decisions needed this week—canceling Thursday’s 30-min sync and posting progress bullets below!\"",
                      "type": "example",
                      "title": "Cancel Safely"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Require an explicit agenda on every calendar invite—decline vague blank invites kindly.",
                        "Default meetings to 25 or 50 minutes to leave breathing space between calls.",
                        "Assign one facilitator and one note-taker upfront."
                      ],
                      "title": "Applying Only Meeting When Async Fails: Lean Agendas"
                    },
                    {
                      "text": "Requiring agendas + pre-reads eliminated 40% of recurring status calls across a distributed engineering & marketing org.",
                      "type": "case_study",
                      "title": "Halved Calendar Load",
                      "takeaway": "Respecting calendars earns immediate team gratitude."
                    },
                    {
                      "text": "If a decision resolves cleanly in 12 minutes of a 30-minute slot, give everyone 18 minutes back immediately.",
                      "type": "callout",
                      "title": "End Early When Done",
                      "variant": "tip"
                    },
                    {
