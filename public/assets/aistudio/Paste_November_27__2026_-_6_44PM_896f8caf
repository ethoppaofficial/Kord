                  "blocks": [
                    {
                      "text": "High-Stakes Pre-Send Protocol",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Before sending any external proposal, executive memo, or sensitive response, run a dedicated 60-second verification scan: verify recipient lists (`To` vs. `CC`), check file attachments match your text claims, validate every number/date twice, and ensure zero embarrassing leftover draft text remains.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Attachment-Body Match",
                      "text": "Confirming every document referenced as attached is actually attached and labeled with a clean external filename (`Client_Proposal_v2_Oct2026.pdf`, not `draft_FINAL_2.docx`).",
                      "type": "definition"
                    },
                    {
                      "body": "Rename `Budget_v4_test_JD.xlsx` to `Acme_Q4_Budget_Summary.xlsx` before sending externally.",
                      "type": "example",
                      "title": "Clean File Naming Discipline"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Read recipient names and email addresses last—right before clicking send.",
                        "Confirm filename clarity and PDF export rendering on mobile/desktop.",
                        "Check dates against an actual calendar (e.g., verify Nov 14 really falls on Thursday)."
                      ],
                      "title": "Applying Pre-Send Quality Gate for High-Stakes Docs"
                    },
                    {
                      "text": "A consultant reused a previous proposal and left the old competitor’s name inside footer text.",
                      "type": "case_study",
                      "title": "Wrong Client Template Remnant",
                      "takeaway": "Doing a Ctrl+F check for old client names and checking exported PDFs eliminates template embarrassment cleanly."
                    },
