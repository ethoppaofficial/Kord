                {
                  "id": "33837e83-c0cd-cb95-86a6-90d232b5978d",
                  "title": "Pricing Logic & Milestone Deposit Protection",
                  "blocks": [
                    {
                      "text": "Value Anchoring & Deposit Milestones",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Never start substantive client execution without a written contract and an upfront deposit (typically 40–50% upfront, 50% prior to final production transfer/launch; or 40/30/30 on larger builds). Price around project complexity, timeline urgency, and client value—not panic-discounting below sustainable hourly living costs.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Kill Fee / Milestone Deposit",
                      "text": "An upfront partial payment securing calendar capacity and compensating work completed if a client pauses or cancels mid-project.",
                      "type": "definition"
                    },
                    {
                      "body": "\"50% deposit to reserve sprint week and begin kickoff; remaining 50% due upon staging approval prior to live domain/source release.\"",
                      "type": "example",
                      "title": "Clean 50/50 Terms"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Calculate your true minimum sustainable rate factoring taxes, non-billable admin, and unpaid holidays.",
                        "Invoice cleanly with clear payment methods and 7–14 day due terms.",
                        "Release final editable master files after final milestone clears."
                      ],
                      "title": "Applying Pricing Logic & Milestone Deposit Protection"
                    },
                    {
                      "text": "Requiring a 50% deposit filtered out an indecisive prospect cleanly while confirming a serious client within 24 hours.",
                      "type": "case_study",
                      "title": "Protected Sprint Slot",
                      "takeaway": "Deposits separate real clients from tire-kickers."
                    },
                    {
                      "text": "If you work 40 hrs/week, expect roughly 25 billable hours once outreach, invoicing, and admin are counted—price accordingly!",
                      "type": "callout",
                      "title": "Track Non-Billable Hours",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why collect a 40–50% milestone deposit before starting client project execution?",
                      "options": [
                        "Looks greedy",
                        "Secures project commitment, protects cash flow, and shares risk fairly between both sides",
                        "Bypasses taxes"
                      ],
                      "explanation": "Upfront deposits protect calendar capacity and reduce non-payment risk sharply.",
                      "correctIndex": 1
