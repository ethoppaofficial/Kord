            {
              "id": "5c092ee8-8a8e-3ab6-0495-6868e470d4d2",
              "title": "Module 6: Evaluating Offers, Onboarding & First 90 Days",
              "lessons": [
                {
                  "id": "2a41da4b-39e3-3aaf-12b3-151d236790ad",
                  "title": "Evaluating Job Offers & Professional Negotiation",
                  "blocks": [
                    {
                      "text": "Assessing Learning Curve, Scope, Manager & Total Package",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Evaluate offers holistically: role clarity, manager mentorship quality, financial stability, learning velocity, remote flexibility, and total compensation. When negotiating, express genuine enthusiasm first, cite clear market/scope reasoning calmly, ask open collaborative questions (\"Is there flexibility on base or a 6-month review milestone?\"), and get final terms clearly in writing.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Collaborative Negotiation",
                      "text": "Framing compensation or scope requests as joint problem-solving around shared long-term contribution rather than adversarial demands.",
                      "type": "definition"
                    },
                    {
                      "body": "\"I’m really excited about joining the team and the 90-day roadmap. Given my portfolio in analytics and X, is there room to move closer to £34k?\"",
                      "type": "example",
                      "title": "Calm Offer Question"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Always ask for 24–48 hours calmly to review written offer details.",
                        "Clarify probation expectations, equipment, benefits, and hours upfront.",
                        "Prioritize trustworthy managers and real craft growth early in your career."
                      ],
                      "title": "Applying Evaluating Job Offers & Professional Negotiation"
                    },
                    {
                      "text": "Asking cleanly about on-call rotation and weekly review cadence before signing avoided a mismatched role expectation completely.",
                      "type": "case_study",
                      "title": "Scope Clarity Saved Burnout",
                      "takeaway": "Clarifying expectations early protects both parties."
                    },
                    {
                      "text": "Confirm verbal promises (remote days, title review, stipend) kindly via updated written offer letter before resigning elsewhere.",
                      "type": "callout",
                      "title": "Get Everything In Writing",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What helps compensation negotiation feel collaborative rather than confrontational?",
                      "options": [
                        "Issuing ultimatums immediately",
                        "Expressing genuine enthusiasm while calmly sharing clear market/skill context and asking open questions",
                        "Sharing personal rent bills"
                      ],
                      "explanation": "Enthusiasm paired with objective reasoning keeps goodwill high.",
                      "correctIndex": 1
                    }
                  ],
