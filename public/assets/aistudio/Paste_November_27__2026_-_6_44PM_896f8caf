                },
                {
                  "id": "2b9136c2-6cf1-1a39-1cd8-d6302f76ec0e",
                  "title": "Neutralizing Lowball Anchors",
                  "blocks": [
                    {
                      "text": "Separating Counter-Anchor From Emotion",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Never match an insulting lowball with anger or move halfway from their extreme offer. Instead, label their number gently as out of bounds (\"Thanks for sharing that budget constraint—£1,500 doesn't cover senior scope, so let's either adjust deliverables or look at phased rollout at £4,500\"), resetting the anchor cleanly around real scope.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Re-Anchoring Pivot",
                      "text": "Explicitly declining an extreme opening figure while resetting discussion onto objective scope benchmarks or phased packages.",
                      "type": "definition"
                    },
                    {
                      "body": "\"At £1,200/month we cannot sustain weekly reporting and ad design; we can run reporting-only at £1,500 or full management at £2,800.\"",
                      "type": "example",
                      "title": "Countering a Low Retainer Offer"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Acknowledge without validating the unreasonable number.",
                        "Ask how they calculated their figure to test if error or tactic.",
                        "Reset with a scoped benchmarked counter-offer."
                      ],
                      "title": "Applying Neutralizing Lowball Anchors"
                    },
                    {
                      "text": "When a contractor quoted £10k and buyer countered £2k, \"meeting halfway\" at £6k meant losing money; scoping down Phase 1 to £5k saved margin cleanly.",
                      "type": "case_study",
                      "title": "Halving Trap Avoided",
                      "takeaway": "Trade scope down rather than discounting unit rates."
                    },
                    {
                      "text": "Protect unit value by trimming optional deliverables whenever buyer budget stays capped.",
                      "type": "callout",
                      "title": "Never Split Extreme Gaps",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "How should you respond to an unrealistic lowball counter-offer?",
                      "options": [
                        "Immediately accept to stay polite",
                        "Challenge aggressively and walk out abruptly",
                        "Separate rate from scope—propose narrower Phase 1 deliverables or restate benchmarked terms"
                      ],
                      "explanation": "Reframing around scope vs. rate preserves margin and keeps dialogue productive.",
                      "correctIndex": 2
                    }
