                {
                  "id": "d7aefea5-8442-d6b3-710c-bec9f4efe6ed",
                  "title": "Self-Proofreading Traps & Fixes",
                  "blocks": [
                    {
                      "text": "Overcoming Familiarity Blindness",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Skimming silently lets your brain auto-complete missing prepositions or wrong homophones (\"their/there\", \"it's/its\"). Proven defenses include reading aloud slowly, scanning backwards sentence-by-sentence strictly for spelling, and checking proper nouns and numbers in a separate pass.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Familiarity Blindness",
                      "text": "Mental auto-correction where a writer sees what they intended to write rather than the missing or misspelled words on screen.",
                      "type": "definition"
                    },
                    {
                      "body": "Change font size or read from printed/PDF preview—your eyes process familiar text as brand-new layout and spot skipped articles immediately.",
                      "type": "example",
                      "title": "Catching Silent Errors"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Read aloud slowly without skipping small words.",
                        "Verify every number, date, URL, and person’s name deliberately.",
                        "Run a final check specifically on headings, captions, and calls to action."
                      ],
                      "title": "Applying Self-Proofreading Traps & Fixes"
                    },
                    {
                      "text": "A newsletter body passed triple review while a misspelled product name sat in giant 36px bold type at the top.",
                      "type": "case_study",
                      "title": "Headlines Hide Typos",
                      "takeaway": "Always inspect large display headlines carefully—editors notoriously skip giant text."
                    },
                    {
                      "text": "Spellcheck approves \"form\" when you meant \"from\" and \"public\" when you typed \"pubic\"—human reading aloud stays irreplaceable.",
                      "type": "callout",
                      "title": "Never Trust Spellcheck Alone",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Which habit defeats familiarity blindness most reliably?",
                      "options": [
                        "Skimming silently at double speed",
                        "Reading aloud slowly or changing layout/font before proofreading",
                        "Relying strictly on browser spellcheck"
                      ],
                      "explanation": "Slowing eye speed via voice or visual layout shifts prevents mental auto-completion.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Intentional proofreading tricks catch errors that rushed skimming always misses.",
