              "lessons": [
                {
                  "id": "ee2a5851-3ebf-7937-9b4f-a3772bf3faed",
                  "title": "Impartial Findings vs. Actionable Proposals",
                  "blocks": [
                    {
                      "text": "Structural Evidence Separation",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Findings report verifiable reality strictly without blame or judgment: \"In 41% of audited calls (n = 35/85), CRM disposition tags remained blank at close.\" Recommendations then follow separately as concrete proposals linking back explicitly: \"Rec 1 (Addresses Finding 2): Add mandatory 1-click tag dropdown before ticket close.\"",
                      "type": "paragraph"
                    },
                    {
                      "term": "Traceability Link",
                      "text": "Labeling every Recommendation (`R1`, `R2`) explicitly against the numbered Finding (`F1`, `F3`) that justifies spending time or money on it.",
                      "type": "definition"
                    },
                    {
                      "body": "Finding 3: Onboarding setup dropped 28% between Step 2 and Step 3 on mobile. Recommendation 3 (Addresses F3): Combine Steps 2–3 on mobile screens and add saved progress state.",
                      "type": "example",
                      "title": "Clean Separation Example"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Scrub judgment adjectives (\"lazy\", \"broken\", \"incompetent\") strictly out of Findings.",
                        "Support every Finding directly with observed log data, quotes, or document counts.",
                        "Give every Recommendation a clear Rationale, Effort Estimate, Priority (`High/Med`), and Suggested Owner Role."
                      ],
                      "title": "Applying Impartial Findings vs. Actionable Proposals"
                    },
                    {
                      "text": "An IT operations audit filled with frustrated tone (\"Poorly disciplined teams ignore rules\") triggered defensive pushback blocking all fixes.",
                      "type": "case_study",
                      "title": "Blaming Audit Rejected",
                      "takeaway": "Rewriting findings neutrally around workflow friction unlocked unanimous adoption across managers."
                    },
                    {
                      "text": "Neutral unemotional phrasing of severe gaps hits twice as persuasively as angry adjectives.",
                      "type": "callout",
                      "title": "Let Data Carry the Verdict",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why enforce clean separation between Findings and Recommendations inside analytical reports?",
                      "options": [
                        "Shortens reports by half",
                        "Keeps empirical facts trustworthy and traceable even if leaders debate which solution fits best",
                        "Hides negative data"
                      ],
                      "explanation": "Readers can accept verified facts first while evaluating competing strategic fixes calmly.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Disciplined separation elevates analysts from partisan commentators into trusted advisors.",
                  "position": 1,
                  "resources": [
