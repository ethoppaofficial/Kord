                  "title": "Lifecycle Emails Without Inbox Burnout",
                  "blocks": [
                    {
                      "text": "Value-First Lifecycle Sequences",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Effective onboarding and nurture emails mirror helpful peer correspondence: Welcome Email #1 delivers promised resources instantly and sets honest expectations; Emails #2–#3 teach small quick wins before making a relevant, well-timed offer connected to that problem.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Welcome Expectation Setting",
                      "text": "Email one delivering the promised download/access immediately while telling new subscribers what helpful insights they will receive and how often.",
                      "type": "definition"
                    },
                    {
                      "body": "Subject: \"Your Freelance Pricing Calculator (+ 1 quick tip)\" -> Opens straight into direct link access, zero 400-word biography preamble.",
                      "type": "example",
                      "title": "Clean Welcome Subject + Hook"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Deliver the promised lead magnet or activation link in paragraph one.",
                        "Keep emails focused strictly on ONE helpful takeaway and ONE click target.",
                        "Write conversational plain-English opening previews (`preheader` text)."
                      ],
                      "title": "Applying Lifecycle Emails Without Inbox Burnout"
                    },
                    {
                      "text": "Sending a 700-word company history before giving the promised PDF checklist angered new subscribers.",
                      "type": "case_study",
                      "title": "Bio-Heavy Welcome Mistake",
                      "takeaway": "Moving the download link to line two lifted click-throughs above 60%."
                    },
                    {
                      "text": "Never waste email preview lines on \"View in browser\"—pair the subject line with a sharp complementary second hook.",
                      "type": "callout",
                      "title": "Check Your Preheader Text",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What belongs directly inside paragraph one of a Welcome email after downloading a guide?",
                      "options": [
                        "Company stock history",
                        "Immediate frictionless link to the promised resource plus brief expectation set",
                        "Three unrelated upsells"
                      ],
                      "explanation": "Fulfilling the initial promise immediately builds goodwill for all future emails.",
                      "correctIndex": 1
