            {
              "id": "36f2136a-a634-ba6b-c3b7-168209ca717e",
              "title": "Module 5: Cold Proofreading & Layout Verification",
              "lessons": [
                {
                  "id": "2e9b0303-30f6-5039-9d9b-9dc9e3b18791",
                  "title": "Breaking Brain Auto-Correct During Proofreading",
                  "blocks": [
                    {
                      "text": "Sensory Disruption Techniques",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "To catch surface errors hiding inside familiar drafts, forcibly slow eye prediction: read text **aloud word-for-word** (never mentally skimming), convert layouts temporarily into a contrasting font/PDF or read on phone width, or scan backwards paragraph-by-paragraph strictly inspecting surface tokens without getting swept into story momentum.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Familiarity Auto-Complete",
                      "text": "Unconscious neural pattern-filling where familiar drafts trigger memory recall instead of literal letter-by-letter visual reading, masking missing small function words cleanly.",
                      "type": "definition"
                    },
                    {
                      "body": "1. Export to PDF & widen zoom 150%. 2. Read aloud tracing lines slowly with cursor/finger. 3. Check display headings & image captions last—twice!",
                      "type": "example",
                      "title": "Disruption Check Trio"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Never proofread right after heavy rewriting—insert at least 1–4 hours cooling space.",
                        "Print tricky high-stakes deliverables on paper or inspect PDF previews cleanly rather than live draft editors.",
                        "Inspect bold display titles (`H1/H2`) deliberately letter-by-letter—big type disguises typos notoriously well!"
                      ],
                      "title": "Applying Breaking Brain Auto-Correct During Proofreading"
                    },
                    {
                      "text": "Four careful reviewers caught tiny footnote typos across a 12-page brochure while missing `\"ANUAL REPORT\"` sitting in 48pt cover typography.",
                      "type": "case_study",
                      "title": "Giant Banner Typo",
                      "takeaway": "Always treat headlines, cover titles, CTAs, and bullet lead-ins as high-risk giant blind spots."
