                  "id": "aef76ac0-957a-251d-7b14-cd09a296043c",
                  "title": "Unbiased Customer Discovery (\"The Mom Test\")",
                  "blocks": [
                    {
                      "text": "Past Behavior Over Future Promises",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Borrowing Rob Fitzpatrick’s Mom Test principle: never pitch your baby upfront and ask hypothetical future questions (\"Would you pay $20/mo?\"). Instead, ask strictly about their **past behavior** (\"Walk me through the last time invoice follow-up broke down — what did it cost you, and what did you try?\"). Real actions outrank optimistic guesses completely.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Mom Test Question",
                      "text": "Interviewing prospects strictly about real past events, actual time/money spent, and concrete workflow bottlenecks without pitching your solution upfront.",
                      "type": "definition"
                    },
                    {
                      "body": "Flawed: \"Would you use a meal planner for busy parents?\" Reliable: \"Walk me through how dinner happened last Wednesday night—what went wrong and what have you tried fixing this month?\"",
                      "type": "example",
                      "title": "Hypothetical vs. Behavioral Prompt"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Keep your solution hidden during the first 15 minutes of any discovery call.",
                        "Ask \"When did this last happen?\" and \"What else have you already tried/paid for?\"",
                        "Listen 80% of the call; capture exact frustrated words verbatim."
                      ],
                      "title": "Applying Unbiased Customer Discovery (\"The Mom Test\")"
                    },
                    {
                      "text": "Eighty surveyed college peers clicked \"Yes I’d pay $15/mo!\"—actual launch conversion hit 0.5%.",
                      "type": "case_study",
                      "title": "False-Positive Survey Launch",
                      "takeaway": "Switching to behavioral past-spend questions saved the founder wasting $8,000 on unviable inventory."
                    },
                    {
                      "text": "\"That sounds super helpful!\" without a pre-order, deposit, or concrete intro means polite social warmth—not market demand.",
                      "type": "callout",
                      "title": "Compliments Hold Zero Data",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why fail hypothetical questions like \"Would you pay $25/mo for this service?\" in customer interviews?",
                      "options": [
                        "Prospects hate math",
                        "Humans overestimate future discipline and give polite encouraging \"yes\" replies that vanish when real payment arrives",
                        "Interviews forbid numbers"
                      ],
                      "explanation": "Past real actions and concrete cash commitments expose true priorities cleanly.",
                      "correctIndex": 1
