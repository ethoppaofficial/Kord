                {
                  "id": "c77c4b86-8259-b42a-d169-391797967eb7",
                  "title": "Scripting Podcasts & Unscripted Hosts Without Stiffness",
                  "blocks": [
                    {
                      "text": "Run-of-Show Beat Outlines",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Podcasts and host-driven shows shine using Beat Run-of-Shows: write full tight word-for-word scripts ONLY for the 30-second Opening Cold Hook, Sponsor/Mid-roll Read, and crisp Closing Callout—while structuring middle deep dives into crisp **bulleted talking prompts, key story reminders, and verified stats** allowing organic natural delivery.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Hybrid Beat Outline",
                      "text": "Scripting exact openings, transitions, and factual quotes verbatim while leaving conversational discussion in crisp flexible bullet prompts.",
                      "type": "definition"
                    },
                    {
                      "body": "Hook (Verbatim 60 words) -> Beat 1: Origin Friction (Bullet prompts + 1 key client stat) -> Beat 2: Counterintuitive Fix -> Wrap + Listener Question.",
                      "type": "example",
                      "title": "Podcast Beat Card"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Script exact numerical stats and quotes verbatim so facts never slip live.",
                        "List sharp provocative questions rather than generic \"Tell us about X.\"",
                        "Mark strict target minute timestamps beside major segments so episodes stay tight."
                      ],
                      "title": "Applying Scripting Podcasts & Unscripted Hosts Without Stiffness"
                    },
                    {
                      "text": "Without beat pacing, two smart hosts spent 25 minutes on casual warmup chats before touching the episode’s promised topic.",
                      "type": "case_study",
                      "title": "Wandering 70-Minute Interview",
                      "takeaway": "Tightening onto 4 timed beats produced crisp memorable 28-minute episodes listeners finished cleanly."
                    },
                    {
                      "text": "Send guests three broad thematic prompts—never robotic pre-answered question lists—so stories emerge fresh and natural.",
                      "type": "callout",
                      "title": "Prompt Guests With 3 Core Themes Early",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Which podcast sections work best fully scripted vs. bulleted beats?",
                      "options": [
                        "Script entire casual banter word-for-word",
                        "Script cold hooks, exact stats, and clean closes verbatim; guide core discussions with crisp bulleted beats",
                        "Zero preparation at all"
                      ],
                      "explanation": "Hybrid structure merges crystal-clear framing with natural conversational warmth.",
                      "correctIndex": 1
                    }
