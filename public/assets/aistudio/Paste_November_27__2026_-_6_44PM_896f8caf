                  "title": "Scannable Hierarchy & ATS Hygiene",
                  "blocks": [
                    {
                      "text": "Clean Typography & Single-Column Structure",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Use a crisp single-column layout (1–2 pages max), standard section headings (Summary, Skills, Projects/Experience, Education), consistent reverse-chronological dates, high-contrast dark text on white, and selectable PDF text—never exported flat JPEGs or text-inside-graphics.",
                      "type": "paragraph"
                    },
                    {
                      "term": "ATS (Applicant Tracking System)",
                      "text": "Software used by employers to parse, store, and search submitted resumes cleanly by headings, skills, and dates.",
                      "type": "definition"
                    },
                    {
                      "body": "Career switchers should place a prominent **Selected Projects** section directly beneath Skills showcasing verified work before older unrelated jobs.",
                      "type": "example",
                      "title": "Projects Section Bridge"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Export resume as text-selectable PDF with standard clean fonts.",
                        "Test copy-pasting your entire PDF into plain Notepad to check reading order.",
                        "Keep filenames crisp: `Maya-Lin-CV-Frontend.pdf`."
                      ],
                      "title": "Applying Scannable Hierarchy & ATS Hygiene"
                    },
                    {
                      "text": "Testing copy-paste exposed an unreadable garbled sidebar column; switching to clean single-column layout fixed parsing immediately.",
                      "type": "case_study",
                      "title": "Scrambled Two-Column PDF",
                      "takeaway": "Always test your own PDF text extraction!"
                    },
                    {
                      "text": "Verify every portfolio, GitHub, or LinkedIn URL opens cleanly with `https://` without requiring logins.",
                      "type": "callout",
                      "title": "Consistent Dates & Links",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why test copy-pasting text from your exported CV PDF into a plain text editor?",
                      "options": [
                        "Checks spelling automatically",
                        "Reveals whether columns, tables, or graphics scrambled your reading order for ATS parsers",
                        "Compresses PDF size"
                      ],
                      "explanation": "Clean plain-text flow proves automated and human readers see your CV in order.",
                      "correctIndex": 1
