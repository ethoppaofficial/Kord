                  "title": "Concise Warm Outreach & Follow-Up Discipline",
                  "blocks": [
                    {
                      "text": "The 4-Sentence Value-First Message",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "When reaching out to hiring leads, peers, or alumni, keep messages under 100 words: 1) Warm shared context (\"Loved your studio’s recent accessibility breakdown\"), 2) Specific proof/relevance (\"I built a clean accessible redesign addressing similar mobile issues\"), 3) Clear low-friction ask (\"Applying for the junior role—sharing my 2-min walkthrough link in case helpful\"), 4) Respectful zero-pressure close.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Low-Friction Ask",
                      "text": "Making it effortless for a busy recipient to skim and reply (e.g., 1 specific question or optional 2-min link) without demanding immediate 60-minute favors.",
                      "type": "definition"
                    },
                    {
                      "body": "One polite 2-sentence nudge 7 business days later (\"Floating this up once in case buried—no rush at all\") closes loops gracefully without pestering.",
                      "type": "example",
                      "title": "Follow-Up Politeness"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Keep subject lines specific and honest.",
                        "Personalize at least one genuine sentence showing you actually read their work.",
                        "Accept silence gracefully after one polite follow-up."
                      ],
                      "title": "Applying Concise Warm Outreach & Follow-Up Discipline"
                    },
                    {
                      "text": "Commenting thoughtfully on a product manager’s public UX post plus sharing a clean mini-audit landed an informational chat within 48 hours.",
                      "type": "case_study",
                      "title": "Studio Note Reply",
                      "takeaway": "Genuine relevance cuts through inbox noise."
                    },
                    {
                      "text": "Never send automated spam blasts or guilt-trip busy professionals who don’t reply.",
                      "type": "callout",
                      "title": "Respect Time & Boundaries",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What makes cold/warm professional outreach actually get read?",
                      "options": [
                        "Sending a 6-paragraph CV attachment",
                        "Keeping it under ~100 words with genuine shared context, relevant proof, and a light clear ask",
                        "Messaging daily until reply"
                      ],
                      "explanation": "Brevity, relevance, and respect earn real human responses.",
                      "correctIndex": 1
                    }
