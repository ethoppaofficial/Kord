                {
                  "id": "e42ec5c6-3a18-fd30-4088-3ef82d33c13a",
                  "title": "Smoothing Variable Income & Emergency Buffers",
                  "blocks": [
                    {
                      "text": "The Separate Tax Account & Hill-and-Valley Buffer",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Open distinct accounts: 1) **Income/Operating Hub** (where client invoices land), 2) **Tax Vault** (automatically move 25–30% of every freelance payment immediately—that money isn’t yours!), 3) **Emergency Reserve** (building from 1 month -> 3–6 months of essentials), and 4) **Personal Checking** paying yourself a steady monthly \"salary\" from the hub.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Hill-and-Valley Fund",
                      "text": "A cash buffer storing surplus earnings from high-revenue months to fund your steady baseline monthly salary during slower booking periods.",
                      "type": "definition"
                    },
                    {
                      "body": "When £2,000 hits your freelance account, immediately move £550 into Tax Vault before paying a single personal bill.",
                      "type": "example",
                      "title": "Instant Tax Split"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Separate business/freelance inflows from daily personal spending cards.",
                        "Protect a starter emergency buffer before aggressive discretionary upgrades.",
                        "Automate transfers right when invoices clear."
                      ],
                      "title": "Applying Smoothing Variable Income & Emergency Buffers"
                    },
                    {
                      "text": "Building a 2-month Hill-and-Valley buffer let a freelancer turn down a terrible low-ball client in August without panic.",
                      "type": "case_study",
                      "title": "Calm Slow Quarter",
                      "takeaway": "Financial buffers buy creative freedom and dignity."
                    },
                    {
                      "text": "Treating gross freelance invoices as spendable cash is the #1 cash-flow trap for independent workers.",
                      "type": "callout",
                      "title": "Never Spend Pre-Tax Revenue",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What should happen FIRST every time a freelance invoice payment clears your account?",
                      "options": [
                        "Upgrade desk gear",
                        "Separate your estimated tax reserve (~25–30%) into a dedicated account so tax money isn’t spent accidentally",
                        "Cancel emergency savings"
                      ],
                      "explanation": "Ring-fencing tax reserves immediately prevents nasty tax-season shortfalls.",
