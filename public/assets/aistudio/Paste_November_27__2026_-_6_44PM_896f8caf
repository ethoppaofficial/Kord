                {
                  "id": "d3aaff84-6ad2-322c-9831-5af848c38352",
                  "title": "Register, Audience & Tone Awareness",
                  "blocks": [
                    {
                      "text": "Calibrating Register & Empathy",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Tone reflects attitude toward your subject and audience. Clear modern prose favors plain, courteous, respectful language—neither slangy nor pompous. Matching vocabulary to reader familiarity builds rapport without dumbing down complex ideas.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Register",
                      "text": "The level of formality, technical vocabulary, and personal distance chosen for a specific writing context and readership.",
                      "type": "definition"
                    },
                    {
                      "body": "Peer chat: \"Hold off merging—tests broke.\" Client note: \"We paused Friday's release to resolve a failing checkout test and will confirm a new window at 2 PM.\"",
                      "type": "example",
                      "title": "Shifting Register Intentionally"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Name your audience relationship before drafting.",
                        "Remove unnecessary jargon or define essential technical terms once.",
                        "Read aloud to verify the tone sounds respectful rather than stiff or defensive."
                      ],
                      "title": "Applying Register, Audience & Tone Awareness"
                    },
                    {
                      "text": "\"Per company stipulation 4B, refunds remain disallowed post-window.\" Customers escalated in anger.",
                      "type": "case_study",
                      "title": "Overly Robotic Support Reply",
                      "takeaway": "Plain empathetic wording explaining policy options lowered repeat tickets cleanly."
                    },
                    {
                      "text": "Aim for dignified plain English: avoid sounding either like an automated form letter or a casual text message.",
                      "type": "callout",
                      "title": "Write Like a Helpful Peer",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What best defines plain-language professional tone?",
                      "options": [
                        "Slang-heavy abbreviations",
                        "Clear, respectful, jargon-free expression matched to reader needs",
                        "Complex Latin-derived vocabulary to sound authoritative"
                      ],
                      "explanation": "Plain respectful wording maximizes comprehension across diverse audiences.",
                      "correctIndex": 1
