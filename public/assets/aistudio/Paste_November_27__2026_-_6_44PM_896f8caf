            {
              "id": "5abbd9c6-14ad-970a-9ce5-0cdef4351703",
              "title": "Module 2: Anchoring & Framing Opening Offers",
              "lessons": [
                {
                  "id": "d606f9f2-3a3f-3614-a499-08d69edd8bb6",
                  "title": "Evidence-Backed Anchoring",
                  "blocks": [
                    {
                      "text": "Credible Reference Anchoring",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Arbitrary outrageous anchors destroy credibility and stall talks; reasoned anchors supported by scope deliverables, market benchmarks, and ROI hold gravity. Frame offers positively around total value delivered (\"Based on comparable deliverables and 12-week SLA, this package sits at £9,500\") rather than apologizing for price.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Credible Anchor",
                      "text": "An opening offer positioned near the optimistic boundary of market reality and justified cleanly by objective benchmarks.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Given benchmark data for mid-level frontend engineers in London plus my React accessibility experience, I am targeting £54,000–£58,000.\"",
                      "type": "example",
                      "title": "Anchoring Compensation"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Research 3 external market comparables first.",
                        "Pair your opening figure with 2 concrete value justifications.",
                        "Pause silently after stating your figure—do not bid against yourself."
                      ],
                      "title": "Applying Evidence-Backed Anchoring"
                    },
                    {
                      "text": "A vendor quoted £12k then panicked at a 4-second pause and blurted \"...or £9.5k if fast!\" before the buyer spoke a word.",
                      "type": "case_study",
                      "title": "Self-Discounting Error",
                      "takeaway": "Holding calm silence after an anchor lets the counter-party speak first."
                    },
                    {
                      "text": "State your benchmarked number cleanly, stop talking, and smile calmly while they process.",
                      "type": "callout",
                      "title": "Wait Out the Four-Second Silence",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What happens if you add immediate unsolicited discounts right after stating your price?",
                      "options": [
                        "Signals fairness immediately",
                        "Trains the buyer to push for even deeper effortless cuts",
                        "Increases profit margin"
                      ],
                      "explanation": "Bidding against yourself destroys anchor credibility before talks even start.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Anchored rationale paired with calm silence holds commercial value steadily.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "b40152d6-a03c-4d09-a5ec-84f77d752f1f",
                      "url": "https://hbr.org/",
                      "title": "Structured Negotiation & Agreement Frameworks",
                      "position": 1,
                      "resource_type": "articles"
                    },
                    {
                      "id": "cbcd0ac3-f832-4e0c-9543-b574efdd8b01",
                      "url": "https://www.mindtools.com/",
