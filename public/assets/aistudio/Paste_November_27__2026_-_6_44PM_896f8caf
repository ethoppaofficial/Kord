                },
                {
                  "id": "4969f669-1dbd-e87b-0da2-acf3cdb3a634",
                  "title": "Breaking Deadlocks Without Cave-Ins",
                  "blocks": [
                    {
                      "text": "Procedural Resets & Objective Criteria",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "If talks jam on one contentious issue, park it temporarily (\"Let's bracket Liability Cap for 10 minutes and check Delivery Schedule first\"), switch to neutral objective benchmarks (industry SLA standards, third-party pricing indices), or suggest a time-boxed reversible trial to lower perceived risk for both parties.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Bracketing",
                      "text": "Temporarily setting aside a sticky clause to agree on surrounding terms first, reducing tension and uncovering possible package trades.",
                      "type": "definition"
                    },
                    {
                      "body": "Park indemnity wording, agree on milestone testing checkpoints, then split risk transparently via a 60-day trial clause.",
                      "type": "example",
                      "title": "Solving a Guarantee Deadlock"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Summarize all points already agreed so progress stays visible.",
                        "Introduce neutral external standards rather than willpower contests.",
                        "Suggest small reversible pilot steps if risk fears drive refusal."
                      ],
                      "title": "Applying Breaking Deadlocks Without Cave-Ins"
                    },
                    {
                      "text": "Procurement blocked an annual tool deal over unproven ROI; suggesting a paid 45-day single-team pilot with clear exit metrics cleared the stalemate.",
                      "type": "case_study",
                      "title": "Stalled Enterprise Pilot",
                      "takeaway": "Pilot structures shrink high-stakes anxiety cleanly."
                    },
                    {
                      "text": "Reminding rooms of 5 agreed clauses keeps 1 stuck clause from killing the whole deal.",
                      "type": "callout",
                      "title": "Summarize Progress Often",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What does \"bracketing\" accomplish during a tense stalemate?",
                      "options": [
                        "Hides unresolved legal fees",
                        "Lets negotiators bank agreement on easier terms before revisiting the toughest clause",
                        "Terminates talks permanently"
                      ],
                      "explanation": "Momentum on surrounding terms softens rigid deadlocks cleanly.",
                      "correctIndex": 1
