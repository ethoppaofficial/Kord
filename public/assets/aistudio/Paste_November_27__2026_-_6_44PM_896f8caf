            {
              "id": "e93d904f-1460-188b-640d-d0308260310c",
              "title": "Module 5: Evaluating Models, Metrics & Fairness",
              "lessons": [
                {
                  "id": "ae2e9f4f-eef3-b512-0ddc-d2404745b72b",
                  "title": "Overfitting, Underfitting & Imbalanced Metrics",
                  "blocks": [
                    {
                      "text": "Confusion Matrices, Precision, Recall & F1",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Avoid raw accuracy on imbalanced data. Use **Precision** (of flagged positives, how many are truly positive—minimizes false alarms) and **Recall** (of all real positives, how many did we catch—minimizes missed emergencies). Watch validation vs training error: wide gaps mean overfitting (memorization).",
                      "type": "paragraph"
                    },
                    {
                      "term": "Overfitting",
                      "text": "When a model memorizes noise and idiosyncrasies inside training data, scoring brilliantly on Train while performing poorly on unseen Test examples.",
                      "type": "definition"
                    },
                    {
                      "body": "Cancer screening prioritizes high Recall (don’t miss real cases); spam folders prioritize higher Precision (don’t hide real job offers).",
                      "type": "example",
                      "title": "Medical vs Spam Trade-Off"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Inspect actual confusion matrix counts (TP, FP, FN, TN).",
                        "Plot training vs validation loss to detect overfitting early.",
                        "Tune probability thresholds to match business error costs, not fixed 0.5 defaults."
                      ],
                      "title": "Applying Overfitting, Underfitting & Imbalanced Metrics"
                    },
                    {
                      "text": "Lowering the at-risk outreach threshold from 0.5 to 0.32 boosted early-mentor intervention Recall from 45% to 82%.",
                      "type": "case_study",
                      "title": "Threshold Tuning Win",
                      "takeaway": "Decision thresholds belong to product trade-offs."
                    },
                    {
                      "text": "Model accuracy drifts as user habits shift—monitor validation metrics on fresh recent cohorts.",
                      "type": "callout",
                      "title": "Test Across Time Windows",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Which metric matters most when missing a real positive case carries much higher cost than a false alarm?",
                      "options": [
                        "Raw overall accuracy",
                        "Recall (Sensitivity)",
                        "Training loss"
                      ],
                      "explanation": "Recall measures how completely true positive cases are captured.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Error-cost-aligned metrics and overfitting checks ensure models behave reliably in the wild.",
