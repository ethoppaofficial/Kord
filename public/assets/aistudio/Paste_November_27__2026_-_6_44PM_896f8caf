            {
              "id": "e38c7298-b863-964f-567e-a1e8b0a41deb",
              "title": "Module 3: Multi-Issue Packaging & Creative Trades",
              "lessons": [
                {
                  "id": "59c40159-caa5-4a67-1ae4-a38afe1ed2c8",
                  "title": "Expanding Value With Multi-Variable Deals",
                  "blocks": [
                    {
                      "text": "Identifying Asymmetric Valuation",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Issues rarely cost both sides equally. Faster 7-day invoice settlement may cost a large client little while solving cash flow for a studio; extra reporting dashboards may cost an agency one template hour while impressing a buyer's VP. Trading items you value lightly for items they value highly grows total pie.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Asymmetric Trade",
                      "text": "Exchanging a term that costs you little for a concession the counterparty values deeply—and vice versa.",
                      "type": "definition"
                    },
                    {
                      "body": "Agency includes a 30-minute quarterly executive QBR (low cost) in exchange for 100% upfront milestone payment + public logo case study (high agency value).",
                      "type": "example",
                      "title": "Asymmetric Win"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "List 5–7 variables beyond price (payment schedule, SLA, IP, length, scope, referral rights).",
                        "Never grant a single free concession—always pair with \"If we include X, could you adjust Y?\""
                      ],
                      "title": "Applying Expanding Value With Multi-Variable Deals"
                    },
                    {
                      "text": "Instead of cutting a £15k software fee by 15%, an account team exchanged a 2-year commit and quarterly testimonial for 8% lower rate.",
                      "type": "case_study",
                      "title": "Price Discount Replaced by Terms",
                      "takeaway": "Multi-term trades kept predictable multi-year revenue high."
                    },
                    {
                      "text": "Never drop price unilaterally; make every move conditional on a reciprocal give from them.",
                      "type": "callout",
                      "title": "Always Use \"If... Then...\"",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What makes \"If we extend onboarding support, can we lock 14-day payment terms?\" effective?",
                      "options": [
                        "It avoids mentioning price",
                        "It establishes reciprocal value exchange instead of one-sided give-aways",
                        "It hides contract clauses"
                      ],
                      "explanation": "Conditional concessions train partners to trade value thoughtfully.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Multi-issue packaging discovers win-win value hidden inside rigid price debates.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "0cb48b5b-623e-44e2-9103-ce9a2089bdbb",
                      "url": "https://hbr.org/",
