              "lessons": [
                {
                  "id": "1a2578cf-37a1-6e5a-a447-ec94707abd6a",
                  "title": "Listening Under Criticism or Heat",
                  "blocks": [
                    {
                      "text": "De-Escalation Through Deep Hearing",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "When an upset customer or stakeholder vents, fighting facts first pours fuel on emotion. Letting them finish their complete grievance uninterrupted while validating impact (\"I hear how costly losing Monday's export was before your board deck\") discharges anger rapidly. Only once they feel genuinely heard can solutions land.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Vent-Before-Fix Principle",
                      "text": "Allowing an upset party to feel completely heard and acknowledged before introducing technical root-causes or repair timelines.",
                      "type": "definition"
                    },
                    {
                      "body": "Let them finish uninterrupted -> Reflect impact clearly -> Ask clarifying facts -> Share concrete fix timeline.",
                      "type": "example",
                      "title": "Calming an Angry Partner"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Listen silently without rehearsing legal defenses.",
                        "Reflect impact accurately in calm tone.",
                        "Transition cleanly: \"Now that I have full context, here is what we can fix immediately.\""
                      ],
                      "title": "Applying Listening Under Criticism or Heat"
                    },
                    {
                      "text": "Listening patiently for four minutes without interrupting let an angry enterprise buyer burn off panic and agree to a dedicated repair sprint.",
                      "type": "case_study",
                      "title": "Churned Client Retained",
                      "takeaway": "Feeling heard reverses churn intentions powerfully."
                    },
                    {
                      "text": "Speaking 10% softer and slower than an agitated caller subtly pulls their intensity downward.",
                      "type": "callout",
                      "title": "Use Lower Steady Tone",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "When an upset buyer vents about a critical failure, what must come first?",
                      "options": [
