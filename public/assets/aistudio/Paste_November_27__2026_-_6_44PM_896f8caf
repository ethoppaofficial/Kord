            {
              "id": "60aea828-d7e8-40e8-cfdc-2da13da4ad84",
              "title": "Module 3: Proposals, Business Cases & Briefs",
              "lessons": [
                {
                  "id": "98261628-92a3-9216-d103-fbe69824a1e2",
                  "title": "The One-Page Business Case",
                  "blocks": [
                    {
                      "text": "Problem Cost & Payback Framing",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Decision-makers fund solutions when the cost of doing nothing clearly exceeds the cost of acting. A strong one-page business case opens with the quantified pain (lost revenue, manual hours, churn risk), proposes a scoped solution with clear cost and timeline, estimates conservative return, and names top risks plus mitigations.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Payback Period",
                      "text": "Number of months required for cumulative savings or added margin to recover initial project investment.",
                      "type": "definition"
                    },
                    {
                      "body": "Spend £3,000 once + £150/month to eliminate 35 hours/month of password-reset tickets—paying back in 5 months while freeing 2 engineers.",
                      "type": "example",
                      "title": "Framing Support Automation"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Quantify status-quo pain conservatively.",
                        "Detail total upfront and ongoing cost transparently.",
                        "Compare 2 realistic alternatives (including \"do nothing\").",
                        "Include launch milestones and accountability owner."
                      ],
                      "title": "Applying The One-Page Business Case"
                    },
                    {
                      "text": "An IT proposal listing 18 technical software specs was rejected until revised to highlight 20% faster client onboarding.",
                      "type": "case_study",
                      "title": "Feature Pitch Rejection",
                      "takeaway": "Translating features into customer and margin impact unlocked instant budget approval."
                    },
                    {
                      "text": "Finance leaders trust a cautious 15% improvement estimate far more than an inflated 300% projection.",
                      "type": "callout",
                      "title": "Use Conservative Math",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why must a business case examine the \"do nothing\" baseline?",
                      "options": [
                        "To prove the proposal has no risks",
                        "To show the ongoing financial or customer cost of maintaining the status quo",
                        "To pad page count"
                      ],
                      "explanation": "Comparing action against status-quo cost clarifies true urgency and value.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Concise business cases win sponsorship by proving measurable commercial value.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "1ed06811-515d-49ea-92c3-8a6915edb5a6",
                      "url": "https://www.plainlanguage.gov/guidelines/",
                      "title": "Plain Language Guidelines & Clarity Principles",
                      "position": 1,
                      "resource_type": "guide"
                    },
                    {
                      "id": "38ab7a83-2076-4540-9bf3-b9ac2ad6c46d",
                      "url": "https://www.mindtools.com/",
                      "title": "Communicating Clearly in Workplaces",
                      "position": 2,
                      "resource_type": "article"
                    }
                  ],
                  "takeaways": [
                    "Quantify cost of current friction",
                    "Include realistic costs, payback, and alternatives",
                    "Speak in outcomes rather than internal tool jargon"
                  ],
                  "objectives": [
                    "Explain problem cost & payback framing",
                    "Apply the one-page business case in everyday scenarios"
                  ],
                  "est_minutes": 28,
                  "is_required": true,
                  "introduction": "Good initiatives fail daily because champions explain features they like instead of commercial outcomes leaders fund.",
                  "further_reading": [
                    {
                      "url": "https://www.plainlanguage.gov/guidelines/",
                      "title": "Plain Language Guidelines & Clarity Principles",
                      "source": "plainlanguage.gov",
                      "resourceType": "Guide"
