                {
                  "id": "5ad2a7ca-22bc-8893-f06c-9cbeade831ae",
                  "title": "Cross-Level Briefing Confidence",
                  "blocks": [
                    {
                      "text": "Concise Authority Without Jargon",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Senior leaders care about user outcomes, risks, resource allocation, and timelines—not granular tool internals unless asked. Speak calmly, answer direct yes/no questions first before elaborating, and admit \"I do not have that figure yet; I will confirm by 4 PM\" cleanly instead of bluffing under spotlight.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Direct Answer First",
                      "text": "Answering an executive's yes/no or numeric question in sentence one before giving supporting nuance (\"Yes, we can hit May 10 if QA starts Monday...\").",
                      "type": "definition"
                    },
                    {
                      "body": "\"I want to give you exact accuracy rather than guess—I will check the Q2 cohort export and send that percentage before 3 PM.\"",
                      "type": "example",
                      "title": "Handling an Unanswered Metric"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Answer directly first, add brief nuance second.",
                        "Keep operational acronyms minimal when briefing cross-functional leaders.",
                        "Never bluff guesses under pressure; commit to a fast verification timestamp."
                      ],
                      "title": "Applying Cross-Level Briefing Confidence"
                    },
                    {
                      "text": "During an executive review, a junior specialist calmly stated she needed ten minutes to verify a regional tax rule rather than guessing. Leadership praised her integrity immediately.",
                      "type": "case_study",
                      "title": "The Honest Analyst Advantage",
                      "takeaway": "Honest precision earns lasting executive credibility."
                    },
                    {
                      "text": "When you say \"I'll follow up by 3 PM\", deliver cleanly at 2:45 PM.",
                      "type": "callout",
                      "title": "Own Your Follow-Through Clock",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What should you do if an executive asks for a specific number you do not know live?",
                      "options": [
                        "Estimate convincingly so you look smart",
                        "Say clearly you will verify the exact figure and share it by a concrete timestamp",
                        "Change the topic immediately"
                      ],
                      "explanation": "Honest commitment backed by fast follow-through builds stronger trust than risky guessing.",
