              "lessons": [
                {
                  "id": "70aacefc-711f-e490-5c5a-401fa4471aca",
                  "title": "Peak-Season Readiness & Capacity Surges",
                  "blocks": [
                    {
                      "text": "Pre-Season Stress Buffers & Cutoff Transparency",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Eight weeks ahead of predictable seasonal spikes (`holidays, spring renovations, September admissions`), lock clear **Peak Surge Guardrails**: pre-order critical slow-lead Class-A inventory early, cross-train backup cross-functional helpers cleanly ahead of crunch, publish honest firm shipping/booking **Cut-Off Dates**, and trim custom messy edge requests temporarily cleanly onto core streamlined offerings!",
                      "type": "paragraph"
                    },
                    {
                      "term": "Peak-Season Menu Simplification",
                      "text": "Temporarily trimming hyper-custom, low-margin complex variations during predictable high-volume crunch weeks so crews execute fast core offerings flawlessly under heavy load.",
                      "type": "definition"
                    },
                    {
                      "body": "Instead of fighting 18 tedious custom basket pairings during peak December week, a gift studio switches smoothly onto 4 signature curated best-seller boxes—doubling throughput with zero stress errors!",
                      "type": "example",
                      "title": "Smart Holiday Focus"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Start seasonal vendor inventory orders and temp cross-training 6–8 weeks early.",
                        "Communicate realistic holiday processing deadlines clearly and loudly upfront across headers/invoices.",
                        "Hold light post-surge debrief snacks capturing every glitch while memory runs sharp—preparing seamlessly for next year!"
                      ],
                      "title": "Applying Peak-Season Readiness & Capacity Surges"
                    },
                    {
                      "text": "Accepting unlimited messy custom engraving deadlines through December 21 broke turnaround promises for 60 families—earning wave after wave of painful refunds.",
                      "type": "case_study",
                      "title": "Overwhelmed Holiday Collapse",
                      "takeaway": "Transparent firm cutoffs + simplified core holiday menus yield ecstatic margins and calm peaceful crews!"
                    },
                    {
                      "text": "Cutting messy niche options temporarily during busy rushes maximizes speed, profit, and sanity simultaneously!",
                      "type": "callout",
                      "title": "Simplify During Surges",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "How should small businesses protect service quality cleanly ahead of predictable annual high-volume surge months?",
