                  "publication_status": "published",
                  "completion_criteria": "Study the core frameworks in \"True Summaries vs. Empty Trailers\", verify the inline knowledge check, and apply the practical checklist."
                },
                {
                  "id": "8637c600-49f5-72ce-050c-187fc8e60a0f",
                  "title": "Scannable One-Pagers & Callout Boxes",
                  "blocks": [
                    {
                      "text": "Structured Page Hierarchy",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Great one-pagers combine a top headline takeaway, a tight 3-metric KPI box or summary table, two short scannable analytical sections, and a bold Next Steps footer. Thoughtful whitespace turns heavy information into an effortless 90-second read.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Executive Scorecard Box",
                      "text": "A compact 3–4 cell header summary highlighting key financial, timeline, and risk numbers right beneath the memo headline.",
                      "type": "definition"
                    },
                    {
                      "body": "Ask: $15k Q1 Seed | Payback: 5 Months | Risk Level: Low | Target Launch: Mar 10.",
                      "type": "example",
                      "title": "Compact Scorecard Block"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Cap one-pagers strictly at ~350–450 words.",
                        "Use bold lead-in phrases on bullets so skimmers catch categories fast.",
                        "End with named approver + next scheduled review checkpoint."
                      ],
                      "title": "Applying Scannable One-Pagers & Callout Boxes"
                    },
                    {
                      "text": "Squeezing 900 words in 9pt font onto one sheet violated the purpose of a one-pager and looked exhausting.",
                      "type": "case_study",
                      "title": "Margin-to-Margin Density",
                      "takeaway": "Cutting to 380 sharp words doubled leadership read-through completely."
                    },
                    {
                      "text": "Never cheat on page limits by shrinking fonts; cut redundant ideas instead.",
                      "type": "callout",
                      "title": "One Page Means Breathing Room",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What makes bold lead-in bullets effective on a one-page business brief?",
                      "options": [
                        "They decorate the font",
                        "Scanners can inspect every analytical pillar cleanly in seconds",
                        "They double word count"
                      ],
                      "explanation": "Consistent bold labels act like horizontal subheadings inside compact bullet lists.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Clean visual framing turns complex business memos into unmistakable action briefs.",
                  "position": 2,
                  "resources": [
                    {
                      "id": "db343fc0-378e-4f0b-adcc-0d09a67ae359",
                      "url": "https://www.plainlanguage.gov/guidelines/",
                      "title": "Plain Language Guidelines",
