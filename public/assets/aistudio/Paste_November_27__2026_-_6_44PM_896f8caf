                  "blocks": [
                    {
                      "text": "Structured Testimonial Prompts & Referral Etiquette",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Ask for a concise 3-sentence testimonial right when you deliver the final approved outcome while excitement is peak! Make writing effortless by supplying 3 gentle prompts (\"What snag did you face before we worked together? How was the process? What result stood out?\"). Let happy clients know clearly what ideal next clients you love helping.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Peak-Satisfaction Window",
                      "text": "The brief high-trust moment immediately following a smooth launch or praised milestone—the ideal time to request honest reviews or referrals.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Thrilled the new deck landed smoothly! If you have 2 minutes, a quick 2–3 sentence quote on what changed for your team would mean a lot for my portfolio.\"",
                      "type": "example",
                      "title": "Guided Review Prompt"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Request feedback immediately after positive milestone approval.",
                        "Ask explicit permission before publishing client names, logos, or quotes.",
                        "Thank referrers warmly and keep them updated when intros pan out."
                      ],
                      "title": "Applying Harvesting Testimonials & Referrals at Peak Satisfaction"
                    },
                    {
                      "text": "Supplying 3 tiny prompt questions replaced vague \"Great to work with!\" blurbs with rich outcome-packed testimonials.",
                      "type": "case_study",
                      "title": "3x Stronger Quotes",
                      "takeaway": "Gentle prompts unlock specific, persuasive quotes."
                    },
                    {
                      "text": "If someone refers a lead—even if it doesn’t close—thank them warmly afterward so they love referring again.",
                      "type": "callout",
                      "title": "Always Close the Loop",
                      "variant": "tip"
                    },
