                {
                  "id": "1af978c7-e299-70ea-a82b-6a87f5592fb3",
                  "title": "Honest Assumptions & Sensitivity Ranges",
                  "blocks": [
                    {
                      "text": "Downside-Base-Upside Framing",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Credible business cases surface underlying unit economics transparently: state baseline assumptions, test what happens if adoption runs slower (Downside), and quantify exact break-even thresholds. Leaders back teams far faster when downside exposure is explicitly bounded.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Break-Even Sensitivity",
                      "text": "Identifying the minimum adoption, price, or conversion rate required for a proposed initiative to cover its costs.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Base case reaches payback in Month 4 at 3% conversion; even at conservative 1.8% conversion, investment pays back within Month 7.\"",
                      "type": "example",
                      "title": "Clear Break-Even Note"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "List top 2–3 levers driving your projection (e.g., unit price, volume, churn).",
                        "Show Conservative vs. Expected outcome briefly.",
                        "State the break-even minimum clearly so downside risk feels manageable."
                      ],
                      "title": "Applying Honest Assumptions & Sensitivity Ranges"
                    },
                    {
                      "text": "A forecast assumed immediate 100% seat utilization from Day 1, triggering skepticism from Finance.",
                      "type": "case_study",
                      "title": "Over-Optimistic Expansion Plan",
                      "takeaway": "Rebuilding around a 60%-utilization break-even threshold earned prompt funding."
                    },
                    {
                      "text": "Including simple visible formula logic (\"40 hours saved x $45/hr = $1,800/mo\") stops budget challenges before they start.",
                      "type": "callout",
                      "title": "Show Your Math Briefly",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why add a conservative downside threshold to a business pitch?",
                      "options": [
                        "To discourage approval",
                        "To demonstrate realistic risk awareness and clear break-even resilience",
                        "To hide expected profit"
                      ],
                      "explanation": "Showing investment viability even under conservative assumptions maximizes leadership confidence.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Transparent assumptions turn shaky projections into bankable business plans.",
                  "position": 2,
                  "resources": [
                    {
                      "id": "e71e1bc4-be5d-4753-bce8-b20d1868e491",
                      "url": "https://www.plainlanguage.gov/guidelines/",
                      "title": "Plain Language Guidelines",
