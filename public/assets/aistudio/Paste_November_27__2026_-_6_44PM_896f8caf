            {
              "id": "82c1a8d4-127b-4511-c76b-a64013ce97e4",
              "title": "Module 3: Simple Unit Economics, Pricing & Bootstrapping",
              "lessons": [
                {
                  "id": "5f664587-ecd1-296b-3677-f3bc53da2894",
                  "title": "Positive Unit Economics Before Scaling Volume",
                  "blocks": [
                    {
                      "text": "Contribution Margin & Break-Even Reality",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Every unit or service hour sold must cleanly pay its direct fulfillment costs (`COGS`, direct contractor time, shipping, payment fees) and contribute real positive dollars (`Contribution Margin`) toward fixed overhead (`rent, tools, marketing`). Knowing exact **Break-Even Volume** (`Fixed Costs / Unit Contribution`) keeps founders anchored firmly in financial truth.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Contribution Margin",
                      "text": "Selling price per unit minus strictly variable direct costs required to produce, ship, or deliver that single unit—showing what remains to cover overhead and profit.",
                      "type": "definition"
                    },
                    {
                      "body": "Workshop Seat Price: $120. Direct catering + platform fee per seat: $30 -> Contribution = $90/seat. Monthly studio/promo fixed overhead: $1,800 -> Exact break-even = `1,800 / 90 = 20 paid seats/mo`.",
                      "type": "example",
                      "title": "Quick Break-Even Check"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Separate fixed monthly overhead rigorously from variable per-sale costs.",
                        "Factor payment processing (~3%), shipping surprises, refunds, and founder delivery hours honestly!",
                        "Verify positive unit economics BEFORE spending money buying ad clicks."
                      ],
                      "title": "Applying Positive Unit Economics Before Scaling Volume"
                    },
                    {
                      "text": "Sold 400 holiday boxes at $28 each while undercounting premium packaging + courier spoilage costing $29.50 per box.",
                      "type": "case_study",
                      "title": "Busy Yet Broke Bakery",
                      "takeaway": "Raising prices thoughtfully to $38 with tighter regional routes turned frantic losses into steady 32% margins immediately."
                    },
                    {
                      "text": "Competing strictly as the cheapest rookie attracts nightmare high-maintenance clients while leaving zero buffer for errors or growth.",
                      "type": "callout",
                      "title": "Price Value—Never Just Cheapness",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why must positive unit Contribution Margin be confirmed before buying ads to scale volume?",
                      "options": [
                        "Ads reduce software fees",
                        "Scaling a negative or razor-thin contribution margin simply multiplies cash burn faster with every extra sale",
                        "Volume always removes shipping"
                      ],
                      "explanation": "Healthy per-sale economics ensure growth compounds profit rather than losses.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Clear unit math protects founders from building exhausting busy jobs that silently bleed cash.",
                  "position": 1,
