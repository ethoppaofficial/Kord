                    }
                  ],
                  "takeaways": [
                    "Reject raw accuracy on imbalanced data",
                    "Balance Precision vs Recall by error cost",
                    "Compare train vs validation scores for overfitting"
                  ],
                  "objectives": [
                    "Understand confusion matrices, precision, recall & f1",
                    "Apply overfitting, underfitting & imbalanced metrics in engineering workflows"
                  ],
