                {
                  "id": "35b858f8-697b-adba-6198-e4fdb768d828",
                  "title": "Accessibility, Live Previews & Trust Hygiene",
                  "blocks": [
                    {
                      "text": "Zero-Friction Reviewer Access",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Audit every portfolio link from an incognito browser before sending applications! Ensure Google Drive/Docs links allow \"Anyone with the link can view\" cleanly, host static web demos on reliable HTTPS URLs, and include clean screenshots/PDF backups in case live demos sleep or expire.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Incognito Link Check",
                      "text": "Opening every resume and portfolio link in a logged-out private browser window to confirm zero login walls or 404s exist.",
                      "type": "definition"
                    },
                    {
                      "body": "Embedding crisp annotated screenshots right inside your case study guarantees reviewers still see your work even if an external host lags.",
                      "type": "example",
                      "title": "Fallback Screenshots"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Verify every link inside an incognito window.",
                        "Check spelling and mobile readability on your portfolio page.",
                        "Remove lorem ipsum, broken dates, or dead placeholder buttons cleanly."
                      ],
                      "title": "Applying Accessibility, Live Previews & Trust Hygiene"
                    },
                    {
                      "text": "A strong candidate missed a shortlist because her flagship portfolio PDF pointed to a private Notion page requiring login.",
                      "type": "case_study",
                      "title": "Locked Case Study",
                      "takeaway": "Five seconds of incognito testing catches fatal access locks."
                    },
                    {
                      "text": "Include direct email and clean LinkedIn/GitHub links in your portfolio footer—never force recruiters through broken CAPTCHAs.",
                      "type": "callout",
                      "title": "Keep Contact Frictionless",
                      "variant": "tip"
                    },
