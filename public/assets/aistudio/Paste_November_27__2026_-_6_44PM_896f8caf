                  "blocks": [
                    {
                      "text": "Tabular Logic & Decision Trees",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "When comparing plans, role permissions, environment variables, or multi-condition matrices, clean tables reveal rules in two seconds where prose requires three re-reads. Keep columns consistent, bold key differentiators, and list exact default values cleanly.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Permission Matrix",
                      "text": "A structured grid mapping user roles against exact system actions (`Read`, `Publish`, `Delete`) for rapid unambiguous verification.",
                      "type": "definition"
                    },
                    {
                      "body": "A 3-row x 4-column table (`Role | View Drafts | Publish | Manage Keys`) replaces 180 words of fragile prose effortlessly.",
                      "type": "example",
                      "title": "Clean Role Table Advantage"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Any sentence containing 3+ \"if/unless/except\" clauses demands a table or bullet branch.",
                        "Keep table cells concise—avoid cramming 4-line essays into narrow columns.",
                        "Align units and boolean phrasing (`Yes / No` or `Allowed / Blocked`) uniformly."
                      ],
                      "title": "Applying Replacing Conditional Prose With Matrices"
                    },
                    {
                      "text": "Administrators misread nested prose exceptions and granted edit rights unintentionally.",
                      "type": "case_study",
                      "title": "Misconfigured Security Matrix",
                      "takeaway": "Converting policy rules into a crystal-clear permission grid ended configuration disputes cleanly."
                    },
                    {
                      "text": "Put critical config tables directly in accessible selectable text—screenshots cannot be searched, copied, or updated easily.",
                      "type": "callout",
                      "title": "Avoid Orphan Screenshots for Text Rules",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "When should technical writers swap narrative paragraphs for a structured table?",
                      "options": [
                        "Never—prose feels warmer",
                        "Whenever presenting role permissions, error dictionaries, or multi-attribute comparisons",
                        "Strictly for pricing pages"
                      ],
                      "explanation": "Grid lookup eliminates cross-referencing fatigue on complex rule sets.",
                      "correctIndex": 1
