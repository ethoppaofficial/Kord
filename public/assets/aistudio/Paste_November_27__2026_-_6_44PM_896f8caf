              "lessons": [
                {
                  "id": "8a2688e6-4ee1-d4c2-97be-c81c3114a9f8",
                  "title": "True Customer Lifetime Value (Adjusted for Margin)",
                  "blocks": [
                    {
                      "text": "Gross-Margin LTV & Churn Sensitivity",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "True usable Lifetime Value calculates strictly on **Gross Profit** earned per account before churn: `LTV = (ARPU x Gross Margin %) / Monthly Churn Rate`. Notice the staggering power of Churn: cutting monthly churn neatly in half (`6% -> 3%`) literally **DOUBLES Lifetime Value automatically** without raising price or spending a single extra marketing dollar!",
                      "type": "paragraph"
                    },
                    {
                      "term": "Margin-Adjusted LTV",
                      "text": "Average monthly revenue per account multiplied by true Gross Margin %, divided by monthly logo churn rate—representing real cash dollars available to pay back CAC and earn net profit.",
                      "type": "definition"
                    },
                    {
                      "body": "Monthly Price = $80 | Direct Hosting/Delivery COGS = 20% -> Gross Margin = 80% ($64/mo profit). Monthly Churn = 4% (`0.04`). Exact LTV = `$64 / 0.04 = $1,600` (Average lifespan = 25 months).",
                      "type": "example",
                      "title": "Real LTV Calculation"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "ALWAYS multiply gross revenue by real `Gross Margin %`—never mix raw top-line revenue directly with CAC!",
                        "Never guess unrealistically tiny 0.5% churn ahead of real 12-month data—test sensitivity at 5% vs 3%.",
                        "Attack early 90-day onboarding churn ruthlessly as your highest-ROI profitability lever."
                      ],
                      "title": "Applying True Customer Lifetime Value (Adjusted for Margin)"
                    },
                    {
                      "text": "A meal-kit subscription touted \"$900 LTV!\" using raw revenue while food shipping ate 72%—real Gross Margin LTV stood only at $252 while ads cost $280 per customer!",
                      "type": "case_study",
                      "title": "Vanity Revenue LTV Delusion",
                      "takeaway": "Adjusting explicitly by Gross Margin keeps growth solvent unconditionally!"
                    },
                    {
                      "text": "When happy loyal customers upgrade seats over time (`Net Revenue Retention > 100%`), retention lifts LTV dramatically past simple math ceilings!",
                      "type": "callout",
                      "title": "Track Annual Cohort Expansion Too (`NRR`)",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why must Gross Margin % strictly be multiplied inside LTV formulas before comparing against Customer Acquisition Cost (CAC)?",
                      "options": [
                        "Makes math shorter",
                        "Direct delivery/COGS dollars belong to suppliers—only leftover Gross Margin cash actually pays off marketing spend and overhead",
                        "Investors forbid gross dollars"
                      ],
                      "explanation": "Comparing raw unadjusted revenue against CAC tricks teams into overspending on costly customers.",
                      "correctIndex": 1
                    }
