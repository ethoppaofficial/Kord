                  "blocks": [
                    {
                      "text": "Separating Craft From Ego",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Treat feedback on documents, designs, or code as shared improvement of the artifact—not personal attack. Ask clarifying questions (\"Could you share an example of what felt unclear in Section 2?\"), thank reviewers honestly, and treat junior coordinators, support agents, and executives with identical courtesy.",
                      "type": "paragraph"
