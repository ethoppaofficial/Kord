                  "blocks": [
                    {
                      "text": "Aligning With Partner Scorecard Metrics",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Before pitching any partner, check recent earnings interviews, roadmap blogs, or job postings: are they bleeding churn around missing onboarding services? Fighting into a fresh vertical where you already hold deep trust? Pitching `\"We help reduce your Month-2 SMB churn by handling migration cleanly\"` earns executive meetings ten times faster than `\"Want affiliate links?\"`.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Partner Pain Mapping",
                      "text": "Diagnosing a prospective partner’s internal KPI bottleneck—churn gaps, stalled enterprise upgrades, or uncovered implementation load—to anchor your alliance inside their active priorities.",
                      "type": "definition"
                    },
                    {
                      "body": "Instead of pitching \"Promote our design app for $30 credit\", pitch: \"Clients adopting clean storefront layouts inside Month 1 renew SaaS annual plans 2x higher—let’s gift your annual tier members a guided layout setup check.\"",
                      "type": "example",
                      "title": "Retention-First Partner Angle"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Read partner product changelogs, customer G2 reviews (\"great software, hard setup...\"), and hiring roles before outreach.",
                        "Map how partnering reinforces THEIR core strategic priority.",
                        "Identify internal champion roles (`Head of Partnerships`, `Customer Success Lead`, `VP Ecosystem`)—not generic `info@`."
                      ],
                      "title": "Applying Decoding What Partners Actually Care About"
                    },
                    {
                      "text": "Sending standard \"Join our 15% Affiliate Tier!\" cold pitches to established software directors hit 1% reply rates.",
                      "type": "case_study",
                      "title": "Ignored Affiliate Pitch",
                      "takeaway": "Reframing cleanly around fixing their publicized integration complaint yielded 40% executive intro calls."
                    },
                    {
                      "text": "Public customer reviews complaining \"wish it connected smoothly to X\" reveal ready-made partnership ammunition instantly!",
                      "type": "callout",
                      "title": "Read Partner 3-Star Reviews",
                      "variant": "tip"
                    },
