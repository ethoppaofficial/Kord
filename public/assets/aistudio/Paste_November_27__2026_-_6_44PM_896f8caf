                },
                {
                  "id": "dc25f76e-ade9-4a9a-758f-2b143cffad99",
                  "title": "Ranking UX Findings by Severity & Impact",
                  "blocks": [
                    {
                      "text": "Triaging Blocker Bugs vs. Polish Tweaks",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Score observed test findings cleanly across Frequency + Task Impact: **Severity 1 (Blocker)**—prevents task completion or loses user data; **Severity 2 (High Friction)**—causes noticeable confusion/rework before succeeding; **Severity 3 (Minor Polish)**—cosmetic spacing or slight phrasing upgrade. Fix every Severity 1 before writing a line of launch code.",
                      "type": "paragraph"
                    },
                    {
                      "term": "UX Severity Triage",
                      "text": "Categorizing usability findings by how severely they halt real task success (`Blocker -> High Friction -> Minor Polish`) so engineering fixes critical barriers first.",
                      "type": "definition"
                    },
                    {
                      "body": "Sev 1 (4/5 failed): Save changes button sits below fold invisibly without warning -> Fix sticky action bar immediately. Sev 3: Center badge text 2px.",
                      "type": "example",
                      "title": "Clean Post-Test Readout"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Summarize findings cleanly in 1-page video/bullet highlights rather than 30-page reports.",
                        "Attach exact suggested UI fix beside every logged snag.",
                        "Verify major fixes with 2 quick follow-up re-checks cleanly."
                      ],
                      "title": "Applying Ranking UX Findings by Severity & Impact"
                    },
                    {
                      "text": "Ranking 18 test observations strictly into 3 Blockers and 15 minor notes allowed a lean product duo to launch cleanly on schedule while hitting 94% task success.",
                      "type": "case_study",
                      "title": "Focusing Sprint Velocity",
                      "takeaway": "Triage keeps standards high without blowing deadlines."
                    },
                    {
                      "text": "Letting developers or founders watch just ONE real user struggle on video builds instant alignment infinitely faster than ten slides.",
                      "type": "callout",
                      "title": "Bring Stakeholders to 1 Live Session",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Which usability finding requires immediate Severity 1 resolution prior to launch?",
                      "options": [
                        "Slightly off-center decorative banner icon",
                        "4 of 5 testers repeatedly abandoned checkout because error feedback cleared their typed address form silently",
                        "Body font weight 400 vs 450"
                      ],
                      "explanation": "Silent data loss and high-frequency task abandonment always block launch cleanly.",
                      "correctIndex": 1
                    }
