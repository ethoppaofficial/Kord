                  "blocks": [
                    {
                      "text": "Duration-Matched Capital Selection",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Sound financial governance matches funding duration strictly to the asset’s cash-generating life: **Short-term seasonal working spikes (`60 days`)** suit cash reserves or clean modest credit lines paid down immediately post-season; **Long-lived durable gear (`5-year equipment`)** fits amortizing fixed-term equipment loans paying alongside machine usage; **High-risk unproven R&D bets** belong strictly to risk-tolerant equity/retained profits—NEVER rigid personal debt guarantees!",
                      "type": "paragraph"
                    },
                    {
                      "term": "Term-Matching Principle",
                      "text": "Aligning borrowing repayment periods closely with the productive useful life of the acquired asset so generated operational cash comfortably retires debt along the way.",
                      "type": "definition"
                    },
                    {
                      "body": "Putting $35,000 of risky unvalidated software development onto high-interest short credit cards forces frantic debt payments months ahead of user revenue!",
                      "type": "example",
                      "title": "Dangerous Mismatch Example"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Reserve long-term debt strictly for proven revenue-generating physical assets carrying steady margins (`>= 2x debt coverage`).",
                        "Calculate true all-in Effective APR including origination fees before signing flashy \"quick merchant cash advance\" notes—many carry brutal hidden 40–90% annualized costs!",
                        "Build a quiet **3–6 Month Core Fixed Operating Reserve** systematically ahead of taking optional risk swings."
                      ],
                      "title": "Applying Matching Funding Lifespan to Asset Lifespan"
                    },
                    {
                      "text": "Taking an \"instant online daily-debit revenue loan\" stripped 15% of daily register cash automatically—crushing healthy margins and forcing secondary bailout loans.",
                      "type": "case_study",
                      "title": "Predatory Cash Advance Spiral",
                      "takeaway": "Reading true annualized effective interest rates cleanly protects businesses from predatory traps!"
                    },
                    {
                      "text": "Notice disguised phrases like `\"1.28 factor rate over 4 months\"`—often equaling devastating triple-digit annualized borrowing rates!",
                      "type": "callout",
                      "title": "Read Annualized APR—Never \"Factor Rates\"",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Which borrowing match respects sound financial term-matching safety?",
                      "options": [
                        "Funding high-risk speculative unproven R&D on personal credit cards",
                        "Financing proven revenue-producing 6-year equipment over a matched fixed-rate multi-year term while retaining liquid reserves",
                        "Using long-term mortgages strictly for monthly utility bills"
                      ],
                      "explanation": "Duration-matched fixed terms pair steady predictable asset returns cleanly against calm structured repayments.",
                      "correctIndex": 1
