                {
                  "id": "d466c623-f80e-fa10-03e4-7a4ab1178b32",
                  "title": "Tight Product Stories & Direct Call-Outs",
                  "blocks": [
                    {
                      "text": "Single-Problem 30-Second Spots",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Effective short promos spotlight ONE painful relatable moment (`0–6s`), demonstrate ONE crisp product relief visually (`6–22s`), show quick honest outcome proof (`22–26s`), and finish with one calm direct step (`26–30s`). Under 75 total spoken words gives editors visual space for clear pacing.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Single-Pain Ad Rule",
                      "text": "Dedicating a tight 30-second script strictly to resolving ONE frustrating everyday buyer problem rather than listing an entire SaaS feature sheet.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Still copying tracking numbers one by one into late Friday client emails? [Show hectic tabs] Watch how SheetSync pulls every updated shipping link cleanly in one click [Demo clean UI]. Get four hours back weekly—start free at SheetSync dot com.\"",
                      "type": "example",
                      "title": "70-Word Demo Spot"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Hold short commercial copy safely between 60 and 75 spoken words per 30 seconds.",
                        "Show the tangible pain visually BEFORE cutting into clean UI software clarity.",
                        "Keep final CTA URL simple, speakable, and clearly echoed on screen."
                      ],
                      "title": "Applying Tight Product Stories & Direct Call-Outs"
                    },
                    {
                      "text": "Squeezing six testimonials and five integrations into 30 seconds overwhelmed ears completely.",
                      "type": "case_study",
                      "title": "Rushed Auctioneer Commercial",
                      "takeaway": "Focusing solely on Friday invoice reconciliation made one crisp 65-word spot convert strongly."
                    },
                    {
                      "text": "Avoid hard-to-spell slashes aloud; point cleanly to crisp visual screen cards or simple domains.",
                      "type": "callout",
                      "title": "Speak Your URL Smoothly",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why limit a 30-second promotional script to resolving just ONE user problem?",
                      "options": [
                        "Shorter scripts cost less",
                        "Focus lets one vivid pain + visual solution lock into viewer memory rather than washing out into feature noise",
                        "Viewers dislike multiple tabs"
                      ],
                      "explanation": "One sharp problem sticks cleanly; five rushed features cancel one another out.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Single-pain simplicity gives micro-commercials unmistakable persuasive punch.",
                  "position": 2,
                  "resources": [
