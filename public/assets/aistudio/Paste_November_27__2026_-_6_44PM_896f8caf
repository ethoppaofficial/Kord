                    {
                      "term": "Client SLA Reminder",
                      "text": "Politely reminding a client what input or approval you need from them—and by when—to keep their launch date safe.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Completed: Draft homepage & mobile QA. Needed by Tue 12pm: Final team photos so launch stays on track for Friday. Next: Contact form integration.\"",
                      "type": "example",
                      "title": "Structured Client Check-In"
                    },
                    {
                      "type": "steps",
                      "items": [
