                  "blocks": [
                    {
                      "text": "Combining Usage, Support, Sponsor & Billing Cues",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Effective **Health Scores** stay dead simple—combining 4 honest weighted cues cleanly into **Green / Yellow / Red**: (1) **Core Adoption Depth** (are key workflows still running steadily?), (2) **Support Friction Trend** (repeated unresolved bugs or tense escalations?), (3) **Champion Continuity** (did our beloved primary sponsor just leave the company?!), and (4) **Invoice/Billing Hygiene**. Even ONE red flag—like a key sponsor leaving—immediately shifts an account to Yellow Watch regardless of happy historical metrics!",
                      "type": "paragraph"
                    },
                    {
                      "term": "Champion Departure Risk",
                      "text": "The sudden spike in renewal churn danger when the exact internal customer advocate who championed purchasing and setup changes roles or leaves the client organization quietly.",
                      "type": "definition"
                    },
                    {
                      "body": "Bounce notification / LinkedIn update reveals primary contact Maya left Acme -> Health Score flips Yellow immediately -> Account lead proactively introduces value brief cleanly to incoming replacement Director within 14 days!",
                      "type": "example",
                      "title": "Catching Silent Sponsor Exit"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Weight real core usage and sponsor stability far heavier than surface politeness.",
                        "Never automate fake bloated 15-factor math nobody understands—keep 4 crystal signals transparent!",
                        "Audit Red/Yellow watch accounts every single Tuesday in focused 20-minute CS huddles."
                      ],
                      "title": "Applying Simple Practical Customer Health Scoring"
                    },
                    {
                      "text": "An annual enterprise buyer never opened a single support ticket all Q3 and politely smiled—simply because original sponsor left cleanly in June and nobody ever re-onboarded the new manager before November non-renewal!",
                      "type": "case_study",
                      "title": "Blindsided \"Happy\" Cancellation",
                      "takeaway": "Monitoring key-contact stability saves effortless multi-year renewals permanently!"
                    },
                    {
                      "text": "Zero usage PLUS zero support tickets is NOT peaceful calm—it frequently signals abandoned shelfware heading straight toward cancellation!",
                      "type": "callout",
                      "title": "Silence Rarely Equals Satisfaction",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why can `\"Zero Support Tickets Opened for 90 Days\"` paired with falling usage actually flash RED Warning rather than Green health?",
                      "options": [
                        "Support bots broke",
                        "Customers who gave up completely stop filing help tickets quietly right before canceling shelfware renewals",
                        "Usage spikes lag"
                      ],
                      "explanation": "Zero support friction combined with absent core usage indicates quiet abandonment—not effortless perfection.",
                      "correctIndex": 1
