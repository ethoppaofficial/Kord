                {
                  "id": "4b190d2e-2717-6e90-8a9d-054632dcdf44",
                  "title": "Visual & Written Story Pairing",
                  "blocks": [
                    {
                      "text": "One-Idea Slides & Structural Whitespace",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "When telling stories alongside slides or digital posts, put ONE arresting visual image or short anchor quote on screen rather than spelling out your entire speech. Let visuals carry atmosphere while voice or concise paragraphs advance narrative suspense.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Visual Counterpoint",
                      "text": "Using a clean photo, object, or single number on screen that complements spoken story tension instead of duplicating words verbatim.",
                      "type": "definition"
                    },
                    {
                      "body": "While narrating the ruined bakery delivery, display one crisp photo of melted frosting—no bullet text competing with audience ears.",
                      "type": "example",
                      "title": "Effective Keynote Slide"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Strip full narrative sentences off companion presentation slides.",
                        "Match image mood tightly to the beat being shared.",
                        "Break written digital stories cleanly with line space before pivotal reveals."
                      ],
                      "title": "Applying Visual & Written Story Pairing"
                    },
                    {
                      "text": "Putting a 90-word story paragraph on a projector while reading it aloud forced attendees to silently race ahead of the speaker.",
                      "type": "case_study",
                      "title": "Slide-Reading Distraction",
                      "takeaway": "Swapping to a single evocative photo locked eyes and ears together instantly."
                    },
                    {
                      "text": "Pause a half-second right after clicking to a striking turn slide—let the room take it in.",
                      "type": "callout",
                      "title": "Pause Visuals Before Reveals",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why avoid pasting whole story paragraphs onto live presentation slides?",
                      "options": [
                        "Fonts look blurry",
                        "Audiences read faster silently than you speak, fracturing attention",
                        "Slides cannot display quotes"
                      ],
                      "explanation": "Clean visual anchors amplify spoken storytelling without stealing vocal attention.",
