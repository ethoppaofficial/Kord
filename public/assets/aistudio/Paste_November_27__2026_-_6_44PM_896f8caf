                {
                  "id": "787b349c-2b03-8f6e-dbb4-637f32f67208",
                  "title": "Serving Multiple Readers Inside One Report",
                  "blocks": [
                    {
                      "text": "Modular Multi-Tier Structure",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Strong reports layer detail gracefully instead of forcing directors to wade through raw data tables to locate conclusions. Opening Title + Executive Summary serve leadership; cleanly numbered Findings + Visual Tables serve operational peers; Technical Methods and Raw Logs live neatly in labeled Appendices.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Modular Report Layering",
                      "text": "Organizing analytical documents into independent depth tiers (Executive Brief -> Main Findings -> Appendices) so each stakeholder accesses needed granularity smoothly.",
                      "type": "definition"
                    },
                    {
                      "body": "Page 1: Executive Summary (headline metrics + top 3 recommendations). Pages 2–4: Sectioned Findings & Charts. Page 5+: Survey Instrument & Raw CSV Summaries.",
                      "type": "example",
                      "title": "Clean Tiered Layout"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Decide primary decision audience and secondary technical verifier roles upfront.",
                        "Number main sections clearly (`1.0`, `2.0`, `2.1`) for effortless meeting reference (\"See section 2.3\").",
                        "Ensure Page 1 makes full standalone sense even if Pages 5–12 remain unread."
                      ],
                      "title": "Applying Serving Multiple Readers Inside One Report"
                    },
                    {
                      "text": "An evaluation team placed twenty pages of interview transcripts ahead of recommendations; committee members postponed funding out of confusion.",
                      "type": "case_study",
                      "title": "Unlayered 30-Page Dump",
                      "takeaway": "Adding a 1-page upfront Findings-Recommendations brief secured unanimous approval cleanly."
                    },
                    {
                      "text": "In team review calls, saying \"Check Finding 3.2\" beats flipping awkwardly past unnumbered headings.",
                      "type": "callout",
                      "title": "Use Decimal Section Numbers",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why isolate detailed survey questions and raw logs inside labeled Appendices?",
                      "options": [
                        "Because raw evidence is unimportant",
                        "So main narrative findings stay concise and readable while reviewers verify rigor cleanly on demand",
                        "To increase margin width"
                      ],
                      "explanation": "Appendices preserve methodological transparency without clogging executive flow.",
