                {
                  "id": "ce5c268c-68bf-6bf8-2c11-9ee0b20a9bc1",
                  "title": "Unblocking Handoffs Without Micromanaging",
                  "blocks": [
                    {
                      "text": "Servant Leadership & Bottleneck Clearing",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "A great project manager clears obstacles OUT of makers’ paths instead of nagging over shoulders! When progress stalls on a board card (`>48 hours stuck in Review/Blocked`), step in helpfully onto **the constraint**—chasing stalled legal signoffs, pre-summarizing messy feedback into clean bullet points, or pairing two conflicting reviewers on a crisp 10-minute tie-breaker call.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Bottleneck Clearing",
                      "text": "Focusing project leadership actively on removing external approvals, conflicting specs, tool gaps, or stalled handoffs holding makers back rather than hovering over individual execution.",
                      "type": "definition"
                    },
                    {
                      "body": "Nag: \"Hey any update on wireframes yet??\" Unblocker: \"Noticed Legal copy notes blocked screen 3—I condensed their 4 comments into 2 crisp choices below so you stay moving smoothly!\"",
                      "type": "example",
                      "title": "Helpful Unblocker vs. Micromanager"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Spot cards sitting untouched inside \"Waiting / Review\" >2 days cleanly via quick visual tags.",
                        "Consolidate scattered multi-reviewer comments into ONE decisive non-contradictory edit list.",
                        "Protect makers cleanly against pointless status syncs during deep build blocks!"
                      ],
                      "title": "Applying Unblocking Handoffs Without Micromanaging"
                    },
                    {
                      "text": "Designers burned four whole days bouncing between VP Sales wanting bigger red buttons and Marketing Director removing them—nobody resolved the clash!",
                      "type": "case_study",
                      "title": "Contradictory Feedback Trap",
                      "takeaway": "A crisp 10-min alignment huddle settled one single direction permanently cleanly!"
                    },
                    {
                      "text": "Tasks rarely break inside one skilled contributor’s hands—projects slip almost always across fuzzy handoffs BETWEEN people!",
                      "type": "callout",
                      "title": "Own the White Space Between Teams",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Where do complex cross-functional team projects most frequently lose critical schedule days?",
                      "options": [
                        "Slow typing speed inside tasks",
                        "Fuzzy stalled handoffs, uncoordinated review waits, and conflicting unresolved feedback sitting BETWEEN roles",
                        "Computer restarts"
                      ],
                      "explanation": "Clearing external approvals and conflicting feedback between people unlocks immediate team velocity.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Removing cross-team friction quietly accelerates delivery far better than stressful schedule pressure.",
                  "position": 2,
