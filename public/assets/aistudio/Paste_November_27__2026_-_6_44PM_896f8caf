                  "title": "Memorable Endings & Discussion Prompts",
                  "blocks": [
                    {
                      "text": "Action-Oriented Synthesis Closings",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Visitors who scroll 100% down a long post are your most engaged audience. Reward completion cleanly: recap the single central mindset shift in 2 crisp lines, issue ONE tiny 10-minute test challenge they can run today, and invite thoughtful comments via a specific open question.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Specific Discussion Prompt",
                      "text": "Closing articles with a narrow, experience-inviting question (\"Which bottleneck slows your onboarding down most right now?\") instead of generic \"Thoughts below?\".",
                      "type": "definition"
                    },
                    {
                      "body": "\"Clean documentation isn’t extra admin work—it saves tomorrow’s calm focus. Open just ONE team wiki link today and fix its prerequisites header—what single missing step trips new teammates most in your world?\"",
                      "type": "example",
                      "title": "Crisp Blog Conclusion"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Summarize core insight concisely rather than repeating all H2s tediously.",
                        "Recommend ONE logical next post to keep deep exploration flowing.",
                        "Spark authentic comment conversations with focused open questions."
                      ],
                      "title": "Applying Memorable Endings & Discussion Prompts"
                    },
                    {
                      "text": "Ending long tutorials cleanly without suggesting next steps or encouraging dialogue left engagement flat.",
                      "type": "case_study",
                      "title": "Dead-End Article Drop",
                      "takeaway": "Adding \"Step 2 next: Read how we test copy\" raised multi-page session depth 35%."
                    },
                    {
                      "text": "Linking ONE carefully chosen follow-up post outperforms noisy 8-card \"Related Posts\" clutter.",
                      "type": "callout",
                      "title": "Curate Just One Next Read",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why ask a concrete focused question at the very end of an educational post?",
                      "options": [
                        "To hide weak research",
                        "Specific prompts help readers reflect meaningfully and spark real comment dialogue",
                        "Required for HTML validity"
                      ],
                      "explanation": "Focused questions lower friction for thoughtful reader sharing.",
