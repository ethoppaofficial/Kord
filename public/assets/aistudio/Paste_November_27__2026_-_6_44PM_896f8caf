                    }
                  ],
                  "takeaways": [
                    "Cap main supporting pillars between 3 and 4",
                    "Verify each pillar directly proves the governing answer",
                    "Cluster granular data points underneath parent pillars"
                  ],
                  "objectives": [
                    "Explain vertical & horizontal argument trees",
                    "Apply top-down logic with the pyramid principle in original drafts"
                  ],
                  "est_minutes": 28,
                  "is_required": true,
                  "introduction": "Readers absorb hierarchical ideas easily when grouped logically rather than listed as a flat 14-point inventory.",
                  "further_reading": [
