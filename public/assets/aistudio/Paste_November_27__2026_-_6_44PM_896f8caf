                  "blocks": [
                    {
                      "text": "Customer Effort Score & Actionable Follow-Up",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Pick lean, surgical feedback moments: **CSAT** (`1-click happy/meh/sad right post-support ticket close`), **CES (`Customer Effort Score`: \"How easy was getting setup done today?\" right after Day-14 onboarding)**—proving effortless simplicity predicts loyalty tightly!—and sparing semi-annual **NPS** (`only valuable if teams read comments AND reply visibly to detractors within 48 hours!`). Closing the loop directly back to customers (`\"Remember your CSV comment last month? Just shipped!\"`) builds astonishing devotion.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Customer Effort Score (CES)",
                      "text": "Measuring literally how much friction a user felt completing a task (`setup, resolving bugs`)—consistently outperforming broad brand polls in predicting actual short-term churn risk.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Hi Priya — You flagged our invoice PDF export lacked PO fields in October’s feedback box. Engineering shipped custom PO fields this morning cleanly—wanted you first to know!\"",
                      "type": "example",
                      "title": "Delightful Closed-Loop Ping"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Trigger max 1 feedback check per 60–90 days per human (`cool-down throttling`) so loyal users don’t feel hunted!",
                        "Keep polls strictly 1-click rating + 1 optional short comment line.",
                        "Share verbatim top 5 recurring client requests smoothly with product leadership every month ranked by affected ARR!"
                      ],
                      "title": "Applying Closing the Loop on Feedback (`CSAT, CES, NPS`)"
                    },
                    {
                      "text": "A firm asked customers `\"How likely are you to recommend us?\"`, collected 300 painful 3/10 frustrated comments—and literally NEVER followed up with a single unhappy client!",
                      "type": "case_study",
                      "title": "Unanswered 2/10 NPS Black Hole",
                      "takeaway": "If you lack bandwidth to read and respond kindly to scores, pause surveys immediately—unanswered criticism worsens frustration!"
                    },
                    {
                      "text": "Emailing specific customers back months later when THEIR requested fix goes live creates legendary lifelong fans!",
                      "type": "callout",
                      "title": "Close Loop Back When Bugs Ship",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why enforce a strict 60–90 day \"Feedback Cool-Down\" throttle across CRM survey workflows?",
                      "options": [
                        "Email providers charge extra",
                        "Prevents repetitive multi-system survey fatigue so thoughtful real users stay willing to share genuine insights",
                        "Scores inflate artificially"
