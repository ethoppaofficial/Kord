                {
                  "id": "ef125bda-0143-d36e-ef78-62c5ebaa21b8",
                  "title": "Remote Video & Focus Etiquette",
                  "blocks": [
                    {
                      "text": "Environment, Framing & Active Attention",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Position light in front of your face rather than behind your head, raise your camera near eye level, test mic clarity, and keep mute disciplined in noisy rooms. Looking near the camera lens when speaking makes listeners feel directly addressed. Avoid typing side emails while unmuted or clearly distracted.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Eye-Level Lens Framing",
                      "text": "Raising a laptop slightly so the camera sits near natural eye level rather than pointing upward from chest height.",
                      "type": "definition"
                    },
                    {
                      "body": "Laptop elevated on two books -> front window or lamp lighting -> headphones connected -> unrelated notifications snoozed.",
                      "type": "example",
                      "title": "Quick 30-Second Pre-Call Check"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Elevate camera close to eye level.",
                        "Mute browser notifications before sharing your screen.",
                        "State clearly if you must step away briefly or turn off video during unstable Wi-Fi."
                      ],
                      "title": "Applying Remote Video & Focus Etiquette"
                    },
                    {
                      "text": "Screen-sharing without Do Not Disturb exposed a private salary Slack message during a client demo.",
                      "type": "case_study",
                      "title": "Notification Leak Prevention",
                      "takeaway": "Enabling Do Not Disturb before every screen share eliminates embarrassment risk completely."
                    },
                    {
                      "text": "Toggle Focus / Do Not Disturb 10 seconds before hitting \"Share Screen\" without exception.",
                      "type": "callout",
                      "title": "Pause Notifications Every Share",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What technical hygiene step should happen before every live screen share?",
                      "options": [
                        "Open all personal browser bookmarks",
                        "Enable Do Not Disturb and close unrelated sensitive tabs",
                        "Turn volume up to maximum"
                      ],
                      "explanation": "Silencing alerts and hiding unrelated tabs protects privacy and polish.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Clean remote hygiene conveys focus, care, and dependability.",
                  "position": 2,
