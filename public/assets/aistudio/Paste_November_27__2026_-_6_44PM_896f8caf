            {
              "id": "28997796-7264-9fb2-23c9-55ab121828a0",
              "title": "Module 2: Verbal Precision & Structured Speaking",
              "lessons": [
                {
                  "id": "18d216a6-49d4-8c32-6cf0-edffe9bdba8f",
                  "title": "Thinking on Your Feet With PREP",
                  "blocks": [
                    {
                      "text": "PREP & Bottom-Line Spoken Structure",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "The PREP framework—Point, Reason, Example, Point—gives listeners a mental coat rack to hang your ideas on. By stating your conclusion first, offering one strong rationale, grounding it in a specific example, and restating your recommendation, you sound prepared even on unscripted topics.",
                      "type": "paragraph"
                    },
                    {
                      "term": "PREP Framework",
                      "text": "Four-beat spoken structure: state your core Point, give the primary Reason, share one concrete Example, and reinforce the Point.",
                      "type": "definition"
                    },
                    {
                      "body": "Point: I recommend keeping onboarding to 3 steps. Reason: Extra fields double drop-off. Example: Last test showed a 42% completion jump when step 4 was deferred. Point: Let us launch 3 steps this sprint.",
                      "type": "example",
                      "title": "Answering a Scope Change Question"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Pause 1–2 seconds to pick your core takeaway.",
                        "Lead directly with your recommendation.",
                        "Support with one focused rationale and one micro-example.",
                        "Stop cleanly after restating the takeaway."
                      ],
                      "title": "Applying Thinking on Your Feet With PREP"
                    },
                    {
                      "text": "A junior coordinator spent four minutes narrating chronological troubleshooting instead of stating current status and blocker.",
                      "type": "case_study",
                      "title": "Stand-Up Rambling Fix",
                      "takeaway": "Leading with status and blocker shrinks updates to 35 seconds while accelerating help."
                    },
                    {
                      "text": "Finish your sentence cleanly and pause—resist adding nervous trailing disclaimers like \"does that make sense?\"",
                      "type": "callout",
                      "title": "Land the Plane",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "In PREP, why should the conclusion appear before the detailed example?",
                      "options": [
                        "To fill awkward silence quickly",
                        "So listeners know what claim your facts are proving",
                        "To prevent colleagues from asking questions"
                      ],
                      "explanation": "Giving the headline first helps listeners process your rationale effortlessly.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Simple spoken scaffolds eliminate rambling and sharpen authority.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "318870bc-688f-4492-9817-9c0c0a2aa697",
                      "url": "https://www.plainlanguage.gov/guidelines/",
                      "title": "Plain Language Guidelines & Clarity Principles",
                      "position": 1,
                      "resource_type": "guide"
                    },
                    {
                      "id": "eb6ac426-2c6c-4d2b-9916-4bdd89294ae8",
                      "url": "https://www.mindtools.com/",
                      "title": "Communicating Clearly in Workplaces",
                      "position": 2,
                      "resource_type": "article"
                    }
                  ],
                  "takeaways": [
                    "Lead with your point before background storytelling",
                    "One sharp example beats three vague generalizations",
                    "Use deliberate silence instead of filler words"
                  ],
                  "objectives": [
                    "Explain prep & bottom-line spoken structure",
                    "Apply thinking on your feet with prep in everyday scenarios"
                  ],
                  "est_minutes": 28,
                  "is_required": true,
                  "introduction": "When put on the spot in meetings or interviews, rambling erodes credibility faster than an imperfect answer.",
                  "further_reading": [
