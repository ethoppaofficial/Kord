            {
              "id": "e766919e-a279-7921-29eb-015213521184",
              "title": "Module 2: Pyramid Principle & MECE Structuring",
              "lessons": [
                {
                  "id": "67b4d06b-6eb4-a1d5-bb9d-d5afe8209f44",
                  "title": "Top-Down Logic With the Pyramid Principle",
                  "blocks": [
                    {
                      "text": "Vertical & Horizontal Argument Trees",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Popularized by Barbara Minto, the Pyramid Principle states that every main claim should be directly supported by three to four distinct grouped arguments underneath it, each backed by concrete facts. Reading only the top-level subheadings must tell your complete strategic story coherently.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Pyramid Principle",
                      "text": "Structuring persuasive business writing as a logical tree where one governing answer sits atop grouped supporting arguments and factual evidence.",
                      "type": "definition"
                    },
                    {
                      "body": "Governing Claim: \"Expand into Mid-Market B2B in Q3.\" Pillars: 1. Demand verified (18 inbound leads/mo). 2. Unit economics profitable (3.4x LTV/CAC). 3. Onboarding team ready.",
                      "type": "example",
                      "title": "Pyramid Grouping Example"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Write one overarching strategic sentence at the top.",
                        "Select 3–4 logical pillars justifying that conclusion.",
                        "Test reading ONLY top claim plus pillar headings—ensure the logic flows standalone."
                      ],
                      "title": "Applying Top-Down Logic With the Pyramid Principle"
                    },
                    {
                      "text": "An operations proposal listed eleven unsorted observations mixing hiring, server costs, and customer quotes equally.",
                      "type": "case_study",
                      "title": "Flat 11-Bullet Strategy Doc",
                      "takeaway": "Grouping them under People, Margin, and Demand made board adoption immediate."
                    },
                    {
                      "text": "Human short-term recall breaks beyond four parallel buckets; cluster smaller observations under sharper parent themes.",
                      "type": "callout",
                      "title": "Limit Top Pillars to 3–5",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "How do you verify a Pyramid Principle structure cleanly?",
                      "options": [
                        "Confirm every bullet starts with \"The\"",
                        "Check that reading only the main claim plus level-1 headings reads as a complete logical argument",
                        "Make sure paragraphs reach 200 words"
                      ],
                      "explanation": "Strong logical hierarchy stands clear at heading level even before reading deep prose.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Hierarchical logic cuts executive reading load in half while strengthening persuasion.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "29cc1c1f-86c7-41cd-aca0-056abedb451a",
                      "url": "https://owl.purdue.edu/",
                      "title": "Purdue OWL General Writing Resources",
                      "position": 1,
