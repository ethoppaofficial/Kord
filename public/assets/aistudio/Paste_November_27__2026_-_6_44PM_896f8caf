            {
              "id": "f8129e59-e472-48ac-6da2-34ada49d713b",
              "title": "Module 2: Paragraph Unity & Logical Flow",
              "lessons": [
                {
                  "id": "d615bd90-5586-5732-7ea9-255698d7f417",
                  "title": "Topic Sentences & Controlling Ideas",
                  "blocks": [
                    {
                      "text": "Single-Focus Paragraph Design",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "A unified paragraph tests one clear idea from top to bottom. When two distinct claims compete inside the same block, skimmers miss the second point entirely. Writing an explicit topic sentence first makes organizing evidence, illustrations, and closing synthesis automatic.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Controlling Idea",
                      "text": "The central claim in a paragraph’s opening sentence that governs every sentence that follows.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Remote reading reduces eyestrain only when typography respects line length.\" Every following sentence then discusses optimal character measure and margins.",
                      "type": "example",
                      "title": "Focused Paragraph Opening"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Write your intended point in 12 words before drafting the paragraph.",
                        "Check every subsequent sentence against that opening claim.",
                        "Split off tangential thoughts into their own focused paragraph."
                      ],
                      "title": "Applying Topic Sentences & Controlling Ideas"
                    },
                    {
                      "text": "A trainee packed history, pricing, and technical bugs into one 220-word block.",
                      "type": "case_study",
                      "title": "Scattered Literature Review",
                      "takeaway": "Dividing into three crisp themed paragraphs turned confusion into an executive-ready brief."
                    },
                    {
                      "text": "Summarize every paragraph in five words in the margin; if you need \"and also...\", split the paragraph.",
                      "type": "callout",
                      "title": "Reverse Outline Check",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What is the safest signal that a paragraph should be split in two?",
                      "options": [
                        "It exceeds four lines on screen",
                        "It introduces a second distinct claim unrelated to its opening sentence",
                        "It uses an example"
                      ],
                      "explanation": "Topic drift—not line count alone—dictates where paragraph breaks belong.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Tight topic control guarantees readers never wonder why a sentence is there.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "0d5db475-40f4-45ee-a251-6624126f61f6",
                      "url": "https://owl.purdue.edu/",
