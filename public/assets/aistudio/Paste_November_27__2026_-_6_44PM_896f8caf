                      "title": "UK Government Content Design Standards",
                      "position": 2,
                      "resource_type": "documentation"
                    }
                  ],
                  "takeaways": [
                    "Introduce figures explicitly prior to display",
                    "Highlight central insight inside graphic titles",
                    "Annotate visible spikes or dips concisely"
                  ],
                  "objectives": [
                    "Explain lead-in, insight title & takeaway triad",
                    "Apply writing analytical callouts & signposting cleanly"
                  ],
                  "est_minutes": 28,
                  "is_required": true,
                  "introduction": "Dropping a raw table mid-page without introducing what pattern to inspect leaves readers drawing conflicting conclusions.",
                  "further_reading": [
