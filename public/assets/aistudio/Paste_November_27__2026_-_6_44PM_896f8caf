            {
              "id": "9cdea651-4911-9286-23e4-1a1a2af92e00",
              "title": "Module 3: Channel Choice & Asynchronous Craft",
              "lessons": [
                {
                  "id": "d0a6f1ca-8b94-83e8-2291-59b7dbcfcb69",
                  "title": "Matching Medium to Stakes",
                  "blocks": [
                    {
                      "text": "Synchronous vs. Asynchronous Bandwidth",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Rich emotional conversations, high ambiguity, or multi-party negotiation belong in live voice or video calls. Status updates, documented decisions, instructions, and non-urgent reviews belong in asynchronous writing where teammates can read deeply without context switching. Picking the wrong channel wastes attention on both ends.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Channel Richness",
                      "text": "The degree to which a medium conveys vocal tone, facial cues, rapid feedback, and permanent referenceability.",
                      "type": "definition"
                    },
                    {
                      "body": "Move routine metric readouts into a structured async post; reserve 15 minutes live strictly for debating the two blocked items.",
                      "type": "example",
                      "title": "Replacing a 45-Minute Status Call"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Assess emotional sensitivity and ambiguity first.",
                        "Use async writing when permanence and thoughtful review matter.",
                        "Escalate immediately to a brief call after two unproductive back-and-forth replies."
                      ],
                      "title": "Applying Matching Medium to Stakes"
                    },
                    {
                      "text": "Two team leads argued over pricing tiers in rapid chat bursts, misreading short phrases as hostility.",
                      "type": "case_study",
                      "title": "Two-Hour Slack Spiral",
                      "takeaway": "Switching to a 10-minute call resolved tone friction and produced a clean summary doc."
                    },
                    {
                      "text": "If a chat thread takes more than three clarifying back-and-forths, hop on a 5-minute call and document the outcome afterward.",
                      "type": "callout",
                      "title": "The Two-Ping Escalation Rule",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "When is a live conversation strongly preferred over chat?",
                      "options": [
                        "Sharing weekly KPI numbers",
                        "Resolving emotionally charged ambiguity or complex trade-offs",
                        "Sending calendar links"
                      ],
                      "explanation": "High ambiguity and emotional stakes require immediate vocal feedback and shared nuance.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Smart channel discipline protects team focus and speeds real alignment.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "0c491780-9c3c-4b22-b7b8-e2fd44e90ac7",
                      "url": "https://www.plainlanguage.gov/guidelines/",
                      "title": "Plain Language Guidelines & Clarity Principles",
                      "position": 1,
                      "resource_type": "guide"
                    },
                    {
                      "id": "9a4a6d47-d591-454a-8d0d-3ac3cf8910f3",
                      "url": "https://www.mindtools.com/",
                      "title": "Communicating Clearly in Workplaces",
                      "position": 2,
                      "resource_type": "article"
                    }
                  ],
                  "takeaways": [
                    "Default to async for status and documentation",
                    "Default to live for sensitive or ambiguous decisions",
                    "Document live decisions back into permanent async channels"
                  ],
                  "objectives": [
                    "Explain synchronous vs. asynchronous bandwidth",
                    "Apply matching medium to stakes in everyday scenarios"
                  ],
                  "est_minutes": 28,
                  "is_required": true,
                  "introduction": "Wrong channel choices create endless ping-pong threads or unnecessary calendar fatigue.",
                  "further_reading": [
