                      "title": "Distinguish Taste From Error",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why prefix peer review notes with `[Must Fix]` vs. `[Optional Idea]`?",
                      "options": [
