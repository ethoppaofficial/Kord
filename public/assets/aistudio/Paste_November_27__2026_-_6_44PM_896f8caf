            {
              "id": "3a1ff191-ab4b-87b5-213d-5bf48b840f09",
              "title": "Module 5: Educational Tutorials & Narrative Storytelling",
              "lessons": [
                {
                  "id": "2a27e9cb-9ca4-378b-e459-e3845cbd5ff1",
                  "title": "Teaching Through Narrative Problem Context",
                  "blocks": [
                    {
                      "text": "Goal-Driven Demo Scripts",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Frame tutorials around completing ONE meaningful realistic project goal (\"Today we turn messy feedback rows into one executive chart in four clicks\"). Introduce tools only at the exact second the project demands them—learners remember features effortlessly when tied to solving authentic tension.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Just-in-Time Tool Reveal",
                      "text": "Introducing software settings or theoretical rules solely at the precise project moment they resolve an immediate visible problem rather than touring empty menus upfront.",
                      "type": "definition"
                    },
                    {
                      "body": "Dry: \"Now let us learn Filter Views.\" Contextual: \"Notice twelve rows show cancelled tests ruining our average—let’s apply one Filter View so clean revenue pops cleanly.\"",
                      "type": "example",
                      "title": "Contextual Feature Framing"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Open tutorials displaying the finished compelling result right at second 5.",
                        "Teach ONLY features actively required to build today’s goal—leave unused edge buttons out.",
                        "Validate tricky steps aloud (\"Pause right here if yours displays an extra pop-up—click Allow\")."
                      ],
                      "title": "Applying Teaching Through Narrative Problem Context"
                    },
                    {
                      "text": "A software onboarding video spent four minutes touring sidebar icons alphabetically before building anything.",
                      "type": "case_study",
                      "title": "Menu-Tour Snooze",
                      "takeaway": "Restructuring around \"Build Your First Weekly Dashboard in 3 Minutes\" lifted course completion over 2x."
                    },
                    {
                      "text": "Let learners see the sharp end artifact within the opening 8 seconds so every subsequent step makes clear sense.",
                      "type": "callout",
                      "title": "Show Finished Result First",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why wait until a real tutorial bottleneck arrives before introducing a software button?",
                      "options": [
                        "Saves script pages",
                        "Learners retain tool purpose deeply when seeing exactly what concrete obstacle it solves right then",
                        "Avoids screen zooming"
                      ],
                      "explanation": "Need-based demonstration cements practical memory far stronger than abstract menu tours.",
                      "correctIndex": 1
                    }
