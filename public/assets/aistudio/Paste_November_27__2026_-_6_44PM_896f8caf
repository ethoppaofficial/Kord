                    },
                    {
                      "id": "04478e09-79ca-4b06-8f7a-a01ee0333c8f",
                      "url": "https://www.gov.uk/guidance/content-design",
                      "title": "Service Writing & Clear Communication Standards",
                      "position": 2,
                      "resource_type": "documentation"
                    }
                  ],
                  "takeaways": [
                    "Use informative subject lines and bolded asks",
                    "Keep paragraphs tight and scannable",
                    "Bring proposed solutions alongside surfaced problems"
                  ],
                  "objectives": [
                    "Explain visual hierarchy in everyday messages",
                    "Apply scannable async structure in everyday scenarios"
                  ],
                  "est_minutes": 28,
                  "is_required": true,
                  "introduction": "Long unbroken blocks of chat or email get skimmed and misread by busy colleagues.",
                  "further_reading": [
                    {
                      "url": "https://www.mindtools.com/",
