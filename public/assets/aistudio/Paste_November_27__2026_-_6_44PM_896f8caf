              "lessons": [
                {
                  "id": "172d1f56-00bd-a646-ed7a-70763b0ae5fc",
                  "title": "Docs-as-Code Workflow & Single Sourcing",
                  "blocks": [
                    {
                      "text": "Co-Locating & Reviewing Docs Like Code",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Docs-as-code keeps Markdown/structured manuals inside version control right alongside application code so engineers update reference flags in the very same Pull Request that alters API routes. Automated linters validate broken links, spelling, and stale JSON schemas continuously.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Docs-as-Code",
                      "text": "Storing technical documentation in plain-text Markdown/markup inside Git repositories and enforcing review, linting, and CI verification alongside code changes.",
                      "type": "definition"
                    },
                    {
                      "body": "PR adds `--dry-run` flag to CLI -> PR checklist blocks merge until `docs/cli-reference.md` and usage test snippet include `--dry-run`.",
                      "type": "example",
                      "title": "Same-PR Docs Gate"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Store source Markdown in Git alongside application modules.",
                        "Add link-checkers and schema validators inside automated CI checks.",
                        "Block major public API releases until matching quickstarts and changelogs pass peer review."
                      ],
                      "title": "Applying Docs-as-Code Workflow & Single Sourcing"
                    },
                    {
                      "text": "Quarterly docs rewrites left new releases undocumented for 90 days while support answered identical config questions manually.",
                      "type": "case_study",
                      "title": "Six-Month Docs Drift",
                      "takeaway": "Moving docs into shared PR definitions-of-done kept releases synchronized permanently."
                    },
                    {
                      "text": "Developers verify factual accuracy cleanly; writers polish scannability and prerequisite gaps quickly.",
                      "type": "callout",
                      "title": "Pair Engineers & Writers on PRs",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
