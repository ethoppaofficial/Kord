            {
              "id": "2cee3435-3fd3-cfad-f2ab-e3cb32b3839f",
              "title": "Module 2: Character Desire, Flaw & Pressure",
              "lessons": [
                {
                  "id": "d41e3746-aadb-b71e-dc07-4b85024ada8b",
                  "title": "Active Want vs. Underlying Need",
                  "blocks": [
                    {
                      "text": "Goal-Driven Characterization",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Every strong scene works better when your character walks in wanting something specific—recovering a lost letter, winning a lease, hiding a lie—while an internal flaw threatens to sabotage them. When external urgency collides with inner vulnerability, plot grows organically from personality.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Active Protagonist",
                      "text": "A character making deliberate, risky choices in pursuit of a clear objective rather than wandering passively through events.",
                      "type": "definition"
                    },
                    {
                      "body": "External Want: Win the neighborhood bakery lease before Friday. Internal Flaw: Refusal to ask partners for help due to past betrayal.",
                      "type": "example",
                      "title": "Want Meets Flaw"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Give your character a concrete tangible objective in every scene.",
                        "Identify what habit or blind spot complicates getting it.",
                        "Escalate pressure until their old habit fails them."
                      ],
                      "title": "Applying Active Want vs. Underlying Need"
                    },
                    {
                      "text": "A sci-fi protagonist watched mentors debate and solve every crisis while merely taking notes.",
                      "type": "case_study",
                      "title": "Observer Protagonist Draft",
                      "takeaway": "Giving her an unauthorized shortcut she had to defend under pressure brought the whole draft alive."
                    },
                    {
                      "text": "Ask why this character must act NOW rather than putting off the choice another month.",
                      "type": "callout",
                      "title": "Test Motivation With \"Why Today?\"",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What transforms a passive protagonist into a compelling narrative driver?",
                      "options": [
                        "Longer physical appearance descriptions",
                        "A concrete urgent goal colliding with an obstacle or internal flaw",
                        "Removing antagonists entirely"
                      ],
                      "explanation": "Desire meeting resistance creates natural dramatic momentum.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Purposeful character desire turns scenes from episodes into true story movement.",
                  "position": 1,
                  "resources": [
