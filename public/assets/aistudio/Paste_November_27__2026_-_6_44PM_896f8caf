                {
                  "id": "852553d3-e67f-fa0a-f82d-30453a5a4b4f",
                  "title": "Regression Discipline & Post-Fix Verification",
                  "blocks": [
                    {
                      "text": "Locking Every Production Fix With a Test",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Adopt the golden regression rule: whenever a bug reaches QA or production, write a failing automated test reproducing that exact defect first, verify the failure, apply the minimal clean fix, watch the test turn green, and document verification honestly without guessing.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Regression Lock",
                      "text": "A permanent automated test created specifically for a discovered defect to guarantee the fix endures across future edits.",
                      "type": "definition"
                    },
                    {
                      "body": "Never claim live production behavior works unless actually tested against that environment; state clearly what local/DB/contract checks passed.",
                      "type": "example",
                      "title": "Honest Verification Standard"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Write failing test before fixing complex bugs.",
                        "Verify adjacent features weren’t broken by the patch.",
                        "Report exact test counts and verified commands clearly."
                      ],
                      "title": "Applying Regression Discipline & Post-Fix Verification"
                    },
                    {
                      "text": "Adding a contract test asserting explicit FK hints after fixing PGRST201 guarantees future refactors can’t strip the constraint name silently.",
                      "type": "case_study",
                      "title": "Protected Relationship Disambiguation",
                      "takeaway": "Every outage makes the test suite permanently stronger."
                    },
                    {
                      "text": "Run the exact test and build commands after your final edit—even a one-line tweak can introduce a typo.",
                      "type": "callout",
                      "title": "Verify, Never Assume",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What is the golden rule right after diagnosing a production bug?",
                      "options": [
                        "Patch quickly and skip tests",
                        "Add a deterministic regression test that reproduces the defect and proves the fix holds",
                        "Delete the feature"
                      ],
                      "explanation": "Regression tests convert past bugs into permanent automated guardrails.",
                      "correctIndex": 1
