                {
                  "id": "30380c59-a418-5b57-7d09-a3560e675f15",
                  "title": "Cutting Redundancy, Tautologies & Clutter",
                  "blocks": [
                    {
                      "text": "Surgical Line Compression",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Experienced line editors notice silent word doubling everywhere: `past history` (all history is past), `end result` (results sit at the end), `free gift`, `collaborate together`, `reason why... is because`. Cutting subtle pleonasms and bloated prepositional strings (`the implementation of -> implementing`) wakes sluggish prose right up without losing a single detail.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Pleonasm / Tautology",
                      "text": "Unintentional word-meaning repetition using multiple words stating the exact same concept (\"advance planning\", \"true fact\", \"repeat again\").",
                      "type": "definition"
                    },
                    {
                      "body": "Before: \"We are currently in the process of planning ahead to merge both duplicate copies together.\" After: \"We are planning to merge the duplicates.\"",
                      "type": "example",
                      "title": "Tautology Snipping"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Spot hidden semantic twins (`basic fundamentals`, `new innovation`, `personal opinion`).",
                        "Replace empty \"There are many people who...\" openers with direct active subjects (\"Many users...\").",
                        "Keep genuine intentional rhetorical emphasis intact when purposeful (\"plain and simple\")."
                      ],
                      "title": "Applying Cutting Redundancy, Tautologies & Clutter"
                    },
                    {
                      "text": "A legal-sounding compliance memo dropped smoothly from 1,400 words to 820 words purely by pruning tautologies and \"the fact that\" fillers—with zero lost rules.",
                      "type": "case_study",
                      "title": "Tightened Policy Manual",
                      "takeaway": "Employee comprehension quiz scores rose 28% immediately."
                    },
                    {
                      "text": "Delete an adjective mentally—if the noun still carries 100% of the exact meaning (`unexpected surprise`), kill the redundant modifier permanently.",
                      "type": "callout",
                      "title": "Test Every Modifier Silently",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Which line removes classic pleonasm/tautology bloat most cleanly?",
                      "options": [
                        "At this current point in time, we are collaborating together on future plans.",
                        "We are currently collaborating on plans.",
                        "We are making future plans together right now at present."
                      ],
                      "explanation": "Dropping repetitive twins (`currently + at this point`, `collaborating + together`) halves words effortlessly.",
                      "correctIndex": 1
                    }
