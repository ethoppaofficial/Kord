            {
              "id": "23ca344d-0fc7-8ee1-2c9d-4131cdf47d98",
              "title": "Module 5: Competitor Dissection & Win/Loss Analysis",
              "lessons": [
                {
                  "id": "deca9be6-0537-ab32-3f7a-67f46e3b4dbc",
                  "title": "Objective Competitor Positioning Without Copycatting",
                  "blocks": [
                    {
                      "text": "Finding Unserved Space & Weakness Gaps",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Audit top 3–4 alternatives buyers currently consider—including `\"Doing Nothing / Excel\"`: document Target Audience, Entry Price Friction (`high upfront setup, locked annual terms`), Honest Core Strength (give credit fairly!), and **Consistent Complaint Pattern** across public 2-to-4-star reviews. Real strategic positioning occupies the clear white space competitors structurally ignore because their existing business model resists serving it!",
                      "type": "paragraph"
                    },
                    {
                      "term": "Structural Competitor Constraint",
                      "text": "An underlying pricing, legacy architecture, or enterprise-sales conflict preventing an incumbent competitor from easily copying your clean simple niche value without hurting their own existing margins.",
                      "type": "definition"
                    },
                    {
                      "body": "Giant Agency X relies strictly on $5,000/mo 12-month retainers to pay expensive downtown overhead -> They structurally CANNOT profitably offer crisp $399 modular self-serve audit workshops without cannibalizing retainers!",
                      "type": "example",
                      "title": "Spotting Structural Blind Spots"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Never cheat yourself by scoring competitors `\"zero\"` across every chart column—acknowledge honestly where they win!",
                        "Harvest public review gaps to pinpoint real underserved workflows cleanly.",
                        "Focus strictly on structural white space competitors avoid purposefully rather than tiny cosmetic button tweaks."
                      ],
                      "title": "Applying Objective Competitor Positioning Without Copycatting"
                    },
                    {
                      "text": "Launched a near-identical copy of an established calendar link tool 10% cheaper—and got ignored completely because nobody risks switching tools for $1/mo.",
                      "type": "case_study",
                      "title": "Me-Too Feature Clone",
                      "takeaway": "Targeting strictly complex multi-coach group clinic scheduling carved effortless traction away from generic incumbents!"
                    },
                    {
                      "text": "Pick value choices that match YOUR nimble model cleanly while contradicting incumbent overhead!",
                      "type": "callout",
                      "title": "Compete Where Incumbents Can’t Follow Easily",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why study an incumbent’s 2-star and 3-star public reviews rather than solely reading 1-star rants?",
                      "options": [
                        "1-star reviewers are invisible",
                        "2–3 star reviews come from serious genuine buyers who liked core goals yet pinpoint exact recurring missing workflow flaws",
                        "3-star reviews contain links"
                      ],
                      "explanation": "Measured mid-rating feedback isolates real product gaps from random shipping accidents.",
                      "correctIndex": 1
                    }
