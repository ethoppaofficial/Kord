                  "id": "94d1a652-3069-3d8a-0316-89af05df0ba3",
                  "title": "Tight Paid & Organic Social Copy",
                  "blocks": [
                    {
                      "text": "Scroll-Stopper Lead Lines",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Paid and organic feed copy works inverted-pyramid style: put the sharpest pattern-interrupt observation, surprising cost, or tangible benefit directly inside line one so mobile screens show full value above the fold-truncation cut.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Above-the-Fold Truncation",
                      "text": "The character limit (~110–125 chars on mobile feeds) where platforms fold long captions behind a \"See more\" link.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Losing 3 hours weekly chasing missing client approvals? Here’s the exact 4-line status template 600 studios switched to.\"",
                      "type": "example",
                      "title": "Tight Mobile Ad Lead"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Keep core pain + promised relief cleanly under 120 opening characters.",
                        "Match ad headline promises seamlessly to landing page H1 copy (message match).",
                        "End with one single clean CTA matching platform intent."
                      ],
                      "title": "Applying Tight Paid & Organic Social Copy"
                    },
                    {
                      "text": "An ad promised \"Free Marketing Budget Sheet\", yet the landing page opened with a broad $99/mo SaaS pitch.",
                      "type": "case_study",
                      "title": "Broken Message Match Drop",
                      "takeaway": "Updating the landing headline to match the promised budget sheet cut bounce rates immediately."
                    },
                    {
                      "text": "Ensure the landing page repeats key words and offers promised in the ad clicked 2 seconds prior.",
                      "type": "callout",
                      "title": "Guard Message Match Religiously",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What causes heavy bounce rates immediately after a high-CTR ad click?",
                      "options": [
