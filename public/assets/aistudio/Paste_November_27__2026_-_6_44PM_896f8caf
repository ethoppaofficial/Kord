                  "blocks": [
                    {
                      "text": "Dedicated Prospecting Time Blocks",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Keep top-of-funnel warmth steady through small protected daily/weekly habits (`e.g., 45–60 uninterrupted morning minutes daily` adding fresh qualified targets, sharing helpful insights, or checking smoothly with warm past contacts—even while busy!). Small steady deposits prevent panicked desperate selling cleanly forever!",
                      "type": "paragraph"
                    },
                    {
                      "term": "Feast-or-Famine Cycle",
                      "text": "Stopping new outreach completely whenever busy servicing signed projects (`Feast`), causing abrupt painful empty-calendar cash drops (`Famine`) right as those deals complete weeks later.",
                      "type": "definition"
                    },
                    {
                      "body": "8:30–9:15 AM Monday–Thursday: Strictly 5 deeply researched warm messages, 3 helpful value follow-ups, 1 past client check-in—never skipped even during busy launch weeks!",
                      "type": "example",
                      "title": "Steady 45-Min Morning Engine"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Protect morning prospecting ahead of reactive messy inbox emergencies.",
                        "Separate clean research/list-building (`batch Friday afternoon`) cleanly from live sending/calling hours.",
                        "Track consistent weekly leading habits (`meaningful outreach dialogues started`) calmly rather than obsessing solely over unpredictable single-day closes!"
                      ],
                      "title": "Applying Ending Feast-or-Famine Prospecting Rollercoasters"
                    },
                    {
                      "text": "Two busy agency quarters left zero outreach hours; the exact afternoon two major contracts concluded naturally, pipeline stood cleanly at `$0` triggering two grim panicked months!",
