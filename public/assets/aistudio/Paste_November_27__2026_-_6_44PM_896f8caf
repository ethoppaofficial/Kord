                },
                {
                  "id": "f36e1c34-7eae-cd71-7aef-a1c2eb0a5d23",
                  "title": "Feasibility & Recommendation Reports",
                  "blocks": [
                    {
                      "text": "Weighted Criteria & Decision Transparency",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Feasibility studies succeed when evaluation criteria (`Setup Cost`, `Time to Launch`, `Maintenance Load`, `Data Security`) are agreed upfront, scored consistently across all candidates using transparent units, and weighed transparently before declaring a winner.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Weighted Decision Matrix",
                      "text": "Scoring competing options quantitatively across pre-agreed weighted criteria so personal preference stays accountable to transparent trade-offs.",
                      "type": "definition"
                    },
                    {
                      "body": "Compare Option A (In-House), Option B (Managed Vendor), Option C (Status Quo) across Cost (30%), Speed (30%), Security (20%), Flexibility (20%).",
                      "type": "example",
                      "title": "Clean Feasibility Structure"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Define evaluation criteria cleanly BEFORE scoring candidates to curb confirmation bias.",
                        "Evaluate doing nothing (Status Quo) honestly alongside active changes.",
                        "Note concrete transition risks even for the winning pick."
                      ],
                      "title": "Applying Feasibility & Recommendation Reports"
                    },
                    {
                      "text": "A team picked a shiny vendor early and invented skewed score weights afterward solely to win.",
                      "type": "case_study",
                      "title": "Retrofitted Justification",
                      "takeaway": "Independent reviewers spotted the biased weighting immediately and halted procurement."
                    },
                    {
                      "text": "Admitting the top pick requires two weeks of data cleanup makes your recommendation dramatically more credible.",
                      "type": "callout",
                      "title": "Acknowledge Winning Risks",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why lock evaluation criteria and weights ahead of scoring vendor alternatives?",
                      "options": [
                        "Saves calculator batteries",
                        "Reduces bias toward a favored pick and keeps comparison transparently objective",
                        "Replaces contracts"
                      ],
                      "explanation": "Pre-committed weights anchor decisions in shared strategic priorities rather than gut partiality.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Transparent criteria turn high-stakes recommendations into consensus decisions.",
                  "position": 2,
                  "resources": [
                    {
                      "id": "c2a0985c-403e-4c07-aba5-338d771f9325",
                      "url": "https://owl.purdue.edu/",
                      "title": "Purdue OWL Academic & Research Guides",
