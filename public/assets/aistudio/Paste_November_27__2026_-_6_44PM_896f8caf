                {
                  "id": "0ecc9123-4d66-b092-7f42-28d54ef3a298",
                  "title": "I-Statements & Non-Blaming Language",
                  "blocks": [
                    {
                      "text": "Shifting From Blame to Shared Impact",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Replacing \"You never...\" with \"When testing builds arrive after 4 PM Thursday, my QA team misses regression coverage before Friday noon\" removes personal character judgment and turns conversation directly onto schedule mechanics both teams can adjust.",
                      "type": "paragraph"
                    },
                    {
                      "term": "\"When X, Impact Y\" Formula",
                      "text": "Stating specific observable event plus concrete workflow consequence minus personal intent guessing.",
                      "type": "definition"
                    },
                    {
                      "body": "Swap \"You hog meeting airtime!\" for \"When agendas run tight, I notice frontend risks go unraised unless we reserve 5 minutes at minute 20.\"",
                      "type": "example",
                      "title": "Clean Re-Framing Practice"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Replace \"You always/never\" with single specific timestamps.",
                        "Describe downstream work impact plainly.",
                        "Invite collaborative ideas immediately afterward."
                      ],
                      "title": "Applying I-Statements & Non-Blaming Language"
                    },
                    {
                      "text": "Switching sprint retros to \"When X happened, impact Y followed\" eliminated defensive shouting completely.",
                      "type": "case_study",
                      "title": "De-Fanged Retro",
                      "takeaway": "Precision wording takes personal sting out of real pain points."
                    },
                    {
                      "text": "Describe only what a neutral camera would record—no guessing secret motives.",
                      "type": "callout",
                      "title": "Stick to Camera Facts",
                      "variant": "tip"
                    },
