              "lessons": [
                {
                  "id": "a421c614-d067-8f8a-275d-4ab85bb1b4a3",
                  "title": "The 30-Minute Weekly Relationship Habit",
                  "blocks": [
                    {
                      "text": "Light Sustainable Rhythm",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Protect just thirty calm minutes every Friday morning: spend ten minutes messaging 2 dormant acquaintances genuinely, ten minutes writing 1 short thank-you or closed-advice-loop note, and ten minutes sharing one thoughtful link or double-opt-in check. Fifty consistent 30-minute Fridays build a lifelong safety net effortlessly without burnout.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Compound Consistency",
                      "text": "Small steady 30-minute weekly touchpoints across stable employment years outperforming frantic networking bursts during sudden layoffs.",
                      "type": "definition"
                    },
                    {
                      "body": "9:00 AM: send 2 warm birthday/article notes -> 9:15 AM: check 1 active mentor follow-up -> 9:25 AM: update 2 tracker lines.",
                      "type": "example",
                      "title": "Balanced Friday Routine"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Tie habit cleanly to existing Friday calendar block.",
                        "Keep weekly reach targets humanly light (2–3 meaningful pings).",
                        "Protect introverted recharge energy equally."
                      ],
                      "title": "Applying The 30-Minute Weekly Relationship Habit"
                    },
                    {
                      "text": "Professionals sustaining quiet 30-minute Friday relationship habits consistently landed next roles through trusted personal introductions inside weeks rather than endless blind portals.",
                      "type": "case_study",
                      "title": "Recession-Proof Career Cushion",
                      "takeaway": "Steady care compounds quietly across careers."
