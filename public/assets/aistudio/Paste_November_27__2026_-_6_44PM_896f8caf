                {
                  "id": "d652f10d-ab80-ec30-9925-9b2e2dd380b3",
                  "title": "Annotating Charts With Clear Takeaways",
                  "blocks": [
                    {
                      "text": "Callouts Over Raw Exports",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Add one light subtle highlight box or concise annotation arrow directly onto the critical spike (\"May pricing simplification lifted trials +28%\") while graying quiet background noise. Annotations bridge raw numbers to commercial decision effortlessly.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Chart Annotation",
                      "text": "Short contextual text label placed cleanly beside a key inflection point explaining its business driver on the visual itself.",
                      "type": "definition"
                    },
                    {
                      "body": "Highlight Q3 week-4 jump in teal with brief note: \"Self-serve setup live -> +31% completion\".",
                      "type": "example",
                      "title": "Spotlight Callout Line"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Ask: What single 1-second takeaway sits inside this chart?",
                        "Write it inside the Action Title AND mark the exact inflection point visually.",
                        "Keep background helper lines light gray."
                      ],
                      "title": "Applying Annotating Charts With Clear Takeaways"
                    },
                    {
                      "text": "Adding one concise inflection-point caption stopped side debates over noisy early months and directed discussion straight to Q4 scaling.",
                      "type": "case_study",
                      "title": "Faster Executive Alignment",
                      "takeaway": "Visual spotlighting saves collective attention cleanly."
                    },
                    {
                      "text": "Mute non-focus bars to light neutral gray so highlighted focal data sings clearly.",
                      "type": "callout",
                      "title": "Dim Everything Except the Signal",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What does placing a concise annotation directly beside a sudden line-chart jump achieve?",
