            {
              "id": "61397307-5081-5dd3-816c-7c60cd61fe05",
              "title": "Module 4: Planning, Outlining & Drafting Workflows",
              "lessons": [
                {
                  "id": "1329d54f-a00d-1300-47e0-16285826c8f8",
                  "title": "Structuring Before Writing",
                  "blocks": [
                    {
                      "text": "Claim-Based Outlines",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Instead of vague outline labels like \"Introduction\" or \"Analysis\", write each section header as a short claim answering what that section must prove. Knowing the exact job of every block prevents wandering tangents and dramatically speeds drafting.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Claim-Driven Outline",
                      "text": "An outline whose headings state concrete arguments or takeaways rather than generic topic labels.",
                      "type": "definition"
                    },
                    {
                      "body": "Weak: \"1. Costs 2. Features\". Strong: \"1. Setup costs drop 40% via automation. 2. Three reporting features replace manual spreadsheets.\"",
                      "type": "example",
                      "title": "Strong vs. Weak Outline"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "State your core message in one plain sentence.",
                        "List 3–4 supporting pillars needed to convince a skeptical reader.",
                        "Slot concrete examples or data points beneath each pillar before writing prose."
                      ],
                      "title": "Applying Structuring Before Writing"
                    },
                    {
                      "text": "Two co-authors rewrote page one five times because they disagreed on what pages three and four argued.",
                      "type": "case_study",
                      "title": "Stalled Quarterly Whitepaper",
                      "takeaway": "Agreeing on a 6-bullet claim outline finished the draft in two afternoons."
                    },
                    {
                      "text": "Outline in plain bullet fragments first; polish phrasing only after the logical sequence holds up.",
                      "type": "callout",
                      "title": "Keep Thinking Fast",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why is a claim-driven outline superior to generic topic labels?",
                      "options": [
                        "It forces each section to have an explicit purpose before writing prose",
                        "It increases overall word count automatically",
                        "It removes the need for editing"
                      ],
                      "explanation": "Knowing what each section must establish keeps drafts tight and logical.",
                      "correctIndex": 0
                    }
                  ],
                  "videos": [],
                  "summary": "Clear upfront structure eliminates structural rewrites later.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "72544fe0-3cc8-4dfe-a16f-4113363ff7e3",
                      "url": "https://owl.purdue.edu/",
