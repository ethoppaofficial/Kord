                {
                  "id": "6d9a3308-0ca6-4fa9-4a2a-3fca739bbdbe",
                  "title": "Stated Intent vs. Revealed Market Behavior",
                  "blocks": [
                    {
                      "text": "Triangulating Behavioral Evidence",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Wise researchers distrust unverified self-predictions (`\"Yes, I’d definitely pay $40!\"`). Always triangulate **What People Say** cleanly against **What People Actually Do**—organic search trends, review complaint volumes, existing competitor pricing tiers, forum hacking threads, and click-through pricing smoke tests—building grounded multi-source conviction.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Methodological Triangulation",
                      "text": "Verifying a market insight across at least two or three independent lenses (e.g., Live Interviews + Existing Review Complaint Clusters + Real Click/Pre-Order Tests) rather than trusting one self-report poll.",
                      "type": "definition"
                    },
                    {
                      "body": "Instead of asking \"Would you pay $50?\", observe active competitor review scores on $49 plans + inspect freelance rates spent hiring human assistants today + run transparent real tier landing checks.",
                      "type": "example",
                      "title": "Triangulating Price Tolerance"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Inspect existing public 2-star and 3-star competitor customer reviews (`G2, Amazon, Reddit, App Stores`)—pure unfiltered behavioral gold!",
                        "Weigh behavioral spend signals 3x heavier than polite survey intentions.",
                        "Document explicitly where different data sources disagree cleanly inside executive briefings."
                      ],
                      "title": "Applying Stated Intent vs. Revealed Market Behavior"
                    },
                    {
                      "text": "88% of respondents ticked \"Strongly agree I’d pay extra for compostable packaging\"—at checkout only 9% paid the +$1.50 option.",
                      "type": "case_study",
                      "title": "Green-Survey Bust",
                      "takeaway": "Revealed behavior tests protect inventory budgets reliably cleanly!"
                    },
                    {
                      "text": "Hundreds of candid customer reviews already sit public across competitor listings—harvest real friction free before cold calling!",
                      "type": "callout",
                      "title": "Mine Public 3-Star Complaints",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What provides the strongest safeguard against \"polite survey optimism\" during demand validation?",
                      "options": [
                        "Asking questions twice in bold font",
                        "Triangulating verbal self-reports with real revealed spend/search behaviors and public competitor complaint patterns",
                        "Making surveys mandatory"
