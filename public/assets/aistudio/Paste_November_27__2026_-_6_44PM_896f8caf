            {
              "id": "5305a08f-7cc3-b754-0303-dc73a83463fc",
              "title": "Module 3: Influence Without Formal Authority",
              "lessons": [
                {
                  "id": "607c234e-b63f-7844-a114-840b0e42764f",
                  "title": "Pre-Wiring Decisions Before Big Meetings",
                  "blocks": [
                    {
                      "text": "Pre-Meeting Listening & Co-Creation",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "High-stakes group meetings trigger performance ego: people defend public objections to avoid looking wrong in front of peers. Sharing your draft one-on-one with key skeptics 3–5 days early lets them critique safely, shape wording, and feel partial ownership—turning room reviews into calm ratification instead of surprise firefights.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Pre-Wiring",
                      "text": "Sharing draft proposals individually with critical stakeholders prior to group meetings to gather candid feedback and integrate fixes early.",
                      "type": "definition"
                    },
                    {
                      "body": "\"I'm pitching this QA checklist Thursday—since it touches Support escalations, could you tear holes in lines 4–8 before I finalize?\"",
                      "type": "example",
                      "title": "Safe Early Outreach"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Meet toughest respectful skeptics earliest.",
                        "Integrate at least one smart adjustment they propose and credit them explicitly.",
                        "Go into the big meeting knowing exactly where votes sit."
                      ],
                      "title": "Applying Pre-Wiring Decisions Before Big Meetings"
                    },
                    {
                      "text": "An analytics manager pre-wired three skeptical leads over coffee chats; when Friday budget review arrived, all three co-endorsed the refined deck.",
                      "type": "case_study",
                      "title": "Zero-Surprise Budget Sign-Off",
                      "takeaway": "Quiet 1:1 listening wins public rooms beforehand."
                    },
                    {
                      "text": "Saying \"Thanks to Omar for shaping the rollout check in section 2\" earns instant allies in the main room.",
                      "type": "callout",
                      "title": "Credit Co-Creators Openly",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why should key skeptics see your draft 1:1 before a major group review?",
                      "options": [
                        "To intimidate them privately",
                        "So they voice legitimate concerns without public pride pressure and co-own improved solutions",
                        "To bypass official process"
                      ],
                      "explanation": "Private co-creation removes group performative defensiveness.",
