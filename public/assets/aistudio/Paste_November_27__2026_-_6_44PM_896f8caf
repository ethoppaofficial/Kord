                {
                  "id": "7422e1ca-cbb5-9eed-bf8e-08bcfee6b877",
                  "title": "The Five-Line Respectful Outreach Formula",
                  "blocks": [
                    {
                      "text": "Brief, Specific, Easy-to-Say-Yes",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Respect busy calendars ruthlessly: (1) Why THEM specifically (genuine detail, never vague flattery), (2) Quick 1-line credibility/context, (3) One crisp specific 15-minute question (\"curious how your team transitioned from agencies to in-house UX\"), (4) Low-pressure graceful out (\"Even two quick bullet thoughts via reply—or 15 mins next month if calm—would help hugely\"). Brief clarity shows immediate maturity.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Low-Friction Ask",
                      "text": "Making it comfortable for a busy recipient to reply effortlessly in 2 minutes via text OR offer a crisp 15-minute slot with zero guilt if slammed.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Hi Nina—loved your writeup on accessible SVG charts at TechConf. I'm an analyst moving toward UX data viz. Could I ask one quick question on how you validate colorblind palettes on dashboards? Happy for two written lines here—zero pressure on calls!\"",
                      "type": "example",
                      "title": "Sharp 75-Word Cold Note"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Keep cold notes comfortably under 100 words.",
                        "Reference one real specific detail showing honest homework.",
                        "Give an easy graceful async text alternative cleanly."
                      ],
                      "title": "Applying The Five-Line Respectful Outreach Formula"
                    },
                    {
                      "text": "Trimming wandering 300-word outreach letters down to 75-word low-friction questions boosted practitioner replies drastically across twenty outreaches.",
                      "type": "case_study",
                      "title": "45% Cold Reply Rate Upgrade",
                      "takeaway": "Brevity and specificity signal deep respect for time."
                    },
                    {
                      "text": "Vague \"pick your brain for 45 mins\" asks sound draining; narrow specific questions sound effortless and flattering.",
                      "type": "callout",
                      "title": "Ban \"Pick Your Brain\"",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why give busy cold outreach recipients a \"two quick written bullets here\" option alongside a 15-minute chat?",
