                {
                  "id": "00756f8d-d14d-1a08-a775-43d0cfcb465d",
                  "title": "Cascade, Specificity, and CSS Custom Properties",
                  "blocks": [
                    {
                      "id": "fe31-1",
                      "text": "Browser styles apply according to Origin, Specificity, and Source Order. Keep selectors flat—prefer single classes like .card-title over deeply nested chains like #main div ul li a so any modifier class can override cleanly.",
                      "type": "paragraph"
                    },
                    {
                      "id": "fe31-2",
                      "code": ":root {\n  --bg-page: #f8fafc;\n  --bg-surface: #ffffff;\n  --text-main: #0f172a;\n  --text-muted: #475569;\n  --brand-primary: #1d4ed8;\n  --radius-card: 12px;\n}\n\n.btn-primary {\n  background: var(--brand-primary);\n  color: #ffffff;\n  padding: 10px 18px;\n  border-radius: 8px;\n}",
                      "type": "code",
                      "title": "Clean :root Design Tokens",
                      "language": "css"
                    },
                    {
                      "id": "fe31-3",
                      "type": "knowledge_check",
                      "prompt": "Which selector has the highest specificity?",
                      "options": [
