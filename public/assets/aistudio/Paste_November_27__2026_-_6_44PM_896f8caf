                      "title": "Capture Quotes Right Away",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why tag stories inside a Story Bank by strategic lesson rather than date alone?",
                      "options": [
                        "Dates are harder to read",
                        "When prepping for talks or interviews, you search by theme needed—not calendar month",
                        "It reduces memory size"
                      ],
                      "explanation": "Thematic tags (`Conflict`, `Ownership`, `Customer Empathy`) retrieve matching stories instantly.",
