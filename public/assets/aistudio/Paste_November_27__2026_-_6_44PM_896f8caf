          "phases": [
            {
              "id": "3b3b09c6-24e3-5fee-191f-093fea8c75ca",
              "title": "Module 1: Living Operating Plans Over Dusty 50-Page Binders",
              "lessons": [
                {
                  "id": "fbfe6d97-6fc7-fa60-0567-5281927ed734",
                  "title": "Why Traditional 50-Page Plans Collect Dust",
                  "blocks": [
                    {
                      "text": "Decision-Useful Living Plans",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "A real business plan exists for one job only: **guiding clear weekly and quarterly resource decisions**. Unless applying to a formal bank loan specifically requiring standard appendices, keep living plans concise (`2–5 pages` or `1-page scorecard + clean assumptions tabs`), spotlighting actual operational bottlenecks, clear customer demand mechanics, capacity limits, and measurable 90-day milestones updated monthly.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Living Operating Plan",
                      "text": "A crisp modular business roadmap pairing stable annual strategic choices with realistic 90-day action milestones, rolling cash budgets, and monthly review cadences.",
                      "type": "definition"
                    },
                    {
                      "body": "Cut 12 pages of generic macroeconomic clichés (\"Global coffee consumption is steady...\") cleanly down to 1 tight table proving local foot-traffic capacity and morning prep throughput!",
                      "type": "example",
                      "title": "Focused Core vs. Bloat"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Cut generic industry trivia everyone already knows cleanly out of planning docs.",
                        "Anchor plans firmly onto operational mechanics: HOW leads enter, WHO fulfills work, WHEN cash clears, and WHAT breaks first at 2x volume.",
                        "Review and revise quarterly forecasts deliberately every 30–90 days against actual results."
                      ],
                      "title": "Applying Why Traditional 50-Page Plans Collect Dust"
                    },
                    {
                      "text": "A founder spent three months formatting ornate Year-4 hockey-stick revenue bars (`$18M`) while completely overlooking local kitchen capacity capping Month-2 output at 150 orders!",
                      "type": "case_study",
                      "title": "5-Year Fantasy Binder",
                      "takeaway": "Operational driver modeling catches physical bottlenecks Day 1 cleanly."
                    },
                    {
                      "text": "Ask: \"To reach $20k/mo safely, literally how many client hours, oven slots, or support calls does that demand?\"",
                      "type": "callout",
                      "title": "Plan From Capacity & Drivers Backward",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What makes a concise living operating plan far more valuable to a running business than a rigid 50-page forecast?",
                      "options": [
                        "Includes shinier fonts",
                        "Grounds decisions in real capacity drivers and adapts every quarter against observed reality rather than aging untouched on a shelf",
                        "Skips budgeting completely"
                      ],
                      "explanation": "Plans drive day-to-day clarity only when linked directly to capacity realities and regularly refreshed.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Lean driver-led planning converts big ambition into clear accountable operating cadence.",
                  "position": 1,
                  "resources": [
