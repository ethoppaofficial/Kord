                {
                  "id": "123dc5f7-7dd5-517d-9997-0ce23fc4c311",
                  "title": "High-Leverage UX Microcopy & CTAs",
                  "blocks": [
                    {
                      "text": "Action-Value Buttons & Friction Checkers",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Microcopy—button labels, error helper lines, field prompts, and confirmation subtext—sits directly on conversion choke points. Changing \"Submit\" to \"Get My Free 5-Step Checklist\" reminds the user what reward follows the click, while reassuring helper lines prevent abandonment over privacy worries.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Button Microcopy",
                      "text": "Concise action-oriented CTA phrasing finishing the unspoken sentence \"I want to...\" rather than using robotic database verbs like \"Submit\".",
                      "type": "definition"
                    },
                    {
                      "body": "Replace \"Submit\" -> \"Send Proposal Request\"; replace \"Sign Up\" -> \"Start 14-Day Free Trial (No Card)\"; add micro-reassurance \"Zero spam—unsubscribe anytime.\"",
                      "type": "example",
                      "title": "Upgrading Generic CTAs"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Complete the mental sentence \"I want to ____\" to name buttons cleanly.",
                        "Explain WHY sensitive fields (phone/role) are asked—or remove unnecessary fields altogether.",
                        "Keep tone friendly and helpful inside error notifications too."
                      ],
                      "title": "Applying High-Leverage UX Microcopy & CTAs"
                    },
                    {
                      "text": "Requiring an unexplained \"Work Phone Number\" killed 45% of form completions.",
                      "type": "case_study",
                      "title": "Abandoned Demo Form",
                      "takeaway": "Making phone optional and changing the CTA to \"Pick My Demo Time\" nearly doubled submissions overnight."
                    },
                    {
                      "text": "Testing \"Build My Portfolio\" vs. \"Build Your Portfolio\" routinely sparks clear lifts by making ownership personal.",
                      "type": "callout",
                      "title": "First Person Often Tests Well",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why does changing a form CTA from \"Submit\" to \"Download My Cost Guide\" boost completions?",
                      "options": [
                        "It uses bigger margins",
                        "It clarifies exact user reward and lowers ambiguity right at click time",
                        "It shortens databases"
                      ],
                      "explanation": "Value-framed buttons focus attention on the benefit received rather than form work done.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Tiny words right beside clicks eliminate huge invisible conversion leaks.",
                  "position": 2,
                  "resources": [
