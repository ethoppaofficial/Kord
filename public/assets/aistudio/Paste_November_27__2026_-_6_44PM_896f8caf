              "lessons": [
                {
                  "id": "f2e16050-aab9-107d-1062-2533962617f7",
                  "title": "High-Frequency Informal Fallacies",
                  "blocks": [
                    {
                      "text": "False Dilemmas, Strawmen & Ad Hominem",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "False Dilemma forces artificial two-choice extremes (\"Approve rush overtime today or watch company fail!\"), overlooking safe third options. Strawman attacks a cartoonish exaggerated version of a peer's view instead of their strongest real claim. Ad Hominem attacks messenger character rather than factual logic. Spotting names fast restores calm clear analysis.",
                      "type": "paragraph"
                    },
                    {
                      "term": "False Dilemma",
                      "text": "Presenting only two extreme options as possible when practical middle or creative phased alternatives exist.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Either keep manual spreadsheets or buy a £50k ERP\" -> Third path: test £80/mo lightweight workflow integration cleanly first.",
                      "type": "example",
                      "title": "Breaking an Artificial Binary"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Watch for \"only two choices\" ultimatums.",
                        "Ask calmly if a peer recognizes your summary of their view before critiquing.",
                        "Evaluate facts completely independently of speaker popularity."
                      ],
                      "title": "Applying High-Frequency Informal Fallacies"
                    },
                    {
                      "text": "Pointing out that delaying feature B was a third phased choice—beyond binary \"ship chaotic vs cancel project\"—broke a tense stalemate in minutes.",
                      "type": "case_study",
                      "title": "Clean Budget Debate",
                      "takeaway": "Naming hidden options dissolves artificial binaries fast."
                    },
                    {
                      "text": "Rigid absolute quantifiers often telegraph false dilemma or overgeneralization fallacies.",
                      "type": "callout",
                      "title": "Notice \"Always / Never / Either-Or\"",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What characterizes a \"Strawman\" fallacy in workplace debate?",
                      "options": [
                        "Building literal agricultural models",
                        "Distorting or exaggerating an opponent's view into an easily mocked version instead of answering their actual best argument",
                        "Testing small pilot samples"
                      ],
                      "explanation": "Misrepresenting opposing logic blocks genuine truth-seeking cleanly.",
                      "correctIndex": 1
                    }
