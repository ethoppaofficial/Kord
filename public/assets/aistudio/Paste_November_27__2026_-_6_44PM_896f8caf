                  "blocks": [
                    {
                      "text": "Quarterly Evergreen Upgrades",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Top performing blogs revisit flagship guides every 6–12 months: update stale year titles cleanly only after genuinely updating body examples, prune broken external citations, fold fresh reader questions into new H3 FAQ blocks, and merge two overlapping weak posts into one strong definitive master guide.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Content Consolidation",
                      "text": "Merging multiple thin, overlapping posts addressing identical reader questions into one updated authoritative cornerstone page rather than fragmenting depth.",
                      "type": "definition"
                    },
                    {
                      "body": "Combining \"Email Tips 2023\" (350 words) + \"Best Subject Lines\" (400 words) into one updated comprehensive guide tripled search traffic and cut reader bouncing.",
                      "type": "example",
                      "title": "Merging Scattered Posts"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Review top 10 most-read posts twice yearly for accuracy and broken outbound links.",
                        "Never change publication year stamps dishonestly (`2026 Guide`) without performing genuine updates inside.",
                        "Inspect reader comments and email replies for overlooked edge cases to weave straight into FAQ sections."
                      ],
                      "title": "Applying Content Decay & Smart Article Refreshes"
                    },
                    {
                      "text": "A popular software tutorial remained #1 in referrals while showing a 2021 retired menu bar causing weekly negative feedback.",
                      "type": "case_study",
                      "title": "Stale Screenshot Embarrassment",
                      "takeaway": "Spending 40 minutes updating screenshots and two paragraphs revived subscriber signups completely."
                    },
                    {
                      "text": "Only stamp \"Updated 2026\" after revising instructions, links, and examples meaningfully.",
                      "type": "callout",
                      "title": "Earn Every Updated Timestamp",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What is the smartest move when two old thin blog posts target nearly identical questions?",
