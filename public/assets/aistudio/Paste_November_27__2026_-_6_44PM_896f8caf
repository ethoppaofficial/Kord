                  "blocks": [
                    {
                      "text": "Everyday Conflict Mining",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Stakes exist wherever something real—reputation, fairness, time, self-doubt, or client livelihoods—hangs in balance. Naming who stood to lose what if things failed helps audiences care deeply even about operational or technical subjects.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Micro-Stakes",
                      "text": "Specific human, financial, or emotional consequences making even a 15-minute daily challenge feel meaningful to listeners.",
                      "type": "definition"
                    },
                    {
                      "body": "Instead of \"Fixing database timeouts\", frame \"Midnight Friday payroll stalled for 400 hourly contractors unless our team isolated the bottleneck before banks closed.\"",
                      "type": "example",
                      "title": "Elevating Operational Stories"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Ask who hurt or lost sleep when the problem existed.",
                        "Zoom in on ONE specific representative person rather than \"10,000 users\".",
                        "State honestly what error or false assumption you held at first."
                      ],
                      "title": "Applying Finding Stakes Inside Ordinary Work"
                    },
                    {
                      "text": "Listing aggregate shelter budgets drew modest clicks; centering one volunteer story solving a Tuesday midnight supply gap tripled donor replies.",
                      "type": "case_study",
                      "title": "Abstract Nonprofit Appeal",
                      "takeaway": "One grounded individual story unlocks empathy statistics alone cannot reach."
                    },
                    {
                      "text": "Audiences empathize intensely with one concrete named individual far more easily than abstract crowds.",
                      "type": "callout",
                      "title": "One Person Over \"Everyone\"",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why focus an applied story around one specific customer or teammate?",
                      "options": [
