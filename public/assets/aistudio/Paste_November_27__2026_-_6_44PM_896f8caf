              "id": "d9c547e8-cca7-6880-4b44-ec0e8366b4f5",
              "title": "Module 2: Ruthless Prioritization Without Loudest-Voice Politics",
              "lessons": [
                {
                  "id": "342a6360-e381-8363-a2cf-cace0dbf23dd",
                  "title": "RICE Scoring & Defeating False Numeric Precision",
                  "blocks": [
                    {
                      "text": "Using Frameworks as Thinking Tools, Never Robots",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "**RICE** evaluates initiatives across `(Reach x Impact x Confidence) / Effort`—forcing teams cleanly to weigh BOTH upside user reach (`how many real accounts benefit next 90 days?`), honest evidence **Confidence** (`100% proven data vs. 30% wild hunch`), and engineering **Effort**! Crucially, use scores to **spark honest structured debate** rather than pretending arbitrary decimals (`Score 42.7 vs 41.9`) act as sacred infallible math!",
                      "type": "paragraph"
                    },
                    {
                      "term": "RICE Prioritization",
                      "text": "Scoring candidate initiatives systematically across Reach (`users impacted`), Impact (`shift magnitude`), Confidence (`evidence certainty`), divided by Effort (`person-weeks`) to balance value against engineering cost transparently.",
                      "type": "definition"
                    },
                    {
                      "body": "Shiny Idea X looks exciting (`High Reach, High Impact`), YET Confidence sits at `30%` (pure guess!) and Effort = `10 weeks` -> Lower score forces a smart 2-day cheap prototype test FIRST raising Confidence cleanly before burning 10 dev weeks!",
                      "type": "example",
                      "title": "Catching Low-Confidence Bets"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Discount pure unvalidated guesses honestly (`Confidence <= 50%`) to expose risky blind bets cleanly.",
                        "Guard explicitly against `Single-Customer Custom Engineering` traps disguised as broad strategy!",
                        "Publish explicit `\"Not Doing This Quarter (Why)\"` roadmaps so Sales & Support understand trade-offs empathetically without resentment!"
                      ],
                      "title": "Applying RICE Scoring & Defeating False Numeric Precision"
                    },
                    {
                      "text": "Dropping everything mid-quarter to build an executive’s weekend nephew app idea stalled vital core reliability fixes causing 12 real paying accounts to churn.",
                      "type": "case_study",
                      "title": "HiPPO Roadmap Hijack",
                      "takeaway": "Transparent Impact-vs-Effort tradeoff boards invite calm objective sanity cleanly back into meetings!"
                    },
                    {
                      "text": "Never just say \"No\" to a stakeholder request—show the live priority shelf: `\"Shipping Custom Reports (4 wks) shifts Day-1 Onboarding Fix out to August—which trade protects Q3 goals better?\"`",
                      "type": "callout",
                      "title": "Show Costs Transparently in Trades",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "In RICE prioritization, what practical role does the `Confidence %` multiplier serve?",
                      "options": [
                        "Hides lazy deadlines",
                        "Penalizes blind unvalidated guesses fairly, nudging teams to run tiny cheap discovery checks before risking huge multi-week builds",
                        "Eliminates user reach estimates"
                      ],
                      "explanation": "Explicit Confidence weighting rewards verified evidence cleanly over confident unsupported hunches.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Transparent trade-off math replaces noisy office politics with calm objective stewardship.",
                  "position": 1,
