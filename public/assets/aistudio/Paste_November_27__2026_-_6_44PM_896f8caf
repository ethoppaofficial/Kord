                  "blocks": [
                    {
                      "text": "Matching Query Intent to Exact Page Format",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Google rewards pages that satisfy what the searcher genuinely wants to accomplish right now. Mismatching intent (sending informational clicks to sales carts or vice versa) spikes bounce rates in SEO and tanks Quality Score in Google Ads cleanly.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Search Intent",
                      "text": "The underlying goal behind a query—typically Informational (learn), Navigational (reach site), Commercial Investigation (compare options), or Transactional (buy/book now).",
                      "type": "definition"
                    },
                    {
                      "body": "Informational: \"how to clean suede boots\" -> Tutorial guide. Transactional: \"suede boot waterproofing kit buy\" -> Product page cleanly.",
                      "type": "example",
                      "title": "Intent-Matched Page Split"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Check the live Google SERP for any target term to see what formats already win Page 1.",
                        "Group synonyms sharing one identical intent onto one focused page/ad group.",
                        "Assign transactional terms immediately to conversion pages and informational queries to guides."
                      ],
                      "title": "Applying Decoding True Searcher Intent"
                    },
                    {
                      "text": "A plumbing software company ranked #2 for \"copper pipe sizes\" (8,000 clicks/month) with 0.02% trial signups because DIY homeowners weren’t software buyers.",
                      "type": "case_study",
                      "title": "Wasted High-Volume Ranking",
                      "takeaway": "Targeting \"plumbing invoice software demo\" (400 searches/month) drove 3x real trials effortlessly."
                    },
                    {
                      "text": "Before writing a page or ad, inspect the top 5 current Google results—they reveal what format users satisfy best.",
                      "type": "callout",
                      "title": "Let Live SERPs Teach You",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why fail sales checkout pages when targeting broad informational queries like \"how does solar energy work\"?",
                      "options": [
                        "Searchers want educational clarity first; forcing an immediate checkout mismatches intent and spikes bounces",
