            {
              "id": "8a63dd2c-74b8-881f-8e97-2becaa605b22",
              "title": "Module 1: Sentence Architecture & Active Meaning",
              "lessons": [
                {
                  "id": "b96abcb7-c712-f4cf-bb2f-ad6a91380041",
                  "title": "Actors, Actions & Concrete Verbs",
                  "blocks": [
                    {
                      "text": "Strong Subjects & Direct Verbs",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "English readers look early in a sentence for who acts and what action occurs. Turning verbs into heavy nouns—called nominalizations, such as \"conducted an investigation of\"—forces weaker helper verbs like \"made\" or \"conducted\" to carry the sentence. Replacing noun clutter with vivid verbs immediately cuts length and boosts clarity.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Nominalization",
                      "text": "Turning an action verb or adjective into an abstract noun (\"make a decision\" instead of \"decide\"), diluting sentence energy.",
                      "type": "definition"
                    },
                    {
                      "body": "Weak: \"Our team performed an evaluation of three vendors.\" Clear: \"Our team evaluated three vendors.\"",
                      "type": "example",
                      "title": "Cutting Nominalization Clutter"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Circle \"is/was/are/were\" paired with -tion/-ment nouns.",
                        "Identify the real person or system doing the action.",
                        "Place that actor in the subject slot followed immediately by the true verb."
                      ],
                      "title": "Applying Actors, Actions & Concrete Verbs"
                    },
                    {
                      "text": "A student handbook wrote \"Non-compliance with submission windows will trigger assessment penalties.\" Half the cohort misread who enforced what.",
                      "type": "case_study",
                      "title": "Policy Handbook Overload",
                      "takeaway": "Rewriting to \"Submit assignments before Friday 5 PM to avoid a 10% deduction\" dropped clarification tickets by half."
                    },
                    {
                      "text": "Whenever you type \"conduct\", \"perform\", \"facilitate\", or \"utilize\", test if the next noun contains the real verb waiting to be freed.",
                      "type": "callout",
                      "title": "Hunt for Hidden Verbs",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Which revision eliminates nominalization clutter cleanly?",
                      "options": [
                        "The committee made a determination regarding the grant.",
                        "The committee decided the grant outcome on Tuesday.",
                        "A determination was made by the committee on Tuesday."
                      ],
                      "explanation": "Making \"the committee\" the subject and \"decided\" the main verb removes four empty words.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Putting concrete actors beside direct verbs gives prose effortless forward motion.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "0edaf985-4aae-4e7d-89e5-5d57dc163ec8",
                      "url": "https://owl.purdue.edu/",
