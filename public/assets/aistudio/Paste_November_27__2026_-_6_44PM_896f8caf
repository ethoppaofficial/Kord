                {
                  "id": "51ce9fac-0ec6-f363-29de-7626c0768378",
                  "title": "High-Trust Welcome & Nurture Arcs",
                  "blocks": [
                    {
                      "text": "Designing Human-Voice Automated Sequences",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "A warm 4-part Welcome Series strikes while curiosity shines: Email 1 (Instant): deliver promised checklist + set expectations + invite reply (\"Hit reply with your #1 goal\"); Email 2 (+2 days): short relatable customer turnaround story; Email 3 (+4 days): bust 1 costly common misconception; Email 4 (+6 days): natural bridge to core product/call.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Subject + Preview Pairing",
                      "text": "Treating the short email preview snippet right beside the subject line as sentence two of your opening hook rather than wasted \"View in browser\" boilerplate.",
                      "type": "definition"
                    },
                    {
                      "body": "Subject: \"Your 5-min speed checklist (+ 1 quick question)\" | Preview: \"Plus the invisible image mistake slowing 80% of homepages...\"",
                      "type": "example",
                      "title": "Sharp Subject + Preview Hook"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Write emails like helpful notes from one thoughtful person—avoid cramped 6-column brochure bloat.",
                        "Use one single unmistakable primary CTA per email.",
                        "Invite genuine two-way replies in Email 1 to boost engagement signals naturally."
                      ],
                      "title": "Applying High-Trust Welcome & Nurture Arcs"
                    },
                    {
                      "text": "Replacing a flashy automated newsletter banner with a plain-text personal Email #1 asking \"What brought you here today?\" generated 19% direct replies and 6x primary-tab placement.",
                      "type": "case_study",
                      "title": "Two-Way Welcome Magic",
                      "takeaway": "Human warmth stands out effortlessly in automated inboxes."
                    },
                    {
                      "text": "Never ask readers to read 3 blogs, follow 4 social links, AND buy a course inside the same email—focus every send around one clear action.",
