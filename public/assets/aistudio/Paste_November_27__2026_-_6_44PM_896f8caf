                {
                  "id": "8ee01dbe-13fc-a1b3-36a4-c6c050a02d3c",
                  "title": "Blameless Retrospectives That Actually Change Habits",
                  "blocks": [
                    {
                      "text": "Systems-Focused Root Analysis & Two Real Tweaks",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Effective **Blameless Retrospectives** enforce one golden premise (`Prime Directive`): **assume everyone gave solid effort given what they knew then—blame BROKEN SYSTEMS/PROCESSES instead of shaming people!** Surface `What worked well / Where friction stung / Root Cause (\"5 Whys\")` cleanly, then select strictly **1–2 concrete fixable process rules WITH named owners and next-week due dates**—not vague `\"communicate better!\"` platitudes.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Blameless Retrospective",
                      "text": "Post-project reflection assuming good human intent while inspecting structural handoffs, checklists, and tool workflows objectively to prevent repeating identical errors.",
                      "type": "definition"
                    },
                    {
                      "body": "Weak retro output: \"People shouldn’t forget checking mobile!\" Sharp system output: \"Owner Alex adds 1 mandatory Mobile Viewport checkbox cleanly to Card Templates by Friday!\"",
                      "type": "example",
                      "title": "Vague Wish vs. Sharp System Fix"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Collect silent sticky-notes (`async 5 mins first`) before open talk so quiet introverts contribute equally alongside loud speakers!",
                        "Focus ruthlessly on locking strictly **1–2 concrete process fixes** (`5 vague goals = 0 fixes`).",
                        "Celebrate real wins loudly first—team morale fuels honest improvement!"
                      ],
                      "title": "Applying Blameless Retrospectives That Actually Change Habits"
                    },
                    {
                      "text": "A product team sighed `\"We keep underestimating QA testing!\"` cleanly across four consecutive launches—because nobody ever changed the default sprint template to reserve Day 9–10 for QA!",
                      "type": "case_study",
                      "title": "Repeated Same Mistake Trap",
                      "takeaway": "One simple checklist update cured four quarters of recurring stress permanently!"
                    },
                    {
                      "text": "When someone breaks something under confusing setup, fix the confusing setup—never humiliate the person!",
                      "type": "callout",
                      "title": "Inspect Systems, Celebrate Humans",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What transforms a team retrospective from harmless venting into genuine faster calmer future launches?",
                      "options": [
                        "Assigning individual blame penalties",
                        "Diagnosing systemic handoff gaps blamelessly and locking strictly 1–2 concrete workflow/checklist changes with clear owners and dates",
                        "Extending session time past 2 hours"
                      ],
                      "explanation": "Tangible small process updates embedded directly inside templates actually prevent errors from repeating.",
                      "correctIndex": 1
