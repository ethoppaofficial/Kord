                {
                  "id": "881c11b7-9238-d7ce-26be-4ae61fac05ed",
                  "title": "Four Core Partnership Archetypes",
                  "blocks": [
                    {
                      "text": "Referral, Co-Marketing, Integration & Channel Tiers",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Scale partnerships progressively across four natural tiers: **Co-Marketing** (joint webinars, guides, swapped newsletters testing audience overlap safely), **Referral Alliances** (clean warm intros/affiliate links), **Product Integrations** (shared UX workflows reducing friction), and **Channel / Reseller Deals** (full embedded distribution). Always start light (`Tier 1`) to verify partner reliability before legal engineering commits deeply!",
                      "type": "paragraph"
                    },
                    {
                      "term": "Crawl-Walk-Run Partnering",
                      "text": "Testing cultural fit and audience overlap first via fast low-risk Co-Marketing wins before negotiating multi-quarter technical integrations or exclusive reseller contracts.",
                      "type": "definition"
                    },
                    {
                      "body": "Run one shared live workshop + joint checklist campaign in Month 1; once 40+ buyers convert cleanly together, escalate smoothly into native API integration in Quarter 2.",
                      "type": "example",
                      "title": "Testing Fit Before Engineering"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Match partnership tier conservatively to existing relationship trust.",
                        "Define single measurable success criteria clearly per test collaboration.",
                        "Avoid premature \"exclusivity\" clauses early before proving real partner execution!"
                      ],
                      "title": "Applying Four Core Partnership Archetypes"
                    },
                    {
                      "text": "Signed an exclusive territory distribution agreement Day 1 with a prestigious partner who then shipped zero deals all year—paralyzing the whole region legally.",
                      "type": "case_study",
                      "title": "Dead Exclusive Reseller Pact",
                      "takeaway": "Always tie exclusivity strictly to verified minimum quarterly performance milestones—or start non-exclusive!"
                    },
                    {
                      "text": "A pretty joint press release generates zero pipeline unless both teams align active daily workflows behind it.",
                      "type": "callout",
                      "title": "Beware Empty Logo Announcements",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What safeguards small teams from stalled heavyweight technical partnership negotiations early on?",
                      "options": [
                        "Demanding 3-year legal exclusivity immediately",
                        "Testing chemistry and audience overlap first via a lightweight Co-Marketing or Referral pilot before deep dev commitments",
                        "Skipping written scopes"
