                {
                  "id": "d0ae5c5e-69f4-9c5b-8d66-d71120090fa7",
                  "title": "Stewardship of Author Voice (\"Do No Harm\")",
                  "blocks": [
                    {
                      "text": "Minimal-Invasive Precision Edits",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "An editor serves the reader AND the writer—never their own ego. Distinguish genuine clarity/accuracy errors (`Must Fix`) cleanly from personal phrasing taste (`Optional Query`). When smoothing a clunky line, preserve the author’s distinctive vocabulary level, rhythm, and conversational quirks wherever meaning stays crystal-clear.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Editorial Over-Writing",
                      "text": "Substituting a capable author’s unique vivid phrasing with sterile corporate synonyms merely because the editor prefers different personal wording.",
                      "type": "definition"
                    },
                    {
                      "body": "Author wrote: \"Deadlines don’t scare small teams—fuzzy handoffs do.\" Keep punchy contrast intact; don’t overwrite to \"Small teams experience anxiety primarily regarding unclear handoff criteria.\"",
                      "type": "example",
                      "title": "Respectful Light Touch"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Ask \"Does this edit clarify meaning or just change phrasing to sound like me?\"",
                        "Leave respectful explanatory margin comments (`\"Trimmed repetition here—keep casual tone?\"`) instead of silent arbitrary rewrites.",
                        "Preserve deliberate stylistic fragments or rhetorical warmth intentionally used by skilled writers."
                      ],
                      "title": "Applying Stewardship of Author Voice (\"Do No Harm\")"
                    },
                    {
                      "text": "A subject expert declined future guest posts after an editor rewrote lively anecdotes into lifeless passive corporate boilerplate.",
                      "type": "case_study",
                      "title": "Quit Contributor Over-Edit",
                      "takeaway": "Light surgical polish respecting native voice keeps expert voices authentic and keen to contribute."
                    },
                    {
