                {
                  "id": "919cbc7a-a600-c19e-5d31-4fb77f01a879",
                  "title": "Mutual SLAs, Brand Guards & Graceful Exits",
                  "blocks": [
                    {
                      "text": "Response Standards & Reversible Pilots",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Great partnerships set explicit **Service-Level Agreements (`SLAs`)**: `\"Every warm intro receives helpful contact within 24 business hours\"`, clear quarterly cadence syncs, honest logo/brand approval checks before publishing announcements, and straightforward **30-day termination for convenience** clauses so neither party stays trapped in stale deals.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Partner Intro SLA",
                      "text": "A mutual commitment guaranteeing prompt, respectful first contact (`within 24–48 business hours`) whenever either partner entrusts their own client relationship via warm introduction.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Either partner may conclude this pilot smoothly with 30 days written notice while honoring active active-window registrations already submitted cleanly.\"",
                      "type": "example",
                      "title": "Respectful Mutual Exit Clause"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Enforce crisp 24-hour response accountability strictly on shared customer referrals.",
                        "Share a 1-paragraph boilerplate description and pre-approved logo assets cleanly.",
                        "Include an explicit 90-day Sunset / Renewal evaluation checkpoint inside every launch plan."
                      ],
                      "title": "Applying Mutual SLAs, Brand Guards & Graceful Exits"
                    },
                    {
                      "text": "A boutique agency introduced three prized accounts to an integration partner who dropped replies for two weeks, embarrassing the referring agency badly.",
                      "type": "case_study",
                      "title": "Neglected Warm Intro Reputation Hit",
                      "takeaway": "Monitoring referral speed closely protects your own client goodwill above commission income!"
                    },
                    {
                      "text": "Never pass clients to a partner whose speed or service quality you haven’t personally vetted first.",
                      "type": "callout",
                      "title": "Guard Referring Client Trust Above All",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why enforce tight 24–48 hour response SLAs on referred partner leads?",
                      "options": [
                        "CRM requires timestamps",
                        "Slow dropped replies directly damage the referring partner’s cherished credibility with their own loyal clients",
                        "Reduces commission %"
                      ],
                      "explanation": "Protecting the referring partner’s client goodwill preserves long-term intro flow unconditionally.",
                      "correctIndex": 1
                    }
