                {
                  "id": "a8772ba0-dcd4-8904-1407-5d997c2c98a1",
                  "title": "Authentic Reputation Hygiene & Repeat Retention",
                  "blocks": [
                    {
                      "text": "Ethical Review Loops & Retention Systems",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Never bribe, fake, or gate public reviews dishonestly (`\"5 stars gets free gifts\"` hurts trust and violates platform rules!). Instead, invite honest feedback smoothly right after **peak delight moments** (`completed service walkthrough, resolved positive delivery`) via simple 1-tap SMS/email links—and reply graciously to EVERY public review (including handling occasional critical 2-star reviews calmly, briefly, and constructively offline!).",
                      "type": "paragraph"
                    },
                    {
                      "term": "Peak-Delight Review Timing",
                      "text": "Asking respectfully for an honest public review strictly right after delivering a clear completed milestone when genuine relief and warmth sit highest—never randomly months later!",
                      "type": "definition"
                    },
                    {
                      "body": "\"Thanks for sharing this honestly, Jordan—missing Thursday’s follow-up slot fell completely short of our standard. I’ve reached out directly via email to resolve your order cleanly this afternoon.\"",
                      "type": "example",
                      "title": "Constructive Public Reply to Criticism"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Respond thoughtfully within 48 hours to public feedback—future cold shoppers read how calmly owners treat critical reviews!",
                        "Build simple reliable repeat touchpoints (`seasonal maintenance check reminders, birthday/anniversary thank-yous, simple loyalty perks`) rather than chasing strictly cold traffic endlessly.",
                        "Track Customer Retention Rate (`what % buys again within 6–12 months?`) right beside fresh leads!"
                      ],
                      "title": "Applying Authentic Reputation Hygiene & Repeat Retention"
                    },
                    {
                      "text": "An angry owner typed defensive caps-lock accusations blaming a dissatisfied diner publicly on Maps—scaring off hundreds of neutral future visitors scrolling through reviews.",
                      "type": "case_study",
                      "title": "Argumentative Public Owner Reply",
                      "takeaway": "Calm courteous public ownership impresses prospective customers reading quietly far more than perfection!"
                    },
                    {
                      "text": "Prospective clients intentionally filter straight to critical reviews simply to judge how maturely and fairly your business resolves problems!",
                      "type": "callout",
                      "title": "Future Buyers Read Your 3-Star Replies Most",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why respond politely and constructively to harsh critical public reviews instead of arguing or ignoring them?",
                      "options": [
                        "Platform rules hide replies",
                        "Dozens of silent prospective buyers inspect how gracefully and responsibly an owner handles complaints ahead of trusting their money there",
                        "Removes star scores"
