                {
                  "id": "2cd79a87-e4bc-5e70-07e2-328ec1ca386e",
                  "title": "Pre-Mortems: Breaking Your Plan Before Launch",
                  "blocks": [
                    {
                      "text": "Prospective Hindsight Pre-Mortems",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Borrowed from cognitive psychologist Gary Klein: before locking an annual plan, gather key contributors and state cleanly: `\"Imagine it is twelve months from today and this plan failed miserably. Write down silently in 5 minutes every concrete reason why it crashed.\"` Unblocking honest skepticism upfront turns unspoken polite doubts straight into clear preventative fixes before a dollar spends.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Pre-Mortem Exercise",
                      "text": "A structured group planning audit imagining a proposal has already failed one year ahead to surface hidden flaws, silent bottlenecks, and uncomfortable truths cleanly before execution starts.",
                      "type": "definition"
                    },
                    {
                      "body": "Silent prompt reveals three separate leads simultaneously feared `\"Engineering lacks QA bandwidth in Q2 while Sales promised custom integrations\"`—catching a fatal collision Day 1!",
                      "type": "example",
                      "title": "Pre-Mortem Breakthrough"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Run anonymous or quiet independent brainstorm writing first for 5 minutes so louder executives don’t anchor quiet dissent!",
                        "Collect top 3 plausible crash causes cleanly without blaming individuals.",
                        "Embed targeted preventative safeguards straight back into Q1 operating milestones immediately."
                      ],
                      "title": "Applying Pre-Mortems: Breaking Your Plan Before Launch"
                    },
                    {
                      "text": "Nobody wanted to look pessimistic during an upbeat kickoff celebrating Q1 growth targets—until shipping infrastructure collapsed Week 6 exactly as warehouse managers feared silently.",
                      "type": "case_study",
                      "title": "Polite Consensus Blindspot",
                      "takeaway": "Formal pre-mortems turn quiet skepticism into prized risk engineering!"
                    },
                    {
                      "text": "Thank the sharpest realistic skepticism loudly during planning sessions—honesty early costs pennies compared to late rework.",
                      "type": "callout",
                      "title": "Make Dissent Socially Safe",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why ask team members to write failure reasons independently BEFORE open discussion in a Pre-Mortem?",
                      "options": [
                        "Saves conference pens",
                        "Prevents senior voices or upbeat consensus bias from silencing honest operational doubts early",
                        "Replaces budgets completely"
                      ],
                      "explanation": "Silent independent writing uncovers authentic bottlenecks across junior and senior roles cleanly.",
                      "correctIndex": 1
                    }
