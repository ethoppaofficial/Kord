                },
                {
                  "id": "0bf16bd7-ad6e-feed-c5a7-8c99b5d11f69",
                  "title": "The CSS Box Model, Typography, and Colour Contrast",
                  "blocks": [
                    {
                      "id": "fe32-1",
                      "body": "With default content-box, width: 100% plus padding: 24px creates a box wider than 100%, triggering horizontal scrollbars. Setting *, *::before, *::after { box-sizing: border-box; } includes padding and border inside the declared width.",
                      "type": "example",
                      "title": "Why border-box Prevents Horizontal Overflow"
                    },
                    {
                      "id": "fe32-2",
                      "type": "bullets",
                      "items": [
                        "Set body prose between 15px and 17px with 1.6 line-height.",
                        "Limit line length to 60–75ch so the eye tracks easily.",
                        "Verify normal text achieves at least 4.5:1 colour contrast."
                      ],
                      "title": "Readable Typography Rules"
                    }
                  ],
                  "videos": [],
                  "summary": "Predictable box sizing and legible typographic rhythm instantly elevate interface clarity.",
                  "position": 2,
                  "resources": [
                    {
                      "id": "9d6d7dc4-65e7-4419-8c54-37f316bd9b95",
                      "url": "https://developer.mozilla.org/en-US/docs/Learn/CSS/Building_blocks/The_box_model",
