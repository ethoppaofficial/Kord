                {
                  "id": "4a9961ab-bed1-98a2-c231-4f63b117ee81",
                  "title": "Two-Column A/V Scripts & Word Timing",
                  "blocks": [
                    {
                      "text": "Standard A/V Table Layout & WPM Math",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Industry brand, explainer, and educational scripts pair two tidy columns side by side: Left Column specifies `VISUAL / SHOT / SCREEN TEXT / SFX`, and Right Column carries `AUDIO / SPOKEN VOICE / PAUSES`. Crucially, comfortable conversational English runs roughly **130–145 words per minute**—calculating runtime upfront avoids shooting 8-minute scripts for 3-minute briefs.",
                      "type": "paragraph"
                    },
                    {
                      "term": "WPM Script Budgeting",
                      "text": "Calculating expected runtime ahead of filming using conversational pacing (~130–145 spoken words per minute, plus pauses for visual reveals).",
                      "type": "definition"
                    },
                    {
                      "body": "`[0:15 - 0:25] VISUAL: Screen capture zooms onto Export Modal; callout highlights \"UTF-8\". | AUDIO: \"Always pick UTF-8 right here—otherwise international names break into strange symbols.\"`",
                      "type": "example",
                      "title": "A/V Two-Column Row"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Keep spoken prose around 135 words per target minute (leave 10–15% room for breaths and visual demos).",
                        "Put exact lower-third titles and on-screen callouts in clear caps or brackets inside Left Column.",
                        "Read through with a literal timer before sending scripts to cameras."
                      ],
                      "title": "Applying Two-Column A/V Scripts & Word Timing"
                    },
                    {
                      "text": "A marketing team approved a 480-word script expecting a punchy 60-second launch clip; voice talent would have spoken like an auctioneer.",
                      "type": "case_study",
                      "title": "500-Word \"One-Minute\" Client Script",
                      "takeaway": "Trimming cleanly to 135 crisp words delivered polished visual room to breathe effortlessly."
                    },
                    {
                      "text": "Complex tutorials need closer to 120–130 WPM so viewers process steps while watching screen cursors move.",
                      "type": "callout",
                      "title": "Never Exceed 145 WPM on Dense Topics",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Approximately how many spoken words belong in a clean 60-second educational video script?",
                      "options": [
                        "300–350 words",
                        "125–145 conversational words leaving room for breaths and visuals",
                        "50 words strictly"
                      ],
                      "explanation": "Pacing near 135 WPM stays brisk yet relaxed enough for viewer comprehension.",
                      "correctIndex": 1
                    }
                  ],
