                },
                {
                  "id": "96f7b66e-00bc-6c96-b5f4-b4275c106a0a",
                  "title": "MECE Buckets Without Gaps or Overlap",
                  "blocks": [
                    {
                      "text": "Mutually Exclusive, Collectively Exhaustive Design",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "MECE ensures your supporting categories neither bleed into one another (Mutually Exclusive) nor omit major slices of reality (Collectively Exhaustive). Whether splitting revenue by segment, costs by fixed vs. variable, or workflows by pre-sale vs. post-sale, clean boundaries make complex audits airtight.",
                      "type": "paragraph"
                    },
                    {
                      "term": "MECE",
                      "text": "Analytical organizing standard ensuring categories have zero overlap (Mutually Exclusive) and cover every relevant dimension (Collectively Exhaustive).",
                      "type": "definition"
                    },
                    {
                      "body": "Non-MECE: \"Customers in North America, Enterprise accounts, and New signups\" (heavy overlap). MECE: \"SMB (<50 seats), Mid-Market (50–500 seats), Enterprise (500+ seats)\".",
                      "type": "example",
                      "title": "MECE Segmentation"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Pick ONE consistent organizing dimension per grouping level (geography OR tier OR timeline).",
                        "Verify items never belong cleanly in two buckets at once.",
                        "Confirm major overlooked corners are captured explicitly."
                      ],
                      "title": "Applying MECE Buckets Without Gaps or Overlap"
                    },
                    {
                      "text": "A monthly deck mixed \"Social Media\", \"Paid Ads\", and \"Instagram Campaigns\" as separate buckets, inflating apparent reach.",
                      "type": "case_study",
                      "title": "Double-Counted Marketing Leads",
                      "takeaway": "Splitting strictly into Paid vs. Organic channels fixed attribution confusion permanently."
                    },
                    {
                      "text": "Mixing customer size with marketing channel in the same list almost always guarantees overlap errors.",
                      "type": "callout",
                      "title": "Stick to One Axis Per Level",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Which category set satisfies the MECE principle cleanly?",
                      "options": [
                        "New customers, EU clients, Retail buyers",
                        "Acquisition cost, Onboarding cost, Ongoing Support cost across the lifecycle",
                        "Marketing, Email, Sales"
                      ],
                      "explanation": "Sequential customer-lifecycle cost buckets keep phases cleanly separate and complete.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "MECE structure prevents double counting and signals strategic rigor immediately.",
                  "position": 2,
                  "resources": [
