                },
                {
                  "id": "21c54ad6-7a30-21c8-4903-b359f68606e3",
                  "title": "Cohesion With Known-to-New Bridges",
                  "blocks": [
                    {
                      "text": "Linking Familiar Context to Fresh Information",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Sentences flow naturally when each sentence opens with a term or concept already familiar from the previous line (the \"known\") and finishes with the fresh point (\"the new\"). Coupling known-to-new progression with accurate transition markers (\"however\", \"consequently\", \"for instance\") eliminates jarring jumps.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Known-to-New Principle",
                      "text": "Opening a sentence with previously introduced context before delivering fresh information at the emphatic sentence ending.",
                      "type": "definition"
                    },
                    {
                      "body": "Before: \"Solar costs dropped 80%. Grid batteries handle night loads.\" After: \"Those falling solar costs now pair with grid batteries that handle night loads.\"",
                      "type": "example",
                      "title": "Smoothing a Choppy Transition"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Underline the closing concept of sentence one.",
                        "Echo or reference that concept within the first five words of sentence two.",
                        "Replace generic \"and\" connectors with exact causal or contrastive links."
                      ],
                      "title": "Applying Cohesion With Known-to-New Bridges"
                    },
                    {
                      "text": "Employees struggled to connect an opening budget cut paragraph to a training freeze paragraph.",
                      "type": "case_study",
                      "title": "Abrupt Policy Memo",
                      "takeaway": "Adding one bridging clause referencing \"that narrowed operating budget\" made causality unmistakable."
                    },
                    {
                      "text": "Never use \"however\" when you merely mean \"additionally\"; imprecise transition words mislead readers.",
                      "type": "callout",
                      "title": "Watch Your Connectors",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Where does new, high-emphasis information belong in a well-paced sentence?",
                      "options": [
                        "Buried in an opening dependent clause",
                        "Near the clear stress position at the end of the sentence",
                        "Inside parentheticals"
                      ],
                      "explanation": "Ending on fresh information prepares the next sentence to pick up that thread cleanly.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Known-to-new chaining creates seamless reading momentum across entire pages.",
                  "position": 2,
                  "resources": [
