            {
              "id": "1234f49a-912a-43f7-149c-e42500e57db8",
              "title": "Module 4: Client Updates, Meeting Recaps & Reporting",
              "lessons": [
                {
                  "id": "20c71c32-550d-9e12-f191-e401e2da3e50",
                  "title": "Client Status Updates Without Noise",
                  "blocks": [
                    {
                      "text": "Traffic-Light Status Digests",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Effective client updates answer four questions effortlessly: Are we on track? What shipped this week? What are we waiting on from you? What happens next week? Labeling overall health (`On Track`, `Watch`, `Needs Action`) removes guessing right from line one.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Client Dependency Highlight",
                      "text": "A visually distinct bullet listing exact approvals, assets, or credentials needed from the client with their target due date.",
                      "type": "definition"
                    },
                    {
                      "body": "Health: On Track | Waiting on Client: Final logo SVG by Wed 12 PM to stay on schedule for Friday staging review.",
                      "type": "example",
                      "title": "Crisp Status Block"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Lead with overall timeline health immediately.",
                        "Translate technical internal tasks into visible client progress.",
                        "Highlight needed client actions clearly with due dates."
                      ],
                      "title": "Applying Client Status Updates Without Noise"
                    },
                    {
                      "text": "An agency avoided sending Friday updates while debugging minor styling delays; the client feared abandonment and escalated Monday morning.",
                      "type": "case_study",
                      "title": "Silent Milestone Slip",
                      "takeaway": "Consistent transparent weekly notes—even short ones—build rock-solid patience."
                    },
                    {
                      "text": "Say \"To hit Friday review, we need final copy by Wednesday 3 PM\" so timelines stay shared clearly.",
                      "type": "callout",
                      "title": "Highlight Client Dependencies Gently",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why highlight items awaiting client approval in a dedicated section?",
                      "options": [
                        "To shift all project blame",
                        "So busy client leads immediately spot what is blocking progress on their side",
                        "To lengthen weekly digests"
                      ],
                      "explanation": "Separating client asks cleanly keeps momentum from stalling over overlooked inbox replies.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Structured weekly digests earn calm trust and faster client turnarounds.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "fce9cd5e-18f8-49ea-b932-ef9322ef9ae1",
                      "url": "https://owl.purdue.edu/",
                      "title": "Purdue OWL General Writing Resources",
                      "position": 1,
