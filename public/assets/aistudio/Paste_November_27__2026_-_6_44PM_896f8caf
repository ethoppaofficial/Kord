                  "id": "180d9865-7dfe-4194-5fe0-d8935c36eb5a",
                  "title": "Cash-Flow Visibility: Fixed Needs vs Variable Reality",
                  "blocks": [
                    {
                      "text": "Zero-Surprise Expense Categorization & Runway",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "List true monthly essentials (rent, food, utilities, debt minimums, transport) separately from flexible lifestyle spending and annual lump expenses (insurance, software renewals, hardware). Divide annual bills by 12 into monthly sinking funds so December renewals never feel like emergencies.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Sinking Fund",
                      "text": "Setting aside a small fixed amount monthly toward predictable non-monthly expenses (tax bills, laptop replacement, annual insurance) so they never ambush cash flow.",
                      "type": "definition"
                    },
                    {
                      "body": "Knowing your essentials require £1,450/month gives instant clarity on minimum freelance bookings and how many months your savings cover.",
                      "type": "example",
                      "title": "Baseline Survival Number"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Audit 60 days of real bank statements to find invisible recurring subscriptions.",
                        "Separate fixed essentials, sinking funds, debt payoff, and flexible spending.",
                        "Track cash flow weekly in 10 minutes—awareness beats guilt."
                      ],
                      "title": "Applying Cash-Flow Visibility: Fixed Needs vs Variable Reality"
                    },
                    {
                      "text": "Auditing two months of statements uncovered £112/month in forgotten trial tools—recovering £1,344/year cleanly.",
                      "type": "case_study",
                      "title": "Killed Subscription Leaks",
                      "takeaway": "Small leaks drain real runway fast."
                    },
                    {
                      "text": "Base ongoing rent/lease commitments on your conservative low-month baseline, never your single best month!",
                      "type": "callout",
                      "title": "Avoid Lifestyle Creep in Boom Months",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why use monthly sinking funds for annual insurance or laptop replacements?",
                      "options": [
                        "Banks charge fees otherwise",
                        "Spreading lumpy annual costs monthly prevents predictable bills from causing cash crises",
                        "Increases credit limits"
                      ],
                      "explanation": "Sinking funds smooth predictable irregular expenses into calm monthly habits.",
