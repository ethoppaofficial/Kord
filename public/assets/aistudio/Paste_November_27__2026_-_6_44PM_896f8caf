                {
                  "id": "f0b364e9-e633-277b-1c78-8ba2a8e22326",
                  "title": "Profit Is Not Cash (The P&L vs. Cash Flow Trap)",
                  "blocks": [
                    {
                      "text": "Accrual Revenue vs. Literal Bank Timing",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "The **Income Statement (`P&L`)** measures economic activity earned during a period (`Revenue - Expenses = Net Profit`)—even before unpaid invoices arrive in cash or after multi-year gear depreciates slowly. The **Cash Flow Statement** tracks real dollars entering and leaving the bank account (`Operating, Investing, Financing`), revealing immediately whether bills clear smoothly Friday afternoon!",
                      "type": "paragraph"
                    },
                    {
                      "term": "Accrual Timing Gap",
                      "text": "Recording earned revenue when work delivers or invoices issue—weeks ahead of actual customer payment hitting the bank—causing paper profit alongside empty checking accounts.",
                      "type": "definition"
                    },
                    {
                      "body": "Studio delivers a $10,000 site Jan 5 (`Net-60` terms) and pays $4,000 contractors Jan 15. January P&L glows cleanly `+6,000 Profit`—yet January 31 Cash Flow sits literally `-$4,000` in the red until March!",
                      "type": "example",
                      "title": "Invoice Timing Reality"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Always inspect the Statement of Cash Flows right beside the P&L every month.",
                        "Track Accounts Receivable (`what clients owe you`) aging past 30 days obsessively.",
                        "Remember loan principal repayments reduce Cash without showing up as P&L \"Expenses\" (only loan interest hits P&L!)."
                      ],
                      "title": "Applying Profit Is Not Cash (The P&L vs. Cash Flow Trap)"
                    },
                    {
                      "text": "A fast-growing wholesaler booked $120k paper profits in Q4 while front-loading $90k inventory and offering 60-day store credit—bouncing vendor checks right after record sales.",
                      "type": "case_study",
                      "title": "Profitable Bankruptcy Shock",
                      "takeaway": "Matching customer deposits closer to vendor payments cures growth cash stress permanently."
                    },
                    {
                      "text": "Never manage daily survival strictly off accrual profit lines—watch real bank cash movement weekly!",
                      "type": "callout",
                      "title": "Profit Pays Long-Term; Cash Pays Friday",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "How can a business report strong P&L Net Profit this month while bank cash drops sharply?",
                      "options": [
                        "Accountants hide decimals",
                        "Clients haven’t paid issued invoices yet (`Receivables`) or cash left upfront for bulk inventory/loan principal not counted directly as current-month expense",
                        "Software deletes deposits"
                      ],
                      "explanation": "Working capital lags and balance-sheet payouts move literal cash independently of accrual profit recognition.",
                      "correctIndex": 1
                    }
