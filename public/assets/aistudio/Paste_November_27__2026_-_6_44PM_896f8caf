            {
              "id": "a9c793cd-4f20-3d81-5351-5f11b4bf6eca",
              "title": "Module 2: Designing Unbiased Surveys & Sample Hygiene",
              "lessons": [
                {
                  "id": "d958fd3b-5456-be43-7b84-39b3262d9212",
                  "title": "Spotting Hidden Survey Bias Traps",
                  "blocks": [
                    {
                      "text": "Neutral Balanced Question Craft",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Clean survey engineering guards fiercely against four common bugs: **Leading Phrasing** (`\"How amazing was our new checkout?\"`), **Double-Barreled Questions** bundling two ideas into one (`\"Rate our support speed and friendliness\"`—what if fast yet rude?!), **Overlapping Ranges** (`0–5, 5–10` leaving `5` stranded), and **Missing Neutral/Opt-Out Choices** forcing frustrated guesses.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Double-Barreled Question",
                      "text": "Combining two separate concepts inside a single rating scale (\"How clear and affordable is our platform?\"), guaranteeing unreadable muddy results when buyers like clarity yet hate price.",
                      "type": "definition"
                    },
                    {
                      "body": "Flawed: \"How helpful was our friendly fast team?\" Clean: Separate 1–5 scales for \"Response Speed\" and \"Issue Resolution Clarity\" plus clean `\"Not Applicable\"` escape!",
                      "type": "example",
                      "title": "Rescuing Two Flawed Questions"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Use neutral balanced scales (`\"How satisfied or dissatisfied...\"`, never `\"How satisfied...\"` alone).",
                        "Put literally ONE concept per item.",
                        "Ensure numeric bracket choices never overlap (`0–4, 5–9, 10+`) and always offer `\"Not sure / Does not apply\"`."
                      ],
                      "title": "Applying Spotting Hidden Survey Bias Traps"
                    },
                    {
                      "text": "Grouping `\"Price & Product Quality\"` together prevented discovering that buyers adored product UI yet choked strictly on onboarding fees.",
                      "type": "case_study",
                      "title": "Useless Customer NPS Survey",
                      "takeaway": "Separating clean atomic variables exposed pricing fixes effortlessly!"
                    },
                    {
                      "text": "Watch three friends complete your survey silently before mass distribution—anywhere they hesitate marks an unclear phrasing flaw!",
                      "type": "callout",
                      "title": "Test On 3 Peers Aloud First",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What fails inside the survey item: `\"How easy and fast was configuring your account today?\"`?",
                      "options": [
                        "Too few emojis",
                        "Double-barreled prompt asking about two distinct dimensions (`Ease` vs `Speed`) inside one forced answer",
                        "Missing demographic info"
                      ],
                      "explanation": "Splitting distinct attributes ensures clean actionable diagnostic clarity.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Neutral atomic phrasing produces crisp trustworthy survey datasets.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "9e32828d-ec28-406d-9aa8-126a8067e03d",
                      "url": "https://www.sba.gov/business-guide",
                      "title": "SBA Startup & Market Validation Guide",
                      "position": 1,
                      "resource_type": "guide"
                    },
                    {
                      "id": "cf5e03b8-ea6e-4595-a71f-d9281607bbfa",
                      "url": "https://hbr.org/",
                      "title": "Harvard Business Review Startup & Business Models",
