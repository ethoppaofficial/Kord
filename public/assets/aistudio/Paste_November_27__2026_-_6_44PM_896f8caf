                  "id": "9c0d180e-5f3c-5eb0-474a-ef74df2b80cb",
                  "title": "Tiered Go-To-Market Without Heavy Overhead",
                  "blocks": [
                    {
                      "text": "Matching Launch Effort to User Impact Tiers",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Standardize three intuitive launch tiers: **Tier 3 (Minor tweaks/fixes -> brief changelog bullet)**, **Tier 2 (Meaningful new customer workflows -> updated Help Docs, Support Team 15-min preview + clean Email/In-app nudge)**, and **Tier 1 (Flagship Platform Milestones -> Full cross-functional GTM, Sales Battlecards, Video demos, Staged Beta)**. Most importantly, **ALWAYS brief Support Teams 48–72 hours ahead** with exact error notes and helpful macro templates before customers discover buttons live!",
                      "type": "paragraph"
                    },
                    {
                      "term": "Tiered Launch Matrix",
                      "text": "Classifying upcoming product releases cleanly into Tier 1/2/3 levels beforehand so marketing, sales training, help docs, and support readiness scale proportionately without chaos.",
                      "type": "definition"
                    },
                    {
                      "body": "3 days before Tier-2 release: PM posts crisp 3-minute screen recording + 3 anticipated support answers directly inside Support channel (`\"Here is how new Permissions look + exact fallback if someone asks why X moved\"`).",
                      "type": "example",
                      "title": "Zero-Surprise Support Prep"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Update user-facing Help Center guides BEFORE toggling global 100% user visibility live!",
                        "Equip Support & Sales early with honest FAQs naming exactly what stays excluded in v1 cleanly.",
                        "Give long-time users graceful transition notice ahead of removing beloved legacy navigation flows (`never abruptly break daily muscle memory silently overnight!`)."
                      ],
                      "title": "Applying Tiered Go-To-Market Without Heavy Overhead"
                    },
                    {
                      "text": "Engineering flipped a giant billing settings overhaul live Sunday midnight without telling Support reps—creating 200 confused ticket waits Monday morning because staff literally didn’t recognize customer screen descriptions!",
                      "type": "case_study",
                      "title": "Ambushed Monday Support Desk",
                      "takeaway": "Briefing Support early turns frontlines into ecstatic launch ambassadors cleanly!"
                    },
                    {
                      "text": "Giving clear brief in-app previews 7 days ahead when relocating heavily clicked core buttons cuts user anger dramatically cleanly!",
                      "type": "callout",
                      "title": "Warning Users Gently Ahead of UI Moves",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Who MUST receive hands-on screenshots, doc links, and anticipated user FAQs at least 48 hours BEFORE any noticeable UI workflow launches?",
                      "options": [
                        "External press agencies strictly",
                        "Internal Customer Support and frontline Sales/Success teams handling immediate live customer confusion cleanly",
                        "Office facilities staff"
                      ],
                      "explanation": "Equipping frontline support ahead of toggle-on prevents embarrassing internal blind-sides completely.",
                      "correctIndex": 1
                    }
