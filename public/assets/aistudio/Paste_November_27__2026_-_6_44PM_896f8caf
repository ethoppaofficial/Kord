            {
              "id": "548372aa-231f-8f06-6da0-d3c4bdefcce2",
              "title": "Module 3: Ideation & Solution Prioritization",
              "lessons": [
                {
                  "id": "b6ae93e3-51bc-29fd-4450-b0a1def6ebb1",
                  "title": "Escaping the First-Idea Trap",
                  "blocks": [
                    {
                      "text": "Diverge First, Converge Second",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Generating only two weak ideas guarantees choosing the lesser flaw. Give groups quiet divergent time aiming for eight distinct approaches—including \"What if budget were £0?\", \"What if we eliminated this step completely instead of speeding it up?\", and \"How do unrelated industries solve waiting lines?\"—before evaluating feasibility cleanly afterward.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Divergent-Convergent Separation",
                      "text": "Enforcing a non-judgmental generation phase exploring bold and low-cost paths before analytical feasibility filtering begins.",
                      "type": "definition"
                    },
                    {
                      "body": "Asking \"How could we eliminate step 3 completely?\" replaced building complex auto-fill software by simply dropping a field Finance never actually used.",
                      "type": "example",
                      "title": "Killing Step 3 Entirely"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Generate 6–8 contrasting angles before scoring.",
                        "Include elimination and process-simplification options.",
                        "Never mock bold \"impossible\" probes—they spark practical hybrids."
                      ],
                      "title": "Applying Escaping the First-Idea Trap"
                    },
                    {
                      "text": "Asking \"How would airlines fix clinic lobby tension?\" led to clear real-time wait SMS updates costing virtually nothing while halving front-desk complaints.",
                      "type": "case_study",
                      "title": "Zero-Cost Waiting Fix",
                      "takeaway": "Cross-domain analogies unlock effortless brilliance."
                    },
                    {
                      "text": "The fastest most bug-free workflow step is the unnecessary step deleted completely.",
                      "type": "callout",
                      "title": "Always Ask: Can We Delete It?",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why should teams intentionally avoid critiquing ideas during divergent brainstorming?",
                      "options": [
                        "All ideas are equally smart",
                        "Early criticism shuts down shy contributors and locks teams onto dull obvious incremental fixes",
                        "Meetings run shorter automatically"
                      ],
                      "explanation": "Separating creation from judgment widens real creative range dramatically.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Structured divergence consistently uncovers simpler, stronger fixes.",
                  "position": 1,
                  "resources": [
