            {
              "id": "687f3715-e635-6919-32d5-4da5d19f1f7b",
              "title": "Module 5: Pipeline Discipline, Enterprise Patience & Metrics",
              "lessons": [
                {
                  "id": "8c9453bc-1af0-fcb5-689d-a8a04e572131",
                  "title": "Eliminating \"Happy Ears\" From BD Pipelines",
                  "blocks": [
                    {
                      "text": "Verifiable Exit Criteria Per Stage",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "BD calls naturally sound upbeat because nobody dislikes polite brainstorming! Protect honest pipeline rigor by tying every stage advance strictly to **concrete customer/partner commitment**: an email confirming named executive sponsor, signed pilot scope date, or first scheduled co-marketing date—NEVER enthusiastic compliments alone.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Happy Ears Trap",
                      "text": "Mistaking polite conversational enthusiasm (\"Let’s definitely collaborate soon!\") for actual verified organizational commitment or internal budget priority.",
                      "type": "definition"
                    },
                    {
                      "body": "A partner cannot move out of `\"Exploratory\"` into `\"Active Pilot\"` purely after nice vibes—they only advance once both teams agree an exact target calendar date and named owner!",
                      "type": "example",
                      "title": "Objective Stage Gate"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Assign conservative weighted probabilities truthfully (`<15%` ahead of signed pilot scope).",
                        "Kill polite \"zombie\" discussions cleanly after two unfulfilled action commitments (\"Happy to reconnect next quarter if priorities reopen!\").",
                        "Audit pipeline age rigorously: anything stuck unchanged 45+ days triggers honest re-qualification or archive."
                      ],
                      "title": "Applying Eliminating \"Happy Ears\" From BD Pipelines"
                    },
                    {
                      "text": "A founder reported \"8 huge enterprise deals near closing\" for nine straight months solely off recurring friendly lunch chats with zero agreed pilot triggers.",
                      "type": "case_study",
                      "title": "Year-Long Coffee Stagnation",
                      "takeaway": "Enforcing verifiable partner action gates exposed real focus instantly and cleared three fast regional wins."
                    },
                    {
                      "text": "Ask politely: \"Could you introduce your Marketing Ops lead by Friday so we lock webinar dates?\"—action speed exposes genuine priority instantaneously!",
                      "type": "callout",
                      "title": "Test Commitment With Micro-Deadlines",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What separates genuine forward BD momentum from empty \"happy ears\" coffee chats?",
                      "options": [
                        "Length of friendly video call",
                        "Concrete reciprocal partner actions—named owners, locked pilot dates, or shared prospect introductions",
                        "Matching corporate slides"
                      ],
                      "explanation": "Reciprocal tangible commitment separates polite conversation from real priority alignment.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Evidence-based stage gates protect founder and team hours from endless hopeful limbo.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "b53f86d4-6cc0-447e-8e5c-b4a501f9f3a4",
                      "url": "https://www.sba.gov/business-guide",
                      "title": "U.S. Small Business Administration Business Guide",
                      "position": 1,
                      "resource_type": "guide"
                    },
                    {
                      "id": "5ef8433e-ea04-4e60-98e2-bf94cca40138",
                      "url": "https://hbr.org/",
                      "title": "Harvard Business Review Strategy & Entrepreneurship",
                      "position": 2,
                      "resource_type": "articles"
                    }
                  ],
                  "takeaways": [
                    "Require verified partner reciprocal action ahead of stage advancement",
                    "Archive unresponsive zombie partnerships cleanly without ego",
                    "Test true priority early using polite small commitments"
                  ],
                  "objectives": [
                    "Explain verifiable exit criteria per stage",
                    "Apply eliminating \"happy ears\" from bd pipelines practically"
                  ],
                  "est_minutes": 28,
                  "is_required": true,
                  "introduction": "\"We had an awesome friendly coffee—they’re super excited to partner!\" fills pipelines with phantom illusions that close zero revenue for quarters.",
                  "further_reading": [
                    {
                      "url": "https://www.sba.gov/business-guide",
