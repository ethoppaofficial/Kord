            {
              "id": "672c6349-ffcf-df7a-5763-3c5c366f1a22",
              "title": "Module 2: Clean Open Inquiry & Precision Questions",
              "lessons": [
                {
                  "id": "519fb4bf-cf59-0ef9-55a3-8a3f6b574daf",
                  "title": "The Art of \"What\" & \"How\" Questions",
                  "blocks": [
                    {
                      "text": "Neutral Diagnostic Inquiry",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Leading questions (\"Don't you agree Option A is cleaner?\") coerce agreement rather than truth. Closed yes/no questions elicit one-word answers. Neutral open prompts anchored in \"What\" and \"How\" (\"What felt unclear in the brief?\", \"How are teams handling handoffs currently?\") prompt speakers to narrate real context without pressure.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Diagnostic Open Question",
                      "text": "A neutral \"What\" or \"How\" question free of embedded blame or desired answers that invites honest story and fact discovery.",
                      "type": "definition"
                    },
                    {
                      "body": "Instead of \"Why haven't you started?\", ask \"What blocked kicking off section one this week?\"",
                      "type": "example",
                      "title": "Replacing \"Why\" With \"What\""
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Catch leading phrases (\"Wouldn't you say...?\", \"Did you forget...?\").",
                        "Swap accusatory \"Why\" for neutral \"What/How\".",
                        "Ask one crisp single question per turn—never stack three at once."
                      ],
                      "title": "Applying The Art of \"What\" & \"How\" Questions"
                    },
                    {
                      "text": "A designer asking \"Would you use this button?\" received polite \"Sure!\" lies until asking \"Walk me through the last time you filed an expense report.\"",
                      "type": "case_study",
                      "title": "User Interview Breakthrough",
                      "takeaway": "Behavioral open prompts reveal genuine reality."
                    },
                    {
                      "text": "Never ask a good open question and then immediately answer it yourself during the silence.",
                      "type": "callout",
                      "title": "Ask One Question, Then Stop",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why do stacked multi-part questions degrade listening quality?",
                      "options": [
                        "They look overly formal",
                        "Speakers only answer the easiest last part, leaving earlier critical parts ignored",
                        "They save meeting time"
                      ],
                      "explanation": "Single clean questions earn deeper, more complete answers.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Clean open questions uncover honest facts without triggering defensiveness.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "24a1867c-2f0a-49df-a073-59c6609c83d0",
