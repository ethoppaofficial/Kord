            {
              "id": "c404a093-c632-f981-5168-bc8eb94aa4de",
              "title": "Module 5: Customer Support, Feedback & Service Emails",
              "lessons": [
                {
                  "id": "3478455f-5b3d-f9bd-c2ac-c9c954e805cd",
                  "title": "One-Touch Support Resolution Craft",
                  "blocks": [
                    {
                      "text": "Empathy, Complete Steps & Contingency",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Top support writing validates the customer’s frustration smoothly (\"I see how frustrating hitting an export error right before your client deadline feels\"), provides clear verified step-by-step instructions, and attaches Plan B proactively (\"If clearing cache still repeats Step 3, reply directly with your file type so I can convert it manually for you today\"). Solving two possible paths upfront halves resolution turnaround.",
                      "type": "paragraph"
                    },
                    {
                      "term": "One-Touch Ticket Mindset",
                      "text": "Anticipating the likely next clarifying follow-up question and supplying clear fallback options inside reply one so issues close cleanly without ping-pong.",
                      "type": "definition"
                    },
                    {
                      "body": "\"1. Switch export format to CSV UTF-8 under Settings > Data. 2. If your sheet exceeds 50k rows, split into Jan–Jun first—or attach it below and I’ll run the clean export for you immediately.\"",
                      "type": "example",
                      "title": "Helpful Plan A + Plan B"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Acknowledge real emotional/time impact first—never sound like a copied bot.",
                        "Give numbered bold UI click steps clearly.",
                        "Include safe Plan B fallback right away if Step A hits limits."
                      ],
                      "title": "Applying One-Touch Support Resolution Craft"
                    },
                    {
