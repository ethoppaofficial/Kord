                {
                  "id": "48b50d30-db3c-d240-9040-e00375cc3006",
                  "title": "Working With Mentors & Turning Feedback Into Fuel",
                  "blocks": [
                    {
                      "text": "Reverse-Driving Mentorship & Feedback Loops",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Drive mentor relationships actively: prepare concrete drafts or dilemmas upfront, listen without defensiveness when critiques sting, execute changes visibly before the next chat, and circle back to share how their advice helped. Consistent gratitude and action keep generous mentors invested.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Actionable Feedback Loop",
                      "text": "Requesting specific critique (\"Where did my portfolio explanation lose clarity?\"), applying fixes rapidly, and closing the loop on outcomes.",
                      "type": "definition"
                    },
                    {
                      "body": "Instead of \"Pick your brain about tech?\", ask \"I’m torn between polishing Project A’s tests or starting Project B—looking at my CV, which helps more for junior roles?\"",
                      "type": "example",
                      "title": "Prepared Coffee Chat"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Respect mentors’ calendars with concise agendas.",
                        "Separate ego from work—critique on a draft is a free shortcut to excellence.",
                        "Document personal quarterly wins so self-reviews and negotiations stay effortless."
                      ],
                      "title": "Applying Working With Mentors & Turning Feedback Into Fuel"
                    },
                    {
                      "text": "Applying a senior engineer’s PR feedback within 24 hours turned a casual 20-minute review into an active job referral.",
                      "type": "case_study",
                      "title": "Fast Iteration Earned Sponsorship",
                      "takeaway": "Visible follow-through is the rarest trait early in any career."
                    },
                    {
                      "text": "Record solved problems, kind feedback, and delivered outcomes monthly so annual reviews and CVs write themselves.",
