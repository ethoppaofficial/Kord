                {
                  "id": "53eb862b-666d-0559-22d5-e286eeaf1843",
                  "title": "Ishikawa (Fishbone) Cause Mapping",
                  "blocks": [
                    {
                      "text": "The 6M Diagnostic Skeleton",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "When messy issues combine policy rules, outdated scripts, training gaps, and unclear metrics, sketch a Fishbone diagram grouping candidate drivers across People/Training, Process/Rules, Technology/Tools, Inputs/Data, Environment/Schedule, and Measurement. Seeing all factors side by side keeps rooms from fixating blindly on their favorite pet complaint.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Fishbone Diagram",
                      "text": "Visual cause-and-effect map categorizing interacting drivers under clear pillars leading toward a stated problem head.",
                      "type": "definition"
                    },
                    {
                      "body": "Map causes cleanly across Training (no video tips), Inputs (dirty customer CSVs), Tools (slow validator), and Policy (manual dual sign-off).",
                      "type": "example",
                      "title": "Diagnosing Slow Customer Onboarding"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Write clean observable problem at Fishbone head.",
                        "Brainstorm drivers calmly across 4–6 category bones.",
                        "Star top 2 high-frequency bones to test empirically first."
                      ],
                      "title": "Applying Ishikawa (Fishbone) Cause Mapping"
                    },
                    {
                      "text": "Customer Success blamed slow software while Support blamed messy imports; Fishbone mapping proved both combined equally, uniting fix priorities seamlessly.",
                      "type": "case_study",
                      "title": "Cross-Team Diagnostic Breakthrough",
                      "takeaway": "Visual shared maps disarm blame wars instantly."
                    },
                    {
                      "text": "Treat Fishbone causes as hypotheses first—pull 20 real recent cases to verify which two bones drive 80% of incidents.",
                      "type": "callout",
                      "title": "Test Top Stars With Quick Logs",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "When does a Fishbone diagram outperform a single linear 5-Whys chain?",
                      "options": [
                        "For trivial single-cause typos",
                        "When multiple interacting factors across people, tools, policies, and inputs jointly produce friction",
                        "Never"
                      ],
                      "explanation": "Multi-pillar cause mapping stops blind single-cause tunnel vision.",
                      "correctIndex": 1
                    }
