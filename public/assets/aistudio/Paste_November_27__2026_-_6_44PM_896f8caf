                  "publication_status": "published",
                  "completion_criteria": "Study the core frameworks in \"Client Expectation & Scope Care\", verify the inline knowledge check, and apply the practical checklist."
                },
                {
                  "id": "e2c4db00-01a3-16e4-bd0c-a20850550bf0",
                  "title": "Cross-Functional Handoff Briefs",
                  "blocks": [
                    {
                      "text": "Structured Context Transfer",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Whenever work crosses departmental boundaries, the receiving team lacks months of prior context. A strong handoff brief records client goals, explicit non-goals, key constraints, stakeholder personalities, and open risks in under one page—eliminating awkward client questions repeating information they already gave.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Non-Goals Declaration",
                      "text": "Explicitly listing what a project will NOT build or cover in this cycle to prevent misdirected team effort.",
                      "type": "definition"
                    },
                    {
                      "body": "Summarize Buyer Success Metric, Target Launch Date, Promised Deliverables, Explicit Non-Goals, and Technical Watchouts before the handoff call.",
                      "type": "example",
                      "title": "Sales-to-Delivery Card"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Standardize a 5-field handoff template across teams.",
                        "Walk through constraints live in 15 minutes for complex accounts.",
                        "Verify the receiving owner can restate success criteria cleanly."
                      ],
                      "title": "Applying Cross-Functional Handoff Briefs"
                    },
                    {
                      "text": "Sales informally mentioned multi-language support; Delivery budgeted zero hours for it, triggering a day-30 escalation.",
                      "type": "case_study",
                      "title": "Broken Sales Promise Recovery",
                      "takeaway": "Mandatory written handoff reviews caught similar gaps before kickoff signatures."
                    },
                    {
                      "text": "Naming what is out of scope avoids half the misunderstandings across engineering and client teams.",
                      "type": "callout",
                      "title": "Make Non-Goals Explicit",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why is listing \"Non-Goals\" critical inside a cross-team handoff brief?",
                      "options": [
                        "To criticize another department",
                        "To clarify scope boundaries so teams do not accidentally build unrequested features",
                        "To shorten project timelines automatically"
                      ],
                      "explanation": "Explicit boundaries keep teams aligned on shared deliverables.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Clean handoffs preserve institutional knowledge and client confidence.",
                  "position": 2,
                  "resources": [
