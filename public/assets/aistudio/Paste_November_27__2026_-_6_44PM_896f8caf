                  "title": "Staffing Triggers & Hidden Growth Bottlenecks",
                  "blocks": [
                    {
                      "text": "Milestone-Linked Capacity Thresholds",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Map literal **Capacity Ceilings** across each role (`1 support coordinator handles max ~180 active clients smoothly`, `1 baker oven clears max 120 loaves/day`). Tie new hires, software tier jumps, and extra equipment straight to pre-defined trigger milestones (`\"Post Part-Time Fulfillment Listing when active monthly clients cross 22 for 2 consecutive months\"`), preserving calm buffer ahead of crunch.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Trigger-Based Hiring",
                      "text": "Pre-planning exactly which sustained operational workload or revenue threshold unlocks adding contractor hours, full-time staff, or larger infrastructure cleanly ahead of crisis.",
                      "type": "definition"
                    },
                    {
                      "body": "Current Team Max: 24 client accounts (120 delivery hrs/wk). Action Trigger: At 20 steady accounts (85% load), begin structured contractor onboarding so quality stays immaculate!",
                      "type": "example",
                      "title": "Clear Scaling Trigger"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Calculate genuine max sustainable weekly output per person leaving 15–20% slack for admin & unexpected glitches.",
                        "Pre-identify lead times (`recruiting + onboarding often consumes 6–8 weeks!`) ahead of peak seasonal rush.",
                        "Keep early overflow flexible via vetted specialists before fixed full-time payroll ramps."
                      ],
                      "title": "Applying Staffing Triggers & Hidden Growth Bottlenecks"
                    },
                    {
                      "text": "Winning two giant Q4 contracts without checking staffing capacity forced chaotic last-minute temp hires who botched deliveries and hurt brand ratings.",
                      "type": "case_study",
                      "title": "Reactive Panic Hiring",
                      "takeaway": "Tracking utilization ceilings ahead of big pitches keeps growth deeply profitable and calm."
                    },
                    {
                      "text": "When core teams run smoothly at 85% utilization, start prepping next capacity steps—at 100%, quality and sales follow-ups crumble fast!",
                      "type": "callout",
                      "title": "Mind the 85% Danger Zone",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why attach hiring and infrastructure upgrades to pre-planned utilization milestones (e.g., 85% sustained load) rather than fixed calendar dates?",
                      "options": [
                        "Calendars miss leap years",
                        "Protects cash cleanly if growth trails slow while preventing chaotic quality crashes if customer growth hits faster than expected",
                        "Avoids job interviews"
                      ],
                      "explanation": "Demand-triggered scaling synchronizes payroll overhead seamlessly with verified revenue load.",
                      "correctIndex": 1
