            {
              "id": "d4dee983-5554-27e1-9859-12d2bc9aa6f0",
              "title": "Module 5: Business Emails, Pitches & External Notes",
              "lessons": [
                {
                  "id": "01c9b92f-4bbc-e4eb-3025-fb6bd465b0ee",
                  "title": "High-Velocity Business Emails",
                  "blocks": [
                    {
                      "text": "Action-Tagged Subjects & Crisp Asks",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Signal urgency and purpose right in the subject line: `[Approval Needed by Thu] Q4 Contractor Scope`. Open with context in line one, present bulleted specifics or options in lines two through four, and close with an easy binary or calendar prompt.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Zero-Friction CTA",
                      "text": "A specific closing request easy to answer in 15 seconds (\"Approve Option A or B?\" / \"Does Tue 10 AM or Wed 2 PM work?\").",
                      "type": "definition"
                    },
                    {
                      "body": "Weak: \"Marketing Sync\". Strong: \"[Input Needed Wed] Q4 Partner Co-Marketing Brief\".",
                      "type": "example",
                      "title": "Subject Line Precision"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Write subject lines containing category tag + concrete topic + deadline if urgent.",
                        "Trim business emails under 150 words whenever possible.",
                        "Propose concrete times or clear options instead of \"Let me know your thoughts\"."
                      ],
                      "title": "Applying High-Velocity Business Emails"
                    },
                    {
                      "text": "Asking \"How should we proceed with Q4 events?\" yielded zero replies over 4 days.",
                      "type": "case_study",
                      "title": "Buried 5-Line Question",
                      "takeaway": "Sending \"Confirming Venue B ($4k) vs. Virtual ($800)—Reply A or B by 3 PM?\" got approved in 12 minutes."
                    },
                    {
                      "text": "Busy leaders reply rapidly when responding takes one word instead of writing a fresh essay.",
                      "type": "callout",
                      "title": "Make Yes/No Easy",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Which email closing earns the fastest reply from a busy partner?",
                      "options": [
                        "Let me know any thoughts when you have a moment.",
                        "Reply \"Approved\" to confirm Thursday’s timeline, or flag preferred adjustments by 4 PM.",
                        "Thanks in advance for everything!"
                      ],
                      "explanation": "Specific binary or constrained asks dramatically lower response effort.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Disciplined email framing clears decisions fast without cluttering inboxes.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "efed453f-20b0-4666-8133-3f1463229168",
                      "url": "https://owl.purdue.edu/",
                      "title": "Purdue OWL General Writing Resources",
                      "position": 1,
                      "resource_type": "guide"
                    },
                    {
                      "id": "6ade72ba-6489-41cc-9a16-8eba5f9dff1d",
                      "url": "https://www.plainlanguage.gov/guidelines/",
                      "title": "Plain Language Guidelines",
                      "position": 2,
                      "resource_type": "documentation"
                    }
                  ],
                  "takeaways": [
                    "Put topic and urgency squarely in subject lines",
                    "Use bullet options for multi-part requests",
                    "Offer low-friction closing prompts"
                  ],
                  "objectives": [
                    "Explain action-tagged subjects & crisp asks",
                    "Apply high-velocity business emails in original drafts"
                  ],
                  "est_minutes": 28,
                  "is_required": true,
                  "introduction": "Unclear subjects (\"Quick question\") and rambling middle paragraphs drop your message to the bottom of an executive inbox.",
                  "further_reading": [
                    {
                      "url": "https://owl.purdue.edu/",
                      "title": "Purdue OWL General Writing Resources",
                      "source": "Purdue OWL",
                      "resourceType": "Guide"
