                {
                  "id": "ced4b81d-7976-fada-565a-37623fe65e1a",
                  "title": "Ethical Citing, Linking & Fair Credit",
                  "blocks": [
                    {
                      "text": "Generous Outbound Attribution & Hub Links",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Thoughtful bloggers link generously inline to original research studies, peer bloggers’ great insights, and canonical docs using descriptive anchor text (`according to the UK Content Design guide`, never `\"click here\"`). Internally linking related cornerstone guides weaves readers deeper through your own ecosystem naturally.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Descriptive Anchor Text",
                      "text": "Clickable link phrasing naming the referenced work or insight clearly (\"recent Baymard checkout usability findings\") instead of blind phrases like \"here\" or \"this link\".",
                      "type": "definition"
                    },
                    {
                      "body": "Weak: \"Read more about usability here.\" Strong: \"Review Baymard’s checkout field benchmarks to spot hidden form drop-offs.\"",
                      "type": "example",
                      "title": "Strong vs. Weak Inline Link"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Attribute coined terms and stats straight back to primary original authors.",
                        "Use meaningful multi-word descriptive anchors helpful for accessibility too.",
                        "Weave 2–4 contextual internal links per post toward deeper guides on your own blog."
                      ],
                      "title": "Applying Ethical Citing, Linking & Fair Credit"
                    },
                    {
                      "text": "Screen-reader users scanning page links heard ten consecutive identical \"here... here... link...\" prompts with zero context.",
                      "type": "case_study",
                      "title": "Broken \"Click Here\" Accessibility",
                      "takeaway": "Descriptive anchors improved usability, clarity, and organic link context simultaneously."
                    },
                    {
                      "text": "Verify primary study links don’t dead-end on broken 404 pages or unrelated affiliate traps before publishing.",
                      "type": "callout",
                      "title": "Check Outbound Links Open Cleanly",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why avoid bare `\"click here\"` phrases when embedding reference links in blog posts?",
                      "options": [
                        "Shorter URLs break HTML",
                        "Descriptive anchor words orient all readers and screen-reader users cleanly to what the link delivers",
                        "Links look too blue"
                      ],
                      "explanation": "Descriptive link text improves comprehension, accessibility, and topical context cleanly.",
                      "correctIndex": 1
                    }
