                        "Message mismatch where the landing H1 fails to match what the ad promised",
                        "Short CTA labels"
                      ],
                      "explanation": "Visitors assume they landed on the wrong page if headlines disconnect from the ad promise.",
                      "correctIndex": 1
                    }
