            {
              "id": "29970fa7-3c7b-2789-c10a-bc22df644f80",
              "title": "Module 2: Difficult Replies, Apologies & Escalations",
              "lessons": [
                {
                  "id": "c43ee0a8-f895-fa71-f0a3-83affed0ce92",
                  "title": "Warm Boundaries & Saying No Cleanly",
                  "blocks": [
                    {
                      "text": "Direct Kindness Over False \"Maybes\"",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "When turning down meeting invites, freelance low-ball rates, or unscheduled favors, reply promptly with brief genuine warmth (\"Thank you for thinking of me—that project sounds exciting\"), deliver a clean unambiguous decline without over-inventing dramatic excuses (\"My schedule is fully committed through December\"), and point helpfully elsewhere if appropriate.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Clean Decline",
                      "text": "Saying no clearly and politely without hedging (\"I’ll try to peek later maybe\") that strings the sender along awkwardly.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Thanks for inviting me to advise on Q1 rollout, Jordan. I’m at capacity with active client deliverables through March and must pass, though I recommend reaching out to Sam Rao who specializes here.\"",
                      "type": "example",
                      "title": "Polite Unambiguous Decline"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Reply promptly rather than letting invites rot silently.",
                        "Skip weak over-apologies or long fabricated excuses—short firm kindness stays strongest.",
                        "Avoid misleading soft phrases like \"Maybe next month\" unless truly open."
                      ],
                      "title": "Applying Warm Boundaries & Saying No Cleanly"
                    },
                    {
                      "text": "Saying \"Things are crazy right now, check back next week!\" forced a persistent requester to follow up four unwanted times.",
                      "type": "case_study",
                      "title": "Dragged-Out Soft \"Maybe\"",
                      "takeaway": "A single clean boundary email closed the loop politely on day one."
                    },
                    {
                      "text": "Short transparent capacity boundaries sound far more respectful than elaborate multi-paragraph alibis.",
                      "type": "callout",
                      "title": "Less Excuse = More Respect",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What weakens an otherwise polite \"No\" email most often?",
                      "options": [
                        "Brief thank-you greeting",
                        "Leaving false ambiguous hopes (\"Maybe check back next week?\") when capacity is genuinely closed",
                        "Suggesting another helpful contact"
                      ],
                      "explanation": "Ambiguous soft letdowns invite endless frustrating follow-up pings.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Prompt, warm, unambiguous boundaries earn profound professional respect.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "6b072706-c5a2-4174-a5de-c4e89ff573fa",
                      "url": "https://www.plainlanguage.gov/guidelines/",
                      "title": "Plain Language Guidelines & Actionable Email Tips",
                      "position": 1,
