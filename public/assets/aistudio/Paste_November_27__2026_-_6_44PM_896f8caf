                },
                {
                  "id": "7943bba7-24c6-1824-ae75-4a10e14dbb81",
                  "title": "Antagonism Beyond Pure Villains",
                  "blocks": [
                    {
                      "text": "Competing Valid Goals",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Strong antagonism happens when two characters want incompatible things for understandable reasons—or when environment, deadline, or inner doubt acts as relentless friction. Treating opposing voices with human logic deepens drama effortlessly.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Mirror Opposition",
                      "text": "An opposing figure whose conflicting objective exposes or challenges the protagonist’s central blind spot.",
                      "type": "definition"
                    },
                    {
                      "body": "A strict city inspector is not \"evil\"—she lost family in an uninspected fire years ago, making her stubbornness toward corners cut fiercely logical.",
                      "type": "example",
                      "title": "Humanized Rival"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Write two lines summarizing the opposition’s own valid justification.",
                        "Place characters in tight spaces where compromise cannot satisfy both.",
                        "Let conflict sharpen both voices instead of lecturing."
                      ],
                      "title": "Applying Antagonism Beyond Pure Villains"
                    },
                    {
                      "text": "An early draft gave a business rival no motive besides spite.",
                      "type": "case_study",
                      "title": "Flat Foil Character",
                      "takeaway": "Giving the rival overdue payroll obligations turned polite board meetings electric."
                    },
                    {
                      "text": "Let opponents make smart moves from their worldview so your protagonist must earn wins honestly.",
                      "type": "callout",
                      "title": "Never Create Stupidity to Aid Plot",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why make an antagonist’s motive logical from their own perspective?",
                      "options": [
