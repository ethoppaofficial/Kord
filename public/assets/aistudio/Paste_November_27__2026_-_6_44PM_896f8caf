                {
                  "id": "8e4cc6f5-4ae6-0c14-9145-3b5917a56063",
                  "title": "Mobile-Friendly 3-Block Email Body",
                  "blocks": [
                    {
                      "text": "Greeting -> Context/Bullets -> Crisp Close",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Structure routine emails into three crisp breathing blocks: 1-line greeting + direct purpose; short bulleted details or options (`2–3` lines max per paragraph); and an isolated bold or single-line Closing Ask telling the reader the easiest possible next action.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Isolated Ask Line",
                      "text": "Placing the single requested action on its own short closing paragraph right above sign-off so scanning eyes catch what to do instantly.",
                      "type": "definition"
                    },
                    {
                      "body": "Hi Priya — Following Tuesday’s sync, here are two staging windows:\n• Option A: Thu 10–11 AM\n• Option B: Fri 2–3 PM\nCould you reply \"A\" or \"B\" by 4 PM today so I can lock QA?",
                      "type": "example",
                      "title": "Clean 3-Block Flow"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Delete generic warm-up fluff (\"I hope this email finds you thriving during these busy times...\").",
                        "Keep emails cleanly focused around ONE core thread ask whenever possible.",
                        "Bold key deadlines or option letters lightly so eyes land cleanly."
                      ],
                      "title": "Applying Mobile-Friendly 3-Block Email Body"
                    },
                    {
                      "text": "Embedding four unrelated questions inside one dense paragraph consistently gets only question four answered.",
                      "type": "case_study",
                      "title": "Ignored 4-Question Paragraph",
                      "takeaway": "Numbering `1, 2, 3` cleanly raised full multi-part completion above 95%."
                    },
                    {
                      "text": "Whenever asking 2–3 distinct things inside one message, always use numbered `1, 2, 3` lines so recipients answer item-by-item effortlessly.",
                      "type": "callout",
                      "title": "Number Multi-Part Questions",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why isolate your main question on its own standalone line near the bottom?",
                      "options": [
                        "To make emails look fancy",
                        "Busy readers jump directly to the end when checking what action you need from them",
                        "To save punctuation"
                      ],
                      "explanation": "Visual isolation makes requested next steps effortless to spot and answer.",
                      "correctIndex": 1
                    }
