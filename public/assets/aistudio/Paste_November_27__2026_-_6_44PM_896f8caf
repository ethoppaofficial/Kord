            {
              "id": "ad94a869-e7bc-255b-dc53-bb6906a356c2",
              "title": "Module 2: Headlines, Hooks & Subheads",
              "lessons": [
                {
                  "id": "0295c785-e461-e568-6f10-08cea56311ae",
                  "title": "Headline Mechanics That Earn Reading",
                  "blocks": [
                    {
                      "text": "Specificity, Value & Qualifier Design",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Strong headlines combine who/what/result crisply without sounding spammy. Specific tangible numbers or timeframes (\"Build 3-step client onboarding in 20 minutes\") feel truthful and concrete compared to hollow hype (\"10x Your Business Overnight!\"). Pairing headline promise with a clarifying subhead resolves skepticism smoothly.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Rule of One",
                      "text": "Focusing each landing page or headline on ONE specific audience, ONE core promise, and ONE primary action rather than diluting focus across five offers.",
                      "type": "definition"
                    },
                    {
                      "body": "Hype: \"The Ultimate Secret to Unlimited Leads!\" Credible: \"Write Cold Emails Decision-Makers Actually Read—Without Templates That Sound Spammy.\"",
                      "type": "example",
                      "title": "Hype vs. Specific Credibility"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Draft at least 10 variations before settling—headlines improve rapidly past attempt #5.",
                        "Include concrete audience qualifier or realistic constraint.",
                        "Add an \"Even if [main objection]\" clarifier cleanly in subhead text."
                      ],
                      "title": "Applying Headline Mechanics That Earn Reading"
                    },
                    {
                      "text": "An agency page pitched \"SEO, Branding, Video & Custom Apps for All Industries\", sounding generic to everyone.",
                      "type": "case_study",
                      "title": "Multi-Offer Headline Confusion",
                      "takeaway": "Focusing strictly on \"Conversion Landing Pages for B2B Software Teams\" tripled qualified leads."
                    },
                    {
                      "text": "Drafting 10 fresh headlines AFTER finishing page copy often yields sharper phrasing than your first opener.",
                      "type": "callout",
                      "title": "Write Headlines Last Too",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What makes \"Cut onboarding calls by 40% without losing personal warmth\" beat \"Revolutionary onboarding mastery\"?",
                      "options": [
                        "It avoids verbs",
                        "Specific measurable gain paired with a real objection (\"without losing warmth\") earns instant credibility",
                        "It uses hype adjectives"
                      ],
                      "explanation": "Named benefits plus pre-answered objections convert skeptical buyers naturally.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Disciplined headline specificity earns genuine attention cleanly.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "fe25204d-4eff-4090-a56a-d54fdf54532a",
                      "url": "https://owl.purdue.edu/",
                      "title": "Purdue OWL Creative & Rhetorical Guides",
                      "position": 1,
