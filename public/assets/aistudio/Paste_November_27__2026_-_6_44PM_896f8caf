              "lessons": [
                {
                  "id": "b217d2aa-6f6f-13c8-f6d9-4c9f41ac2734",
                  "title": "Countering Late Nibbles & Fake Urgency",
                  "blocks": [
                    {
                      "text": "Calm Scope Protection at Closing",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Late nibbles exploit your excitement about closing. Smiling warmly and pricing the extra explicitly (\"Happy to add training slides as an extra £450 line item, or keep our agreed £6,000 scope as discussed\") restores fairness politely. Similarly, challenge artificial \"sign by 5 PM today or lose everything\" urgency without panic.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Late Nibble",
                      "text": "Requesting a small unpaid add-on right after terms seemed final, gambling the other side will cave rather than reopen talks.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Excited to launch Friday! Custom mobile templates sit outside our £5k core fee—would you like them quoted at £600 separately or saved for Month 2?\"",
                      "type": "example",
                      "title": "Stopping a Closing Nibble"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Pause whenever new extras appear near signing.",
                        "Separate core agreed deal from newly introduced additions.",
                        "Verify whether tight deadlines reflect genuine business events or mere pressure tactics."
                      ],
                      "title": "Applying Countering Late Nibbles & Fake Urgency"
                    },
                    {
                      "text": "Refusing calmly to fold 4 free hours of quarterly reporting into a closing signature protected £1,800/year across an agency client.",
                      "type": "case_study",
                      "title": "Preserving 12% Margin on Signing Day",
                      "takeaway": "Polite clarity prevents margin erosion at finish lines."
                    },
                    {
                      "text": "Ask smoothly on day one: \"Who else weighs in before this gets green-lit?\" so late mystery bosses do not ambush terms.",
                      "type": "callout",
                      "title": "Confirm Authority Early",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "How do you handle a sudden \"Can you also throw in free monthly coaching?\" on closing day?",
                      "options": [
                        "Grumble secretly and add it free",
                        "Enthusiastically offer it as a priced optional add-on alongside the already agreed package",
                        "Cancel the entire contract immediately"
                      ],
                      "explanation": "Polite separation protects your deal without spoiling excitement.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Spotting tactical pressure keeps closing stages fair and predictable.",
                  "position": 1,
                  "resources": [
                    {
