                {
                  "id": "101709cd-3e28-e9c8-e48c-7fc4b0de35ee",
                  "title": "Avoiding Reverse Delegation",
                  "blocks": [
                    {
                      "text": "Coaching Peers Back Through Friction",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "When a teammate runs into a puzzle and asks \"Can you just finish this formula?\", kindly resist grabbing the mouse. Coach lightly: \"Good catch—try checking step 2 lookup key for five minutes, drop a note if still blocked, and we'll debug together.\" Coaching peers past tiny walls builds real competence fast.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Reverse Delegation Trap",
                      "text": "Leader casually accepting back tasks they delegated the moment small obstacles arise, leaving peers passive and leaders swamped.",
                      "type": "definition"
                    },
                    {
                      "body": "\"What two paths have you checked so far, and which one feels safest to test first?\"",
                      "type": "example",
                      "title": "Constructive Re-Empowering"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Ask what options the teammate already weighed.",
                        "Verify no dangerous external risk exists before stepping back.",
                        "Praise independent problem-solving loudly afterward."
                      ],
                      "title": "Applying Avoiding Reverse Delegation"
                    },
                    {
                      "text": "Stopping habitual problem-grabbing for thirty days transformed four passive coordinators into proactive owners solving 85% of daily snags cleanly.",
                      "type": "case_study",
                      "title": "From Bottleneck Lead to Team Multiplier",
                      "takeaway": "Coaching beats solo heroism over every horizon."
                    },
                    {
                      "text": "Give crisp 2-minute directional hints rather than doing the teammate's work overnight.",
