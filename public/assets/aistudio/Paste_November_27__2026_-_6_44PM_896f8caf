                  "blocks": [
                    {
                      "text": "Planning Coverage That Edits Effortlessly",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Before turning cameras on, sketch or list 5 distinct purposeful shots for any sequence: (1) **Tight Detail Hands/Action** (hooks eyes immediately!), (2) **Medium Portrait/Face** (human connection), (3) **Wide Context** (shows where we are), (4) **Over-the-Shoulder Perspective** (puts viewer inside action), and (5) **Creative Unusual Angle / Clean Payoff**. Shooting varied focal distances makes editing smooth cuts automatic!",
                      "type": "paragraph"
                    },
                    {
                      "term": "Five-Shot Coverage Sequence",
                      "text": "Classic documentary shooting formula combining Detail Hands, Subject Face, Wide Setting, POV/Over-Shoulder, and Unusual Angle so editors assemble seamless sequences naturally.",
                      "type": "definition"
                    },
                    {
                      "body": "1. Close-up chisel shaving wood curls (Detail) -> 2. Carpenter smiling explaining craft (Medium) -> 3. Sunlit workshop bench (Wide) -> 4. Over-shoulder measuring wood joint -> 5. Finished table delivery.",
                      "type": "example",
                      "title": "60-Second Maker Storyboard"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Never shoot five medium-wide shots in a row—varied shot sizes eliminate awkward jump cuts cleanly.",
                        "Hold every shot steady for 5 full seconds before stopping record!",
                        "Capture 15 seconds of quiet \"Room Tone\" audio before packing bags."
                      ],
                      "title": "Applying The Five-Shot Storyboarding Formula"
                    },
                    {
                      "text": "Instructing crew to count silently \"1-2-3-4-5\" before moving cameras turned chaotic 1-second shaky clips into rock-steady editable coverage overnight.",
