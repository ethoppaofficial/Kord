                },
                {
                  "id": "8c551490-e096-4843-f77d-4ddb32854171",
                  "title": "Focus Choices: Saying No Inside Your Annual Plan",
                  "blocks": [
                    {
                      "text": "Strategic Trade-Off Discipline",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Good business planning declares explicitly what the team will **Stop** or **Delay** so top 2–3 priorities actually ship cleanly. A plan listing 14 top priorities actually holds zero priorities—forcing stretched managers into constant crisis firefighting without finishing core builds.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Not-Doing List",
                      "text": "An explicit companion section inside an annual or quarterly business plan specifying attractive initiatives deliberately deferred this cycle so scarce cash and time concentrate fully on primary goals.",
                      "type": "definition"
                    },
                    {
                      "body": "Q2 Top Bets: Launch Subscription Packaging & Automate Warehouse Scanning. Explicitly Deferred to Q4: International Shipping & Retail Pop-Up Booths.",
                      "type": "example",
                      "title": "Explicit Focus Trade-Off"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Cap company-wide major quarterly initiatives strictly at maximum 2–3 bets.",
                        "Document enticing deferred ideas openly onto a visible `\"Parked / Q4 Backlog\"` list so contributors feel heard without hijacking present focus.",
                        "Audit ongoing legacy commitments annually—kill silent time-draining low-margin products gracefully!"
                      ],
                      "title": "Applying Focus Choices: Saying No Inside Your Annual Plan"
                    },
                    {
                      "text": "An enthusiastic 8-person team entered January chasing 11 simultaneous goals; by June, zero finished completely and morale burned out.",
                      "type": "case_study",
                      "title": "Twelve-Initiative Paralysis",
                      "takeaway": "Trimming focus cleanly onto 3 clear sequential bets cleared every single target ahead of October!"
                    },
                    {
                      "text": "If your business plan never forces saying no to good optional opportunities, it hasn’t made real strategic choices yet.",
                      "type": "callout",
                      "title": "Strategy Means Deliberate Sacrifice",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why include an explicit `\"Deferred / Not Doing Now\"` block directly inside quarterly business plans?",
                      "options": [
                        "Shows laziness",
                        "Protects scarce team bandwidth visibly from shiny distractions so top 2–3 critical bets finish cleanly",
                        "Removes customer feedback"
                      ],
                      "explanation": "Documenting deferred items settles team debate and preserves execution concentration cleanly.",
                      "correctIndex": 1
                    }
                  ],
