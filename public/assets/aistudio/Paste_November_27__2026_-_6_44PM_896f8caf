                {
                  "id": "7c14a735-f053-aa87-b072-0af736975e28",
                  "title": "Celebrating, Crediting & Connecting Peers",
                  "blocks": [
                    {
                      "text": "Becoming a Generous Connector",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Notice overlap among folks you trust: when a talented freelance designer seeks steady SaaS work and an agency founder struggles with overflow, ask BOTH privately first via double opt-in before sending a concise intro thread highlighting why they will enjoy meeting. Double opt-in protects calendars while cementing deep respect from both peers simultaneously.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Double Opt-In Introduction",
                      "text": "Checking privately with both parties separately to verify genuine interest and bandwidth BEFORE linking them together in an intro email thread.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Hey Maya—an impact studio friend needs accessible chart audits for Q4. Happy if I introduce you two via email this week?\" -> Wait for yes -> Send intro.",
                      "type": "example",
                      "title": "Clean Opt-In Check"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Never surprise-introduce two busy colleagues unasked.",
                        "Highlight shared interests concisely in the intro email.",
                        "Step gracefully out of reply threads (\"Moving myself to BCC so you both coordinate easily\")."
                      ],
                      "title": "Applying Celebrating, Crediting & Connecting Peers"
                    },
                    {
                      "text": "Making four thoughtful double-opt-in intros per year quickly establishes anyone as a beloved connector whom leaders gladly help back whenever needed.",
                      "type": "case_study",
                      "title": "Quiet Hub Reputation",
                      "takeaway": "Generous hubs anchor entire communities cleanly."
                    },
                    {
                      "text": "Keep double-opt-in intros easy to reply to without trapping connectors on endless scheduling threads.",
                      "type": "callout",
                      "title": "Move to BCC Cleanly",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why ALWAYS confirm Double Opt-In privately before introducing two contacts via email?",
                      "options": [
                        "Doubles inbox clicks",
                        "Respects both people's current capacity and avoids forcing awkward unwanted calls onto either calendar",
                        "Required by email servers"
                      ],
                      "explanation": "Double opt-in guarantees welcome, high-energy introductions cleanly.",
                      "correctIndex": 1
