                  "blocks": [
                    {
                      "text": "The Coaching Conversation Arc",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Great listening conversations follow four calm steps: Establish safety and aim -> Explore context broadly via What/How prompts -> Reflect constraints and emotion until the speaker experiences clarity -> Co-design one next experiment they genuinely own. Keeping yourself 70% in listener mode builds independent thinking in others.",
                      "type": "paragraph"
                    },
                    {
                      "term": "70/30 Listening Ratio",
                      "text": "Aiming for the speaker to talk ~70% of diagnostic or coaching dialogues while your 30% consists of sharp open questions and clear reflections.",
                      "type": "definition"
                    },
                    {
                      "body": "Ask: \"What's taking unexpected energy this week?\" -> Reflect core bottleneck -> Ask: \"What's 1 small shift worth testing before Friday?\"",
                      "type": "example",
                      "title": "Weekly Peer Coaching Check"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Track rough talk-time ratio honestly.",
                        "Ask coaching prompts before advising.",
                        "Let the speaker name their own committed first step."
                      ],
                      "title": "Applying Discovery & Coaching Listening Cadence"
                    },
                    {
                      "text": "Shifting from giving instant answers to asking two clean coaching questions halved recurring escalations to a busy team lead within six weeks.",
                      "type": "case_study",
                      "title": "Self-Reliant Team Growth",
                      "takeaway": "Diagnostic listening builds capable independent teams."
                    },
                    {
                      "text": "If a discovery conversation never surprises your initial hypothesis, you probably talked or led too much.",
                      "type": "callout",
                      "title": "Measure Insight Surprises",
                      "variant": "tip"
                    },
