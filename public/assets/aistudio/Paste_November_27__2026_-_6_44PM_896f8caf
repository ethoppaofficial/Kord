          "phases": [
            {
              "id": "a8602a79-407a-8393-c8b8-da1fc498c574",
              "title": "Module 1: Showing Scenes vs. Pure Summary",
              "lessons": [
                {
                  "id": "4012a253-4ed5-4f22-efc6-a90f4c36e4e5",
                  "title": "Concrete Sensory Grounding",
                  "blocks": [
                    {
                      "text": "Show Through Behavior & Detail",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Telling declares an emotion (\"Tom was angry\"); showing places the reader inside the room as Tom squeezes a paper cup until coffee beads across his knuckles. Grounding scenes in two or three carefully chosen sensory cues (sound, tactile texture, light) creates immediate immersion without burying action in purple adjectives.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Scene Dramatization",
                      "text": "Rendering a pivotal story moment in real-time action, dialogue, and sensory detail rather than compressing it into summary narration.",
                      "type": "definition"
                    },
                    {
                      "body": "Summary: \"The kitchen felt lonely and old.\" Scene: \"Rust ringed the kettle base, and the wall clock ticked loud enough to count his breaths.\"",
                      "type": "example",
                      "title": "Rewriting Abstract Mood"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Name the emotion in your notes, then forbid yourself from typing that adjective.",
                        "Choose one bodily cue and one environmental object reacting under pressure.",
                        "Filter details strictly through what your POV character actually notices."
                      ],
                      "title": "Applying Concrete Sensory Grounding"
                    },
                    {
                      "text": "A draft opened with three paragraphs summarizing a protagonist’s lonely childhood before a single scene occurred.",
                      "type": "case_study",
                      "title": "Over-Explained Opening",
                      "takeaway": "Starting right as she unpacked one chipped teacup inside an empty apartment hooked readers immediately."
                    },
                    {
                      "text": "Show high-stakes turning points in full scenes; use crisp summary strictly to bridge uneventful time gaps.",
                      "type": "callout",
                      "title": "Use Summary Intentionally",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Which detail best \"shows\" anxiety without stating the emotion word?",
                      "options": [
                        "She was very scared waiting outside.",
                        "She folded her boarding pass into narrower squares until the paper edge split.",
                        "Fear filled her mind completely."
                      ],
                      "explanation": "Small physical actions under tension invite readers to infer emotion actively.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Concrete physical cues let readers inhabit scenes alongside characters.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "f416dee0-721b-431b-90fd-1e4bad7da5c6",
                      "url": "https://owl.purdue.edu/",
                      "title": "Purdue OWL Creative & Rhetorical Guides",
                      "position": 1,
                      "resource_type": "guide"
                    },
                    {
                      "id": "1134db82-70c5-4d2c-9fa3-52247d7a46ba",
                      "url": "https://www.nngroup.com/",
                      "title": "Nielsen Norman Group UX & Copy Clarity",
                      "position": 2,
                      "resource_type": "research"
                    }
                  ],
                  "takeaways": [
                    "Replace emotion labels with behavioral cues",
                    "Select 2–3 sharp sensory details over long lists",
                    "Save summary strictly for routine time transitions"
                  ],
                  "objectives": [
