            {
              "id": "3033afad-ea18-1cec-18e1-70bb467ac862",
              "title": "Module 2: Synthesis Matrix & Literature Integration",
              "lessons": [
                {
                  "id": "f88a45f7-aae7-8593-82e3-2d7e933d2aba",
                  "title": "Synthesis vs. Serial Summary (\"He Said, She Said\")",
                  "blocks": [
                    {
                      "text": "Thematic Source Architecture",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "True literature reviews organize by shared concepts, variables, or debates—NOT author surnames. Inside each thematic paragraph, two to four citations speak directly to one another: agreeing on mechanisms, diverging on population bounds, or revealing methodological gaps.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Synthesis Matrix",
                      "text": "A structured grid grouping reviewed papers by recurring themes, findings, methods, and points of agreement/conflict across columns before drafting prose.",
                      "type": "definition"
                    },
                    {
