                  "blocks": [
                    {
                      "text": "Delivering Value Manually First",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "A **Concierge MVP** solves the real customer problem manually behind the scenes using spreadsheets, plain email, or video calls—charging real modest fees right away—to learn every subtle messiness first. Only automate repetitive bottlenecks AFTER paying customers genuinely pull the service cleanly week over week.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Concierge MVP",
                      "text": "Manually delivering the exact end customer outcome to early paying clients using off-the-shelf docs/tools before investing heavily in software automation or leases.",
                      "type": "definition"
                    },
                    {
                      "body": "Want to build an automated pet-nutrition subscription? Manually design custom diet PDFs and fulfill 10 local paid trial orders via plain Stripe/bank link first—learn retention realities in two weekends!",
                      "type": "example",
                      "title": "Manual Before Custom Software"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Identify ONE risky core question (\"Will landlords actually pay for faster repair triage?\").",
                        "Design the smallest manual test delivering real value inside 7 days.",
                        "Define success thresholds ahead of time (`3 of 10 cold clinics pay $50 pilot`)."
                      ],
                      "title": "Applying Concierge Pilots Before Full Automation"
                    },
                    {
                      "text": "Spent $25,000 hiring agency developers for two-sided tutor booking software with zero real students lined up.",
                      "type": "case_study",
                      "title": "Premature Custom Marketplace",
                      "takeaway": "Running manual Google-Form + WhatsApp tutor matching for 15 families first would have uncovered pricing friction in 10 days for $0!"
                    },
                    {
                      "text": "Even a discounted $20 pilot filters out polite freebie collectors and proves genuine perceived value immediately.",
                      "type": "callout",
                      "title": "Charge Something Early",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why deliver early pilot outcomes manually via spreadsheets/email before writing custom automation code?",
