              "lessons": [
                {
                  "id": "d1cd2ac7-d8e1-a738-cde4-744a7f2559ca",
                  "title": "Linting, Type Checking & Build Gates in CI",
                  "blocks": [
                    {
                      "text": "Automated Pre-Merge Verification Pipelines",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Configure CI workflows running fast checks in sequence: static linting + `checkJs` type diagnostics, full automated unit + database test suites, production bundler verification (`vite build`), and dependency vulnerability audits (`npm audit`). Fail merges immediately on any non-zero exit.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Quality Gate",
                      "text": "An automated pass/fail check in CI preventing broken builds, syntax errors, or failing tests from merging into the main branch.",
                      "type": "definition"
                    },
                    {
                      "body": "Run 2-second ESLint/`tsc --noEmit` checks before slower container/E2E suites so obvious typos fail immediately.",
                      "type": "example",
                      "title": "Fast Feedback Ordering"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Keep test commands single-command runnable (`npm test`, `npm run lint`).",
                        "Commit a single deterministic lockfile (`package-lock.json`).",
                        "Verify production build (`npm run build`) actually succeeds in CI."
                      ],
                      "title": "Applying Linting, Type Checking & Build Gates in CI"
                    },
                    {
                      "text": "Running `eslint` alongside `vite build` flagged an undefined identifier on an error-handler branch that tests hadn’t executed yet.",
                      "type": "case_study",
                      "title": "Caught Missing Import Before Deploy",
                      "takeaway": "Static checks and tests complement each other cleanly."
                    },
                    {
                      "text": "Keep CI under a few minutes so engineers never feel tempted to bypass checks.",
                      "type": "callout",
                      "title": "Fail Fast, Fix Cleanly",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why pair static linting/type checking with runtime tests in CI?",
                      "options": [
                        "Redundant busywork",
                        "Linters catch dead imports and unexecuted-branch typos while tests verify runtime logic and DB rules",
                        "Vitest requires ESLint"
                      ],
                      "explanation": "Static analysis inspects 100% of code paths including rarely hit error branches.",
                      "correctIndex": 1
