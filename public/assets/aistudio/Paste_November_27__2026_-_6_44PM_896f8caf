              "lessons": [
                {
                  "id": "2ee49b17-4148-513b-236d-2b1bec861c0b",
                  "title": "The Moment of Truth Snapshot",
                  "blocks": [
                    {
                      "text": "Zooming Into Turning Moments",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Instead of sweeping smoothly over weeks of effort, freeze time right on the pivotal second: the unread slack ping at 6 PM, the handwritten sticky note beside a monitor, or the exact client quote. One vivid snapshot stays in audience memory weeks after slide bullets vanish.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Zoom Snapshot",
                      "text": "Slowing narrative speed deliberately onto one sensory detail or exact quote at the story’s emotional turning point.",
                      "type": "definition"
                    },
                    {
                      "body": "\"We stared at 14 spreadsheets until a warehouse packer asked cleanly: 'Why print labels twice when barcodes scan once?'\"",
                      "type": "example",
                      "title": "Freezing the Turning Point"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Pick ONE crisp moment marking your story’s insight shift.",
                        "Render dialogue word-for-word or name one concrete visual object.",
                        "Keep surrounding transitions tight so the snapshot pops."
                      ],
                      "title": "Applying The Moment of Truth Snapshot"
                    },
                    {
                      "text": "A speaker summarized six months of user tests as \"iterative learnings revealed alignment opportunities\".",
                      "type": "case_study",
                      "title": "Forgettable Summary Keynote",
                      "takeaway": "Quoting one confused user holding an upside-down box made the whole ballroom laugh and remember forever."
                    },
                    {
                      "text": "Preserving an exact short colloquial sentence from a customer or peer beats any polished corporate paraphrase.",
                      "type": "callout",
                      "title": "Quote Real Human Words",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why freeze briefly onto a specific quote or visual detail at the turning point?",
                      "options": [
