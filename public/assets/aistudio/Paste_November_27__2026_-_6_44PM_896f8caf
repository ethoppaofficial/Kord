                  "blocks": [
                    {
                      "text": "Depth in One Core + Fluency Across Adjacent Skills",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Cultivate a **T-shaped profile**: deep verified mastery in one core craft (e.g., Frontend Engineering, Paid Social, or Technical Writing) paired with working fluency in two adjacent skills (e.g., UX clarity, SQL data analysis, or client communication). That rare intersection makes you uniquely valuable on real teams.",
                      "type": "paragraph"
                    },
                    {
                      "term": "T-Shaped Skill Profile",
                      "text": "Deep specialized execution in one core discipline (the vertical bar) combined with broad collaborative literacy across neighboring fields (the horizontal bar).",
                      "type": "definition"
                    },
                    {
                      "body": "A Graphic Designer who also understands Conversion Copywriting and Basic HTML/CSS solves end-to-end landing page bottlenecks alone.",
                      "type": "example",
                      "title": "High-Leverage Intersection"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Pick one primary anchor domain for the next 6 months.",
                        "Pair it intentionally with 1–2 complementary bridge skills.",
                        "Validate each step with practical deliverables rather than passive certificates."
                      ],
                      "title": "Applying T-Shaped Skills & Deliberate Career Moats"
                    },
                    {
                      "text": "A customer support specialist who learned basic SQL and clean bug reporting transitioned smoothly into Associate Product Operations.",
                      "type": "case_study",
                      "title": "Bridge Skill Promotion",
                      "takeaway": "Adjacent skills create natural internal bridges."
                    },
                    {
                      "text": "Avoid shiny-object hopping across five fields simultaneously—earn verified proof in one anchor skill first.",
                      "type": "callout",
                      "title": "Depth First, Breadth Second",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What defines a T-shaped professional skill set?",
                      "options": [
                        "Equal beginner awareness across 15 topics",
                        "Deep verified mastery in one primary domain paired with collaborative fluency in adjacent disciplines",
                        "Zero soft skills"
                      ],
                      "explanation": "Deep craft plus cross-functional literacy makes contributors indispensable.",
