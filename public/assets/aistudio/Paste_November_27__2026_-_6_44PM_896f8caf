              "lessons": [
                {
                  "id": "b8925176-c73a-7187-3be1-677a19adcf14",
                  "title": "Lean Inventory, ABC Focus & Reorder Points",
                  "blocks": [
                    {
                      "text": "ABC Triage & Exact Reorder Triggers",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Sort stock via **ABC Analysis**: **Class A (~20% of items driving ~70–80% of cash)** gets tight weekly counts and firm **Reorder Points (`Reorder Trigger = Average Daily Usage x Vendor Lead Days + Safety Buffer`)**; **Class B** checks bi-weekly; **Class C** slow items stay ultra-lean or order-on-demand! Never guess replenishment solely by eyeballing boxes emotionally.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Reorder Point Formula",
                      "text": "Minimum stock threshold triggering a fresh purchase order automatically: `(Average Daily Usage x Supplier Delivery Lead Days) + Safety Buffer Units`, ensuring restock arrives right before hitting zero.",
                      "type": "definition"
                    },
                    {
                      "body": "Best-selling coffee bag sells `8 bags/day`. Roaster lead time = `5 days`. Safety Cushion (`3 days`) = `24 bags`. Reorder Trigger Point = `(8 x 5) + 24 = 64 bags`! The moment count hits 64, click reorder automatically!",
                      "type": "example",
                      "title": "Clean Reorder Trigger Math"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Identify strictly your top 20% Class-A cash generators and guard zero stockouts on them fiercely.",
                        "Liquidating stagnant Class-C shelf-warmers via quick bundle clearances converts dead boxes back into spendable bank cash!",
                        "Account honestly for realistic supplier shipping delays (`not rosy best-case speeds`) inside Lead Days."
                      ],
                      "title": "Applying Lean Inventory, ABC Focus & Reorder Points"
                    },
                    {
                      "text": "A charming boutique shop felt broke despite steady foot traffic—an inventory count revealed $38,000 sitting stagnant in odd-sized winter clearance stock while top core gift sizes stocked out constantly!",
                      "type": "case_study",
                      "title": "Cash Trapped on Dusty Shelves",
                      "takeaway": "ABC clearing restored liquid cash reserves and lifted profit within 60 days effortlessly!"
                    },
                    {
                      "text": "Count strictly 5–10 top Class-A SKUs weekly in ten minutes instead of closing the whole shop painfully once a year!",
                      "type": "callout",
                      "title": "Cycle-Count Weekly Over Annual Chaos",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Using `(Daily Sales x Lead Days) + Safety Buffer`, when should an owner reorder a SKU selling `5 units/day` with `6-day delivery` and `10-unit safety buffer`?",
                      "options": [
                        "At 10 units remaining",
                        "At 40 units remaining",
                        "At 5 units remaining"
                      ],
                      "explanation": "`(5 x 6) + 10 = 40 units` guarantees incoming delivery clears cleanly ahead of exhausting safety cushion.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Smart math-led replenishment balances lean shelves smoothly against costly best-seller stockouts.",
                  "position": 1,
                  "resources": [
