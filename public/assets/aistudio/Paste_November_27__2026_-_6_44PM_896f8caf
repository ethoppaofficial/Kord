              "lessons": [
                {
                  "id": "6a127855-4676-18c0-6285-cd1bdda86e55",
                  "title": "Buying Outcomes, Never Specs Alone",
                  "blocks": [
                    {
                      "text": "Clarity Trumps Cleverness",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Visitors land on a page wondering three rapid questions: What is this? Is it for someone like me? What concrete result will I get? Copy succeeds when it translates technical capabilities (\"256-bit automated nightly backup\") into human peace of mind (\"Never lose client contracts if a laptop crashes—automatic nightly restores in two clicks\").",
                      "type": "paragraph"
                    },
                    {
                      "term": "\"So What?\" Benefit Chain",
                      "text": "Asking \"So what does that mean for my customer’s Tuesday?\" repeatedly on every product feature until tangible time, money, or stress relief emerges.",
                      "type": "definition"
                    },
                    {
                      "body": "Feature: \"Real-time multi-currency sync.\" Outcome: \"Send client invoices in their currency and reconcile payout totals automatically without spreadsheet math.\"",
                      "type": "example",
                      "title": "Feature vs. Outcome Copy"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "List raw product/service capabilities honestly.",
                        "Ask \"Why does a tired customer care about this?\" twice per line.",
                        "Lead headlines with the core outcome; place supporting spec in subhead."
                      ],
                      "title": "Applying Buying Outcomes, Never Specs Alone"
                    },
                    {
                      "text": "\"Reimagine Synergistic Workflow Velocity\" left 70% of first-time visitors bouncing because nobody knew what the app did.",
                      "type": "case_study",
                      "title": "Vague SaaS Hero Banner",
                      "takeaway": "Changing to \"Turn Messy Client Requests Into Tracked Project Tasks in 30 Seconds\" lifted trial signups 38%."
                    },
                    {
                      "text": "Show your headline + subhead to a stranger for 5 seconds; ask them to explain what you sell. If they hesitate, rewrite clearly.",
                      "type": "callout",
                      "title": "Pass the 5-Second Squint Test",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What is a visitor primarily asking during their first 5 seconds on a sales page?",
                      "options": [
                        "How clever the brand pun sounds",
                        "What is this, who is it for, and what concrete problem does it solve for me?",
                        "How many engineers built it"
                      ],
                      "explanation": "Immediate comprehension unlocks every step down the conversion funnel.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Outcome-led clarity reliably outperforms vague creative slogans.",
                  "position": 1,
                  "resources": [
                    {
                      "id": "a507b1f5-f7e3-4208-920b-f46308f5c4e6",
                      "url": "https://owl.purdue.edu/",
