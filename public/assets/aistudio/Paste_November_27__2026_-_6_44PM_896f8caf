                    {
                      "text": "Write simple unmistakable economic rules ahead of Day 1: how leads get tagged (`CRM deal registration form` vs `dedicated partner link`), exact attribution duration (`e.g., 90 days post-intro`), payout triggers (`strictly upon paid cleared invoice`—protecting cash flow against refunds!), and clear rules if an account already existed inside active pipelines.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Deal Registration Protection",
                      "text": "A simple form or timestamped intro email locking a partner’s credit on a newly surfaced prospect for a defined window (`60–90 days`) so direct sales reps don’t quietly snatch earned credit.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Partner receives 15% recurring share on net collected Year-1 subscription revenue for new accounts not actively engaged within the prior 90 days, triggered 30 days post-payment to allow refund holds.\"",
                      "type": "example",
                      "title": "Fair Attribution Rule"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Clarify \"Existing Active Pipeline\" conflicts upfront—transparency prevents ugly sales disputes.",
                        "Pay strictly upon cleared cash collected (`net of refunds`), never uncollected gross invoices.",
                        "Keep tracking mechanics absurdly lightweight (one shared sheet or clean form beats bloated portals initially)."
                      ],
                      "title": "Applying Clean Attribution & Economic Fairness"
                    },
                    {
                      "text": "A partner introduced a mid-market prospect that a direct rep vaguely emailed 18 months earlier; without clear \"90-day active window\" definitions, both sides fought furiously over commission.",
                      "type": "case_study",
                      "title": "Channel Conflict Blowup",
                      "takeaway": "Explicit 90-day cold-account thresholds keep internal reps and external partners smoothly aligned."
                    },
                    {
                      "text": "Don’t build complex custom partner portals before you actively manage 15+ recurring partners—simple shared forms work cleanly Day 1!",
                      "type": "callout",
                      "title": "Keep Portals Simple Early",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why define a clear \"active pipeline lookback window\" (e.g., 90 days) inside partner agreements?",
                      "options": [
                        "Blocks all referrals permanently",
                        "Establishes indisputable fair rules distinguishing stale forgotten leads from true active sales deals",
                        "Replaces billing"
                      ],
                      "explanation": "Clear cutoffs prevent friction between internal sales reps and referring partners cleanly.",
                      "correctIndex": 1
                    }
