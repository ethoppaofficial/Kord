                },
                {
                  "id": "9659a318-d36c-0c71-ae48-f683ecc0a107",
                  "title": "Mining Real Voice-of-Customer (VoC) Phrases",
                  "blocks": [
                    {
                      "text": "Message Mining & Exact Phrasing",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "When prospects see their own exact private frustrations echoed back on your page, instant rapport forms. Scanning 20–30 honest 3-star and 5-star reviews uncovers emotional pain, unexpected use cases, and common hesitations far faster than internal brainstorming.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Voice of Customer (VoC)",
                      "text": "Systematically collecting exact recurring phrases customers use to describe pains, desired outcomes, and buying hesitations.",
                      "type": "definition"
                    },
                    {
                      "body": "Review phrase: \"I dreaded Friday payroll because formulas kept breaking.\" Headline: \"Stop Dreading Friday Payroll Broken Formulas.\"",
                      "type": "example",
                      "title": "VoC Gold Conversion"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Review 25 authentic customer testimonials, forums, or support emails.",
                        "Bucket recurring words into Pain Points, Desired Outcomes, and Objections.",
                        "Adopt exact natural phrasing rather than stiff corporate synonyms."
                      ],
                      "title": "Applying Mining Real Voice-of-Customer (VoC) Phrases"
                    },
                    {
                      "text": "Customers kept complaining about \"juggling receipts in shoeboxes\", while marketers wrote \"enterprise expense optimization\".",
                      "type": "case_study",
                      "title": "Corporate Translation Loss",
                      "takeaway": "Putting \"Ditch the Receipt Shoebox Forever\" doubled small-business click-through rates."
                    },
                    {
                      "text": "Mid-rating reviews hold the richest nuanced hesitations and feature gaps you can address proactively in copy.",
                      "type": "callout",
                      "title": "Inspect 3-Star & 4-Star Reviews",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why borrow phrasing directly from real customer reviews instead of inventing brand buzzwords?",
                      "options": [
                        "It takes less typing",
                        "Customers trust copy that mirrors their own real problems and everyday vocabulary",
                        "It replaces product demos completely"
                      ],
                      "explanation": "Familiar lived language signals immediate empathy and category fit.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Customer research eliminates blank-page guesswork and anchors copy in reality.",
                  "position": 2,
                  "resources": [
                    {
                      "id": "4ca51e82-5b8a-417f-9faf-6e9d39369a06",
