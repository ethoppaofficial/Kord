                },
                {
                  "id": "3cdf73ff-919b-d663-d4b1-2f91630dda15",
                  "title": "Separating Drafting From Editing",
                  "blocks": [
                    {
                      "text": "Zero-Friction Drafting Momentum",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Generating ideas uses creative flow, while judging prose uses analytical precision. Attempting both at once stalls momentum. Treating the first draft strictly as raw clay—leaving `[VERIFY STAT]` brackets for facts to double-check later—gets complete ideas onto the page rapidly.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Bracket Placeholder Technique",
                      "text": "Inserting quick inline markers like `[CHECK DATE]` during first drafts to maintain momentum without pausing to research.",
                      "type": "definition"
                    },
                    {
                      "body": "Open directly with a placeholder summary, draft sections 2 and 3 smoothly, then return to polish a sharp introduction once the ending is clear.",
                      "type": "example",
                      "title": "Flowing Through a Tough Opening"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Set a 20-minute uninterrupted drafting sprint.",
                        "Use bracket tags for missing citations or tricky transitions.",
                        "Wait until the full draft exists before tuning word choice."
                      ],
                      "title": "Applying Separating Drafting From Editing"
                    },
                    {
                      "text": "A technical coordinator spent three hours polishing two introductory sentences before writing a single word of the guide.",
                      "type": "case_study",
                      "title": "Perfectionist Paralysis",
                      "takeaway": "Switching to timed raw sprints produced complete guides in one day."
                    },
                    {
                      "text": "Start drafting your middle explanation or examples first; introductions are far easier once you know what you actually wrote.",
                      "type": "callout",
                      "title": "Draft Backwards When Stuck",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What should you do when you lack an exact figure mid-sentence during a first draft?",
                      "options": [
                        "Stop drafting and search for 20 minutes",
                        "Insert a visible bracket tag like [ADD STAT] and keep writing",
                        "Invent an approximate number silently"
                      ],
                      "explanation": "Visible bracket markers preserve momentum while guaranteeing fact verification during revision.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Splitting creation from critique makes writing faster and surprisingly better.",
                  "position": 2,
                  "resources": [
                    {
                      "id": "f940ae9c-c282-4416-a1ae-a6339c816c0f",
                      "url": "https://www.plainlanguage.gov/guidelines/",
                      "title": "Plain Language Guidelines",
