                {
                  "id": "59074558-b653-e5be-8ce3-5eca16d72410",
                  "title": "Extracting Genuine Subject-Matter Depth",
                  "blocks": [
                    {
                      "text": "Anchoring Content in Real Experience & Data",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Interview an internal specialist for 20 minutes, inspect real anonymized ticket trends, show genuine screenshots/diagrams, share mistakes honestly, and cite verifiable workflows. Specific, lived nuance makes readers trust your team instinctively.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Information Gain",
                      "text": "Unique original data, worked examples, real screenshots, or expert field trade-offs that generic rehashed summaries lack.",
                      "type": "definition"
                    },
                    {
                      "body": "Instead of listing \"5 tips for faster CSS\", include real before/after DevTools Lighthouse screenshots and exact refactored lines cleanly.",
                      "type": "example",
                      "title": "Adding Real Information Gain"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Pair writers with real practitioners for 15-minute recorded voice memos.",
                        "Include concrete examples, anti-patterns (\"What broke when we tried X\"), and numbers.",
