                {
                  "id": "b1396059-91c4-797d-c39c-c9b210021c38",
                  "title": "Bucket Brigades & Scannable Rhythm",
                  "blocks": [
                    {
                      "text": "Pattern Interrupts & Conversational Bridges",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Long-form web publishing relies on deliberate visual variety: alternate 2–3 line paragraphs with descriptive H2/H3 headers, real example callout quotes, numbered takeaways, brief conversational transitional prompts (\"Here is where most setups quietly trip:\"), and concise visual tables.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Bucket Brigade",
                      "text": "Short conversational bridge sentences (\"That raises a fair question:\", \"Here is the catch:\") pulling skimming eyes smoothly down into the next key explanation.",
                      "type": "definition"
                    },
                    {
                      "body": "\"That sounds simple on paper. In practice, three hidden edge cases catch beginners off guard:\"",
                      "type": "example",
                      "title": "Conversational Bridge"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Audit screen heights—avoid forcing readers to scroll more than 1–2 swipes without a subhead, bold pullout, list, or image.",
                        "Keep voice conversational (\"you\", \"we\") without rambling.",
                        "End sections cleanly by setting up natural curiosity into the next header."
                      ],
                      "title": "Applying Bucket Brigades & Scannable Rhythm"
                    },
                    {
                      "text": "A strong 2,200-word SaaS guide received minimal scroll completions because zero lists, examples, or sub-breaks divided body walls.",
                      "type": "case_study",
                      "title": "Uniform Text Marathon",
                      "takeaway": "Adding bold case boxes and descriptive H3s boosted average time-on-page dramatically."
                    },
                    {
                      "text": "Always glance at finished article formatting in a narrow phone column—what looks airy on widescreen turns into a 14-line brick on mobile.",
                      "type": "callout",
                      "title": "Preview On Mobile Width",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What helps web readers finish a 1,800-word deep-dive guide comfortably?",
                      "options": [
                        "Tiny tight margins",
                        "Frequent descriptive subheads, real visual breaks, short paragraphs, and crisp transition bridges",
                        "Hiding examples until footer"
                      ],
                      "explanation": "Visual cadence resets mental attention across long multi-section reads.",
                      "correctIndex": 1
                    }
