                },
                {
                  "id": "41cf7501-e1d7-48b5-9b76-26487e33798e",
                  "title": "Thinking in Second-Order Consequences",
                  "blocks": [
                    {
                      "text": "Anticipating Ripple Effects",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Every intervention echoes through complex systems. Offering instant unconditional partial refunds solves angry tickets today—yet may train repeat abuse next quarter unless logged clearly. Offering rush overtime fixes May targets—yet burns out top engineers by July. Tracing \"And then what?\" two steps downstream builds resilient solutions.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Second-Order Thinking",
                      "text": "Tracing indirect downstream behavioral, financial, or incentive shifts triggered weeks after an initial Level-1 solution takes effect.",
                      "type": "definition"
                    },
                    {
                      "body": "Level-1: route tough tickets to senior leads fast. Level-2 risk: junior reps stop learning debugging and escalate everything. Guardrail: require 2 tried troubleshooting notes before escalating.",
                      "type": "example",
                      "title": "Fixing Escalation Incentives"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Ask \"And what behavior does this reward?\" two steps out.",
                        "Check side effects on adjacent teams cleanly.",
                        "Add mild friction/visibility checks blocking perverse gaming."
                      ],
                      "title": "Applying Thinking in Second-Order Consequences"
                    },
                    {
                      "text": "Adding a mandatory 3-line \"What I Checked\" note stopped senior escalation flooding within 48 hours while preserving fast rescue on genuine emergencies.",
                      "type": "case_study",
                      "title": "Smart Support Routing Tweak",
                      "takeaway": "Tiny feedback design beats reactive bans completely."
                    },
                    {
                      "text": "Consider lightly how stressed humans might shortcut or exploit a well-meaning rule later.",
                      "type": "callout",
                      "title": "Ask: Who Might Game This?",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What characterizes Level-2 (second-order) problem-solving thinking?",
                      "options": [
                        "Ignoring long-term side effects completely",
                        "Tracing indirect incentive, morale, or downstream ripple shifts weeks after an immediate patch launches",
                        "Picking cheapest option blindly"
                      ],
                      "explanation": "Looking two steps ahead builds durable healthy systems.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Systems awareness keeps today's fix from becoming tomorrow's crisis.",
                  "position": 2,
