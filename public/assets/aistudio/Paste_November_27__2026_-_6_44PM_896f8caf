                },
                {
                  "id": "4e138cf6-86eb-6479-1a4c-c9602f725ca0",
                  "title": "Point of View & Psychic Distance",
                  "blocks": [
                    {
                      "text": "Controlling POV Discipline",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "In tight Third-Person Limited or First-Person POV, every observation, metaphor, and judgment on the page must pass believably through one focal character’s eyes and temperament. Holding consistent psychic distance keeps emotional stakes unified.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Head-Hopping",
                      "text": "Shifting abruptly between multiple characters’ private unspoken thoughts within the same scene without a structured scene break.",
                      "type": "definition"
                    },
                    {
                      "body": "If writing from Maya’s POV, describe David’s clenched jaw and tight smile—never say \"David secretly wished he had stayed home.\"",
                      "type": "example",
                      "title": "Keeping POV Clean"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Mark whose eyes anchor each scene before drafting.",
                        "Inspect drafts for accidental \"he thought / she realized\" swaps mid-scene.",
                        "Let vocabulary match the POV character’s personality and profession."
                      ],
                      "title": "Applying Point of View & Psychic Distance"
                    },
                    {
                      "text": "Jumping between three siblings’ internal grievances within two pages left readers unsure whose side the story followed.",
                      "type": "case_study",
                      "title": "Confused Dinner Conflict",
                      "takeaway": "Locking scenes strictly to one POV turned scattered noise into genuine tension."
                    },
                    {
                      "text": "If a story shifts viewpoints, place a clear scene break (`***`) or start a fresh chapter.",
                      "type": "callout",
                      "title": "Separate POV Changes Visually",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What violates Third-Person Limited POV discipline inside a single scene?",
                      "options": [
                        "Describing weather vividly",
                        "Reporting private unspoken memories of a secondary character mid-paragraph",
                        "Using dialogue tags cleanly"
                      ],
                      "explanation": "Limited POV observes secondary characters solely through external behavior and speech.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Disciplined point of view sustains unbroken reader empathy.",
                  "position": 2,
                  "resources": [
                    {
                      "id": "007e3196-68be-41f3-9f94-d24a6d7715c3",
                      "url": "https://www.nngroup.com/",
                      "title": "Nielsen Norman Group UX & Copy Clarity",
                      "position": 1,
