              "lessons": [
                {
                  "id": "267d5c9e-983a-31ea-1d11-5ac17bff9f1e",
                  "title": "Working ON the Business Alongside Working IN It",
                  "blocks": [
                    {
                      "text": "Protecting Builder Time From Urgent Whirlwinds",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Separate reactive daily fulfillment (**Working IN**: baking, coding, packing, calls) cleanly from proactive structural upgrading (**Working ON**: improving checklists, mentoring staff, calling lost clients, auditing supplier costs, refining offers). Protecting strictly **two uninterrupted 2-hour mornings weekly** locked strictly \"Working ON\" builds steady structural progress month after month without sacrificing client warmth!",
                      "type": "paragraph"
                    },
                    {
                      "term": "Working ON vs. Working IN",
                      "text": "Distinguishing tactical daily delivery work (`Working IN`) from strategic improvement—updating SOPs, finances, hiring, and offers (`Working ON`) that permanently elevates future capacity.",
                      "type": "definition"
                    },
                    {
                      "body": "Tuesday & Thursday `8:00–10:00 AM`: Phone silenced, zero routine tickets—strictly dedicated to revising 1 messy SOP, reviewing cash forecast, and thanking top clients!",
                      "type": "example",
                      "title": "Calendar Protection Example"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Guard \"Working ON\" morning blocks fiercely on calendars like unbreakable external surgeon appointments!",
                        "Delegate repetitive daily routines sequentially (`bookkeeping prep -> supply ordering -> routine inbox sorting`) off the founder desk strictly using documented checklists first!",
                        "Review where YOUR personal weekly hours drained every Sunday (`\"What tasks belonged cleanly at $20/hr while blocking $200/hr strategy?\"`)."
                      ],
                      "title": "Applying Working ON the Business Alongside Working IN It"
                    },
                    {
                      "text": "An experienced IT shop owner worked nonstop 6 days a week for four years personally resetting routine printers—zero revenue growth because zero hours existed to train assistants or improve pricing.",
                      "type": "case_study",
                      "title": "70-Hour Stagnant Treadmill",
                      "takeaway": "Protecting 4 weekly hours systematically trained two junior techs cleanly out of chaos into calm doubling!"
                    },
                    {
                      "text": "Handing off messy undocumented chores guarantees boomeranging errors back onto your desk—document the tiny 1-page checklist cleanly BEFORE delegating!",
                      "type": "callout",
                      "title": "Delegate Checklists, Never Blindly",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "What makes blocking just four uninterrupted \"Working ON\" hours weekly transform stagnant overworked small businesses?",
                      "options": [
                        "Eliminates customer work",
                        "Carves steady calm space to fix root recurring fires, coach teams, and tighten financial margins permanently",
                        "Replaces accounting"
                      ],
                      "explanation": "Compounding weekly system upgrades gradually break the exhausting firefighting cycle cleanly.",
                      "correctIndex": 1
