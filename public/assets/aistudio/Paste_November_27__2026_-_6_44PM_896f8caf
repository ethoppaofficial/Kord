                    }
                  ],
                  "publication_status": "published",
                  "completion_criteria": "Study the core frameworks in \"Eliminating \"Happy Ears\" From BD Pipelines\", verify the inline knowledge check, and apply the practical checklist."
                },
                {
                  "id": "f703ecf4-e05c-60ac-0e1e-546b45b8e463",
                  "title": "Measuring Partnership Health & Portfolio Pruning",
                  "blocks": [
                    {
                      "text": "The 80/20 Partner Portfolio Rule",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Track clean leading metrics (`Qualified Partner-Sourced Intros/Month`, `Enablement Adoption`, `Intro Conversion Speed`) alongside lagging outcome value (`Partner-Sourced Pipeline`, `Retention Lift of Integrated Customers`). Quarterly, prune idle agreements politely down to maintenance tier so active high-velocity champions get deeply supported co-selling focus.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Partner Tiering (80/20)",
                      "text": "Allocating active dedicated co-selling time, bespoke campaigns, and executive alignment exclusively to top proven high-velocity partners while automating self-serve basics for occasional referrers.",
                      "type": "definition"
                    },
                    {
                      "body": "Top 4 active agencies generating steady monthly referrals graduate to Tier-A Gold Support (`dedicated Slack + co-funded workshops`); dormant signups shift onto clean automated portal updates.",
                      "type": "example",
                      "title": "Quarterly Tiering Shift"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Track Partner-Sourced Revenue separately from Partner-Influenced Revenue—never inflate credits sloppily!",
                        "Compare CAC + LTV of partner-acquired customers against direct ads cleanly—partner buyers frequently retain twice as long!",
                        "Audit active partner bandwidth quarterly to reward builders producing genuine wins."
                      ],
                      "title": "Applying Measuring Partnership Health & Portfolio Pruning"
                    },
                    {
