              "lessons": [
                {
                  "id": "5536adee-8e14-0089-9717-f29d50ced3b8",
                  "title": "Decomposing Big Ambiguous Tasks via WBS",
                  "blocks": [
                    {
                      "text": "Work Breakdown Structure & The 3-Day Rule",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "A **Work Breakdown Structure (`WBS`)** splits deliverable outcomes hierarchically into concrete **work packages** small enough to estimate accurately and check progress weekly (`Target: break tasks down until every piece takes <=2–3 working days!`). Smaller visible steps reveal forgotten prerequisites (`legal signoff, vendor API key, copy review`) on Day 2 instead of Launch Eve.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Work Breakdown Structure (WBS)",
                      "text": "Hierarchical decomposition of a project’s total deliverables into clean, trackable, assignable <=3-day sub-tasks so hidden dependencies and blind spots surface early.",
                      "type": "definition"
                    },
                    {
                      "body": "Vague: \"Send Campaign (2 wks).\" WBS: 1) Confirm audience list segments (`0.5d`), 2) Draft copy + review (`2d`), 3) Design responsive template (`1.5d`), 4) Litmus inbox render QA (`0.5d`), 5) Legal unsubscribe check (`1d`), 6) Schedule send + monitor metrics (`0.5d`).",
                      "type": "example",
                      "title": "Breaking Down \"Launch Client Newsletter\""
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Decompose strictly by tangible output milestones (`noun + verb` completions) rather than vague verbs like \"Research\".",
                        "Spot multi-person tasks—split them so ONE person owns each finite card cleanly.",
                        "Validate missing steps cleanly by reading backward from Launch Day!"
                      ],
                      "title": "Applying Decomposing Big Ambiguous Tasks via WBS"
                    },
                    {
                      "text": "Decomposing a \"2-day pricing update\" surfaced a mandatory compliance signoff queue taking 5 business days—saving an entire campaign window!",
                      "type": "case_study",
                      "title": "The Hidden 4-Day Legal Gate"
                    },
                    {
                      "text": "Never assume drafts ship perfect—schedule explicit `Review + Revisions` tasks right inside your WBS!",
