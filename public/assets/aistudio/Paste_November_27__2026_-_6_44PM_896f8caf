                  "blocks": [
                    {
                      "text": "Problem-Matched Opt-In Filters",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "The smartest lead magnet solves Step 1 of the exact problem your paid service solves completely: a bookkeeping firm offers an \"End-of-Year Receipt Audit Checklist\", while a web studio offers a \"5-Minute Homepage Speed & Accessibility Self-Check\". Only people actively caring about that real problem opt in.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Qualified Lead Magnet",
                      "text": "A compact, instantly usable resource solving an immediate sub-problem strictly relevant to future customers—naturally filtering out unrelated freebie seekers.",
                      "type": "definition"
                    },
                    {
                      "body": "Bad: \"Enter to win headphones!\" Good: \"Download the 7-Point Commercial Lease Red-Flag Checklist before signing.\"",
                      "type": "example",
                      "title": "Filtering For Buyers"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Pick a bottleneck buyers hit 1–4 weeks before needing your core offer.",
                        "Keep asset consumption under 10 minutes (template/checklist beats 80-page ebook!).",
                        "Pair immediate instant delivery with one thoughtful follow-up prompt."
                      ],
                      "title": "Applying Specific Lead Magnets vs. Generic Giveaways"
                    },
                    {
                      "text": "Replacing a sweeping contest with a focused ROI pricing worksheet cut monthly lead volume by 40% while tripling qualified sales calls.",
                      "type": "case_study",
                      "title": "Cleaning 4,000 Dead Leads",
                      "takeaway": "Fewer sharper leads beat bloated noisy lists cleanly."
                    },
                    {
                      "text": "Busy prospects consume interactive checklists and ready-to-copy templates vastly faster than dense PDF novels.",
