                    {
                      "term": "Frictionless Brand Adoption",
                      "text": "Providing clean pre-built starter layout frames, copy snippets, and accessible brand links so teammates and freelancers stay effortlessly on-brand simply because templates save them 20 minutes!",
                      "type": "definition"
