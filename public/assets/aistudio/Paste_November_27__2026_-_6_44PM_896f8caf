                {
                  "id": "18f95c31-4129-3b1e-5f75-6b162306b1a9",
                  "title": "The Accordion Story Method",
                  "blocks": [
                    {
                      "text": "Compressing & Expanding Without Breaking Spine",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "If you know a story’s core spine—Want, Clash, Insight, Shift—you can shrink it to 45 seconds for an interview or expand it to 1,200 words for an editorial feature without losing coherence. Master the 60-word micro-story first; extra time merely lets you enrich key snapshots.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Story Spine",
                      "text": "The irreducible 4-sentence skeleton holding Setup, Complication, Turn, and Meaning before sensory details expand around it.",
                      "type": "definition"
                    },
                    {
                      "body": "Last May our checkout abandoned rate hit 68%. Developers assumed server speed lagged, BUT watching five users on phone revealed hidden shipping fees at step four. Moving estimates upfront cut abandonment nearly in half within ten days.",
                      "type": "example",
                      "title": "60-Word Micro-Story"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Write your 4-sentence irreducible spine first.",
                        "Check that complication and insight remain intact even at 60 words.",
                        "Expand strictly by deepening Turning-Point detail—never adding rambling side subplots."
                      ],
                      "title": "Applying The Accordion Story Method"
                    },
                    {
                      "text": "A candidate spent four minutes setting up an early internship scene and got cut off before reaching what they actually solved.",
                      "type": "case_study",
                      "title": "Interview Time-Out",
                      "takeaway": "Practicing 90-second accordion compression made every subsequent STAR story shine."
                    },
                    {
                      "text": "Speak your core version against a 60-second timer until pace feels conversational, not rushed.",
                      "type": "callout",
                      "title": "Time Your Spine Live",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "When compressing a story from 5 minutes to 60 seconds, what must NEVER be cut?",
                      "options": [
                        "Detailed wardrobe history",
                        "The complication (\"but\") and resulting insight turn",
                        "Peripheral characters’ names"
                      ],
                      "explanation": "Without friction and the turning insight, only empty plot summary remains.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Mastering accordion compression makes you agile in any speaking or writing slot.",
                  "position": 1,
                  "resources": [
                    {
