                      "url": "https://www.gov.uk/guidance/content-design",
                      "title": "Content Design & Writing Standards",
                      "position": 2,
                      "resource_type": "guide"
                    }
                  ],
                  "takeaways": [
                    "Honor word limits rather than shrinking font sizes",
                    "Feature quick headline metric boxes upfront",
                    "Use bold lead-ins on analytical bullets"
                  ],
                  "objectives": [
                    "Explain structured page hierarchy",
                    "Apply scannable one-pagers & callout boxes in original drafts"
                  ],
                  "est_minutes": 28,
                  "is_required": true,
                  "introduction": "One-page briefs succeed only when visual layout separates strategic signal from dense paragraphs.",
                  "further_reading": [
                    {
                      "url": "https://www.plainlanguage.gov/guidelines/",
