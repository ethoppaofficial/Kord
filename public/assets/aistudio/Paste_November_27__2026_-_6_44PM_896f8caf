                  "blocks": [
                    {
                      "text": "Modular Snippets Over Rigid Scripts",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Save modular structural skeletons (`Context + Bullet Slots + Standard Sign-Off`) rather than rigid canned essays. Always leave clear eye-catching brackets (`[[INSERT SPECIFIC DETAIL]]`) forcing deliberate human personalization in opening line one before sending.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Personalization Slot",
                      "text": "An unmistakable visual placeholder (`[[REFERENCE THEIR SPECIFIC TALK/DOC]]`) inside reusable email snippets preventing accidental un-customized sends.",
                      "type": "definition"
                    },
                    {
                      "body": "\"Hi [[Name]], thanks again for walking through [[Project]]. Here is our quick recap:\n• Decisions: [[...]]\n• Next Owners: [[...]]\"",
                      "type": "example",
                      "title": "Safe Modular Snippet"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Keep tone natural—avoid stale legal clichés like \"Kindly do the needful\" or \"Attached please find herewith.\"",
                        "Use unmistakable double brackets `[[...]]` that jump out if skipped.",
                        "Refresh snippet phrasing quarterly so your own voice stays fresh."
                      ],
                      "title": "Applying Humanizing Templates Without Robotic Stiffness"
                    },
                    {
                      "text": "An applicant pasted a cover email template reading \"I would be thrilled to join [COMPANY_NAME] as QA Lead!\" right into three top applications.",
                      "type": "case_study",
                      "title": "Leftover Placeholder Fail",
                      "takeaway": "Bright `[[VERIFY]]` anchors plus slow final-line read catch slip-ups completely."
                    },
                    {
                      "text": "Populate `To:` and `CC:` strictly AFTER finishing final edits, proofread, and attaching files—zero premature accidental clicks!",
                      "type": "callout",
                      "title": "Add Recipients Dead Last",
                      "variant": "tip"
                    },
