              "lessons": [
                {
                  "id": "5a070030-1776-8f85-ef0a-4987de11b225",
                  "title": "Macro Editing Before Line Polish",
                  "blocks": [
                    {
                      "text": "Top-Down Revision Sequence",
                      "type": "heading",
                      "level": 2
                    },
                    {
                      "text": "Experienced editors revise from large to small: first auditing purpose, order, and missing arguments; next tightening paragraphs and sentences; only finally inspecting spelling and punctuation. Changing this order saves hours and improves overall logic.",
                      "type": "paragraph"
                    },
                    {
                      "term": "Macro-to-Micro Revision",
                      "text": "Three distinct editing stages checking overall argument/order first, sentence clarity second, and typos/punctuation last.",
                      "type": "definition"
                    },
                    {
                      "body": "Discovering during Pass 1 that section three repeats section one allows immediate merging before any line-level polishing occurs.",
                      "type": "example",
                      "title": "Spotting Macro Gaps"
                    },
                    {
                      "type": "steps",
                      "items": [
                        "Pass 1 (Macro): Check thesis clarity, section order, and unsupported claims.",
                        "Pass 2 (Line): Cut filler, strengthen verbs, smooth transitions.",
                        "Pass 3 (Copy/Proof): Verify numbers, links, names, and punctuation."
                      ],
                      "title": "Applying Macro Editing Before Line Polish"
                    },
                    {
                      "text": "A writer perfected every sentence in a 900-word draft, only for an editor to request removing the entire middle third for irrelevance.",
                      "type": "case_study",
                      "title": "Wasted Line-Edit Sprint",
                      "takeaway": "Checking structure first avoids polishing doomed paragraphs."
                    },
                    {
                      "text": "Even a 30-minute break—or reading in a different font/view—shuts off memory bias so you read what is actually written.",
                      "type": "callout",
                      "title": "Step Away Before Editing",
                      "variant": "tip"
                    },
                    {
                      "type": "knowledge_check",
                      "prompt": "Why must macro structure review precede proofreading?",
                      "options": [
                        "Commas do not matter in finished articles",
                        "Polishing lines that may be moved or cut wastes time and hides bigger logical gaps",
                        "Spellcheck fixes structure too"
                      ],
                      "explanation": "Fixing large structural issues first prevents wasted micro-polishing.",
                      "correctIndex": 1
                    }
                  ],
                  "videos": [],
                  "summary": "Layered editing keeps revision calm, fast, and thorough.",
                  "position": 1,
                  "resources": [
